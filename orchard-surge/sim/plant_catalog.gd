static func get_stats(kind: int) -> Dictionary:
	var out := (DEFS[kind] as Dictionary).duplicate(true)
	out["kind"] = kind
	out["fire_interval"] = float(out["fire_ticks"]) * DT
	out["slow_duration"] = float(out["slow_ticks"]) * DT
	return out
