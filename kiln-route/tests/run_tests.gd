func _test_throat_blocked_does_not_spill() -> void:
	var behind_wall := {
		"id": 0, "name": "throat behind wall", "blurb": "", "rule": "", "w": 3, "h": 3,
		"sources": [Rooms.source(2, 1, Rules.Dir.WEST, [Rules.Mat.ORE, Rules.Mat.INGOT], 1)],
		"sinks": [
			Rooms.sink(2, 1, [Rules.Mat.ORE, Rules.Mat.INGOT]),
			Rooms.sink(1, 2, [Rules.Mat.ORE, Rules.Mat.INGOT]),
			Rooms.sink(1, 0, [Rules.Mat.ORE, Rules.Mat.INGOT]),
		],
		"chutes": [Rooms.cell(0, 0), Rooms.cell(2, 0), Rooms.cell(0, 2), Rooms.cell(2, 2)],
		"walls": [Rooms.cell(0, 1)],
		"budget": Rooms.kv([Rules.Kind.THROAT, 1, Rules.Kind.POINT, 1]),
		"quota": Rooms.kv([Rules.Mat.ORE, 1]),
		"initial": [], "solution": [],
	}
	var held := World.simulate(behind_wall, [Rooms.piece(Rules.Kind.THROAT, 1, 1, Rules.Dir.EAST)], 6)
	var point := World.simulate(behind_wall, [Rooms.piece(Rules.Kind.POINT, 1, 1, Rules.Dir.EAST)], 2)
	check(held.error == "" and held.discarded == 0 and held.trace.is_empty(), "a throat with a blocked behind cell does not spill forward or sideways")
	check(held.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "blocked ore stays on the throat when the behind cell refuses")
	check(int(held.world.sources[0].pending) == Rules.Mat.INGOT, "the arrival is not accepted while the throat's behind cell refuses")
	check(int(held.counts[Rules.Mat.ORE]) == 0 and int(held.counts[Rules.Mat.INGOT]) == 0, "a blocked behind cell does not send the arrival forward")
	check(_trace(point) == "2:1,2:0|2:2,1:1", "a point uses the open right cell the throat refuses, got %s" % _trace(point))
	var forward_wall := {
		"id": 0, "name": "throat forward wall", "blurb": "", "rule": "", "w": 3, "h": 3,
		"sources": [Rooms.source(2, 1, Rules.Dir.WEST, [Rules.Mat.ORE, Rules.Mat.INGOT], 1)],
		"sinks": [
			Rooms.sink(0, 1, [Rules.Mat.ORE, Rules.Mat.INGOT]),
			Rooms.sink(1, 0, [Rules.Mat.ORE, Rules.Mat.INGOT]),
			Rooms.sink(1, 2, [Rules.Mat.ORE, Rules.Mat.INGOT]),
		],
		"chutes": [Rooms.cell(0, 0), Rooms.cell(2, 0), Rooms.cell(0, 2), Rooms.cell(2, 2)],
		"walls": [],
		"budget": Rooms.kv([Rules.Kind.THROAT, 1, Rules.Kind.BEAM, 1]),
		"quota": Rooms.kv([Rules.Mat.ORE, 1]),
		"initial": [], "solution": [],
	}
	var forward_held := World.simulate(forward_wall, [Rooms.piece(Rules.Kind.THROAT, 1, 1, Rules.Dir.EAST)], 6)
	var beam := World.simulate(forward_wall, [Rooms.piece(Rules.Kind.BEAM, 1, 1, Rules.Dir.EAST)], 2)
	check(forward_held.trace.is_empty() and forward_held.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "a blocked forward cell keeps the waiter on the throat")
	check(int(forward_held.world.sources[0].pending) == Rules.Mat.INGOT, "the arrival is not accepted while the throat's forward cell refuses")
	check(int(forward_held.counts[Rules.Mat.ORE]) == 0 and int(forward_held.counts[Rules.Mat.INGOT]) == 0, "a blocked forward cell does not send the waiter behind")
	check(_trace(beam) == "2:0,1:0|2:1,0:1", "a beam sends the arrival left, not forward, got %s" % _trace(beam))


func _test_wing33_lessons() -> void:
	var wrong_kinds: Array = [
		Rules.Kind.BELT, Rules.Kind.DWELL, Rules.Kind.TWIN, Rules.Kind.PASS,
		Rules.Kind.SLIP, Rules.Kind.SHED, Rules.Kind.HOOK, Rules.Kind.RAKE,
		Rules.Kind.HOE, Rules.Kind.HARROW, Rules.Kind.LANDSIDE, Rules.Kind.MOLDBOARD,
		Rules.Kind.COULTER, Rules.Kind.SHARE, Rules.Kind.FORK, Rules.Kind.PRONG,
		Rules.Kind.SLADE, Rules.Kind.HEEL, Rules.Kind.STILT, Rules.Kind.CLEVIS,
		Rules.Kind.BEAM, Rules.Kind.HAKE, Rules.Kind.SOLE, Rules.Kind.FROG,
		Rules.Kind.SHIN, Rules.Kind.POINT,
	]
	for index in range(256, 264):
		var room: Dictionary = Rooms.all()[index]
		for kind in wrong_kinds:
			var swapped := _swap_kind(room.solution, Rules.Kind.THROAT, int(kind))
			var run: Dictionary = World.simulate(room, swapped)
			check(run.error == "", "%s in place of the room %d throat simulates (%s)" % [Rules.KIND_NAME[int(kind)], room.id, run.error])
			check(not run.quota_ok, "%s in place of the room %d throat misses the quota (%s)" % [Rules.KIND_NAME[int(kind)], room.id, run.text])
			check(not run.success, "%s in place of the room %d throat does not clear" % [Rules.KIND_NAME[int(kind)], room.id])
			if int(kind) != Rules.Kind.BELT:
				check(int(room.budget.get(int(kind), 0)) == 0, "room %d does not budget a %s" % [room.id, Rules.KIND_NAME[int(kind)]])
		var planner = Planner.new(room)
		for piece in room.initial:
			check(planner.pickup(int(piece.x), int(piece.y)), "room %d picks up its starting piece" % room.id)
		for piece in room.solution:
			check(planner.place(int(piece.kind), int(piece.x), int(piece.y), int(piece.dir)), "room %d places its solution from the tray" % room.id)
		var spare := _spare_cell(room)
		check(spare.x >= 0, "room %d has an empty cell for an extra piece" % room.id)
		check(not planner.place(Rules.Kind.BELT, spare.x, spare.y, Rules.Dir.EAST), "room %d rejects a belt past the tray" % room.id)
		var extra: Array = room.solution.duplicate(true)
		extra.append(Rooms.piece(Rules.Kind.BELT, spare.x, spare.y, Rules.Dir.EAST))
		var over: Dictionary = World.simulate(room, extra)
		check(over.quota_ok and not over.budget_ok and not over.success, "room %d extra belt meets the quota and is rejected (%s)" % [room.id, over.text])
	var ore: Dictionary = Rooms.all()[256]
	var smelted: Dictionary = World.simulate(ore, ore.solution)
	check(int(smelted.counts[Rules.Mat.INGOT]) == 29 and int(smelted.counts[Rules.Mat.PLATE]) == 30, "ahead ore feeds the kiln and the plate bin (%s)" % smelted.text)
	var ore_point: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.THROAT, Rules.Kind.POINT))
	var ore_shin: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.THROAT, Rules.Kind.SHIN))
	var ore_frog: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.THROAT, Rules.Kind.FROG))
	var ore_sole: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.THROAT, Rules.Kind.SOLE))
	var ore_beam: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.THROAT, Rules.Kind.BEAM))
	check(int(ore_point.counts[Rules.Mat.INGOT]) == 0, "ahead ore's point sends the ore right (%s)" % ore_point.text)
	check(int(ore_shin.counts[Rules.Mat.INGOT]) == 0, "ahead ore's shin sends the ore left (%s)" % ore_shin.text)
	check(int(ore_frog.counts[Rules.Mat.INGOT]) == 0, "ahead ore's frog sends the ore forward (%s)" % ore_frog.text)
	check(int(ore_sole.counts[Rules.Mat.INGOT]) == 0, "ahead ore's sole sends the ore forward (%s)" % ore_sole.text)
	check(int(ore_beam.counts[Rules.Mat.PLATE]) == 0, "ahead ore's beam sends the plate left (%s)" % ore_beam.text)
	var still: Dictionary = Rooms.all()[257]
	var stilled: Dictionary = World.simulate(still, still.solution)
	check(int(still.budget[Rules.Kind.BELT]) == 1, "still throat budgets one belt")
	var still_belts := 0
	var still_south := false
	for piece in still.solution:
		if int(piece.kind) == Rules.Kind.BELT:
			still_belts += 1
			check(int(piece.x) == 2 and int(piece.y) == 0, "still throat's belt is on the crossing")
		if int(piece.kind) == Rules.Kind.THROAT:
			still_south = int(piece.dir) == Rules.Dir.SOUTH
	check(still_belts == 1 and still_south, "still throat places one south-facing throat")
	check(int(stilled.counts[Rules.Mat.INGOT]) == 29 and int(stilled.counts[Rules.Mat.PLATE]) == 30 and int(stilled.discarded) > 0, "still throat counts both exits and scraps the side stream (%s discarded %d)" % [stilled.text, stilled.discarded])
	var seat: Dictionary = Rooms.all()[258]
	var parked: Array = []
	for piece in seat.solution:
		if int(piece.kind) != Rules.Kind.THROAT:
			parked.append(piece)
	parked.append(Rooms.piece(Rules.Kind.THROAT, 5, 0, Rules.Dir.EAST))
	var gap: Dictionary = World.simulate(seat, parked)
	check(World.budget_met(parked, seat.budget) and not gap.quota_ok, "a parked throat misses the seat (%s)" % gap.text)
	var seated: Dictionary = World.simulate(seat, seat.solution)
	check(int(seated.counts[Rules.Mat.INGOT]) == 29 and int(seated.counts[Rules.Mat.PLATE]) == 30, "seating the throat clears the seat (%s)" % seated.text)
	var corner: Dictionary = Rooms.all()[259]
	var cornered: Dictionary = World.simulate(corner, corner.solution)
	check(int(cornered.counts[Rules.Mat.INGOT]) == 59 and int(cornered.counts[Rules.Mat.PLATE]) == 60, "split corner counts both exits (%s)" % cornered.text)
	var corner_point: Dictionary = World.simulate(corner, _swap_kind(corner.solution, Rules.Kind.THROAT, Rules.Kind.POINT))
	check(int(corner_point.counts[Rules.Mat.INGOT]) == 0, "split corner's point sends the ore right (%s)" % corner_point.text)
	var stocks: Dictionary = Rooms.all()[260]
	var stocked: Dictionary = World.simulate(stocks, stocks.solution)
	check(int(stocked.counts[Rules.Mat.INGOT]) == 118 and int(stocked.counts[Rules.Mat.PLATE]) == 120, "two stocks counts both lanes (%s)" % stocked.text)
	var scrap: Dictionary = Rooms.all()[261]
	var scraped: Dictionary = World.simulate(scrap, scrap.solution)
	var scrap_south := false
	for piece in scrap.solution:
		if int(piece.kind) == Rules.Kind.THROAT:
			scrap_south = int(piece.dir) == Rules.Dir.SOUTH
	check(scrap_south, "after the split's throat faces south")
	check(int(scraped.counts[Rules.Mat.INGOT]) == 29 and int(scraped.counts[Rules.Mat.PLATE]) == 30 and int(scraped.discarded) > 0, "after the split counts both exits and discards the scrap (%s discarded %d)" % [scraped.text, scraped.discarded])
	var bin: Dictionary = Rooms.all()[262]
	var solved: Dictionary = World.simulate(bin, bin.solution)
	check(int(solved.counts[Rules.Mat.INGOT]) == 29 and int(solved.counts[Rules.Mat.PLATE]) == 104, "split bin hits both quotas (%s)" % solved.text)
	check(solved.world.machines[Vector2i(5, 3)].hold < 0, "split bin's throat is empty after the pairs")
	var plates_only: Dictionary = World.simulate(bin, [Rooms.piece(Rules.Kind.BELT, 6, 5, Rules.Dir.WEST)])
	check(int(plates_only.counts[Rules.Mat.INGOT]) == 0 and int(plates_only.counts[Rules.Mat.PLATE]) < int(bin.quota[Rules.Mat.PLATE]), "split bin's lower plates alone miss (%s)" % plates_only.text)
	var pressed: Dictionary = World.simulate(bin, [
		Rooms.piece(Rules.Kind.THROAT, 5, 3, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.KILN, 4, 3, Rules.Dir.WEST),
		Rooms.piece(Rules.Kind.PRESS, 3, 3, Rules.Dir.WEST),
		Rooms.piece(Rules.Kind.BELT, 6, 5, Rules.Dir.WEST),
	])
	check(int(pressed.counts[Rules.Mat.INGOT]) == 0 and not pressed.success, "pressing every ingot misses the split bin (%s)" % pressed.text)
	var held_room: Dictionary = Rooms.all()[263]
	var waiting: Dictionary = World.simulate(held_room, held_room.solution, 2)
	var leaving: Dictionary = World.simulate(held_room, held_room.solution, 3)
	var finished: Dictionary = World.simulate(held_room, held_room.solution)
	var belt_early: Dictionary = World.simulate(held_room, _swap_kind(held_room.solution, Rules.Kind.THROAT, Rules.Kind.BELT), 2)
	var held_point: Dictionary = World.simulate(held_room, _swap_kind(held_room.solution, Rules.Kind.THROAT, Rules.Kind.POINT))
	check(waiting.world.machines[Vector2i(3, 2)].hold == Rules.Mat.ORE and waiting.trace.is_empty(), "held pair keeps the first ore through the empty tick")
	check(leaving.world.machines[Vector2i(3, 2)].hold < 0 and _trace(leaving) == "3:4,2:2", "held pair leaves on the arrival tick and the cell is empty, got %s" % _trace(leaving))
	check(belt_early.world.machines[Vector2i(3, 2)].hold < 0 and belt_early.world.machines[Vector2i(2, 2)].hold < 0 and int(belt_early.world.sources[0].pending) == Rules.Mat.ORE, "a belt refuses the ahead arrival, so the first ore stays on the source")
	check(int(finished.counts[Rules.Mat.INGOT]) == 29 and int(finished.counts[Rules.Mat.PLATE]) == 30, "held pair feeds the kiln and the plate bin (%s)" % finished.text)
	check(int(held_point.counts[Rules.Mat.INGOT]) == 0, "held pair's point sends the ore right (%s)" % held_point.text)



func _wrest_lane(pattern: Array, period: int) -> Dictionary:
	return {
		"id": 0,
		"name": "wrest",
		"blurb": "",
		"rule": "",
		"w": 3,
		"h": 3,
		"sources": [Rooms.source(2, 1, Rules.Dir.WEST, pattern, period)],
		"sinks": [
			Rooms.sink(2, 1, [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE]),
			Rooms.sink(0, 1, [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE]),
			Rooms.sink(1, 0, [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE]),
			Rooms.sink(1, 2, [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE]),
		],
		"chutes": [],
		"walls": [],
		"budget": Rooms.kv([Rules.Kind.WREST, 1]),
		"quota": Rooms.kv([Rules.Mat.ORE, 1]),
		"initial": [],
		"solution": [],
	}


func _test_wrest_splits_left_and_right() -> void:
	var mixed := _wrest_lane([Rules.Mat.ORE, Rules.Mat.INGOT], 4)
	var placed := [Rooms.piece(Rules.Kind.WREST, 1, 1, Rules.Dir.EAST)]
	var early := World.simulate(mixed, placed, 4)
	var mid := World.simulate(mixed, placed, 8)
	var waiting := World.simulate(mixed, placed, 12)
	var result := World.simulate(mixed, placed, 16)
	var again := World.simulate(mixed, placed, 16)
	check(_trace(early) == "" and early.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "a lone ore is still in the wrest after the belt tick and the dwell tick")
	check(_trace(mid) == "5:1,0:0|5:1,2:1" and mid.world.machines[Vector2i(1, 1)].hold < 0, "the waiter leaves left and the arrival leaves right, got %s" % _trace(mid))
	check(int(mid.counts[Rules.Mat.ORE]) == 1 and int(mid.counts[Rules.Mat.INGOT]) == 1, "the first wrest pair leaves on the arrival tick")
	check(_trace(waiting) == "5:1,0:0|5:1,2:1" and waiting.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "the next lone ore does not leave the wrest, got %s" % _trace(waiting))
	check(_trace(result) == "5:1,0:0|5:1,2:1|13:1,0:0|13:1,2:1", "the next wrest pair leaves left and right, got %s" % _trace(result))
	check(result.world.machines[Vector2i(1, 1)].hold < 0, "the wrest is empty after the second pair")
	check(not ("2,1:" in _trace(result)), "a wrest does not send either item forward")
	check(not ("0,1:" in _trace(result)), "a wrest does not send the waiter behind")
	check(int(result.world.machines[Vector2i(1, 1)].phase) == 0, "a wrest does not rotate or alternate")
	check(_same(result, again), "the same wrest lane is deterministic (seed %d)" % result.seed)
	var same := World.simulate(_wrest_lane([Rules.Mat.ORE], 4), placed, 16)
	check(_trace(same) == "" and same.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "the same material does not release the waiter, got %s" % _trace(same))
	var as_throat := World.simulate(mixed, [Rooms.piece(Rules.Kind.THROAT, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_throat) == "5:0,1:0|5:2,1:1", "a throat on the wrest lane sends the waiter behind and the arrival forward, got %s" % _trace(as_throat))
	var as_shin := World.simulate(mixed, [Rooms.piece(Rules.Kind.SHIN, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_shin) == "5:1,0:0|5:2,1:1", "a shin on the wrest lane sends the arrival forward, got %s" % _trace(as_shin))
	var as_point := World.simulate(mixed, [Rooms.piece(Rules.Kind.POINT, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_point) == "5:1,2:0|5:2,1:1", "a point on the wrest lane sends the waiter right and the arrival forward, got %s" % _trace(as_point))
	var as_beam := World.simulate(mixed, [Rooms.piece(Rules.Kind.BEAM, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_beam) == "5:0,1:0|5:1,0:1", "a beam on the wrest lane sends the waiter backward, got %s" % _trace(as_beam))
	var behind := {
		"id": 0, "name": "wrest behind", "blurb": "", "rule": "", "w": 3, "h": 3,
		"sources": [Rooms.source(0, 1, Rules.Dir.EAST, [Rules.Mat.ORE, Rules.Mat.INGOT], 4)],
		"sinks": [
			Rooms.sink(0, 1, [Rules.Mat.ORE, Rules.Mat.INGOT]), Rooms.sink(1, 0, [Rules.Mat.ORE, Rules.Mat.INGOT]),
			Rooms.sink(1, 2, [Rules.Mat.ORE, Rules.Mat.INGOT]), Rooms.sink(2, 1, [Rules.Mat.ORE, Rules.Mat.INGOT]),
		],
		"chutes": [], "walls": [],
		"budget": Rooms.kv([Rules.Kind.WREST, 1]),
		"quota": Rooms.kv([Rules.Mat.ORE, 1]),
		"initial": [], "solution": [],
	}
	var from_behind := World.simulate(behind, placed, 8)
	check(_trace(from_behind) == "" and from_behind.world.machines[Vector2i(1, 1)].hold < 0, "a wrest refuses an arrival from behind, got %s" % _trace(from_behind))
	check(_trace(World.simulate(_stilt_lane([Rules.Mat.ORE, Rules.Mat.INGOT], 4), placed, 8)) == "", "a wrest refuses an arrival from the left")
	check(_trace(World.simulate(_clevis_lane([Rules.Mat.ORE, Rules.Mat.INGOT], 4), placed, 8)) == "", "a wrest refuses an arrival from the right")
	var belt := World.simulate(mixed, [Rooms.piece(Rules.Kind.BELT, 1, 1, Rules.Dir.EAST)], 12)
	check(_trace(belt) == "" and belt.world.machines[Vector2i(1, 1)].hold < 0, "a belt refuses the wrest's ahead arrival, got %s" % _trace(belt))
	for mat in [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE]:
		var lone := World.simulate(_wrest_lane([mat], 80), placed, 15)
		check(_trace(lone) == "" and lone.world.machines[Vector2i(1, 1)].hold == mat, "a lone %s never leaves a wrest" % Rules.MAT_NAME[mat])
	var south := {
		"id": 0, "name": "wrest south", "blurb": "", "rule": "", "w": 3, "h": 3,
		"sources": [Rooms.source(1, 2, Rules.Dir.NORTH, [Rules.Mat.ORE, Rules.Mat.INGOT], 4)],
		"sinks": [
			Rooms.sink(1, 0, [Rules.Mat.ORE, Rules.Mat.INGOT]),
			Rooms.sink(0, 1, [Rules.Mat.ORE, Rules.Mat.INGOT]),
			Rooms.sink(2, 1, [Rules.Mat.ORE, Rules.Mat.INGOT]),
			Rooms.sink(1, 2, [Rules.Mat.ORE, Rules.Mat.INGOT]),
		],
		"chutes": [], "walls": [],
		"budget": Rooms.kv([Rules.Kind.WREST, 1]),
		"quota": Rooms.kv([Rules.Mat.ORE, 1]),
		"initial": [], "solution": [],
	}
	var turned := World.simulate(south, [Rooms.piece(Rules.Kind.WREST, 1, 1, Rules.Dir.SOUTH)], 8)
	check(_trace(turned) == "5:2,1:0|5:0,1:1" and turned.world.machines[Vector2i(1, 1)].hold < 0, "a south-facing wrest sends the waiter left and the arrival right, got %s" % _trace(turned))


