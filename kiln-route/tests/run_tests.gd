func _test_wing20_lessons() -> void:
	var wrong_kinds: Array = [
		Rules.Kind.BELT,
		Rules.Kind.DWELL,
		Rules.Kind.TWIN,
		Rules.Kind.PASS,
		Rules.Kind.SLIP,
		Rules.Kind.SHED,
		Rules.Kind.HOOK,
		Rules.Kind.RAKE,
		Rules.Kind.HOE,
		Rules.Kind.HARROW,
		Rules.Kind.FORK,
		Rules.Kind.PRONG,
		Rules.Kind.SHARE,
	]
	for index in range(152, 160):
		var room: Dictionary = Rooms.all()[index]
		for kind in wrong_kinds:
			var swapped := _swap_kind(room.solution, Rules.Kind.COULTER, int(kind))
			var run: Dictionary = World.simulate(room, swapped)
			check(run.error == "", "%s in place of the room %d coulter simulates (%s)" % [Rules.KIND_NAME[int(kind)], room.id, run.error])
			check(not run.quota_ok, "%s in place of the room %d coulter misses the quota (%s)" % [Rules.KIND_NAME[int(kind)], room.id, run.text])
			check(not run.success, "%s in place of the room %d coulter does not clear" % [Rules.KIND_NAME[int(kind)], room.id])
			if int(kind) != Rules.Kind.BELT:
				check(int(room.budget.get(int(kind), 0)) == 0, "room %d does not budget a %s" % [room.id, Rules.KIND_NAME[int(kind)]])
		var planner = Planner.new(room)
		for piece in room.initial:
			check(planner.pickup(int(piece.x), int(piece.y)), "room %d picks up its starting piece" % room.id)
		for piece in room.solution:
			check(planner.place(int(piece.kind), int(piece.x), int(piece.y), int(piece.dir)), "room %d places its solution from the tray" % room.id)
		var spare := _spare_cell(room)
		check(spare.x >= 0, "room %d has an empty cell for an extra piece" % room.id)
		check(not planner.place(Rules.Kind.BELT, spare.x, spare.y, Rules.Dir.EAST), "room %d rejects a belt past the tray" % room.id)
		var extra: Array = room.solution.duplicate(true)
		extra.append(Rooms.piece(Rules.Kind.BELT, spare.x, spare.y, Rules.Dir.EAST))
		var over: Dictionary = World.simulate(room, extra)
		check(over.quota_ok and not over.budget_ok and not over.success, "room %d extra belt meets the quota and is rejected (%s)" % [room.id, over.text])
	for id in [137, 140, 142]:
		var kept: Dictionary = Rooms.all()[id - 1]
		var fork_run: Dictionary = World.simulate(kept, _swap_kind(kept.solution, Rules.Kind.PRONG, Rules.Kind.FORK))
		check(fork_run.quota_ok, "a fork still meets the quota on room %d (%s)" % [id, fork_run.text])
	var forward: Dictionary = Rooms.all()[152]
	var split: Dictionary = World.simulate(forward, forward.solution)
	check(int(split.counts[Rules.Mat.PLATE]) == 60 and split.world.machines[Vector2i(2, 2)].hold < 0, "forward right delivers 60 plates and the coulter ends empty (%s)" % split.text)
	var forward_share: Dictionary = World.simulate(forward, _swap_kind(forward.solution, Rules.Kind.COULTER, Rules.Kind.SHARE))
	var forward_fork: Dictionary = World.simulate(forward, _swap_kind(forward.solution, Rules.Kind.COULTER, Rules.Kind.FORK))
	var forward_prong: Dictionary = World.simulate(forward, _swap_kind(forward.solution, Rules.Kind.COULTER, Rules.Kind.PRONG))
	var forward_pass: Dictionary = World.simulate(forward, _swap_kind(forward.solution, Rules.Kind.COULTER, Rules.Kind.PASS))
	var forward_slip: Dictionary = World.simulate(forward, _swap_kind(forward.solution, Rules.Kind.COULTER, Rules.Kind.SLIP))
	var forward_hoe: Dictionary = World.simulate(forward, _swap_kind(forward.solution, Rules.Kind.COULTER, Rules.Kind.HOE))
	check(int(forward_share.counts[Rules.Mat.PLATE]) == 30, "forward right's share sends the later plate left into the pit (%s)" % forward_share.text)
	check(int(forward_fork.counts[Rules.Mat.PLATE]) == 30, "forward right's fork misses the forward bin (%s)" % forward_fork.text)
	check(int(forward_prong.counts[Rules.Mat.PLATE]) == 30, "forward right's prong misses the forward bin (%s)" % forward_prong.text)
	check(int(forward_pass.counts[Rules.Mat.PLATE]) == 59, "forward right's pass sends only the first plate forward and holds the later plate (%s)" % forward_pass.text)
	check(int(forward_slip.counts[Rules.Mat.PLATE]) == 59, "forward right's slip sends the later plate forward and holds the first (%s)" % forward_slip.text)
	check(int(forward_hoe.counts[Rules.Mat.PLATE]) == 59, "forward right's hoe sends the first plate right and holds the later plate (%s)" % forward_hoe.text)
	var ore: Dictionary = Rooms.all()[153]
	var smelted: Dictionary = World.simulate(ore, ore.solution)
	check(int(smelted.counts[Rules.Mat.INGOT]) == 29 and int(smelted.counts[Rules.Mat.PLATE]) == 29, "split ore feeds the kiln and the plate bin (%s)" % smelted.text)
	var ore_share: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.COULTER, Rules.Kind.SHARE))
	var ore_fork: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.COULTER, Rules.Kind.FORK))
	var ore_prong: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.COULTER, Rules.Kind.PRONG))
	var ore_pass: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.COULTER, Rules.Kind.PASS))
	var ore_hoe: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.COULTER, Rules.Kind.HOE))
	check(int(ore_share.counts[Rules.Mat.INGOT]) == 29 and int(ore_share.counts[Rules.Mat.PLATE]) == 0, "split ore's share sends the plate left (%s)" % ore_share.text)
	check(int(ore_fork.counts[Rules.Mat.INGOT]) == 0 and int(ore_fork.counts[Rules.Mat.PLATE]) == 29, "split ore's fork sends the ore left and the plate right (%s)" % ore_fork.text)
	check(int(ore_prong.counts[Rules.Mat.INGOT]) == 0 and int(ore_prong.counts[Rules.Mat.PLATE]) == 0, "split ore's prong sends the ore right and the plate left (%s)" % ore_prong.text)
	check(int(ore_pass.counts[Rules.Mat.INGOT]) == 1 and int(ore_pass.counts[Rules.Mat.PLATE]) == 0, "split ore's pass sends the ore forward and holds the plate (%s)" % ore_pass.text)
	check(int(ore_hoe.counts[Rules.Mat.INGOT]) == 0 and int(ore_hoe.counts[Rules.Mat.PLATE]) == 0, "split ore's hoe sends the ore right and holds the plate (%s)" % ore_hoe.text)
	var still: Dictionary = Rooms.all()[154]
	var stilled: Dictionary = World.simulate(still, still.solution)
	check(int(still.budget[Rules.Kind.BELT]) == 1, "still coulter budgets one belt")
	var still_belts := 0
	for piece in still.solution:
		if int(piece.kind) == Rules.Kind.BELT:
			still_belts += 1
			check(int(piece.x) == 1 and int(piece.y) == 1, "still coulter's belt is on the crossing")
	check(still_belts == 1, "still coulter places that one belt")
	check(int(stilled.counts[Rules.Mat.INGOT]) == 29 and int(stilled.counts[Rules.Mat.PLATE]) == 30 and int(stilled.discarded) > 0, "still coulter leaves the scrap pit and counts both exits (%s discarded %d)" % [stilled.text, stilled.discarded])
	var still_share: Dictionary = World.simulate(still, _swap_kind(still.solution, Rules.Kind.COULTER, Rules.Kind.SHARE))
	var still_fork: Dictionary = World.simulate(still, _swap_kind(still.solution, Rules.Kind.COULTER, Rules.Kind.FORK))
	var still_prong: Dictionary = World.simulate(still, _swap_kind(still.solution, Rules.Kind.COULTER, Rules.Kind.PRONG))
	var still_pass: Dictionary = World.simulate(still, _swap_kind(still.solution, Rules.Kind.COULTER, Rules.Kind.PASS))
	var still_hoe: Dictionary = World.simulate(still, _swap_kind(still.solution, Rules.Kind.COULTER, Rules.Kind.HOE))
	check(int(still_share.counts[Rules.Mat.INGOT]) == 0 and int(still_share.counts[Rules.Mat.PLATE]) == 0, "still coulter's share sends the plate left and the pair stays (%s)" % still_share.text)
	check(int(still_fork.counts[Rules.Mat.INGOT]) == 0 and int(still_fork.counts[Rules.Mat.PLATE]) == 0, "still coulter's fork misses the forward kiln (%s)" % still_fork.text)
