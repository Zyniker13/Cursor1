	check(int(scraped.counts[Rules.Mat.INGOT]) == 29 and int(scraped.counts[Rules.Mat.PLATE]) == 30 and int(scraped.discarded) > 0, "after the split counts both exits and discards the scrap (%s discarded %d)" % [scraped.text, scraped.discarded])
	var scrap_share: Dictionary = World.simulate(scrap, _swap_kind(scrap.solution, Rules.Kind.COULTER, Rules.Kind.SHARE))
	var scrap_fork: Dictionary = World.simulate(scrap, _swap_kind(scrap.solution, Rules.Kind.COULTER, Rules.Kind.FORK))
	var scrap_prong: Dictionary = World.simulate(scrap, _swap_kind(scrap.solution, Rules.Kind.COULTER, Rules.Kind.PRONG))
	check(int(scrap_share.counts[Rules.Mat.PLATE]) == 0 and int(scrap_share.counts[Rules.Mat.INGOT]) == 29, "after the split's share sends the plate left toward the scrap (%s)" % scrap_share.text)
	check(int(scrap_fork.counts[Rules.Mat.INGOT]) == 0, "after the split's fork sends the ore toward the scrap (%s)" % scrap_fork.text)
	check(int(scrap_prong.counts[Rules.Mat.INGOT]) == 0, "after the split's prong misses the forward kiln (%s)" % scrap_prong.text)
	var bin: Dictionary = Rooms.all()[159]
	var solved: Dictionary = World.simulate(bin, bin.solution)
	check(int(solved.counts[Rules.Mat.INGOT]) == 19 and int(solved.counts[Rules.Mat.PLATE]) == 99, "split bin hits both quotas (%s)" % solved.text)
	check(solved.world.machines[Vector2i(1, 3)].hold < 0, "split bin's coulter is empty after the pairs")
	var plates_only: Dictionary = World.simulate(bin, [
		Rooms.piece(Rules.Kind.BELT, 1, 5, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.BELT, 2, 5, Rules.Dir.EAST),
	])
	check(int(plates_only.counts[Rules.Mat.INGOT]) == 0 and int(plates_only.counts[Rules.Mat.PLATE]) < int(bin.quota[Rules.Mat.PLATE]), "split bin's lower plates alone miss (%s)" % plates_only.text)
	var pressed: Dictionary = World.simulate(bin, [
		Rooms.piece(Rules.Kind.BELT, 1, 5, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.BELT, 2, 5, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.BELT, 3, 1, Rules.Dir.SOUTH),
		Rooms.piece(Rules.Kind.BELT, 3, 2, Rules.Dir.SOUTH),
		Rooms.piece(Rules.Kind.COULTER, 1, 3, Rules.Dir.NORTH),
		Rooms.piece(Rules.Kind.WEIR, 2, 3, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.BELT, 3, 3, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.FILTER, 4, 3, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.KILN, 5, 3, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.BELT, 6, 3, Rules.Dir.SOUTH),
		Rooms.piece(Rules.Kind.BELT, 6, 4, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.PRESS, 7, 4, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.BELT, 8, 4, Rules.Dir.EAST),
	])
	check(int(pressed.counts[Rules.Mat.INGOT]) == 0 and not pressed.success, "pressing every ingot misses the split bin (%s)" % pressed.text)
	for kind in [Rules.Kind.SHARE, Rules.Kind.FORK, Rules.Kind.PRONG, Rules.Kind.HARROW, Rules.Kind.HOE, Rules.Kind.RAKE]:
		var missed: Dictionary = World.simulate(bin, _swap_kind(bin.solution, Rules.Kind.COULTER, int(kind)))
		var misses_one: bool = int(missed.counts[Rules.Mat.INGOT]) < int(bin.quota[Rules.Mat.INGOT]) or int(missed.counts[Rules.Mat.PLATE]) < int(bin.quota[Rules.Mat.PLATE])
		check(misses_one, "%s in place of the split-bin coulter misses at least one quota (%s)" % [Rules.KIND_NAME[int(kind)], missed.text])
	var bin_share: Dictionary = World.simulate(bin, _swap_kind(bin.solution, Rules.Kind.COULTER, Rules.Kind.SHARE))
	var bin_fork: Dictionary = World.simulate(bin, _swap_kind(bin.solution, Rules.Kind.COULTER, Rules.Kind.FORK))
	var bin_prong: Dictionary = World.simulate(bin, _swap_kind(bin.solution, Rules.Kind.COULTER, Rules.Kind.PRONG))
	check(int(bin_share.counts[Rules.Mat.INGOT]) == 0, "split bin's share sends the ore left into the pit (%s)" % bin_share.text)
	check(int(bin_fork.counts[Rules.Mat.PLATE]) == 39, "split bin's fork misses the forward plates (%s)" % bin_fork.text)
	check(int(bin_prong.counts[Rules.Mat.INGOT]) == 0 and int(bin_prong.counts[Rules.Mat.PLATE]) == 30, "split bin's prong misses both quotas (%s)" % bin_prong.text)


func _test_moldboard_splits_left_and_forward() -> void:
	var ore := _coulter_lane([Rules.Mat.ORE], 4)
	var placed := [Rooms.piece(Rules.Kind.MOLDBOARD, 1, 1, Rules.Dir.EAST)]
	var early := World.simulate(ore, placed, 4)
	var mid := World.simulate(ore, placed, 8)
	var waiting := World.simulate(ore, placed, 12)
	var result := World.simulate(ore, placed, 16)
	var again := World.simulate(ore, placed, 16)
	check(_trace(early) == "" and early.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "a lone ore is still in the moldboard after the belt tick and the dwell tick")
	check(_trace(mid) == "5:1,0:0|5:2,1:0" and mid.world.machines[Vector2i(1, 1)].hold < 0, "the waiter leaves left and the arrival leaves forward, and the moldboard is empty, got %s" % _trace(mid))
	check(int(mid.counts[Rules.Mat.ORE]) == 2, "the first moldboard pair leaves on the arrival tick")
	check(_trace(waiting) == "5:1,0:0|5:2,1:0" and waiting.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "the next lone ore does not leave the moldboard on the next tick or the tick after that, got %s" % _trace(waiting))
	check(_trace(result) == "5:1,0:0|5:2,1:0|13:1,0:0|13:2,1:0", "the next moldboard pair leaves left and forward, got %s" % _trace(result))
	check(result.world.machines[Vector2i(1, 1)].hold < 0, "the moldboard is empty after the second pair")
	check(int(result.counts[Rules.Mat.ORE]) == 4, "two moldboard pairs leave and nothing stays")
	check(not ("1,2:" in _trace(result)), "a moldboard does not send right")
	check(_same(result, again), "the same moldboard lane is deterministic (seed %d)" % result.seed)
	var as_share := World.simulate(ore, [Rooms.piece(Rules.Kind.SHARE, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_share) == "5:2,1:0|5:1,0:0" and as_share.world.machines[Vector2i(1, 1)].hold < 0, "a share on the moldboard lane sends the waiter forward and the arrival left, got %s" % _trace(as_share))
	var as_coulter := World.simulate(ore, [Rooms.piece(Rules.Kind.COULTER, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_coulter) == "5:2,1:0|5:1,2:0" and as_coulter.world.machines[Vector2i(1, 1)].hold < 0, "a coulter on the moldboard lane sends the waiter forward and the arrival right, got %s" % _trace(as_coulter))
	var as_fork := World.simulate(ore, [Rooms.piece(Rules.Kind.FORK, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_fork) == "5:1,0:0|5:1,2:0" and as_fork.world.machines[Vector2i(1, 1)].hold < 0, "a fork on the moldboard lane sends the waiter left and the arrival right, got %s" % _trace(as_fork))
	var as_prong := World.simulate(ore, [Rooms.piece(Rules.Kind.PRONG, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_prong) == "5:1,2:0|5:1,0:0" and as_prong.world.machines[Vector2i(1, 1)].hold < 0, "a prong on the moldboard lane sends the waiter right and the arrival left, got %s" % _trace(as_prong))
	var belt := World.simulate(ore, [Rooms.piece(Rules.Kind.BELT, 1, 1, Rules.Dir.EAST)], 12)
	var dwell := World.simulate(ore, [Rooms.piece(Rules.Kind.DWELL, 1, 1, Rules.Dir.EAST)], 12)
	check(_trace(belt) == "2:2,1:0|6:2,1:0|10:2,1:0", "a belt on the moldboard cell sends forward on the next tick, got %s" % _trace(belt))
	check(_trace(dwell) == "3:2,1:0|7:2,1:0|11:2,1:0", "a dwell on the moldboard cell sends forward one tick after a belt, got %s" % _trace(dwell))
	for mat in [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE]:
		var lane := _coulter_lane([mat], 80)
		var lone := World.simulate(lane, placed, 15)
		check(_trace(lone) == "" and lone.world.machines[Vector2i(1, 1)].hold == mat, "a lone %s never leaves a moldboard" % Rules.MAT_NAME[mat])
	var mixed := _coulter_lane([Rules.Mat.ORE, Rules.Mat.INGOT], 4)
	var held := World.simulate(mixed, placed, 4)
	var pushed := World.simulate(mixed, placed, 8)
	var later := World.simulate(mixed, placed, 12)
	check(_trace(held) == "" and held.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "a moldboard does not release before the different material arrives")
	check(_trace(pushed) == "5:1,0:0|5:2,1:1" and pushed.world.machines[Vector2i(1, 1)].hold < 0, "a different material leaves forward while the waiter leaves left, and the moldboard is empty, got %s" % _trace(pushed))
	check(_trace(later) == "5:1,0:0|5:2,1:1" and later.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "the next lone ore waits in the moldboard and does not leave yet, got %s" % _trace(later))
	check(int(pushed.world.machines[Vector2i(1, 1)].phase) == 0, "a moldboard does not rotate or alternate")
	var as_rake := World.simulate(mixed, [Rooms.piece(Rules.Kind.RAKE, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_rake) == "5:1,0:0" and as_rake.world.machines[Vector2i(1, 1)].hold == Rules.Mat.INGOT, "a rake on the moldboard lane sends the waiter left and keeps the arrival, got %s" % _trace(as_rake))
	var as_slip := World.simulate(mixed, [Rooms.piece(Rules.Kind.SLIP, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_slip) == "5:2,1:1" and as_slip.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "a slip on the moldboard lane sends the arrival forward and keeps the waiter, got %s" % _trace(as_slip))
	var south := {
		"id": 0,
		"name": "moldboard south",
		"blurb": "",
		"rule": "",
		"w": 3,
		"h": 3,
		"sources": [Rooms.source(1, 0, Rules.Dir.SOUTH, [Rules.Mat.ORE, Rules.Mat.INGOT], 4)],
		"sinks": [
			Rooms.sink(0, 1, [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE]),
			Rooms.sink(2, 1, [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE]),
			Rooms.sink(1, 2, [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE]),
		],
		"chutes": [],
		"walls": [],
		"budget": Rooms.kv([Rules.Kind.MOLDBOARD, 1]),
		"quota": Rooms.kv([Rules.Mat.ORE, 1]),
		"initial": [],
		"solution": [],
	}
	var turned := World.simulate(south, [Rooms.piece(Rules.Kind.MOLDBOARD, 1, 1, Rules.Dir.SOUTH)], 8)
	check(_trace(turned) == "5:2,1:0|5:1,2:1" and turned.world.machines[Vector2i(1, 1)].hold < 0, "a south-facing moldboard sends the waiter left and the arrival forward, got %s" % _trace(turned))


func _test_moldboard_refuses_side_and_front() -> void:
	var side_only := {
		"id": 0,
		"name": "moldboard side",
		"blurb": "",
		"rule": "",
		"w": 3,
		"h": 3,
		"sources": [Rooms.source(1, 0, Rules.Dir.SOUTH, [Rules.Mat.PLATE], 1)],
		"sinks": [Rooms.sink(2, 1, [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE])],
		"chutes": [],
		"walls": [],
		"budget": Rooms.kv([Rules.Kind.MOLDBOARD, 1, Rules.Kind.BELT, 1]),
		"quota": Rooms.kv([Rules.Mat.PLATE, 1]),
		"initial": [],
		"solution": [],
	}
	var placed := [Rooms.piece(Rules.Kind.MOLDBOARD, 1, 1, Rules.Dir.EAST)]
	var belt := World.simulate(side_only, [Rooms.piece(Rules.Kind.BELT, 1, 1, Rules.Dir.EAST)], 4)
	var mold_side := World.simulate(side_only, placed, 4)
	check(_trace(belt) == "2:2,1:2|3:2,1:2|4:2,1:2", "a belt takes a plate from the side of the moldboard cell, got %s" % _trace(belt))
	check(int(mold_side.counts[Rules.Mat.PLATE]) == 0 and int(mold_side.world.sources[0].pending) == Rules.Mat.PLATE, "a moldboard refuses that same side plate")
	var front := {
		"id": 0,
		"name": "moldboard front",
		"blurb": "",
		"rule": "",
		"w": 3,
		"h": 1,
		"sources": [
			Rooms.source(0, 0, Rules.Dir.EAST, [Rules.Mat.ORE], 4),
			Rooms.source(2, 0, Rules.Dir.WEST, [Rules.Mat.INGOT], 1),
		],
		"sinks": [],
		"chutes": [],
		"walls": [],
		"budget": Rooms.kv([Rules.Kind.MOLDBOARD, 1]),
		"quota": Rooms.kv([Rules.Mat.ORE, 1]),
		"initial": [],
		"solution": [],
	}
	var blocked := World.simulate(front, [Rooms.piece(Rules.Kind.MOLDBOARD, 1, 0, Rules.Dir.EAST)], 6)
	var machine = blocked.world.machines[Vector2i(1, 0)]
	check(int(blocked.world.sources[1].pending) == Rules.Mat.INGOT, "moldboard refuses a head-on ingot")
	check(machine.hold == Rules.Mat.ORE, "the rear load stays on the moldboard")
	check(blocked.trace.is_empty(), "a head-on entry does not leave the moldboard, got %s" % _trace(blocked))
	check(int(machine.phase) == 0, "a head-on entry does not rotate the moldboard")
	var beside := {
		"id": 0,
		"name": "moldboard side while held",
		"blurb": "",
		"rule": "",
		"w": 3,
		"h": 3,
		"sources": [
			Rooms.source(0, 1, Rules.Dir.EAST, [Rules.Mat.ORE, Rules.Mat.PLATE], 1),
			Rooms.source(1, 2, Rules.Dir.NORTH, [Rules.Mat.INGOT], 1),
		],
		"sinks": [
			Rooms.sink(2, 1, [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE]),
		],
		"chutes": [],
		"walls": [Rooms.cell(1, 0)],
		"budget": Rooms.kv([Rules.Kind.MOLDBOARD, 1]),
		"quota": Rooms.kv([Rules.Mat.ORE, 1]),
		"initial": [],
		"solution": [],
	}
	var held := World.simulate(beside, placed, 6)
	check(held.trace.is_empty() and held.discarded == 0, "a side entry does not leave the moldboard, got %s" % _trace(held))
	check(held.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "the rear ore stays while the side entry is refused")
	check(int(held.world.sources[1].pending) == Rules.Mat.INGOT, "moldboard refuses an ingot from the side")
	check(int(held.world.sources[0].pending) == Rules.Mat.PLATE, "the arrival stays behind when the left cell refuses")
	check(int(held.counts[Rules.Mat.ORE]) == 0 and int(held.counts[Rules.Mat.PLATE]) == 0 and int(held.counts[Rules.Mat.INGOT]) == 0, "a blocked left cell does not send the arrival forward")


