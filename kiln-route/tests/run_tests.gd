	check(refused.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE and int(refused.world.sources[0].pending) == Rules.Mat.ORE, "the same material does not release a mandrel")


func _test_mandrel_refuses_left_right_and_behind() -> void:
	var left_side := {
		"id": 0, "name": "mandrel left", "blurb": "", "rule": "", "w": 3, "h": 3,
		"sources": [Rooms.source(1, 0, Rules.Dir.SOUTH, [Rules.Mat.PLATE], 1)],
		"sinks": [Rooms.sink(2, 1, [Rules.Mat.PLATE])],
		"chutes": [], "walls": [],
		"budget": Rooms.kv([Rules.Kind.MANDREL, 1, Rules.Kind.BELT, 1]),
		"quota": Rooms.kv([Rules.Mat.PLATE, 1]),
		"initial": [], "solution": [],
	}
	var belt_left := World.simulate(left_side, [Rooms.piece(Rules.Kind.BELT, 1, 1, Rules.Dir.EAST)], 4)
	var board_left := World.simulate(left_side, [Rooms.piece(Rules.Kind.MANDREL, 1, 1, Rules.Dir.EAST)], 4)
	check(int(belt_left.counts[Rules.Mat.PLATE]) >= 1, "a belt takes a plate from the left of the mandrel cell, got %s" % _trace(belt_left))
	check(int(board_left.counts[Rules.Mat.PLATE]) == 0 and int(board_left.world.sources[0].pending) == Rules.Mat.PLATE, "a mandrel refuses that same plate from the left")
	var right_side := {
		"id": 0, "name": "mandrel right", "blurb": "", "rule": "", "w": 3, "h": 3,
		"sources": [Rooms.source(1, 2, Rules.Dir.NORTH, [Rules.Mat.INGOT], 1)],
		"sinks": [Rooms.sink(2, 1, [Rules.Mat.INGOT])],
		"chutes": [], "walls": [],
		"budget": Rooms.kv([Rules.Kind.MANDREL, 1, Rules.Kind.BELT, 1]),
		"quota": Rooms.kv([Rules.Mat.INGOT, 1]),
		"initial": [], "solution": [],
	}
	var belt_right := World.simulate(right_side, [Rooms.piece(Rules.Kind.BELT, 1, 1, Rules.Dir.EAST)], 4)
	var board_right := World.simulate(right_side, [Rooms.piece(Rules.Kind.MANDREL, 1, 1, Rules.Dir.EAST)], 4)
	check(int(belt_right.counts[Rules.Mat.INGOT]) >= 1, "a belt takes an ingot from the right of the mandrel cell, got %s" % _trace(belt_right))
	check(int(board_right.counts[Rules.Mat.INGOT]) == 0 and int(board_right.world.sources[0].pending) == Rules.Mat.INGOT, "a mandrel refuses that same ingot from the right")
	var behind_lane := {
		"id": 0, "name": "mandrel behind refuse", "blurb": "", "rule": "", "w": 3, "h": 1,
		"sources": [Rooms.source(0, 0, Rules.Dir.EAST, [Rules.Mat.PLATE], 1)],
		"sinks": [Rooms.sink(2, 0, [Rules.Mat.PLATE])],
		"chutes": [], "walls": [],
		"budget": Rooms.kv([Rules.Kind.MANDREL, 1, Rules.Kind.BELT, 1]),
		"quota": Rooms.kv([Rules.Mat.PLATE, 1]),
		"initial": [], "solution": [],
	}
	var belt := World.simulate(behind_lane, [Rooms.piece(Rules.Kind.BELT, 1, 0, Rules.Dir.EAST)], 4)
	var board_behind := World.simulate(behind_lane, [Rooms.piece(Rules.Kind.MANDREL, 1, 0, Rules.Dir.EAST)], 4)
	check(int(belt.counts[Rules.Mat.PLATE]) >= 1, "a belt takes a plate from behind the mandrel cell, got %s" % _trace(belt))
	check(int(board_behind.counts[Rules.Mat.PLATE]) == 0 and int(board_behind.world.sources[0].pending) == Rules.Mat.PLATE, "a mandrel refuses that same plate from behind")


func _test_mandrel_blocked_does_not_spill() -> void:
	var right_wall := {
		"id": 0, "name": "right wall", "blurb": "", "rule": "", "w": 5, "h": 4,
		"sources": [Rooms.source(3, 1, Rules.Dir.WEST, [Rules.Mat.ORE, Rules.Mat.INGOT], 1)],
		"sinks": [
			Rooms.sink(2, 0, [Rules.Mat.ORE, Rules.Mat.INGOT]),
			Rooms.sink(1, 1, [Rules.Mat.ORE, Rules.Mat.INGOT]),
			Rooms.sink(4, 1, [Rules.Mat.ORE, Rules.Mat.INGOT]),
		],
		"chutes": [], "walls": [Rooms.cell(2, 2)], "budget": {}, "quota": {}, "initial": [], "solution": [],
	}
	var blocked := World.simulate(right_wall, [Rooms.piece(Rules.Kind.MANDREL, 2, 1, Rules.Dir.EAST)], 6)
