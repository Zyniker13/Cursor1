		"walls": [Rooms.cell(1, 0)],
		"budget": Rooms.kv([Rules.Kind.MOLDBOARD, 1, Rules.Kind.BELT, 1]),
		"quota": Rooms.kv([Rules.Mat.ORE, 1]),
		"initial": [],
		"solution": [],
	}
	var held := World.simulate(left_wall, [Rooms.piece(Rules.Kind.MOLDBOARD, 1, 1, Rules.Dir.EAST)], 6)
	check(held.error == "" and held.discarded == 0 and held.trace.is_empty(), "a moldboard with a blocked left cell does not spill forward, right, or back")
	check(held.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "blocked ore stays on the moldboard when the left cell refuses")
	check(int(held.world.sources[0].pending) == Rules.Mat.PLATE, "the arrival is not accepted while the moldboard's left cell refuses")
	check(int(held.counts[Rules.Mat.ORE]) == 0 and int(held.counts[Rules.Mat.PLATE]) == 0, "a blocked left cell does not send the arrival forward")
	check(int(held.world.machines[Vector2i(1, 1)].phase) == 0, "a moldboard does not rotate or alternate when blocked")
	var belt := World.simulate(left_wall, [Rooms.piece(Rules.Kind.BELT, 1, 1, Rules.Dir.EAST)], 4)
	check(int(belt.counts[Rules.Mat.ORE]) >= 1, "the same open forward cell lets a belt send forward")
	var forward_wall := {
		"id": 0,
		"name": "moldboard forward wall",
		"blurb": "",
		"rule": "",
		"w": 3,
		"h": 3,
		"sources": [Rooms.source(0, 1, Rules.Dir.EAST, [Rules.Mat.ORE, Rules.Mat.PLATE], 1)],
		"sinks": [Rooms.sink(1, 0, [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE])],
		"chutes": [Rooms.cell(0, 0), Rooms.cell(2, 0), Rooms.cell(0, 2), Rooms.cell(2, 2)],
		"walls": [Rooms.cell(2, 1)],
		"budget": Rooms.kv([Rules.Kind.MOLDBOARD, 1]),
		"quota": Rooms.kv([Rules.Mat.ORE, 1]),
		"initial": [],
		"solution": [],
	}
	var forward_held := World.simulate(forward_wall, [Rooms.piece(Rules.Kind.MOLDBOARD, 1, 1, Rules.Dir.EAST)], 6)
	check(forward_held.error == "" and forward_held.discarded == 0 and forward_held.trace.is_empty(), "a moldboard with a blocked forward cell does not spill left, right, or back")
	check(forward_held.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "blocked ore stays on the moldboard when the forward cell refuses")
	check(int(forward_held.world.sources[0].pending) == Rules.Mat.PLATE, "the arrival is not accepted while the moldboard's forward cell refuses")
	check(int(forward_held.counts[Rules.Mat.ORE]) == 0 and int(forward_held.counts[Rules.Mat.PLATE]) == 0, "a blocked forward cell does not send the waiter left")


func _test_wing21_lessons() -> void:
	var wrong_kinds: Array = [
		Rules.Kind.BELT,
		Rules.Kind.DWELL,
		Rules.Kind.TWIN,
		Rules.Kind.PASS,
		Rules.Kind.SLIP,
		Rules.Kind.SHED,
		Rules.Kind.HOOK,
		Rules.Kind.RAKE,
		Rules.Kind.HOE,
		Rules.Kind.HARROW,
		Rules.Kind.FORK,
		Rules.Kind.PRONG,
		Rules.Kind.SHARE,
		Rules.Kind.COULTER,
	]
	for index in range(160, 168):
		var room: Dictionary = Rooms.all()[index]
		for kind in wrong_kinds:
			var swapped := _swap_kind(room.solution, Rules.Kind.MOLDBOARD, int(kind))
			var run: Dictionary = World.simulate(room, swapped)
			check(run.error == "", "%s in place of the room %d moldboard simulates (%s)" % [Rules.KIND_NAME[int(kind)], room.id, run.error])
			check(not run.quota_ok, "%s in place of the room %d moldboard misses the quota (%s)" % [Rules.KIND_NAME[int(kind)], room.id, run.text])
			check(not run.success, "%s in place of the room %d moldboard does not clear" % [Rules.KIND_NAME[int(kind)], room.id])
			if int(kind) != Rules.Kind.BELT:
				check(int(room.budget.get(int(kind), 0)) == 0, "room %d does not budget a %s" % [room.id, Rules.KIND_NAME[int(kind)]])
		var planner = Planner.new(room)
		for piece in room.initial:
			check(planner.pickup(int(piece.x), int(piece.y)), "room %d picks up its starting piece" % room.id)
		for piece in room.solution:
			check(planner.place(int(piece.kind), int(piece.x), int(piece.y), int(piece.dir)), "room %d places its solution from the tray" % room.id)
		var spare := _spare_cell(room)
		check(spare.x >= 0, "room %d has an empty cell for an extra piece" % room.id)
		check(not planner.place(Rules.Kind.BELT, spare.x, spare.y, Rules.Dir.EAST), "room %d rejects a belt past the tray" % room.id)
		var extra: Array = room.solution.duplicate(true)
		extra.append(Rooms.piece(Rules.Kind.BELT, spare.x, spare.y, Rules.Dir.EAST))
		var over: Dictionary = World.simulate(room, extra)
		check(over.quota_ok and not over.budget_ok and not over.success, "room %d extra belt meets the quota and is rejected (%s)" % [room.id, over.text])
	var ore: Dictionary = Rooms.all()[160]
	var smelted: Dictionary = World.simulate(ore, ore.solution)
	check(int(smelted.counts[Rules.Mat.INGOT]) == 29 and int(smelted.counts[Rules.Mat.PLATE]) == 29, "left ore feeds the kiln and the plate bin (%s)" % smelted.text)
	var ore_share: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.MOLDBOARD, Rules.Kind.SHARE))
	var ore_coulter: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.MOLDBOARD, Rules.Kind.COULTER))
	var ore_fork: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.MOLDBOARD, Rules.Kind.FORK))
	var ore_slip: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.MOLDBOARD, Rules.Kind.SLIP))
	var ore_rake: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.MOLDBOARD, Rules.Kind.RAKE))
	check(int(ore_share.counts[Rules.Mat.INGOT]) == 0 and int(ore_share.counts[Rules.Mat.PLATE]) == 0, "left ore's share sends the ore forward and the plate left (%s)" % ore_share.text)
	check(int(ore_coulter.counts[Rules.Mat.INGOT]) == 0 and int(ore_coulter.counts[Rules.Mat.PLATE]) == 0 and int(ore_coulter.discarded) > 0, "left ore's coulter sends the plate right, where there is no bin (%s)" % ore_coulter.text)
	check(int(ore_fork.counts[Rules.Mat.INGOT]) == 29 and int(ore_fork.counts[Rules.Mat.PLATE]) == 0, "left ore's fork sends the plate right and misses the forward bin (%s)" % ore_fork.text)
	check(int(ore_slip.counts[Rules.Mat.INGOT]) == 0 and int(ore_slip.counts[Rules.Mat.PLATE]) < 29, "left ore's slip sends the plate forward and holds the ore (%s)" % ore_slip.text)
	check(int(ore_rake.counts[Rules.Mat.INGOT]) < 29 and int(ore_rake.counts[Rules.Mat.PLATE]) == 0, "left ore's rake sends the ore left and holds the plate (%s)" % ore_rake.text)
	var still: Dictionary = Rooms.all()[161]
	var stilled: Dictionary = World.simulate(still, still.solution)
	check(int(still.budget[Rules.Kind.BELT]) == 1, "still moldboard budgets one belt")
	var still_belts := 0
	var still_south := false
	for piece in still.solution:
		if int(piece.kind) == Rules.Kind.BELT:
			still_belts += 1
			check(int(piece.x) == 3 and int(piece.y) == 3, "still moldboard's belt is on the crossing")
		if int(piece.kind) == Rules.Kind.MOLDBOARD:
			still_south = int(piece.dir) == Rules.Dir.SOUTH
	check(still_belts == 1, "still moldboard places that one belt")
	check(still_south, "still moldboard faces south")
	check(int(stilled.counts[Rules.Mat.INGOT]) == 29 and int(stilled.counts[Rules.Mat.PLATE]) == 30 and int(stilled.discarded) > 0, "still moldboard leaves the scrap pit and counts both exits (%s discarded %d)" % [stilled.text, stilled.discarded])
	var still_share: Dictionary = World.simulate(still, _swap_kind(still.solution, Rules.Kind.MOLDBOARD, Rules.Kind.SHARE))
	var still_coulter: Dictionary = World.simulate(still, _swap_kind(still.solution, Rules.Kind.MOLDBOARD, Rules.Kind.COULTER))
	var still_fork: Dictionary = World.simulate(still, _swap_kind(still.solution, Rules.Kind.MOLDBOARD, Rules.Kind.FORK))
	check(int(still_share.counts[Rules.Mat.INGOT]) == 0 and int(still_share.counts[Rules.Mat.PLATE]) == 0 and int(still_share.discarded) > int(stilled.discarded), "still moldboard's share sends the ore forward into the scrap (%s)" % still_share.text)
	check(int(still_coulter.counts[Rules.Mat.PLATE]) == 0, "still moldboard's coulter sends the plate right (%s)" % still_coulter.text)
	check(int(still_fork.counts[Rules.Mat.INGOT]) == 29 and int(still_fork.counts[Rules.Mat.PLATE]) == 0, "still moldboard's fork misses the forward bin (%s)" % still_fork.text)
	var seat: Dictionary = Rooms.all()[162]
	var parked: Array = []
	for piece in seat.solution:
		if int(piece.kind) != Rules.Kind.MOLDBOARD:
			parked.append(piece)
	parked.append(Rooms.piece(Rules.Kind.MOLDBOARD, 0, 4, Rules.Dir.WEST))
	var gap: Dictionary = World.simulate(seat, parked)
	check(World.budget_met(parked, seat.budget), "leaving the seat moldboard parked stays inside the tray")
	check(int(gap.counts[Rules.Mat.INGOT]) == 0 and int(gap.counts[Rules.Mat.PLATE]) == 0 and not gap.quota_ok, "a parked moldboard leaves a gap and misses (%s)" % gap.text)
	var seat_planner = Planner.new(seat)
	check(seat_planner.at(0, 4) != null and seat_planner.remaining(Rules.Kind.MOLDBOARD) == 0, "seat starts with the moldboard off the tray")
	check(seat_planner.pickup(0, 4), "pickup lifts the pre-placed moldboard")
	check(seat_planner.at(0, 4) == null and seat_planner.remaining(Rules.Kind.MOLDBOARD) == 1, "pre-placed moldboard returns to the tray")
	check(seat_planner.place(Rules.Kind.MOLDBOARD, 3, 3, Rules.Dir.NORTH), "the returned moldboard can be seated on the lane")
	var seated: Dictionary = World.simulate(seat, seat.solution)
	check(int(seated.counts[Rules.Mat.INGOT]) == 29 and int(seated.counts[Rules.Mat.PLATE]) == 30, "a seated moldboard feeds the kiln and the plate bin (%s)" % seated.text)
	var seated_share: Dictionary = World.simulate(seat, _swap_kind(seat.solution, Rules.Kind.MOLDBOARD, Rules.Kind.SHARE))
	var seated_coulter: Dictionary = World.simulate(seat, _swap_kind(seat.solution, Rules.Kind.MOLDBOARD, Rules.Kind.COULTER))
	check(int(seated_share.counts[Rules.Mat.INGOT]) == 0, "a share seated on the moldboard lane misses the kiln (%s)" % seated_share.text)
	check(int(seated_coulter.counts[Rules.Mat.PLATE]) == 0, "a coulter seated on the moldboard lane misses the forward bin (%s)" % seated_coulter.text)
	var corner: Dictionary = Rooms.all()[163]
	var cornered: Dictionary = World.simulate(corner, corner.solution)
	check(int(cornered.counts[Rules.Mat.INGOT]) == 57 and int(cornered.counts[Rules.Mat.PLATE]) == 57, "split corner feeds both exits (%s)" % cornered.text)
	var corner_share: Dictionary = World.simulate(corner, _swap_kind(corner.solution, Rules.Kind.MOLDBOARD, Rules.Kind.SHARE))
	var corner_coulter: Dictionary = World.simulate(corner, _swap_kind(corner.solution, Rules.Kind.MOLDBOARD, Rules.Kind.COULTER))
	var corner_fork: Dictionary = World.simulate(corner, _swap_kind(corner.solution, Rules.Kind.MOLDBOARD, Rules.Kind.FORK))
	check(int(corner_share.counts[Rules.Mat.INGOT]) == 0 and int(corner_share.counts[Rules.Mat.PLATE]) == 0, "split corner's share swaps them into the grate and the wrong bin (%s)" % corner_share.text)
	check(int(corner_coulter.counts[Rules.Mat.INGOT]) == 0 and int(corner_coulter.counts[Rules.Mat.PLATE]) == 0, "split corner's coulter sends the arrival right into the wall (%s)" % corner_coulter.text)
	check(int(corner_fork.counts[Rules.Mat.PLATE]) == 0, "split corner's fork misses the forward bin (%s)" % corner_fork.text)
	var stocks: Dictionary = Rooms.all()[164]
	var stocked: Dictionary = World.simulate(stocks, stocks.solution)
	check(int(stocked.counts[Rules.Mat.INGOT]) == 58 and int(stocked.counts[Rules.Mat.PLATE]) == 58, "two stocks reaches 58 ingots and 58 plates (%s)" % stocked.text)
	var stocks_share: Dictionary = World.simulate(stocks, _swap_kind(stocks.solution, Rules.Kind.MOLDBOARD, Rules.Kind.SHARE))
	var stocks_coulter: Dictionary = World.simulate(stocks, _swap_kind(stocks.solution, Rules.Kind.MOLDBOARD, Rules.Kind.COULTER))
	var stocks_fork: Dictionary = World.simulate(stocks, _swap_kind(stocks.solution, Rules.Kind.MOLDBOARD, Rules.Kind.FORK))
	check(int(stocks_share.counts[Rules.Mat.INGOT]) == 0 and int(stocks_share.counts[Rules.Mat.PLATE]) == 0, "two stocks' share feeds the kiln with the plate and the plate bin with the ore (%s)" % stocks_share.text)
	check(int(stocks_coulter.counts[Rules.Mat.PLATE]) == 0, "two stocks' coulter misses the forward bin (%s)" % stocks_coulter.text)
	check(int(stocks_fork.counts[Rules.Mat.INGOT]) == 58 and int(stocks_fork.counts[Rules.Mat.PLATE]) == 0, "two stocks' fork misses the forward bin (%s)" % stocks_fork.text)
	var scrap: Dictionary = Rooms.all()[165]
	var scraped: Dictionary = World.simulate(scrap, scrap.solution)
	var scrap_south := false
	for piece in scrap.solution:
		if int(piece.kind) == Rules.Kind.MOLDBOARD:
			scrap_south = int(piece.dir) == Rules.Dir.SOUTH
	check(scrap_south, "after the split's moldboard faces south")
	check(int(scraped.counts[Rules.Mat.INGOT]) == 29 and int(scraped.counts[Rules.Mat.PLATE]) == 30 and int(scraped.discarded) > 0, "after the split counts both exits and discards the scrap (%s discarded %d)" % [scraped.text, scraped.discarded])
	var scrap_share: Dictionary = World.simulate(scrap, _swap_kind(scrap.solution, Rules.Kind.MOLDBOARD, Rules.Kind.SHARE))
	var scrap_coulter: Dictionary = World.simulate(scrap, _swap_kind(scrap.solution, Rules.Kind.MOLDBOARD, Rules.Kind.COULTER))
	var scrap_fork: Dictionary = World.simulate(scrap, _swap_kind(scrap.solution, Rules.Kind.MOLDBOARD, Rules.Kind.FORK))
	check(int(scrap_share.counts[Rules.Mat.INGOT]) == 0 and int(scrap_share.counts[Rules.Mat.PLATE]) == 0, "after the split's share sends the ore forward, toward the scrap (%s)" % scrap_share.text)
	check(int(scrap_coulter.counts[Rules.Mat.PLATE]) == 0, "after the split's coulter sends the plate right (%s)" % scrap_coulter.text)
	check(int(scrap_fork.counts[Rules.Mat.PLATE]) == 0, "after the split's fork misses the forward bin (%s)" % scrap_fork.text)
	var bin: Dictionary = Rooms.all()[166]
	var solved: Dictionary = World.simulate(bin, bin.solution)
	check(int(solved.counts[Rules.Mat.INGOT]) == 19 and int(solved.counts[Rules.Mat.PLATE]) == 99, "split bin hits both quotas (%s)" % solved.text)
	check(solved.world.machines[Vector2i(8, 3)].hold < 0, "split bin's moldboard is empty after the pairs")
	var plates_only: Dictionary = World.simulate(bin, [
		Rooms.piece(Rules.Kind.BELT, 8, 5, Rules.Dir.WEST),
		Rooms.piece(Rules.Kind.BELT, 7, 5, Rules.Dir.WEST),
	])
	check(int(plates_only.counts[Rules.Mat.INGOT]) == 0 and int(plates_only.counts[Rules.Mat.PLATE]) < int(bin.quota[Rules.Mat.PLATE]), "split bin's lower plates alone miss (%s)" % plates_only.text)
	var pressed: Dictionary = World.simulate(bin, [
		Rooms.piece(Rules.Kind.BELT, 8, 5, Rules.Dir.WEST),
		Rooms.piece(Rules.Kind.BELT, 7, 5, Rules.Dir.WEST),
		Rooms.piece(Rules.Kind.BELT, 6, 1, Rules.Dir.SOUTH),
		Rooms.piece(Rules.Kind.BELT, 6, 2, Rules.Dir.SOUTH),
		Rooms.piece(Rules.Kind.MOLDBOARD, 8, 3, Rules.Dir.NORTH),
		Rooms.piece(Rules.Kind.WEIR, 7, 3, Rules.Dir.WEST),
		Rooms.piece(Rules.Kind.BELT, 6, 3, Rules.Dir.WEST),
		Rooms.piece(Rules.Kind.FILTER, 5, 3, Rules.Dir.WEST),
		Rooms.piece(Rules.Kind.KILN, 4, 3, Rules.Dir.WEST),
		Rooms.piece(Rules.Kind.BELT, 3, 3, Rules.Dir.NORTH),
		Rooms.piece(Rules.Kind.BELT, 3, 2, Rules.Dir.WEST),
		Rooms.piece(Rules.Kind.PRESS, 2, 2, Rules.Dir.WEST),
		Rooms.piece(Rules.Kind.BELT, 1, 2, Rules.Dir.WEST),
	])
	check(int(pressed.counts[Rules.Mat.INGOT]) == 0 and not pressed.success, "pressing every ingot misses the split bin (%s)" % pressed.text)
	for kind in [Rules.Kind.SHARE, Rules.Kind.COULTER, Rules.Kind.FORK, Rules.Kind.PRONG]:
		var missed: Dictionary = World.simulate(bin, _swap_kind(bin.solution, Rules.Kind.MOLDBOARD, int(kind)))
		var misses_one: bool = int(missed.counts[Rules.Mat.INGOT]) < int(bin.quota[Rules.Mat.INGOT]) or int(missed.counts[Rules.Mat.PLATE]) < int(bin.quota[Rules.Mat.PLATE])
		check(misses_one, "%s in place of the split-bin moldboard misses at least one quota (%s)" % [Rules.KIND_NAME[int(kind)], missed.text])
	var bin_share: Dictionary = World.simulate(bin, _swap_kind(bin.solution, Rules.Kind.MOLDBOARD, Rules.Kind.SHARE))
	check(int(bin_share.counts[Rules.Mat.INGOT]) < 19 or int(bin_share.counts[Rules.Mat.PLATE]) < 99, "split bin's share misses the swapped assignment (%s)" % bin_share.text)
	var held_room: Dictionary = Rooms.all()[167]
	var waiting: Dictionary = World.simulate(held_room, held_room.solution, 2)
	var leaving: Dictionary = World.simulate(held_room, held_room.solution, 3)
	var finished: Dictionary = World.simulate(held_room, held_room.solution)
	var belt_early: Dictionary = World.simulate(held_room, _swap_kind(held_room.solution, Rules.Kind.MOLDBOARD, Rules.Kind.BELT), 2)
	check(waiting.world.machines[Vector2i(3, 3)].hold == Rules.Mat.ORE and waiting.trace.is_empty(), "held pair keeps the first ore through the empty tick")
	check(leaving.world.machines[Vector2i(3, 3)].hold < 0, "held pair leaves on the arrival tick")
	check(belt_early.world.machines[Vector2i(3, 3)].hold < 0 and belt_early.world.machines[Vector2i(3, 2)].hold == Rules.Mat.ORE, "a belt would have moved the first item on that tick")
	check(int(finished.counts[Rules.Mat.INGOT]) == 29 and int(finished.counts[Rules.Mat.PLATE]) == 30, "held pair feeds the kiln and the plate bin (%s)" % finished.text)
	var held_share: Dictionary = World.simulate(held_room, _swap_kind(held_room.solution, Rules.Kind.MOLDBOARD, Rules.Kind.SHARE))
	check(int(held_share.counts[Rules.Mat.INGOT]) == 0, "held pair's share misses the kiln (%s)" % held_share.text)


func _test_landside_splits_right_and_forward() -> void:
	var ore := _coulter_lane([Rules.Mat.ORE], 4)
	var placed := [Rooms.piece(Rules.Kind.LANDSIDE, 1, 1, Rules.Dir.EAST)]
	var early := World.simulate(ore, placed, 4)
	var mid := World.simulate(ore, placed, 8)
	var waiting := World.simulate(ore, placed, 12)
	var result := World.simulate(ore, placed, 16)
	var again := World.simulate(ore, placed, 16)
	check(_trace(early) == "" and early.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "a lone ore is still in the landside after the belt tick and the dwell tick")
	check(_trace(mid) == "5:1,2:0|5:2,1:0" and mid.world.machines[Vector2i(1, 1)].hold < 0, "the waiter leaves right and the arrival leaves forward, and the landside is empty, got %s" % _trace(mid))
	check(int(mid.counts[Rules.Mat.ORE]) == 2, "the first landside pair leaves on the arrival tick")
	check(_trace(waiting) == "5:1,2:0|5:2,1:0" and waiting.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "the next lone ore does not leave the landside on the next tick or the tick after that, got %s" % _trace(waiting))
	check(_trace(result) == "5:1,2:0|5:2,1:0|13:1,2:0|13:2,1:0", "the next landside pair leaves right and forward, got %s" % _trace(result))
	check(result.world.machines[Vector2i(1, 1)].hold < 0, "the landside is empty after the second pair")
	check(int(result.counts[Rules.Mat.ORE]) == 4, "two landside pairs leave and nothing stays")
	check(not ("1,0:" in _trace(result)), "a landside does not send left")
	check(_same(result, again), "the same landside lane is deterministic (seed %d)" % result.seed)
	var as_moldboard := World.simulate(ore, [Rooms.piece(Rules.Kind.MOLDBOARD, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_moldboard) == "5:1,0:0|5:2,1:0" and as_moldboard.world.machines[Vector2i(1, 1)].hold < 0, "a moldboard on the landside lane sends the waiter left and the arrival forward, got %s" % _trace(as_moldboard))
	var as_coulter := World.simulate(ore, [Rooms.piece(Rules.Kind.COULTER, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_coulter) == "5:2,1:0|5:1,2:0" and as_coulter.world.machines[Vector2i(1, 1)].hold < 0, "a coulter on the landside lane sends the waiter forward and the arrival right, got %s" % _trace(as_coulter))
	var as_share := World.simulate(ore, [Rooms.piece(Rules.Kind.SHARE, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_share) == "5:2,1:0|5:1,0:0" and as_share.world.machines[Vector2i(1, 1)].hold < 0, "a share on the landside lane sends the waiter forward and the arrival left, got %s" % _trace(as_share))
	var as_fork := World.simulate(ore, [Rooms.piece(Rules.Kind.FORK, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_fork) == "5:1,0:0|5:1,2:0" and as_fork.world.machines[Vector2i(1, 1)].hold < 0, "a fork on the landside lane sends the waiter left and the arrival right, and nothing forward, got %s" % _trace(as_fork))
	var as_prong := World.simulate(ore, [Rooms.piece(Rules.Kind.PRONG, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_prong) == "5:1,2:0|5:1,0:0" and as_prong.world.machines[Vector2i(1, 1)].hold < 0, "a prong on the landside lane sends the waiter right and the arrival left, and nothing forward, got %s" % _trace(as_prong))
	var belt := World.simulate(ore, [Rooms.piece(Rules.Kind.BELT, 1, 1, Rules.Dir.EAST)], 12)
	var dwell := World.simulate(ore, [Rooms.piece(Rules.Kind.DWELL, 1, 1, Rules.Dir.EAST)], 12)
	check(_trace(belt) == "2:2,1:0|6:2,1:0|10:2,1:0", "a belt on the landside cell sends forward on the next tick, got %s" % _trace(belt))
	check(_trace(dwell) == "3:2,1:0|7:2,1:0|11:2,1:0", "a dwell on the landside cell sends forward one tick after a belt, got %s" % _trace(dwell))
	for mat in [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE]:
		var lane := _coulter_lane([mat], 80)
		var lone := World.simulate(lane, placed, 15)
		check(_trace(lone) == "" and lone.world.machines[Vector2i(1, 1)].hold == mat, "a lone %s never leaves a landside" % Rules.MAT_NAME[mat])
	var mixed := _coulter_lane([Rules.Mat.ORE, Rules.Mat.INGOT], 4)
	var held := World.simulate(mixed, placed, 4)
	var pushed := World.simulate(mixed, placed, 8)
