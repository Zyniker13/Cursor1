	check(_trace(held).is_empty() and held.world.machines[Vector2i(2, 2)].hold == Rules.Mat.ORE and int(held.world.sources[0].pending) == Rules.Mat.INGOT, "a right source holds the mandrel pair")
	check(_trace(stepped) == "5:1,2:0|5:4,2:1", "a breast still steps through the forward source when a right source holds the mandrel, got %s" % _trace(stepped))
	var south := {
