		"rule": "",
		"w": 3,
		"h": 1,
		"sources": [
			Rooms.source(0, 0, Rules.Dir.EAST, [Rules.Mat.ORE], 4),
			Rooms.source(2, 0, Rules.Dir.WEST, [Rules.Mat.INGOT], 1),
		],
		"sinks": [],
