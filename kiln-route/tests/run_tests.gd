	check(int(corner_rake.counts[Rules.Mat.INGOT]) == 0, "split corner's rake sends left and the kiln misses (%s)" % corner_rake.text)
	check(int(corner_shed.counts[Rules.Mat.INGOT]) == 0, "split corner's shed sends left and the kiln misses (%s)" % corner_shed.text)
	check(int(corner_hook.counts[Rules.Mat.INGOT]) == 0, "split corner's hook sends left and the kiln misses (%s)" % corner_hook.text)
	var heat: Dictionary = Rooms.all()[157]
