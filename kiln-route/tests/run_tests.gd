	check(int(stocks_coulter.counts[Rules.Mat.INGOT]) == 0 and int(stocks_coulter.counts[Rules.Mat.PLATE]) == 0, "two stocks' coulters send the ore forward and the plate right (%s)" % stocks_coulter.text)
