	check(int(heat_fork.counts[Rules.Mat.INGOT]) == 58, "two heats' fork feeds the right kiln and misses the forward kiln (%s)" % heat_fork.text)
	check(int(heat_prong.counts[Rules.Mat.INGOT]) == 58, "two heats' prong feeds the right kiln with the waiter (%s)" % heat_prong.text)
	check(int(heat_pass.counts[Rules.Mat.INGOT]) == 58, "two heats' pass feeds only the forward kiln (%s)" % heat_pass.text)
	check(int(heat_hoe.counts[Rules.Mat.INGOT]) == 58, "two heats' hoe feeds only the right (%s)" % heat_hoe.text)
	check(int(heat_harrow.counts[Rules.Mat.INGOT]) == 58, "two heats' harrow feeds only the right with the arrival (%s)" % heat_harrow.text)
	var scrap: Dictionary = Rooms.all()[158]
