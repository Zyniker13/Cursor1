	check(_trace(dwell) == "3:2,1:0|7:2,1:0|11:2,1:0", "a dwell on that cell sends forward one tick after a belt, got %s" % _trace(dwell))
	var hook := World.simulate(ore, [Rooms.piece(Rules.Kind.HOOK, 1, 1, Rules.Dir.EAST)], 12)
