func _test_throat_splits_behind_and_forward() -> void:
	var mixed := _throat_lane([Rules.Mat.ORE, Rules.Mat.INGOT], 4)
	var placed := [Rooms.piece(Rules.Kind.THROAT, 1, 1, Rules.Dir.EAST)]
	var early := World.simulate(mixed, placed, 4)
	var mid := World.simulate(mixed, placed, 8)
	var waiting := World.simulate(mixed, placed, 12)
	var result := World.simulate(mixed, placed, 16)
	var again := World.simulate(mixed, placed, 16)
	check(_trace(early) == "" and early.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "a lone ore is still in the throat after the belt tick and the dwell tick")
	check(_trace(mid) == "5:0,1:0|5:2,1:1" and mid.world.machines[Vector2i(1, 1)].hold < 0, "the waiter leaves behind and the arrival leaves forward, got %s" % _trace(mid))
	check(int(mid.counts[Rules.Mat.ORE]) == 1 and int(mid.counts[Rules.Mat.INGOT]) == 1, "the first throat pair leaves on the arrival tick")
	check(_trace(waiting) == "5:0,1:0|5:2,1:1" and waiting.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "the next lone ore does not leave the throat, got %s" % _trace(waiting))
	check(_trace(result) == "5:0,1:0|5:2,1:1|13:0,1:0|13:2,1:1", "the next throat pair leaves behind and forward, got %s" % _trace(result))
	check(result.world.machines[Vector2i(1, 1)].hold < 0, "the throat is empty after the second pair")
	check(not ("1,2:" in _trace(result)), "a throat does not send the waiter right")
	check(not ("1,0:" in _trace(result)), "a throat does not send the waiter left")
	check(int(result.world.machines[Vector2i(1, 1)].phase) == 0, "a throat does not rotate or alternate")
	check(_same(result, again), "the same throat lane is deterministic (seed %d)" % result.seed)
	var same := World.simulate(_throat_lane([Rules.Mat.ORE], 4), placed, 16)
	check(_trace(same) == "" and same.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "the same material does not release the waiter, got %s" % _trace(same))
	var as_point := World.simulate(mixed, [Rooms.piece(Rules.Kind.POINT, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_point) == "5:1,2:0|5:2,1:1", "a point on the throat lane sends the waiter right, got %s" % _trace(as_point))
	var as_shin := World.simulate(mixed, [Rooms.piece(Rules.Kind.SHIN, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_shin) == "5:1,0:0|5:2,1:1", "a shin on the throat lane sends the waiter left, got %s" % _trace(as_shin))
	var as_beam := World.simulate(mixed, [Rooms.piece(Rules.Kind.BEAM, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_beam) == "5:0,1:0|5:1,0:1", "a beam on the throat lane sends the arrival left, not forward, got %s" % _trace(as_beam))
	var behind := {
		"id": 0, "name": "throat behind", "blurb": "", "rule": "", "w": 3, "h": 3,
		"sources": [Rooms.source(0, 1, Rules.Dir.EAST, [Rules.Mat.ORE, Rules.Mat.INGOT], 4)],
		"sinks": [
			Rooms.sink(0, 1, [Rules.Mat.ORE, Rules.Mat.INGOT]), Rooms.sink(1, 0, [Rules.Mat.ORE, Rules.Mat.INGOT]),
			Rooms.sink(1, 2, [Rules.Mat.ORE, Rules.Mat.INGOT]), Rooms.sink(2, 1, [Rules.Mat.ORE, Rules.Mat.INGOT]),
		],
		"chutes": [], "walls": [],
		"budget": Rooms.kv([Rules.Kind.THROAT, 1]),
		"quota": Rooms.kv([Rules.Mat.ORE, 1]),
		"initial": [], "solution": [],
	}
	var from_behind := World.simulate(behind, placed, 8)
	check(_trace(from_behind) == "" and from_behind.world.machines[Vector2i(1, 1)].hold < 0, "a throat refuses an arrival from behind, got %s" % _trace(from_behind))
	check(_trace(World.simulate(_stilt_lane([Rules.Mat.ORE, Rules.Mat.INGOT], 4), placed, 8)) == "", "a throat refuses an arrival from the left")
	check(_trace(World.simulate(_clevis_lane([Rules.Mat.ORE, Rules.Mat.INGOT], 4), placed, 8)) == "", "a throat refuses an arrival from the right")
	var belt := World.simulate(mixed, [Rooms.piece(Rules.Kind.BELT, 1, 1, Rules.Dir.EAST)], 12)
	check(_trace(belt) == "" and belt.world.machines[Vector2i(1, 1)].hold < 0, "a belt refuses the throat's ahead arrival, got %s" % _trace(belt))
	for mat in [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE]:
		var lone := World.simulate(_throat_lane([mat], 80), placed, 15)
		check(_trace(lone) == "" and lone.world.machines[Vector2i(1, 1)].hold == mat, "a lone %s never leaves a throat" % Rules.MAT_NAME[mat])
	var south := {
		"id": 0, "name": "throat south", "blurb": "", "rule": "", "w": 3, "h": 3,
		"sources": [Rooms.source(1, 2, Rules.Dir.NORTH, [Rules.Mat.ORE, Rules.Mat.INGOT], 4)],
		"sinks": [
			Rooms.sink(1, 0, [Rules.Mat.ORE, Rules.Mat.INGOT]),
			Rooms.sink(0, 1, [Rules.Mat.ORE, Rules.Mat.INGOT]),
			Rooms.sink(2, 1, [Rules.Mat.ORE, Rules.Mat.INGOT]),
			Rooms.sink(1, 2, [Rules.Mat.ORE, Rules.Mat.INGOT]),
		],
		"chutes": [], "walls": [],
		"budget": Rooms.kv([Rules.Kind.THROAT, 1]),
		"quota": Rooms.kv([Rules.Mat.ORE, 1]),
		"initial": [], "solution": [],
	}
	var turned := World.simulate(south, [Rooms.piece(Rules.Kind.THROAT, 1, 1, Rules.Dir.SOUTH)], 8)
	check(_trace(turned) == "5:1,0:0|5:1,2:1" and turned.world.machines[Vector2i(1, 1)].hold < 0, "a south-facing throat sends the waiter behind and the arrival forward, got %s" % _trace(turned))


