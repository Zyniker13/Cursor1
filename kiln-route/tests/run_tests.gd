		"quota": Rooms.kv([Rules.Mat.PLATE, 1]),
		"initial": [], "solution": [],
	}
	var belt := World.simulate(behind_lane, [Rooms.piece(Rules.Kind.BELT, 1, 0, Rules.Dir.EAST)], 4)
	var board_behind := World.simulate(behind_lane, [Rooms.piece(Rules.Kind.PRITCHEL, 1, 0, Rules.Dir.EAST)], 4)
	check(int(belt.counts[Rules.Mat.PLATE]) >= 1, "a belt takes a plate from behind the pritchel cell, got %s" % _trace(belt))
	check(int(board_behind.counts[Rules.Mat.PLATE]) == 0 and int(board_behind.world.sources[0].pending) == Rules.Mat.PLATE, "a pritchel refuses that same plate from behind")


