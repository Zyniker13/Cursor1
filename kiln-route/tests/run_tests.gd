func _test_slade_splits_backward_and_forward() -> void:
	var ore := _slade_lane([Rules.Mat.ORE], 4)
	var placed := [Rooms.piece(Rules.Kind.SLADE, 1, 1, Rules.Dir.EAST)]
	var early := World.simulate(ore, placed, 4)
	var mid := World.simulate(ore, placed, 8)
	var waiting := World.simulate(ore, placed, 12)
	var result := World.simulate(ore, placed, 16)
	var again := World.simulate(ore, placed, 16)
	check(_trace(early) == "" and early.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "a lone ore is still in the slade after the belt tick and the dwell tick")
	check(_trace(mid) == "5:0,1:0|5:2,1:0" and mid.world.machines[Vector2i(1, 1)].hold < 0, "the waiter leaves backward and the arrival leaves forward, and the slade is empty, got %s" % _trace(mid))
	check(int(mid.counts[Rules.Mat.ORE]) == 2, "the first slade pair leaves on the arrival tick")
	check(_trace(waiting) == "5:0,1:0|5:2,1:0" and waiting.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "the next lone ore does not leave the slade on the next tick or the tick after that, got %s" % _trace(waiting))
	check(_trace(result) == "5:0,1:0|5:2,1:0|13:0,1:0|13:2,1:0", "the next slade pair leaves backward and forward, got %s" % _trace(result))
	check(result.world.machines[Vector2i(1, 1)].hold < 0, "the slade is empty after the second pair")
	check(int(result.counts[Rules.Mat.ORE]) == 4, "two slade pairs leave and nothing stays")
	check(not ("1,0:" in _trace(result)), "a slade does not send left")
	check(not ("1,2:" in _trace(result)), "a slade does not send right")
	check(_same(result, again), "the same slade lane is deterministic (seed %d)" % result.seed)
