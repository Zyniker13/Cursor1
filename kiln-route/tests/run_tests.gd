		"initial": [], "solution": [],
	}
	var belt_right := World.simulate(right_side, [Rooms.piece(Rules.Kind.BELT, 1, 1, Rules.Dir.EAST)], 4)
	var board_right := World.simulate(right_side, [Rooms.piece(Rules.Kind.PRITCHEL, 1, 1, Rules.Dir.EAST)], 4)
