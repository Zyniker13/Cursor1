		"initial": [], "solution": [],
	}
	var belt_left := World.simulate(left_side, [Rooms.piece(Rules.Kind.BELT, 1, 1, Rules.Dir.EAST)], 4)
	var board_left := World.simulate(left_side, [Rooms.piece(Rules.Kind.PRITCHEL, 1, 1, Rules.Dir.EAST)], 4)
