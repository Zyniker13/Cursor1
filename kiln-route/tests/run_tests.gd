	var heat_share: Dictionary = World.simulate(heat, _swap_kind(heat.solution, Rules.Kind.COULTER, Rules.Kind.SHARE))
	var heat_fork: Dictionary = World.simulate(heat, _swap_kind(heat.solution, Rules.Kind.COULTER, Rules.Kind.FORK))
