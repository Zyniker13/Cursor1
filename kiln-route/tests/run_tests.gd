func _test_coulter_splits_forward_and_right() -> void:
	var ore := _coulter_lane([Rules.Mat.ORE], 4)
	var placed := [Rooms.piece(Rules.Kind.COULTER, 1, 1, Rules.Dir.EAST)]
	var early := World.simulate(ore, placed, 4)
	var mid := World.simulate(ore, placed, 8)
	var waiting := World.simulate(ore, placed, 12)
	var result := World.simulate(ore, placed, 16)
	var again := World.simulate(ore, placed, 16)
	check(_trace(early) == "" and early.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "a lone ore is still in the coulter after the belt tick and the dwell tick")
	check(_trace(mid) == "5:2,1:0|5:1,2:0" and mid.world.machines[Vector2i(1, 1)].hold < 0, "the waiter leaves forward and the arrival leaves right, and the coulter is empty, got %s" % _trace(mid))
	check(int(mid.counts[Rules.Mat.ORE]) == 2, "the first coulter pair leaves on the arrival tick")
	check(_trace(waiting) == "5:2,1:0|5:1,2:0" and waiting.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "the next lone ore does not leave the coulter on the next tick or the tick after that, got %s" % _trace(waiting))
	check(_trace(result) == "5:2,1:0|5:1,2:0|13:2,1:0|13:1,2:0", "the next coulter pair leaves forward and right, got %s" % _trace(result))
	check(result.world.machines[Vector2i(1, 1)].hold < 0, "the coulter is empty after the second pair")
	check(int(result.counts[Rules.Mat.ORE]) == 4, "two coulter pairs leave and nothing stays")
	check(not ("1,0:" in _trace(result)), "a coulter does not send left")
	check(_same(result, again), "the same coulter lane is deterministic (seed %d)" % result.seed)
	var as_share := World.simulate(ore, [Rooms.piece(Rules.Kind.SHARE, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_share) == "5:2,1:0|5:1,0:0" and as_share.world.machines[Vector2i(1, 1)].hold < 0, "a share on the coulter lane sends the waiter forward and the arrival left, got %s" % _trace(as_share))
	var as_fork := World.simulate(ore, [Rooms.piece(Rules.Kind.FORK, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_fork) == "5:1,0:0|5:1,2:0" and as_fork.world.machines[Vector2i(1, 1)].hold < 0, "a fork on the coulter lane sends the waiter left and the arrival right, got %s" % _trace(as_fork))
	var as_prong := World.simulate(ore, [Rooms.piece(Rules.Kind.PRONG, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_prong) == "5:1,2:0|5:1,0:0" and as_prong.world.machines[Vector2i(1, 1)].hold < 0, "a prong on the coulter lane sends the waiter right and the arrival left, got %s" % _trace(as_prong))
	var belt := World.simulate(ore, [Rooms.piece(Rules.Kind.BELT, 1, 1, Rules.Dir.EAST)], 12)
	var dwell := World.simulate(ore, [Rooms.piece(Rules.Kind.DWELL, 1, 1, Rules.Dir.EAST)], 12)
	check(_trace(belt) == "2:2,1:0|6:2,1:0|10:2,1:0", "a belt on the coulter cell sends forward on the next tick, got %s" % _trace(belt))
	check(_trace(dwell) == "3:2,1:0|7:2,1:0|11:2,1:0", "a dwell on the coulter cell sends forward one tick after a belt, got %s" % _trace(dwell))
	var hook := World.simulate(ore, [Rooms.piece(Rules.Kind.HOOK, 1, 1, Rules.Dir.EAST)], 12)
	check(_trace(hook) == "2:1,0:0|6:1,0:0|10:1,0:0", "a hook on the coulter cell sends its one item left and does not keep a waiter, got %s" % _trace(hook))
	check(hook.world.machines[Vector2i(1, 1)].hold < 0, "a hook on the coulter cell does not keep an item in place")
	for mat in [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE]:
		var lane := _coulter_lane([mat], 80)
		var lone := World.simulate(lane, placed, 15)
		check(_trace(lone) == "" and lone.world.machines[Vector2i(1, 1)].hold == mat, "a lone %s never leaves a coulter" % Rules.MAT_NAME[mat])
	var mixed := _coulter_lane([Rules.Mat.ORE, Rules.Mat.INGOT], 4)
	var held := World.simulate(mixed, placed, 4)
	var pushed := World.simulate(mixed, placed, 8)
	var later := World.simulate(mixed, placed, 12)
	check(_trace(held) == "" and held.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "a coulter does not release before the different material arrives")
	check(_trace(pushed) == "5:2,1:0|5:1,2:1" and pushed.world.machines[Vector2i(1, 1)].hold < 0, "a different material leaves right while the waiter leaves forward, and the coulter is empty, got %s" % _trace(pushed))
	check(_trace(later) == "5:2,1:0|5:1,2:1" and later.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "the next lone ore waits in the coulter and does not leave yet, got %s" % _trace(later))
	check(int(pushed.world.machines[Vector2i(1, 1)].phase) == 0, "a coulter does not rotate or alternate")
	var as_pass := World.simulate(mixed, [Rooms.piece(Rules.Kind.PASS, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_pass) == "5:2,1:0" and as_pass.world.machines[Vector2i(1, 1)].hold == Rules.Mat.INGOT, "a pass on the coulter lane sends the waiter forward and keeps the arrival, got %s" % _trace(as_pass))
	var as_slip := World.simulate(mixed, [Rooms.piece(Rules.Kind.SLIP, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_slip) == "5:2,1:1" and as_slip.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "a slip on the coulter lane sends the arrival forward and keeps the waiter, got %s" % _trace(as_slip))
	var as_hoe := World.simulate(mixed, [Rooms.piece(Rules.Kind.HOE, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_hoe) == "5:1,2:0" and as_hoe.world.machines[Vector2i(1, 1)].hold == Rules.Mat.INGOT, "a hoe on the coulter lane sends the waiter right and keeps the arrival, got %s" % _trace(as_hoe))
	var as_twin := World.simulate(mixed, [Rooms.piece(Rules.Kind.TWIN, 1, 1, Rules.Dir.EAST)], 8)
	check(_trace(as_twin) == "" and as_twin.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "a twin on the coulter lane refuses that different material")
	check(int(as_twin.world.sources[0].pending) == Rules.Mat.INGOT, "the twin on the coulter lane leaves the different material on the previous piece")
	var south := {
		"id": 0,
		"name": "coulter south",
		"blurb": "",
		"rule": "",
		"w": 3,
		"h": 3,
		"sources": [Rooms.source(1, 0, Rules.Dir.SOUTH, [Rules.Mat.ORE, Rules.Mat.INGOT], 4)],
		"sinks": [
			Rooms.sink(0, 1, [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE]),
			Rooms.sink(2, 1, [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE]),
			Rooms.sink(1, 2, [Rules.Mat.ORE, Rules.Mat.INGOT, Rules.Mat.PLATE]),
		],
		"chutes": [],
		"walls": [],
		"budget": Rooms.kv([Rules.Kind.COULTER, 1]),
		"quota": Rooms.kv([Rules.Mat.ORE, 1]),
		"initial": [],
		"solution": [],
	}
	var turned := World.simulate(south, [Rooms.piece(Rules.Kind.COULTER, 1, 1, Rules.Dir.SOUTH)], 8)
	check(_trace(turned) == "5:1,2:0|5:0,1:1" and turned.world.machines[Vector2i(1, 1)].hold < 0, "a south-facing coulter sends the waiter forward and the arrival right, got %s" % _trace(turned))


