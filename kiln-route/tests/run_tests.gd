	check(_trace(hardie) == "2:4,1:0|2:2,0:1|4:4,1:0|4:2,0:1|6:4,1:0|6:2,0:1", "a hardie spills the same pair forward and left, got %s" % _trace(hardie))
	var forward_wall := {
