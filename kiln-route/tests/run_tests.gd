		Rules.Kind.FORK, Rules.Kind.PRONG, Rules.Kind.SETT, Rules.Kind.BOLSTER, Rules.Kind.SNAP,
		Rules.Kind.ANVIL, Rules.Kind.SLEDGE, Rules.Kind.BREAST,
	]
	for index in range(400, 408):
