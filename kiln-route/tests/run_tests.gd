	var right_held := World.simulate(right_wall, [Rooms.piece(Rules.Kind.COULTER, 1, 1, Rules.Dir.EAST)], 6)
	check(right_held.error == "" and right_held.discarded == 0 and right_held.trace.is_empty(), "a coulter with a blocked right cell does not spill forward, left, or back")
	check(right_held.world.machines[Vector2i(1, 1)].hold == Rules.Mat.ORE, "blocked ore stays on the coulter when the right cell refuses")
	check(int(right_held.world.sources[0].pending) == Rules.Mat.PLATE, "the arrival is not accepted while the coulter's right cell refuses")
	check(int(right_held.counts[Rules.Mat.ORE]) == 0 and int(right_held.counts[Rules.Mat.PLATE]) == 0, "a blocked right cell does not send the waiter forward")
	var belt := World.simulate(right_wall, [Rooms.piece(Rules.Kind.BELT, 1, 1, Rules.Dir.EAST)], 4)
