func _test_wing26_lessons() -> void:
	var wrong_kinds: Array = [
		Rules.Kind.BELT,
		Rules.Kind.DWELL,
		Rules.Kind.TWIN,
		Rules.Kind.PASS,
		Rules.Kind.SLIP,
		Rules.Kind.SHED,
		Rules.Kind.HOOK,
		Rules.Kind.RAKE,
		Rules.Kind.HOE,
		Rules.Kind.HARROW,
		Rules.Kind.LANDSIDE,
		Rules.Kind.MOLDBOARD,
		Rules.Kind.COULTER,
		Rules.Kind.SHARE,
		Rules.Kind.FORK,
		Rules.Kind.PRONG,
		Rules.Kind.SLADE,
		Rules.Kind.HEEL,
		Rules.Kind.STILT,
	]
	for index in range(200, 208):
		var room: Dictionary = Rooms.all()[index]
		for kind in wrong_kinds:
			var swapped := _swap_kind(room.solution, Rules.Kind.CLEVIS, int(kind))
			var run: Dictionary = World.simulate(room, swapped)
			check(run.error == "", "%s in place of the room %d clevis simulates (%s)" % [Rules.KIND_NAME[int(kind)], room.id, run.error])
			check(not run.quota_ok, "%s in place of the room %d clevis misses the quota (%s)" % [Rules.KIND_NAME[int(kind)], room.id, run.text])
			check(not run.success, "%s in place of the room %d clevis does not clear" % [Rules.KIND_NAME[int(kind)], room.id])
			if int(kind) != Rules.Kind.BELT:
				check(int(room.budget.get(int(kind), 0)) == 0, "room %d does not budget a %s" % [room.id, Rules.KIND_NAME[int(kind)]])
		var planner = Planner.new(room)
		for piece in room.initial:
			check(planner.pickup(int(piece.x), int(piece.y)), "room %d picks up its starting piece" % room.id)
		for piece in room.solution:
			check(planner.place(int(piece.kind), int(piece.x), int(piece.y), int(piece.dir)), "room %d places its solution from the tray" % room.id)
		var spare := _spare_cell(room)
		check(spare.x >= 0, "room %d has an empty cell for an extra piece" % room.id)
		check(not planner.place(Rules.Kind.BELT, spare.x, spare.y, Rules.Dir.EAST), "room %d rejects a belt past the tray" % room.id)
		var extra: Array = room.solution.duplicate(true)
		extra.append(Rooms.piece(Rules.Kind.BELT, spare.x, spare.y, Rules.Dir.EAST))
		var over: Dictionary = World.simulate(room, extra)
		check(over.quota_ok and not over.budget_ok and not over.success, "room %d extra belt meets the quota and is rejected (%s)" % [room.id, over.text])
	var ore: Dictionary = Rooms.all()[200]
	var smelted: Dictionary = World.simulate(ore, ore.solution)
	check(int(smelted.counts[Rules.Mat.INGOT]) == 29 and int(smelted.counts[Rules.Mat.PLATE]) == 30, "right ore feeds the kiln and the plate bin (%s)" % smelted.text)
	var ore_landside: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.CLEVIS, Rules.Kind.LANDSIDE))
	var ore_heel: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.CLEVIS, Rules.Kind.HEEL))
	var ore_slade: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.CLEVIS, Rules.Kind.SLADE))
	var ore_stilt: Dictionary = World.simulate(ore, _swap_kind(ore.solution, Rules.Kind.CLEVIS, Rules.Kind.STILT))
	check(int(ore_landside.counts[Rules.Mat.INGOT]) == 0 and int(ore_landside.counts[Rules.Mat.PLATE]) == 0, "right ore's landside refuses the right arrival (%s)" % ore_landside.text)
	check(int(ore_heel.counts[Rules.Mat.INGOT]) == 0 and int(ore_heel.counts[Rules.Mat.PLATE]) == 0, "right ore's heel refuses the right arrival (%s)" % ore_heel.text)
	check(int(ore_slade.counts[Rules.Mat.INGOT]) == 0 and int(ore_slade.counts[Rules.Mat.PLATE]) == 0, "right ore's slade refuses the right arrival (%s)" % ore_slade.text)
	check(int(ore_stilt.counts[Rules.Mat.INGOT]) == 0 and int(ore_stilt.counts[Rules.Mat.PLATE]) == 0, "right ore's stilt refuses the right arrival (%s)" % ore_stilt.text)
	var still: Dictionary = Rooms.all()[201]
	var stilled: Dictionary = World.simulate(still, still.solution)
	check(int(still.budget[Rules.Kind.BELT]) == 1, "still clevis budgets one belt")
	var still_belts := 0
	var still_south := false
	for piece in still.solution:
		if int(piece.kind) == Rules.Kind.BELT:
			still_belts += 1
			check(int(piece.x) == 3 and int(piece.y) == 3, "still clevis's belt is on the crossing")
		if int(piece.kind) == Rules.Kind.CLEVIS:
			still_south = int(piece.dir) == Rules.Dir.SOUTH
	check(still_belts == 1, "still clevis places that one belt")
	check(still_south, "still clevis faces south")
	check(int(stilled.counts[Rules.Mat.INGOT]) == 29 and int(stilled.counts[Rules.Mat.PLATE]) == 30 and int(stilled.discarded) > 0, "still clevis leaves the scrap pit and counts both exits (%s discarded %d)" % [stilled.text, stilled.discarded])
	var still_heel: Dictionary = World.simulate(still, _swap_kind(still.solution, Rules.Kind.CLEVIS, Rules.Kind.HEEL))
	var still_stilt: Dictionary = World.simulate(still, _swap_kind(still.solution, Rules.Kind.CLEVIS, Rules.Kind.STILT))
	check(int(still_heel.counts[Rules.Mat.INGOT]) == 0 and int(still_heel.counts[Rules.Mat.PLATE]) == 0, "still clevis's heel refuses the right arrival (%s)" % still_heel.text)
	check(int(still_stilt.counts[Rules.Mat.INGOT]) == 0, "still clevis's stilt refuses the right arrival (%s)" % still_stilt.text)
	var seat: Dictionary = Rooms.all()[202]
	var parked: Array = []
	for piece in seat.solution:
		if int(piece.kind) != Rules.Kind.CLEVIS:
			parked.append(piece)
	parked.append(Rooms.piece(Rules.Kind.CLEVIS, 5, 2, Rules.Dir.EAST))
	var gap: Dictionary = World.simulate(seat, parked)
	check(World.budget_met(parked, seat.budget), "leaving the seat clevis parked stays inside the tray")
	check(not gap.quota_ok, "a parked clevis misses the seat (%s)" % gap.text)
	var seated: Dictionary = World.simulate(seat, seat.solution)
	check(int(seated.counts[Rules.Mat.INGOT]) == 29 and int(seated.counts[Rules.Mat.PLATE]) == 30, "seating the clevis clears the seat (%s)" % seated.text)
	var corner: Dictionary = Rooms.all()[203]
	var cornered: Dictionary = World.simulate(corner, corner.solution)
	check(int(cornered.counts[Rules.Mat.INGOT]) == 59 and int(cornered.counts[Rules.Mat.PLATE]) == 60, "split corner counts both exits (%s)" % cornered.text)
	var stocks: Dictionary = Rooms.all()[204]
	var stocked: Dictionary = World.simulate(stocks, stocks.solution)
	check(int(stocked.counts[Rules.Mat.INGOT]) == 118 and int(stocked.counts[Rules.Mat.PLATE]) == 120, "two stocks counts both lanes (%s)" % stocked.text)
	var scrap: Dictionary = Rooms.all()[205]
	var scraped: Dictionary = World.simulate(scrap, scrap.solution)
	var scrap_south := false
	for piece in scrap.solution:
		if int(piece.kind) == Rules.Kind.CLEVIS:
			scrap_south = int(piece.dir) == Rules.Dir.SOUTH
	check(scrap_south, "after the split's clevis faces south")
	check(int(scraped.counts[Rules.Mat.INGOT]) == 29 and int(scraped.counts[Rules.Mat.PLATE]) == 30 and int(scraped.discarded) > 0, "after the split counts both exits and discards the scrap (%s discarded %d)" % [scraped.text, scraped.discarded])
	var bin: Dictionary = Rooms.all()[206]
	var solved: Dictionary = World.simulate(bin, bin.solution)
	check(int(solved.counts[Rules.Mat.INGOT]) == 29 and int(solved.counts[Rules.Mat.PLATE]) == 104, "split bin hits both quotas (%s)" % solved.text)
	check(solved.world.machines[Vector2i(2, 1)].hold < 0, "split bin's clevis is empty after the pairs")
	var plates_only: Dictionary = World.simulate(bin, [
		Rooms.piece(Rules.Kind.BELT, 1, 3, Rules.Dir.EAST),
	])
	check(int(plates_only.counts[Rules.Mat.INGOT]) == 0 and int(plates_only.counts[Rules.Mat.PLATE]) < int(bin.quota[Rules.Mat.PLATE]), "split bin's lower plates alone miss (%s)" % plates_only.text)
	var pressed: Dictionary = World.simulate(bin, [
		Rooms.piece(Rules.Kind.CLEVIS, 2, 1, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.KILN, 3, 1, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.PRESS, 4, 1, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.BELT, 1, 3, Rules.Dir.EAST),
	])
	check(int(pressed.counts[Rules.Mat.INGOT]) == 0 and not pressed.success, "pressing every ingot misses the split bin (%s)" % pressed.text)
	for kind in [Rules.Kind.LANDSIDE, Rules.Kind.MOLDBOARD, Rules.Kind.COULTER, Rules.Kind.SHARE, Rules.Kind.FORK, Rules.Kind.PRONG, Rules.Kind.SLADE, Rules.Kind.HEEL, Rules.Kind.STILT]:
		var missed: Dictionary = World.simulate(bin, _swap_kind(bin.solution, Rules.Kind.CLEVIS, int(kind)))
		var misses_one: bool = int(missed.counts[Rules.Mat.INGOT]) < int(bin.quota[Rules.Mat.INGOT]) or int(missed.counts[Rules.Mat.PLATE]) < int(bin.quota[Rules.Mat.PLATE])
		check(misses_one, "%s in place of the split-bin clevis misses at least one quota (%s)" % [Rules.KIND_NAME[int(kind)], missed.text])
	var held_room: Dictionary = Rooms.all()[207]
	var waiting: Dictionary = World.simulate(held_room, held_room.solution, 2)
	var leaving: Dictionary = World.simulate(held_room, held_room.solution, 3)
	var finished: Dictionary = World.simulate(held_room, held_room.solution)
	var belt_early: Dictionary = World.simulate(held_room, _swap_kind(held_room.solution, Rules.Kind.CLEVIS, Rules.Kind.BELT), 2)
	var held_slip: Dictionary = World.simulate(held_room, _swap_kind(held_room.solution, Rules.Kind.CLEVIS, Rules.Kind.SLIP))
	var held_stilt: Dictionary = World.simulate(held_room, _swap_kind(held_room.solution, Rules.Kind.CLEVIS, Rules.Kind.STILT))
	check(waiting.world.machines[Vector2i(3, 1)].hold == Rules.Mat.ORE and waiting.trace.is_empty(), "held pair keeps the first ore through the empty tick")
	check(leaving.world.machines[Vector2i(3, 1)].hold < 0, "held pair leaves on the arrival tick and the cell is empty")
	check(belt_early.world.machines[Vector2i(3, 1)].hold < 0 and belt_early.world.machines[Vector2i(4, 1)].hold == Rules.Mat.ORE, "a belt would have moved the first item on that tick")
	check(int(finished.counts[Rules.Mat.INGOT]) == 29 and int(finished.counts[Rules.Mat.PLATE]) == 30, "held pair feeds the kiln and the plate bin (%s)" % finished.text)
	check(int(held_slip.counts[Rules.Mat.INGOT]) == 0, "held pair's slip keeps the ore (%s)" % held_slip.text)
	check(int(held_stilt.counts[Rules.Mat.INGOT]) == 0 and int(held_stilt.counts[Rules.Mat.PLATE]) == 0, "held pair's stilt refuses the right arrival (%s)" % held_stilt.text)



