func _test_wing53_lessons() -> void:
	var wrong_kinds := [
		Rules.Kind.BELT, Rules.Kind.DWELL, Rules.Kind.TWIN, Rules.Kind.PASS, Rules.Kind.SLIP,
		Rules.Kind.SHED, Rules.Kind.HOOK, Rules.Kind.RAKE, Rules.Kind.HOE, Rules.Kind.HARROW,
		Rules.Kind.FLATTER, Rules.Kind.PUNCH, Rules.Kind.THROAT, Rules.Kind.FULLER, Rules.Kind.DRIFT,
		Rules.Kind.SWAGE, Rules.Kind.HARDIE, Rules.Kind.GAUGE, Rules.Kind.TRASHBOARD, Rules.Kind.BRIDLE,
		Rules.Kind.JOINTER, Rules.Kind.WREST, Rules.Kind.SHIN, Rules.Kind.FROG, Rules.Kind.SOLE,
		Rules.Kind.HAKE, Rules.Kind.BEAM, Rules.Kind.CLEVIS, Rules.Kind.STILT, Rules.Kind.HEEL,
		Rules.Kind.SLADE, Rules.Kind.LANDSIDE, Rules.Kind.MOLDBOARD, Rules.Kind.COULTER, Rules.Kind.SHARE,
		Rules.Kind.FORK, Rules.Kind.PRONG, Rules.Kind.SETT, Rules.Kind.BOLSTER, Rules.Kind.SNAP,
		Rules.Kind.ANVIL, Rules.Kind.SLEDGE, Rules.Kind.BREAST, Rules.Kind.BICK, Rules.Kind.PRITCHEL,
	]
	for index in range(416, 424):
		var room: Dictionary = Rooms.all()[index]
		var solved: Dictionary = World.simulate(room, room.solution)
		check(solved.quota_ok and solved.error == "", "room %d mandrel clears (%s)" % [room.id, solved.text])
		for kind in wrong_kinds:
			var missed: Dictionary = World.simulate(room, _swap_kind(room.solution, Rules.Kind.MANDREL, kind))
			check(not missed.quota_ok, "%s misses room %d (%s)" % [Rules.KIND_NAME[kind], room.id, missed.text])
	var still: Dictionary = Rooms.all()[417]
	var belt_still: Dictionary = World.simulate(still, _swap_kind(still.solution, Rules.Kind.MANDREL, Rules.Kind.BELT), 2)
	check(belt_still.world.machines[Vector2i(5, 1)].hold < 0 and int(belt_still.world.sources[0].pending) == Rules.Mat.ORE, "still mandrel's belt leaves the first ore on the source")
	var seat: Dictionary = Rooms.all()[418]
	var parked := []
	for piece in seat.solution:
		if int(piece.kind) != Rules.Kind.MANDREL:
			parked.append(piece)
	parked.append(Rooms.piece(Rules.Kind.MANDREL, 5, 0, Rules.Dir.EAST))
	var left: Dictionary = World.simulate(seat, parked)
	check(not left.quota_ok, "leaving the seat mandrel parked misses (%s)" % left.text)
	var gate: Dictionary = Rooms.all()[419]
	var gate_run: Dictionary = World.simulate(gate, gate.solution)
	check(int(gate_run.counts[Rules.Mat.INGOT]) == 59 and int(gate_run.counts[Rules.Mat.PLATE]) == 60, "mandrel gate is the one-tick pair (%s)" % gate_run.text)
	var two: Dictionary = Rooms.all()[420]
	var one := []
	for piece in two.solution:
		if int(piece.x) == 1:
			one.append(piece)
	var lane: Dictionary = World.simulate(two, one)
	check(int(lane.counts[Rules.Mat.INGOT]) == 59 and int(lane.counts[Rules.Mat.PLATE]) == 60 and not lane.success, "one mandrel lane is half of two mandrels (%s)" % lane.text)
	var scrap: Dictionary = Rooms.all()[421]
	var scrap_run: Dictionary = World.simulate(scrap, scrap.solution)
	check(int(scrap_run.discarded) > 0 and int(scrap_run.counts[Rules.Mat.INGOT]) == 29 and int(scrap_run.counts[Rules.Mat.PLATE]) == 30, "mandrel scrap discards the extra stream (%s)" % scrap_run.text)
	var bin: Dictionary = Rooms.all()[422]
	var lower := []
	for piece in bin.solution:
		if int(piece.x) != 3 or int(piece.y) != 4:
			lower.append(piece)
	var stream: Dictionary = World.simulate(bin, lower)
	check(int(stream.counts[Rules.Mat.INGOT]) == 0 and int(stream.counts[Rules.Mat.PLATE]) == 30 and not stream.success, "the lower stream is not the mandrel bin quota (%s)" % stream.text)
	var pressed: Dictionary = World.simulate(bin, [
		Rooms.piece(Rules.Kind.MANDREL, 3, 4, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.KILN, 3, 2, Rules.Dir.NORTH),
		Rooms.piece(Rules.Kind.BELT, 3, 1, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.BELT, 4, 1, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.PRESS, 5, 1, Rules.Dir.EAST),
		Rooms.piece(Rules.Kind.BELT, 1, 5, Rules.Dir.EAST),
	])
	check(int(pressed.counts[Rules.Mat.INGOT]) == 0 and not pressed.success, "pressing every ingot misses the mandrel bin (%s)" % pressed.text)
	var held_room: Dictionary = Rooms.all()[423]
	var waiting: Dictionary = World.simulate(held_room, held_room.solution, 2)
	var leaving: Dictionary = World.simulate(held_room, held_room.solution, 3)
	var finished: Dictionary = World.simulate(held_room, held_room.solution)
	var belt_early: Dictionary = World.simulate(held_room, _swap_kind(held_room.solution, Rules.Kind.MANDREL, Rules.Kind.BELT), 2)
	var held_pritchel: Dictionary = World.simulate(held_room, _swap_kind(held_room.solution, Rules.Kind.MANDREL, Rules.Kind.PRITCHEL))
	var held_bick: Dictionary = World.simulate(held_room, _swap_kind(held_room.solution, Rules.Kind.MANDREL, Rules.Kind.BICK))
	var held_sledge: Dictionary = World.simulate(held_room, _swap_kind(held_room.solution, Rules.Kind.MANDREL, Rules.Kind.SLEDGE))
	var held_breast: Dictionary = World.simulate(held_room, _swap_kind(held_room.solution, Rules.Kind.MANDREL, Rules.Kind.BREAST))
	check(waiting.world.machines[Vector2i(4, 4)].hold == Rules.Mat.ORE and waiting.trace.is_empty(), "mandrel hold keeps the first ore through the empty tick")
	check(leaving.world.machines[Vector2i(4, 4)].hold < 0 and _trace(leaving) == "3:4,5:2", "mandrel hold leaves on the arrival tick and the cell is empty, got %s" % _trace(leaving))
	check(belt_early.world.machines[Vector2i(4, 2)].hold < 0 and int(belt_early.world.sources[0].pending) == Rules.Mat.ORE, "a belt refuses the ahead arrival, so the first ore stays on the source")
	check(int(finished.counts[Rules.Mat.INGOT]) == 29 and int(finished.counts[Rules.Mat.PLATE]) == 30, "mandrel hold feeds the kiln and the plate bin (%s)" % finished.text)
	check(not held_pritchel.quota_ok, "mandrel hold's pritchel misses because the ore goes right onto the plate bin (%s)" % held_pritchel.text)
	check(not held_bick.quota_ok, "mandrel hold's bick misses because the ore goes behind into the wall (%s)" % held_bick.text)
	check(not held_sledge.quota_ok, "mandrel hold's sledge misses because the ore goes behind into the wall (%s)" % held_sledge.text)
	check(not held_breast.quota_ok, "mandrel hold's breast misses because the ore goes behind into the wall (%s)" % held_breast.text)
