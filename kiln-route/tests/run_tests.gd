	var corner_prong: Dictionary = World.simulate(corner, _swap_kind(corner.solution, Rules.Kind.COULTER, Rules.Kind.PRONG))
	var corner_rake: Dictionary = World.simulate(corner, _swap_kind(corner.solution, Rules.Kind.COULTER, Rules.Kind.RAKE))
	var corner_shed: Dictionary = World.simulate(corner, _swap_kind(corner.solution, Rules.Kind.COULTER, Rules.Kind.SHED))
