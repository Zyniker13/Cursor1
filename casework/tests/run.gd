	for exhibit in Haunch.EXHIBITS:
		_expect(Haunch.holds(exhibit, model), "%s rejects the haunch timeline" % exhibit["id"])


func _test_haunch_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Haunch.EXHIBITS, Haunch)
	for exhibit in Haunch.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Haunch.without(exhibit_id), Haunch)
		print("haunch without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "haunch %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Haunch.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "haunch %s removal did not admit a timeline it forbids" % exhibit_id)


