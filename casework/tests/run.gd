func _player_pin_counts(book) -> Dictionary:
	var counts := {"taker": 0, "place": 0, "hour": 0}
	for exhibit in book.EXHIBITS:
		for literal in exhibit["literals"]:
			var field := str(literal["field"])
			if counts.has(field):
				counts[field] = int(counts[field]) + 1
	return counts


