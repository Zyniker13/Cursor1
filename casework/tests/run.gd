	_expect(str(model["snib_room"]) == "scratch", "quirk snib room")
	_expect(str(model["astragal_room"]) == "veiner", "quirk astragal room")
	_expect(str(model["oil_hour"]) == "136", "quirk oil hour")
	_expect(str(model["stone_hour"]) == "139", "quirk stone hour")
	_expect(str(model["hang_hour"]) == "140", "quirk hang hour")
	for hour in Quirk.HOURS:
		var used := false
