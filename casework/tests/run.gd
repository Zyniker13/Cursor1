func _test_gutta_unique_model() -> void:
	var models := Solver.enumerate(Gutta.EXHIBITS, Gutta)
	print("gutta models: %d" % models.size())
	_expect(models.size() == 1, "expected exactly one gutta model, found %d" % models.size())
	if models.is_empty():
		return
	var model: Dictionary = models[0]
	_expect(str(model["taker"]) == "Ingrid", "gutta taker")
	_expect(str(model["place"]) == "apse", "gutta place")
	_expect(str(model["hour"]) == "198", "gutta hour")
	_expect(str(model["linden"]) == "Tove", "gutta linden hand")
	_expect(str(model["linden_room"]) == "fid", "gutta linden room")
	_expect(str(model["linden_hour"]) == "197", "gutta linden hour")
	_expect(str(model["seen_from"]) == "perch", "gutta seen from")
	_expect(str(model["perch"]) == "Remy", "gutta perch")
	_expect(str(model["aim"]) == "take_linden", "gutta aim")
	_expect(str(model["perch_room"]) == "apse", "gutta perch room")
	_expect(str(model["aspen_room"]) == "fid", "gutta aspen room")
	_expect(str(model["rosin_hour"]) == "196", "gutta rosin hour")
	_expect(str(model["stain_hour"]) == "199", "gutta stain hour")
	_expect(str(model["hang_hour"]) == "200", "gutta hang hour")
	for hour in Gutta.HOURS:
		var used := false
		for field in Gutta.fields():
			if str(model[field]) == hour:
				used = true
		_expect(used, "gutta hour %s is blank in the true timeline" % hour)
	for place in Gutta.PLACES:
		var place_used := false
		for field in Gutta.fields():
			if str(model[field]) == place:
				place_used = true
		_expect(place_used, "gutta room %s is blank in the true timeline" % place)
	for person in Gutta.PEOPLE:
		var person_used := false
		for field in Gutta.fields():
			if str(model[field]) == person:
				person_used = true
		_expect(person_used, "gutta person %s is blank in the true timeline" % person)
	_expect(Gutta.timeline(model) == GUTTA_TIMELINE, "gutta timeline drifted:\n%s" % Gutta.timeline(model))
	for exhibit in Gutta.EXHIBITS:
		_expect(Gutta.holds(exhibit, model), "%s rejects the gutta timeline" % exhibit["id"])


func _test_gutta_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Gutta.EXHIBITS, Gutta)
	for exhibit in Gutta.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Gutta.without(exhibit_id), Gutta)
		print("gutta without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "gutta %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Gutta.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "gutta %s removal did not admit a timeline it forbids" % exhibit_id)


