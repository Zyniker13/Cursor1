func _test_triglyph_unique_model() -> void:
	var models := Solver.enumerate(Triglyph.EXHIBITS, Triglyph)
	print("triglyph models: %d" % models.size())
	_expect(models.size() == 1, "expected exactly one triglyph model, found %d" % models.size())
	if models.is_empty():
		return
	var model: Dictionary = models[0]
	_expect(str(model["taker"]) == "Osric", "triglyph taker")
	_expect(str(model["place"]) == "retrochoir", "triglyph place")
	_expect(str(model["hour"]) == "243", "triglyph hour")
	_expect(str(model["teak"]) == "Wulfrun", "triglyph teak hand")
	_expect(str(model["teak_room"]) == "lozenge", "triglyph teak room")
	_expect(str(model["teak_hour"]) == "242", "triglyph teak hour")
	_expect(str(model["seen_from"]) == "refectory", "triglyph seen from")
	_expect(str(model["refectory"]) == "Aethelthryth", "triglyph refectory")
	_expect(str(model["aim"]) == "take_teak", "triglyph aim")
	_expect(str(model["refectory_room"]) == "retrochoir", "triglyph refectory room")
	_expect(str(model["iroko_room"]) == "lozenge", "triglyph iroko room")
	_expect(str(model["smalt_hour"]) == "241", "triglyph smalt hour")
	_expect(str(model["storax_hour"]) == "244", "triglyph storax hour")
	_expect(str(model["hang_hour"]) == "245", "triglyph hang hour")
	for hour in Triglyph.HOURS:
		var used := false
		for field in Triglyph.fields():
			if str(model[field]) == hour:
				used = true
		_expect(used, "triglyph hour %s is blank in the true timeline" % hour)
	for place in Triglyph.PLACES:
		var place_used := false
		for field in Triglyph.fields():
			if str(model[field]) == place:
				place_used = true
		_expect(place_used, "triglyph room %s is blank in the true timeline" % place)
	for person in Triglyph.PEOPLE:
		var person_used := false
		for field in Triglyph.fields():
			if str(model[field]) == person:
				person_used = true
		_expect(person_used, "triglyph person %s is blank in the true timeline" % person)
	_expect(Triglyph.timeline(model) == TRIGLYPH_TIMELINE, "triglyph timeline drifted:\n%s" % Triglyph.timeline(model))
	for exhibit in Triglyph.EXHIBITS:
		_expect(Triglyph.holds(exhibit, model), "%s rejects the triglyph timeline" % exhibit["id"])


func _test_triglyph_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Triglyph.EXHIBITS, Triglyph)
	for exhibit in Triglyph.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Triglyph.without(exhibit_id), Triglyph)
		print("triglyph without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "triglyph %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Triglyph.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "triglyph %s removal did not admit a timeline it forbids" % exhibit_id)


