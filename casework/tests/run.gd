		_expect(message.to_lower().find("wrong") == -1, "trochilus incomplete message says wrong: %s" % message)
		_expect(message.to_lower().find("conflict") == -1, "trochilus incomplete message talks about a conflict: %s" % message)
		_expect(_cited_ids(message).is_empty(), "trochilus incomplete message cites exhibits: %s" % message)
		for phrase in case_row["present"]:
			_expect(message.find(phrase) >= 0, "trochilus missing slot not named (%s) in: %s" % [phrase, message])
		for phrase in case_row["absent"]:
			_expect(message.find(phrase) == -1, "trochilus named a filled slot (%s) in: %s" % [phrase, message])
		for phrase in other_slots:
			_expect(message.find(phrase) == -1, "trochilus incomplete used another file's slot (%s) in: %s" % [phrase, message])
	print("trochilus incomplete submissions refused with the missing slot")

