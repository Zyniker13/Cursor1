func _test_finger_near_misses() -> void:
	var misses := [
		{"who": "Clem", "place": "pad", "hour": "119", "titles": ["Finger leaf", "Finger note", "Rub order"]},
		{"who": "Clem", "place": "pad", "hour": "117", "titles": ["Finger leaf", "Finger note", "Rub order"]},
		{"who": "Clem", "place": "badger", "hour": "118", "titles": ["Face slate", "Catch card", "Sheen slip"]},
		{"who": "Gale", "place": "pad", "hour": "118", "titles": ["Socket chit", "Burr sight", "Chip bill"]},
	]
	var wrong_hour_in_pad := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_pad := 0
	for theory in misses:
		_expect_rejected(theory, Finger)
		var result: Dictionary = Verdict.submit(theory, Finger)
		var message := str(result["message"])
		_expect(Finger.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Finger.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Clem" and str(theory["place"]) == "pad" and str(theory["hour"]) != "118":
			wrong_hour_in_pad += 1
		if str(theory["who"]) == "Clem" and str(theory["place"]) != "pad" and str(theory["hour"]) == "118":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Clem" and str(theory["place"]) == "pad" and str(theory["hour"]) == "118":
			wrong_person_in_pad += 1
	print("finger near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four finger near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_pad == 2, "two near-misses should keep Clem in the pad at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Clem at 118 in another room")
	_expect(wrong_person_in_pad >= 1, "a near-miss should keep the pad at 118 for another person")

