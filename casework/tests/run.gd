func _test_trochilus_unique_model() -> void:
	var models := Solver.enumerate(Trochilus.EXHIBITS, Trochilus)
	print("trochilus models: %d" % models.size())
	_expect(models.size() == 1, "expected exactly one trochilus model, found %d" % models.size())
	if models.is_empty():
		return
	var model: Dictionary = models[0]
	_expect(str(model["taker"]) == "Colin", "trochilus taker")
	_expect(str(model["place"]) == "ambulatory", "trochilus place")
	_expect(str(model["hour"]) == "223", "trochilus hour")
	_expect(str(model["applewood"]) == "Lars", "trochilus applewood hand")
	_expect(str(model["applewood_room"]) == "burin", "trochilus applewood room")
	_expect(str(model["applewood_hour"]) == "222", "trochilus applewood hour")
	_expect(str(model["seen_from"]) == "oratory", "trochilus seen from")
	_expect(str(model["oratory"]) == "Ines", "trochilus oratory")
	_expect(str(model["aim"]) == "take_applewood", "trochilus aim")
	_expect(str(model["oratory_room"]) == "ambulatory", "trochilus oratory room")
	_expect(str(model["laburnum_room"]) == "burin", "trochilus laburnum room")
	_expect(str(model["amber_hour"]) == "221", "trochilus amber hour")
	_expect(str(model["copal_hour"]) == "224", "trochilus copal hour")
	_expect(str(model["hang_hour"]) == "225", "trochilus hang hour")
	for hour in Trochilus.HOURS:
		var used := false
		for field in Trochilus.fields():
			if str(model[field]) == hour:
				used = true
		_expect(used, "trochilus hour %s is blank in the true timeline" % hour)
	for place in Trochilus.PLACES:
		var place_used := false
		for field in Trochilus.fields():
			if str(model[field]) == place:
				place_used = true
		_expect(place_used, "trochilus room %s is blank in the true timeline" % place)
	for person in Trochilus.PEOPLE:
		var person_used := false
		for field in Trochilus.fields():
			if str(model[field]) == person:
				person_used = true
		_expect(person_used, "trochilus person %s is blank in the true timeline" % person)
	_expect(Trochilus.timeline(model) == TROCHILUS_TIMELINE, "trochilus timeline drifted:\n%s" % Trochilus.timeline(model))
	for exhibit in Trochilus.EXHIBITS:
		_expect(Trochilus.holds(exhibit, model), "%s rejects the trochilus timeline" % exhibit["id"])


func _test_trochilus_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Trochilus.EXHIBITS, Trochilus)
	for exhibit in Trochilus.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Trochilus.without(exhibit_id), Trochilus)
		print("trochilus without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "trochilus %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Trochilus.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "trochilus %s removal did not admit a timeline it forbids" % exhibit_id)


