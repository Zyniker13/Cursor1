func _test_taenia_near_misses() -> void:
	var misses := [
		{"who": "Elsie", "place": "cloister", "hour": "214", "titles": ["Taenia leaf", "Aglet note", "Anointed order"]},
		{"who": "Elsie", "place": "cloister", "hour": "212", "titles": ["Taenia leaf", "Aglet note", "Anointed order"]},
		{"who": "Elsie", "place": "vestry", "hour": "213", "titles": ["Alizarin slate", "Vestry card", "Smeared slip"]},
		{"who": "Stig", "place": "cloister", "hour": "213", "titles": ["Acacia chit", "Shikonin sight", "Sorb bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Taenia)
		var result: Dictionary = Verdict.submit(theory, Taenia)
		var message := str(result["message"])
		_expect(Taenia.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Taenia.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Elsie" and str(theory["place"]) == "cloister" and str(theory["hour"]) != "213":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Elsie" and str(theory["place"]) != "cloister" and str(theory["hour"]) == "213":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Elsie" and str(theory["place"]) == "cloister" and str(theory["hour"]) == "213":
			wrong_person_in_bit += 1
	print("taenia near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four taenia near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Elsie in the cloister at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Elsie at 213 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the cloister at 213 for another person")

