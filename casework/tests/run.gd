func _test_bellcast_unique_model() -> void:
	var models := Solver.enumerate(Bellcast.EXHIBITS, Bellcast)
	print("bellcast models: %d" % models.size())
	_expect(models.size() == 1, "expected exactly one bellcast model, found %d" % models.size())
	if models.is_empty():
		return
	var model: Dictionary = models[0]
	_expect(str(model["taker"]) == "Cuthbert", "bellcast taker")
	_expect(str(model["place"]) == "triforium", "bellcast place")
	_expect(str(model["hour"]) == "233", "bellcast hour")
	_expect(str(model["hickory"]) == "Wulfstan", "bellcast hickory hand")
	_expect(str(model["hickory_room"]) == "elliptic", "bellcast hickory room")
	_expect(str(model["hickory_hour"]) == "232", "bellcast hickory hour")
	_expect(str(model["seen_from"]) == "calefactory", "bellcast seen from")
	_expect(str(model["calefactory"]) == "Frideswide", "bellcast calefactory")
	_expect(str(model["aim"]) == "take_hickory", "bellcast aim")
	_expect(str(model["calefactory_room"]) == "triforium", "bellcast calefactory room")
	_expect(str(model["paulownia_room"]) == "elliptic", "bellcast paulownia room")
	_expect(str(model["orpiment_hour"]) == "231", "bellcast orpiment hour")
	_expect(str(model["cinnabar_hour"]) == "234", "bellcast cinnabar hour")
	_expect(str(model["hang_hour"]) == "235", "bellcast hang hour")
	for hour in Bellcast.HOURS:
		var used := false
		for field in Bellcast.fields():
			if str(model[field]) == hour:
				used = true
		_expect(used, "bellcast hour %s is blank in the true timeline" % hour)
	for place in Bellcast.PLACES:
		var place_used := false
		for field in Bellcast.fields():
			if str(model[field]) == place:
				place_used = true
		_expect(place_used, "bellcast room %s is blank in the true timeline" % place)
	for person in Bellcast.PEOPLE:
		var person_used := false
		for field in Bellcast.fields():
			if str(model[field]) == person:
				person_used = true
		_expect(person_used, "bellcast person %s is blank in the true timeline" % person)
	_expect(Bellcast.timeline(model) == BELLCAST_TIMELINE, "bellcast timeline drifted:\n%s" % Bellcast.timeline(model))
	for exhibit in Bellcast.EXHIBITS:
		_expect(Bellcast.holds(exhibit, model), "%s rejects the bellcast timeline" % exhibit["id"])


func _test_bellcast_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Bellcast.EXHIBITS, Bellcast)
	for exhibit in Bellcast.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Bellcast.without(exhibit_id), Bellcast)
		print("bellcast without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "bellcast %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Bellcast.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "bellcast %s removal did not admit a timeline it forbids" % exhibit_id)


