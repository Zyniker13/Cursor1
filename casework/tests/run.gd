func _test_quirk_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Quirk.EXHIBITS, Quirk)
	for exhibit in Quirk.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Quirk.without(exhibit_id), Quirk)
