func _test_bowtell_near_misses() -> void:
	var misses := [
		{"who": "Siward", "place": "chevet", "hour": "254", "titles": ["Bowtell leaf", "Sling note", "Vetivered order"]},
		{"who": "Siward", "place": "chevet", "hour": "252", "titles": ["Bowtell leaf", "Sling note", "Vetivered order"]},
		{"who": "Siward", "place": "locutory", "hour": "253", "titles": ["Azurite slate", "Locutory card", "Ylanged slip"]},
		{"who": "Gytha", "place": "chevet", "hour": "253", "titles": ["Myrtle chit", "Carmine sight", "Osage bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Bowtell)
		var result: Dictionary = Verdict.submit(theory, Bowtell)
		var message := str(result["message"])
		_expect(Bowtell.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Bowtell.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Siward" and str(theory["place"]) == "chevet" and str(theory["hour"]) != "253":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Siward" and str(theory["place"]) != "chevet" and str(theory["hour"]) == "253":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Siward" and str(theory["place"]) == "chevet" and str(theory["hour"]) == "253":
			wrong_person_in_bit += 1
	print("bowtell near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four bowtell near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Siward in the chevet at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Siward at 253 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the chevet at 253 for another person")

