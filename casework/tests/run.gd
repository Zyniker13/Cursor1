		_expect_rejected({"who": outsider, "place": "drawknife", "hour": "113"}, Scarf)
	print("scarf theories accepted: %d rejected: %d" % [accepted, rejected])
	_expect(accepted == 1, "accepted %d scarf theories" % accepted)
