					_expect(str(result["message"]).find("Faye (dowel hand) cut the dowel in the bit at 128") >= 0, "dowel acceptance omits the cutting")
					_expect(Dowel.conflicting_ids(theory).is_empty(), "true dowel theory conflicts with an exhibit")
					accepted += 1
				else:
					_expect_rejected(theory, Dowel)
					_expect(Dowel.conflicting_ids(theory).size() >= 2, "%s / %s / %s contradicts fewer than two exhibits" % [who, place, hour])
