func _test_haunch_unique_model() -> void:
	var models := Solver.enumerate(Haunch.EXHIBITS, Haunch)
	print("haunch models: %d" % models.size())
	_expect(models.size() == 1, "expected exactly one haunch model, found %d" % models.size())
