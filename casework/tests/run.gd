func _test_listel_unique_model() -> void:
	var models := Solver.enumerate(Listel.EXHIBITS, Listel)
	print("listel models: %d" % models.size())
	_expect(models.size() == 1, "expected exactly one listel model, found %d" % models.size())
	if models.is_empty():
		return
	var model: Dictionary = models[0]
	_expect(str(model["taker"]) == "Giles", "listel taker")
	_expect(str(model["place"]) == "plinth", "listel place")
	_expect(str(model["hour"]) == "178", "listel hour")
	_expect(str(model["alder"]) == "Nora", "listel alder hand")
	_expect(str(model["alder_room"]) == "template", "listel alder room")
	_expect(str(model["alder_hour"]) == "177", "listel alder hour")
	_expect(str(model["seen_from"]) == "trammel", "listel seen from")
	_expect(str(model["trammel"]) == "Ellis", "listel trammel")
	_expect(str(model["aim"]) == "take_alder", "listel aim")
	_expect(str(model["trammel_room"]) == "plinth", "listel trammel room")
	_expect(str(model["quince_room"]) == "template", "listel quince room")
	_expect(str(model["plate_hour"]) == "176", "listel plate hour")
	_expect(str(model["dope_hour"]) == "179", "listel dope hour")
	_expect(str(model["hang_hour"]) == "180", "listel hang hour")
	for hour in Listel.HOURS:
		var used := false
		for field in Listel.fields():
			if str(model[field]) == hour:
				used = true
		_expect(used, "listel hour %s is blank in the true timeline" % hour)
	for place in Listel.PLACES:
		var place_used := false
		for field in Listel.fields():
			if str(model[field]) == place:
				place_used = true
		_expect(place_used, "listel room %s is blank in the true timeline" % place)
	for person in Listel.PEOPLE:
		var person_used := false
		for field in Listel.fields():
			if str(model[field]) == person:
				person_used = true
		_expect(person_used, "listel person %s is blank in the true timeline" % person)
	_expect(Listel.timeline(model) == LISTEL_TIMELINE, "listel timeline drifted:\n%s" % Listel.timeline(model))
	for exhibit in Listel.EXHIBITS:
		_expect(Listel.holds(exhibit, model), "%s rejects the listel timeline" % exhibit["id"])


func _test_listel_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Listel.EXHIBITS, Listel)
	for exhibit in Listel.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Listel.without(exhibit_id), Listel)
		print("listel without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "listel %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Listel.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "listel %s removal did not admit a timeline it forbids" % exhibit_id)


