		_expect_rejected({"who": outsider, "place": "bit", "hour": "128"}, Dowel)
	print("dowel theories accepted: %d rejected: %d" % [accepted, rejected])
	_expect(accepted == 1, "accepted %d dowel theories" % accepted)
	_expect(rejected >= 2, "rejected %d dowel theories" % rejected)


func _test_dowel_near_misses() -> void:
	var misses := [
		{"who": "Faye", "place": "bit", "hour": "129", "titles": ["Dowel leaf", "Dowel note", "Hone order"]},
		{"who": "Faye", "place": "bit", "hour": "127", "titles": ["Dowel leaf", "Dowel note", "Hone order"]},
		{"who": "Faye", "place": "auger", "hour": "128", "titles": ["Flute slate", "Chuck card", "Wax slip"]},
		{"who": "Kerr", "place": "bit", "hour": "128", "titles": ["Bore chit", "Point sight", "Curl bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Dowel)
		var result: Dictionary = Verdict.submit(theory, Dowel)
		var message := str(result["message"])
		_expect(Dowel.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Dowel.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Faye" and str(theory["place"]) == "bit" and str(theory["hour"]) != "128":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Faye" and str(theory["place"]) != "bit" and str(theory["hour"]) == "128":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Faye" and str(theory["place"]) == "bit" and str(theory["hour"]) == "128":
			wrong_person_in_bit += 1
	print("dowel near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four dowel near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Faye in the bit at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Faye at 128 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the bit at 128 for another person")

