	_expect(str(model["pin_room"]) == "smoother", "haunch pin room")
	_expect(str(model["sliver_room"]) == "jointer", "haunch sliver room")
	_expect(str(model["wipe_hour"]) == "121", "haunch buff hour")
	_expect(str(model["stone_hour"]) == "124", "haunch rub hour")
	_expect(str(model["hang_hour"]) == "125", "haunch hang hour")
	for hour in Haunch.HOURS:
		var used := false
		for field in Haunch.fields():
			if str(model[field]) == hour:
				used = true
		_expect(used, "haunch hour %s is blank in the true timeline" % hour)
	for place in Haunch.PLACES:
		var place_used := false
		for field in Haunch.fields():
			if str(model[field]) == place:
