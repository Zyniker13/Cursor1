func _test_talon_unique_model() -> void:
	var models := Solver.enumerate(Talon.EXHIBITS, Talon)
	print("talon models: %d" % models.size())
	_expect(models.size() == 1, "expected exactly one talon model, found %d" % models.size())
	if models.is_empty():
		return
	var model: Dictionary = models[0]
	_expect(str(model["taker"]) == "Selwyn", "talon taker")
	_expect(str(model["place"]) == "undercroft", "talon place")
	_expect(str(model["hour"]) == "228", "talon hour")
	_expect(str(model["persimmon"]) == "Osbert", "talon persimmon hand")
	_expect(str(model["persimmon_room"]) == "onglette", "talon persimmon room")
	_expect(str(model["persimmon_hour"]) == "227", "talon persimmon hour")
	_expect(str(model["seen_from"]) == "scriptorium", "talon seen from")
	_expect(str(model["scriptorium"]) == "Mildred", "talon scriptorium")
	_expect(str(model["aim"]) == "take_persimmon", "talon aim")
	_expect(str(model["scriptorium_room"]) == "undercroft", "talon scriptorium room")
	_expect(str(model["catalpa_room"]) == "onglette", "talon catalpa room")
	_expect(str(model["asphalt_hour"]) == "226", "talon asphalt hour")
	_expect(str(model["benzoin_hour"]) == "229", "talon benzoin hour")
	_expect(str(model["hang_hour"]) == "230", "talon hang hour")
	for hour in Talon.HOURS:
		var used := false
		for field in Talon.fields():
			if str(model[field]) == hour:
				used = true
		_expect(used, "talon hour %s is blank in the true timeline" % hour)
	for place in Talon.PLACES:
		var place_used := false
		for field in Talon.fields():
			if str(model[field]) == place:
				place_used = true
		_expect(place_used, "talon room %s is blank in the true timeline" % place)
	for person in Talon.PEOPLE:
		var person_used := false
		for field in Talon.fields():
			if str(model[field]) == person:
				person_used = true
		_expect(person_used, "talon person %s is blank in the true timeline" % person)
	_expect(Talon.timeline(model) == TALON_TIMELINE, "talon timeline drifted:\n%s" % Talon.timeline(model))
	for exhibit in Talon.EXHIBITS:
		_expect(Talon.holds(exhibit, model), "%s rejects the talon timeline" % exhibit["id"])


func _test_talon_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Talon.EXHIBITS, Talon)
	for exhibit in Talon.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Talon.without(exhibit_id), Talon)
		print("talon without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "talon %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Talon.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "talon %s removal did not admit a timeline it forbids" % exhibit_id)


func _test_talon_only_true_theory() -> void:
	var accepted := 0
	var rejected := 0
	var scriptorium_miss := {"who": "Osbert", "place": "scriptorium", "hour": "226"}
	_expect(Talon.conflicting_ids(scriptorium_miss).size() == 9, "Osbert / scriptorium / 226 contradicts %d exhibits" % Talon.conflicting_ids(scriptorium_miss).size())
	for who in Talon.PEOPLE:
		for place in Talon.PLACES:
			for hour in Talon.HOURS:
				var theory := {"who": who, "place": place, "hour": hour}
				if who == TALON_TRUE["who"] and place == TALON_TRUE["place"] and hour == TALON_TRUE["hour"]:
					var result: Dictionary = Verdict.submit(theory, Talon)
					print("talon true theory: %s" % result["status"])
					_expect(result["status"] == "accepted", "true talon theory status %s" % result["status"])
					_expect(str(result["message"]).find("fits every exhibit") >= 0, "talon acceptance should say it fits every exhibit")
					_expect(str(result["message"]).find(TALON_TIMELINE) >= 0, "talon acceptance should give the timeline")
					_expect(str(result["message"]).find("Selwyn") >= 0, "talon acceptance omits Selwyn")
					_expect(str(result["message"]).find("undercroft") >= 0, "talon acceptance omits the undercroft")
					_expect(str(result["message"]).find("228") >= 0, "talon acceptance omits 228")
					_expect(str(result["message"]).find("so the persimmon would take the talon") >= 0, "talon acceptance omits the persimmon")
					_expect(str(result["message"]).find("Selwyn (talon hand) cut the talon in the undercroft at 228") >= 0, "talon acceptance omits the taloning")
					_expect(Talon.conflicting_ids(theory).is_empty(), "true talon theory conflicts with an exhibit")
					accepted += 1
				else:
					_expect_rejected(theory, Talon)
					_expect(Talon.conflicting_ids(theory).size() >= 2, "%s / %s / %s contradicts fewer than two exhibits" % [who, place, hour])
