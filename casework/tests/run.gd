func _test_listel_near_misses() -> void:
	var misses := [
		{"who": "Giles", "place": "plinth", "hour": "179", "titles": ["Listel leaf", "Jenny note", "Dope order"]},
		{"who": "Giles", "place": "plinth", "hour": "177", "titles": ["Listel leaf", "Jenny note", "Dope order"]},
		{"who": "Giles", "place": "trammel", "hour": "178", "titles": ["Ochre slate", "Trammel card", "Plate slip"]},
		{"who": "Nora", "place": "plinth", "hour": "178", "titles": ["Alder chit", "Flax sight", "Quince bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Listel)
		var result: Dictionary = Verdict.submit(theory, Listel)
		var message := str(result["message"])
		_expect(Listel.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Listel.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Giles" and str(theory["place"]) == "plinth" and str(theory["hour"]) != "178":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Giles" and str(theory["place"]) != "plinth" and str(theory["hour"]) == "178":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Giles" and str(theory["place"]) == "plinth" and str(theory["hour"]) == "178":
			wrong_person_in_bit += 1
	print("listel near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four listel near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Giles in the plinth at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Giles at 178 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the plinth at 178 for another person")

