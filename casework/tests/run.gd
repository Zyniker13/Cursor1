		{"who": "Linnea", "place": "quire", "hour": "218", "titles": ["Bixin slate", "Quire card", "Lacquered slip"]},
		{"who": "Rune", "place": "chapel", "hour": "218", "titles": ["Robinia chit", "Emodin sight", "Service bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Apophyge)
		var result: Dictionary = Verdict.submit(theory, Apophyge)
		var message := str(result["message"])
		_expect(Apophyge.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Apophyge.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Linnea" and str(theory["place"]) == "chapel" and str(theory["hour"]) != "218":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Linnea" and str(theory["place"]) != "chapel" and str(theory["hour"]) == "218":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Linnea" and str(theory["place"]) == "chapel" and str(theory["hour"]) == "218":
			wrong_person_in_bit += 1
	print("apophyge near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four apophyge near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Linnea in the chapel at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Linnea at 218 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the chapel at 218 for another person")

