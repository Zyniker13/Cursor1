func _test_mutule_unique_model() -> void:
	var models := Solver.enumerate(Mutule.EXHIBITS, Mutule)
	print("mutule models: %d" % models.size())
	_expect(models.size() == 1, "expected exactly one mutule model, found %d" % models.size())
	if models.is_empty():
		return
	var model: Dictionary = models[0]
	_expect(str(model["taker"]) == "Marta", "mutule taker")
	_expect(str(model["place"]) == "transept", "mutule place")
	_expect(str(model["hour"]) == "203", "mutule hour")
	_expect(str(model["elder"]) == "Freya", "mutule elder hand")
	_expect(str(model["elder_room"]) == "reamer", "mutule elder room")
	_expect(str(model["elder_hour"]) == "202", "mutule elder hour")
	_expect(str(model["seen_from"]) == "porch", "mutule seen from")
	_expect(str(model["porch"]) == "Signe", "mutule porch")
	_expect(str(model["aim"]) == "take_elder", "mutule aim")
	_expect(str(model["porch_room"]) == "transept", "mutule porch room")
	_expect(str(model["mulberry_room"]) == "reamer", "mutule mulberry room")
	_expect(str(model["gild_hour"]) == "201", "mutule gild hour")
	_expect(str(model["scorch_hour"]) == "204", "mutule scorch hour")
	_expect(str(model["hang_hour"]) == "205", "mutule hang hour")
	for hour in Mutule.HOURS:
		var used := false
		for field in Mutule.fields():
			if str(model[field]) == hour:
				used = true
		_expect(used, "mutule hour %s is blank in the true timeline" % hour)
	for place in Mutule.PLACES:
		var place_used := false
		for field in Mutule.fields():
			if str(model[field]) == place:
				place_used = true
		_expect(place_used, "mutule room %s is blank in the true timeline" % place)
	for person in Mutule.PEOPLE:
		var person_used := false
		for field in Mutule.fields():
			if str(model[field]) == person:
				person_used = true
		_expect(person_used, "mutule person %s is blank in the true timeline" % person)
	_expect(Mutule.timeline(model) == MUTULE_TIMELINE, "mutule timeline drifted:\n%s" % Mutule.timeline(model))
	for exhibit in Mutule.EXHIBITS:
		_expect(Mutule.holds(exhibit, model), "%s rejects the mutule timeline" % exhibit["id"])


func _test_mutule_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Mutule.EXHIBITS, Mutule)
	for exhibit in Mutule.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Mutule.without(exhibit_id), Mutule)
		print("mutule without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "mutule %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Mutule.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "mutule %s removal did not admit a timeline it forbids" % exhibit_id)


