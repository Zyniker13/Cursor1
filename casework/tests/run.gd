				var repeats := 0
				for other in Bridle.EXHIBITS:
					for other_literal in other["literals"]:
						if str(other_literal["field"]) == field and str(other_literal["value"]) == str(literal["value"]):
							repeats += 1
				_expect(repeats >= 2, "%s states %s once" % [exhibit_id, field])
			else:
				hidden_literals += 1
				var owners := 0
				for other in Bridle.EXHIBITS:
