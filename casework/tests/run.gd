func _test_mutule_near_misses() -> void:
	var misses := [
		{"who": "Marta", "place": "transept", "hour": "204", "titles": ["Mutule leaf", "Barb note", "Scorched order"]},
		{"who": "Marta", "place": "transept", "hour": "202", "titles": ["Mutule leaf", "Barb note", "Scorched order"]},
		{"who": "Marta", "place": "porch", "hour": "203", "titles": ["Gamboge slate", "Porch card", "Gilded slip"]},
		{"who": "Freya", "place": "transept", "hour": "203", "titles": ["Elder chit", "Fustet sight", "Mulberry bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Mutule)
		var result: Dictionary = Verdict.submit(theory, Mutule)
		var message := str(result["message"])
		_expect(Mutule.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Mutule.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Marta" and str(theory["place"]) == "transept" and str(theory["hour"]) != "203":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Marta" and str(theory["place"]) != "transept" and str(theory["hour"]) == "203":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Marta" and str(theory["place"]) == "transept" and str(theory["hour"]) == "203":
			wrong_person_in_bit += 1
	print("mutule near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four mutule near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Marta in the transept at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Marta at 203 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the transept at 203 for another person")

