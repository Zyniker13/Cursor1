func _test_dowel_unique_model() -> void:
	var models := Solver.enumerate(Dowel.EXHIBITS, Dowel)
	print("dowel models: %d" % models.size())
	_expect(models.size() == 1, "expected exactly one dowel model, found %d" % models.size())
	if models.is_empty():
		return
	var model: Dictionary = models[0]
	_expect(str(model["taker"]) == "Faye", "dowel taker")
	_expect(str(model["place"]) == "bit", "dowel place")
	_expect(str(model["hour"]) == "128", "dowel hour")
	_expect(str(model["bore"]) == "Kerr", "dowel bore hand")
	_expect(str(model["bore_room"]) == "brace", "dowel bore room")
	_expect(str(model["bore_hour"]) == "127", "dowel bore hour")
	_expect(str(model["seen_from"]) == "auger", "dowel seen from")
	_expect(str(model["chuck"]) == "Brynn", "dowel chuck")
	_expect(str(model["aim"]) == "take_bore", "dowel aim")
	_expect(str(model["chuck_room"]) == "auger", "dowel chuck room")
	_expect(str(model["curl_room"]) == "brace", "dowel curl room")
	_expect(str(model["wax_hour"]) == "126", "dowel wax hour")
	_expect(str(model["hone_hour"]) == "129", "dowel hone hour")
	_expect(str(model["hang_hour"]) == "130", "dowel hang hour")
	for hour in Dowel.HOURS:
		var used := false
		for field in Dowel.fields():
			if str(model[field]) == hour:
				used = true
		_expect(used, "dowel hour %s is blank in the true timeline" % hour)
	for place in Dowel.PLACES:
		var place_used := false
		for field in Dowel.fields():
			if str(model[field]) == place:
				place_used = true
		_expect(place_used, "dowel room %s is blank in the true timeline" % place)
	for person in Dowel.PEOPLE:
