	for outsider in ["Osric", "Wulfrun", "Aethelthryth", "Aelfric", "Leofwine", "Eadgyth", "Cuthbert", "Wulfstan", "Frideswide", "Selwyn", "Osbert", "Mildred", "Colin", "Lars", "Ines", "Linnea", "Rune", "Sigrid", "Elsie", "Stig", "Maud", "Hilda", "Astrid", "Einar", "Marta", "Freya", "Signe", "Ingrid", "Tove", "Remy", "Iris", "Otto", "Leif", "Agnes", "Simon", "Felix", "Una", "Hart", "Pearl", "Giles", "Nora", "Ellis", "Hugo", "Nina", "Walter", "Clive", "Edith", "Maude", "Greta", "Nolan", "Celia", "Seth", "Ida", "Vera", "Ruth", "Amos", "Lena", "Willa", "Nils", "Cora", "Merrick", "Enid", "Petra", "Ross", "Pia", "Jude", "Shay", "Dell", "Glen", "Faye", "Kerr", "Brynn", "Rhys", "Mab", "Lisle", "Clem", "Gale", "Boyd", "Hob", "Nairn", "Cole", "Nye", "Yew", "Pry", "Orrin", "Venn", "Haim", "Senn", "Voss", "Cade", "Kern", "Phel", "Tarn", "Quill", "Wend", "Sile", "Jute", "Harl", "Neve", "Luth", "Ewan", "Maren", "Hollin", "Tansy", "Solt", "Quern", "Arlo", "Keel", "Weske", "Doss", "Yarrow", "Peck", "Vetch", "Odell", "Brigg", "Maeve", "Jory", "Perrin", "Hester", "Gwyn", "Idris", "Brea", "Ansel", "Colm", "Rho", "Lumen", "Kit", "Sera", "Pim", "Joss", "Clinden", "Ness", "Edda", "Tess", "Ivo", "Wynn", "Quin", "Mara", "Sable", "Holt", "Lin", "Opal", "Nell"]:
