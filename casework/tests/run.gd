		for phrase in case_row["present"]:
			_expect(message.find(phrase) >= 0, "bellcast missing slot not named (%s) in: %s" % [phrase, message])
		for phrase in case_row["absent"]:
			_expect(message.find(phrase) == -1, "bellcast named a filled slot (%s) in: %s" % [phrase, message])
