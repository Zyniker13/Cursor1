func _test_trochilus_near_misses() -> void:
	var misses := [
		{"who": "Colin", "place": "ambulatory", "hour": "224", "titles": ["Trochilus leaf", "Grommet note", "Copaled order"]},
		{"who": "Colin", "place": "ambulatory", "hour": "222", "titles": ["Trochilus leaf", "Grommet note", "Copaled order"]},
		{"who": "Colin", "place": "oratory", "hour": "223", "titles": ["Morin slate", "Oratory card", "Ambered slip"]},
		{"who": "Lars", "place": "ambulatory", "hour": "223", "titles": ["Applewood chit", "Litmus sight", "Laburnum bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Trochilus)
		var result: Dictionary = Verdict.submit(theory, Trochilus)
		var message := str(result["message"])
		_expect(Trochilus.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Trochilus.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Colin" and str(theory["place"]) == "ambulatory" and str(theory["hour"]) != "223":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Colin" and str(theory["place"]) != "ambulatory" and str(theory["hour"]) == "223":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Colin" and str(theory["place"]) == "ambulatory" and str(theory["hour"]) == "223":
			wrong_person_in_bit += 1
	print("trochilus near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four trochilus near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Colin in the ambulatory at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Colin at 223 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the ambulatory at 223 for another person")

