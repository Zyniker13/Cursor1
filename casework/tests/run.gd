func _test_talon_near_misses() -> void:
	var misses := [
		{"who": "Selwyn", "place": "undercroft", "hour": "229", "titles": ["Talon leaf", "Gudgeon note", "Benzoined order"]},
		{"who": "Selwyn", "place": "undercroft", "hour": "227", "titles": ["Talon leaf", "Gudgeon note", "Benzoined order"]},
		{"who": "Selwyn", "place": "scriptorium", "hour": "228", "titles": ["Apigenin slate", "Scriptorium card", "Asphalted slip"]},
		{"who": "Osbert", "place": "undercroft", "hour": "228", "titles": ["Persimmon chit", "Galangin sight", "Catalpa bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Talon)
		var result: Dictionary = Verdict.submit(theory, Talon)
		var message := str(result["message"])
		_expect(Talon.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Talon.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Selwyn" and str(theory["place"]) == "undercroft" and str(theory["hour"]) != "228":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Selwyn" and str(theory["place"]) != "undercroft" and str(theory["hour"]) == "228":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Selwyn" and str(theory["place"]) == "undercroft" and str(theory["hour"]) == "228":
			wrong_person_in_bit += 1
	print("talon near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four talon near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Selwyn in the undercroft at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Selwyn at 228 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the undercroft at 228 for another person")

