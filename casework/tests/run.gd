func _test_taenia_unique_model() -> void:
	var models := Solver.enumerate(Taenia.EXHIBITS, Taenia)
	print("taenia models: %d" % models.size())
	_expect(models.size() == 1, "expected exactly one taenia model, found %d" % models.size())
	if models.is_empty():
		return
	var model: Dictionary = models[0]
	_expect(str(model["taker"]) == "Elsie", "taenia taker")
	_expect(str(model["place"]) == "cloister", "taenia place")
	_expect(str(model["hour"]) == "213", "taenia hour")
	_expect(str(model["acacia"]) == "Stig", "taenia acacia hand")
	_expect(str(model["acacia_room"]) == "slick", "taenia acacia room")
	_expect(str(model["acacia_hour"]) == "212", "taenia acacia hour")
	_expect(str(model["seen_from"]) == "vestry", "taenia seen from")
	_expect(str(model["vestry"]) == "Maud", "taenia vestry")
	_expect(str(model["aim"]) == "take_acacia", "taenia aim")
	_expect(str(model["vestry_room"]) == "cloister", "taenia vestry room")
	_expect(str(model["sorb_room"]) == "slick", "taenia sorb room")
	_expect(str(model["smear_hour"]) == "211", "taenia smear hour")
	_expect(str(model["anoint_hour"]) == "214", "taenia anoint hour")
	_expect(str(model["hang_hour"]) == "215", "taenia hang hour")
	for hour in Taenia.HOURS:
		var used := false
		for field in Taenia.fields():
			if str(model[field]) == hour:
				used = true
		_expect(used, "taenia hour %s is blank in the true timeline" % hour)
	for place in Taenia.PLACES:
		var place_used := false
		for field in Taenia.fields():
			if str(model[field]) == place:
				place_used = true
		_expect(place_used, "taenia room %s is blank in the true timeline" % place)
	for person in Taenia.PEOPLE:
		var person_used := false
		for field in Taenia.fields():
			if str(model[field]) == person:
				person_used = true
		_expect(person_used, "taenia person %s is blank in the true timeline" % person)
	_expect(Taenia.timeline(model) == TAENIA_TIMELINE, "taenia timeline drifted:\n%s" % Taenia.timeline(model))
	for exhibit in Taenia.EXHIBITS:
		_expect(Taenia.holds(exhibit, model), "%s rejects the taenia timeline" % exhibit["id"])


func _test_taenia_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Taenia.EXHIBITS, Taenia)
	for exhibit in Taenia.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Taenia.without(exhibit_id), Taenia)
		print("taenia without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "taenia %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Taenia.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "taenia %s removal did not admit a timeline it forbids" % exhibit_id)


