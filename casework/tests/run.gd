func _test_scotia_near_misses() -> void:
	var misses := [
		{"who": "Willa", "place": "hollow", "hour": "149", "titles": ["Scotia leaf", "Yearling note", "Peen order"]},
		{"who": "Willa", "place": "hollow", "hour": "147", "titles": ["Scotia leaf", "Yearling note", "Peen order"]},
		{"who": "Willa", "place": "riffler", "hour": "148", "titles": ["Soot slate", "Riffler card", "Pumice slip"]},
		{"who": "Nils", "place": "hollow", "hour": "148", "titles": ["Torus chit", "Cusp sight", "Fascia bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Scotia)
		var result: Dictionary = Verdict.submit(theory, Scotia)
		var message := str(result["message"])
		_expect(Scotia.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Scotia.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Willa" and str(theory["place"]) == "hollow" and str(theory["hour"]) != "148":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Willa" and str(theory["place"]) != "hollow" and str(theory["hour"]) == "148":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Willa" and str(theory["place"]) == "hollow" and str(theory["hour"]) == "148":
			wrong_person_in_bit += 1
	print("scotia near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four scotia near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Willa in the hollow at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Willa at 148 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the hollow at 148 for another person")

