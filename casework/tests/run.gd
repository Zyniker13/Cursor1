func _test_gutta_near_misses() -> void:
	var misses := [
		{"who": "Ingrid", "place": "apse", "hour": "199", "titles": ["Gutta leaf", "Stud note", "Stained order"]},
		{"who": "Ingrid", "place": "apse", "hour": "197", "titles": ["Gutta leaf", "Stud note", "Stained order"]},
		{"who": "Ingrid", "place": "perch", "hour": "198", "titles": ["Cutch slate", "Perch card", "Rosined slip"]},
		{"who": "Tove", "place": "apse", "hour": "198", "titles": ["Linden chit", "Alkanet sight", "Aspen bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Gutta)
		var result: Dictionary = Verdict.submit(theory, Gutta)
		var message := str(result["message"])
		_expect(Gutta.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Gutta.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Ingrid" and str(theory["place"]) == "apse" and str(theory["hour"]) != "198":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Ingrid" and str(theory["place"]) != "apse" and str(theory["hour"]) == "198":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Ingrid" and str(theory["place"]) == "apse" and str(theory["hour"]) == "198":
			wrong_person_in_bit += 1
	print("gutta near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four gutta near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Ingrid in the apse at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Ingrid at 198 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the apse at 198 for another person")

