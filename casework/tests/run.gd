func _test_cavetto_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Cavetto.EXHIBITS, Cavetto)
	for exhibit in Cavetto.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Cavetto.without(exhibit_id), Cavetto)
		print("cavetto without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "cavetto %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Cavetto.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "cavetto %s removal did not admit a timeline it forbids" % exhibit_id)


