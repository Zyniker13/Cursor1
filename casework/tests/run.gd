func _test_finger_unique_model() -> void:
	var models := Solver.enumerate(Finger.EXHIBITS, Finger)
	print("finger models: %d" % models.size())
	_expect(models.size() == 1, "expected exactly one finger model, found %d" % models.size())
	if models.is_empty():
		return
	var model: Dictionary = models[0]
	_expect(str(model["taker"]) == "Clem", "finger taker")
	_expect(str(model["place"]) == "pad", "finger place")
	_expect(str(model["hour"]) == "118", "finger hour")
	_expect(str(model["socket"]) == "Gale", "finger socket hand")
	_expect(str(model["socket_room"]) == "jack", "finger socket room")
	_expect(str(model["socket_hour"]) == "117", "finger socket hour")
	_expect(str(model["seen_from"]) == "badger", "finger seen from")
	_expect(str(model["catch"]) == "Boyd", "finger catch")
	_expect(str(model["aim"]) == "take_socket", "finger aim")
	_expect(str(model["catch_room"]) == "badger", "finger catch room")
	_expect(str(model["chip_room"]) == "jack", "finger chip room")
	_expect(str(model["buff_hour"]) == "116", "finger buff hour")
	_expect(str(model["rub_hour"]) == "119", "finger rub hour")
	_expect(str(model["hang_hour"]) == "120", "finger hang hour")
	for hour in Finger.HOURS:
		var used := false
		for field in Finger.fields():
			if str(model[field]) == hour:
				used = true
		_expect(used, "finger hour %s is blank in the true timeline" % hour)
	for place in Finger.PLACES:
		var place_used := false
		for field in Finger.fields():
			if str(model[field]) == place:
				place_used = true
		_expect(place_used, "finger room %s is blank in the true timeline" % place)
	for person in Finger.PEOPLE:
		var person_used := false
		for field in Finger.fields():
			if str(model[field]) == person:
				person_used = true
		_expect(person_used, "finger person %s is blank in the true timeline" % person)
	_expect(Finger.timeline(model) == FINGER_TIMELINE, "finger timeline drifted:\n%s" % Finger.timeline(model))
	for exhibit in Finger.EXHIBITS:
		_expect(Finger.holds(exhibit, model), "%s rejects the finger timeline" % exhibit["id"])


func _test_finger_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Finger.EXHIBITS, Finger)
	for exhibit in Finger.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Finger.without(exhibit_id), Finger)
		print("finger without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "finger %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Finger.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "finger %s removal did not admit a timeline it forbids" % exhibit_id)


