		for field in Dowel.fields():
			if str(model[field]) == person:
				person_used = true
		_expect(person_used, "dowel person %s is blank in the true timeline" % person)
	_expect(Dowel.timeline(model) == DOWEL_TIMELINE, "dowel timeline drifted:\n%s" % Dowel.timeline(model))
	for exhibit in Dowel.EXHIBITS:
		_expect(Dowel.holds(exhibit, model), "%s rejects the dowel timeline" % exhibit["id"])


func _test_dowel_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Dowel.EXHIBITS, Dowel)
	for exhibit in Dowel.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Dowel.without(exhibit_id), Dowel)
		print("dowel without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "dowel %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Dowel.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "dowel %s removal did not admit a timeline it forbids" % exhibit_id)


