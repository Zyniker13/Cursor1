func _test_bowtell_unique_model() -> void:
	var models := Solver.enumerate(Bowtell.EXHIBITS, Bowtell)
	print("bowtell models: %d" % models.size())
	_expect(models.size() == 1, "expected exactly one bowtell model, found %d" % models.size())
	if models.is_empty():
		return
	var model: Dictionary = models[0]
	_expect(str(model["taker"]) == "Siward", "bowtell taker")
	_expect(str(model["place"]) == "chevet", "bowtell place")
	_expect(str(model["hour"]) == "253", "bowtell hour")
	_expect(str(model["myrtle"]) == "Gytha", "bowtell myrtle hand")
	_expect(str(model["myrtle_room"]) == "ryoba", "bowtell myrtle room")
	_expect(str(model["myrtle_hour"]) == "252", "bowtell myrtle hour")
	_expect(str(model["seen_from"]) == "locutory", "bowtell seen from")
	_expect(str(model["locutory"]) == "Ealdred", "bowtell locutory")
	_expect(str(model["aim"]) == "take_myrtle", "bowtell aim")
	_expect(str(model["locutory_room"]) == "chevet", "bowtell locutory room")
	_expect(str(model["osage_room"]) == "ryoba", "bowtell osage room")
	_expect(str(model["ylang_hour"]) == "251", "bowtell ylang hour")
	_expect(str(model["vetiver_hour"]) == "254", "bowtell vetiver hour")
	_expect(str(model["hang_hour"]) == "255", "bowtell hang hour")
	for hour in Bowtell.HOURS:
		var used := false
		for field in Bowtell.fields():
			if str(model[field]) == hour:
				used = true
		_expect(used, "bowtell hour %s is blank in the true timeline" % hour)
	for place in Bowtell.PLACES:
		var place_used := false
		for field in Bowtell.fields():
			if str(model[field]) == place:
				place_used = true
		_expect(place_used, "bowtell room %s is blank in the true timeline" % place)
	for person in Bowtell.PEOPLE:
		var person_used := false
		for field in Bowtell.fields():
			if str(model[field]) == person:
				person_used = true
		_expect(person_used, "bowtell person %s is blank in the true timeline" % person)
	_expect(Bowtell.timeline(model) == BOWTELL_TIMELINE, "bowtell timeline drifted:\n%s" % Bowtell.timeline(model))
	for exhibit in Bowtell.EXHIBITS:
		_expect(Bowtell.holds(exhibit, model), "%s rejects the bowtell timeline" % exhibit["id"])


func _test_bowtell_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Bowtell.EXHIBITS, Bowtell)
	for exhibit in Bowtell.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Bowtell.without(exhibit_id), Bowtell)
		print("bowtell without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "bowtell %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Bowtell.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "bowtell %s removal did not admit a timeline it forbids" % exhibit_id)


