func _test_modillion_unique_model() -> void:
	var models := Solver.enumerate(Modillion.EXHIBITS, Modillion)
	print("modillion models: %d" % models.size())
	_expect(models.size() == 1, "expected exactly one modillion model, found %d" % models.size())
	if models.is_empty():
		return
	var model: Dictionary = models[0]
	_expect(str(model["taker"]) == "Hilda", "modillion taker")
	_expect(str(model["place"]) == "narthex", "modillion place")
	_expect(str(model["hour"]) == "208", "modillion hour")
	_expect(str(model["cornel"]) == "Astrid", "modillion cornel hand")
	_expect(str(model["cornel_room"]) == "broach", "modillion cornel room")
	_expect(str(model["cornel_hour"]) == "207", "modillion cornel hour")
	_expect(str(model["seen_from"]) == "aisle", "modillion seen from")
	_expect(str(model["aisle"]) == "Einar", "modillion aisle")
	_expect(str(model["aim"]) == "take_cornel", "modillion aim")
	_expect(str(model["aisle_room"]) == "narthex", "modillion aisle room")
	_expect(str(model["dogwood_room"]) == "broach", "modillion dogwood room")
	_expect(str(model["resin_hour"]) == "206", "modillion resin hour")
	_expect(str(model["taw_hour"]) == "209", "modillion taw hour")
	_expect(str(model["hang_hour"]) == "210", "modillion hang hour")
	for hour in Modillion.HOURS:
		var used := false
		for field in Modillion.fields():
			if str(model[field]) == hour:
				used = true
		_expect(used, "modillion hour %s is blank in the true timeline" % hour)
	for place in Modillion.PLACES:
		var place_used := false
		for field in Modillion.fields():
			if str(model[field]) == place:
				place_used = true
		_expect(place_used, "modillion room %s is blank in the true timeline" % place)
	for person in Modillion.PEOPLE:
		var person_used := false
		for field in Modillion.fields():
			if str(model[field]) == person:
				person_used = true
		_expect(person_used, "modillion person %s is blank in the true timeline" % person)
	_expect(Modillion.timeline(model) == MODILLION_TIMELINE, "modillion timeline drifted:\n%s" % Modillion.timeline(model))
	for exhibit in Modillion.EXHIBITS:
		_expect(Modillion.holds(exhibit, model), "%s rejects the modillion timeline" % exhibit["id"])


func _test_modillion_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Modillion.EXHIBITS, Modillion)
	for exhibit in Modillion.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Modillion.without(exhibit_id), Modillion)
		print("modillion without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "modillion %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
