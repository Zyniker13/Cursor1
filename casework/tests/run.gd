func _test_apophyge_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Apophyge.EXHIBITS, Apophyge)
	for exhibit in Apophyge.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Apophyge.without(exhibit_id), Apophyge)
		print("apophyge without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "apophyge %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Apophyge.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "apophyge %s removal did not admit a timeline it forbids" % exhibit_id)


