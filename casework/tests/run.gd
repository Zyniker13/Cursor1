func _test_cable_unique_model() -> void:
	var models := Solver.enumerate(Cable.EXHIBITS, Cable)
	print("cable models: %d" % models.size())
	_expect(models.size() == 1, "expected exactly one cable model, found %d" % models.size())
	if models.is_empty():
		return
	var model: Dictionary = models[0]
	_expect(str(model["taker"]) == "Aelfwig", "cable taker")
	_expect(str(model["place"]) == "pulpitum", "cable place")
	_expect(str(model["hour"]) == "258", "cable hour")
	_expect(str(model["magnolia"]) == "Cynesige", "cable magnolia hand")
	_expect(str(model["magnolia_room"]) == "kataba", "cable magnolia room")
	_expect(str(model["magnolia_hour"]) == "257", "cable magnolia hour")
	_expect(str(model["seen_from"]) == "sedilia", "cable seen from")
	_expect(str(model["sedilia"]) == "Wulfthryth", "cable sedilia")
	_expect(str(model["aim"]) == "take_magnolia", "cable aim")
	_expect(str(model["sedilia_room"]) == "pulpitum", "cable sedilia room")
	_expect(str(model["bubinga_room"]) == "kataba", "cable bubinga room")
	_expect(str(model["olibanum_hour"]) == "256", "cable olibanum hour")
	_expect(str(model["labdanum_hour"]) == "259", "cable labdanum hour")
	_expect(str(model["hang_hour"]) == "260", "cable hang hour")
	for hour in Cable.HOURS:
		var used := false
		for field in Cable.fields():
			if str(model[field]) == hour:
				used = true
		_expect(used, "cable hour %s is blank in the true timeline" % hour)
	for place in Cable.PLACES:
		var place_used := false
		for field in Cable.fields():
			if str(model[field]) == place:
				place_used = true
		_expect(place_used, "cable room %s is blank in the true timeline" % place)
	for person in Cable.PEOPLE:
		var person_used := false
		for field in Cable.fields():
			if str(model[field]) == person:
				person_used = true
		_expect(person_used, "cable person %s is blank in the true timeline" % person)
	_expect(Cable.timeline(model) == CABLE_TIMELINE, "cable timeline drifted:\n%s" % Cable.timeline(model))
	for exhibit in Cable.EXHIBITS:
		_expect(Cable.holds(exhibit, model), "%s rejects the cable timeline" % exhibit["id"])


func _test_cable_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Cable.EXHIBITS, Cable)
	for exhibit in Cable.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Cable.without(exhibit_id), Cable)
		print("cable without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "cable %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Cable.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "cable %s removal did not admit a timeline it forbids" % exhibit_id)


func _test_cable_only_true_theory() -> void:
	var accepted := 0
	var rejected := 0
	var sedilia_miss := {"who": "Cynesige", "place": "sedilia", "hour": "256"}
	_expect(Cable.conflicting_ids(sedilia_miss).size() == 9, "Cynesige / sedilia / 256 contradicts %d exhibits" % Cable.conflicting_ids(sedilia_miss).size())
	for who in Cable.PEOPLE:
		for place in Cable.PLACES:
			for hour in Cable.HOURS:
				var theory := {"who": who, "place": place, "hour": hour}
				if who == CABLE_TRUE["who"] and place == CABLE_TRUE["place"] and hour == CABLE_TRUE["hour"]:
					var result: Dictionary = Verdict.submit(theory, Cable)
					print("cable true theory: %s" % result["status"])
					_expect(result["status"] == "accepted", "true cable theory status %s" % result["status"])
					_expect(str(result["message"]).find("fits every exhibit") >= 0, "cable acceptance should say it fits every exhibit")
					_expect(str(result["message"]).find(CABLE_TIMELINE) >= 0, "cable acceptance should give the timeline")
					_expect(str(result["message"]).find("Aelfwig") >= 0, "cable acceptance omits Aelfwig")
					_expect(str(result["message"]).find("pulpitum") >= 0, "cable acceptance omits the pulpitum")
					_expect(str(result["message"]).find("258") >= 0, "cable acceptance omits 258")
					_expect(str(result["message"]).find("so the magnolia would take the cable") >= 0, "cable acceptance omits the magnolia")
					_expect(str(result["message"]).find("Aelfwig (cable hand) cut the cable in the pulpitum at 258") >= 0, "cable acceptance omits the cabling")
					_expect(Cable.conflicting_ids(theory).is_empty(), "true cable theory conflicts with an exhibit")
					accepted += 1
				else:
					_expect_rejected(theory, Cable)
