func _test_cable_near_misses() -> void:
	var misses := [
		{"who": "Aelfwig", "place": "pulpitum", "hour": "259", "titles": ["Cable leaf", "Becket note", "Labdanumed order"]},
		{"who": "Aelfwig", "place": "pulpitum", "hour": "257", "titles": ["Cable leaf", "Becket note", "Labdanumed order"]},
		{"who": "Aelfwig", "place": "sedilia", "hour": "258", "titles": ["Stibnite slate", "Sedilia card", "Olibanumed slip"]},
		{"who": "Cynesige", "place": "pulpitum", "hour": "258", "titles": ["Magnolia chit", "Hypericin sight", "Bubinga bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Cable)
		var result: Dictionary = Verdict.submit(theory, Cable)
		var message := str(result["message"])
		_expect(Cable.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Cable.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Aelfwig" and str(theory["place"]) == "pulpitum" and str(theory["hour"]) != "258":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Aelfwig" and str(theory["place"]) != "pulpitum" and str(theory["hour"]) == "258":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Aelfwig" and str(theory["place"]) == "pulpitum" and str(theory["hour"]) == "258":
			wrong_person_in_bit += 1
	print("cable near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four cable near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Aelfwig in the pulpitum at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Aelfwig at 258 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the pulpitum at 258 for another person")

