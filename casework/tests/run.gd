					rejected += 1
	_expect_rejected({"who": "Wren", "place": "quay", "hour": "33"}, Tide)
	print("tide theories accepted: %d rejected: %d" % [accepted, rejected])
	_expect(accepted == 1, "accepted %d tide theories" % accepted)
