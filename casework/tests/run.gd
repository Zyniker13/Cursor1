func _test_haunch_near_misses() -> void:
	var misses := [
		{"who": "Rhys", "place": "fore", "hour": "124", "titles": ["Haunch leaf", "Haunch note", "Stone order"]},
		{"who": "Rhys", "place": "fore", "hour": "122", "titles": ["Haunch leaf", "Haunch note", "Stone order"]},
		{"who": "Rhys", "place": "smoother", "hour": "123", "titles": ["Bed slate", "Pin card", "Wipe slip"]},
		{"who": "Mab", "place": "fore", "hour": "123", "titles": ["Cheek chit", "Toe sight", "Sliver bill"]},
	]
	var wrong_hour_in_fore := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_fore := 0
	for theory in misses:
		_expect_rejected(theory, Haunch)
		var result: Dictionary = Verdict.submit(theory, Haunch)
		var message := str(result["message"])
		_expect(Haunch.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Haunch.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Rhys" and str(theory["place"]) == "fore" and str(theory["hour"]) != "123":
			wrong_hour_in_fore += 1
		if str(theory["who"]) == "Rhys" and str(theory["place"]) != "fore" and str(theory["hour"]) == "123":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Rhys" and str(theory["place"]) == "fore" and str(theory["hour"]) == "123":
			wrong_person_in_fore += 1
	print("haunch near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four haunch near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_fore == 2, "two near-misses should keep Rhys in the fore at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Rhys at 123 in another room")
	_expect(wrong_person_in_fore >= 1, "a near-miss should keep the fore at 123 for another person")

