func _test_quirk_near_misses() -> void:
	var misses := [
		{"who": "Ross", "place": "scratch", "hour": "139", "titles": ["Quirk leaf", "Gelding note", "Whet order"]},
		{"who": "Ross", "place": "scratch", "hour": "137", "titles": ["Quirk leaf", "Gelding note", "Whet order"]},
		{"who": "Ross", "place": "snib", "hour": "138", "titles": ["Score slate", "Snib card", "Grease slip"]},
		{"who": "Pia", "place": "scratch", "hour": "138", "titles": ["Ovolo chit", "Bolt sight", "Astragal bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Quirk)
		var result: Dictionary = Verdict.submit(theory, Quirk)
		var message := str(result["message"])
		_expect(Quirk.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Quirk.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Ross" and str(theory["place"]) == "scratch" and str(theory["hour"]) != "138":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Ross" and str(theory["place"]) != "scratch" and str(theory["hour"]) == "138":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Ross" and str(theory["place"]) == "scratch" and str(theory["hour"]) == "138":
			wrong_person_in_bit += 1
	print("quirk near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four quirk near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Ross in the scratch at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Ross at 138 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the scratch at 138 for another person")

