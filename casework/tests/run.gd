func _test_cavetto_near_misses() -> void:
	var misses := [
		{"who": "Seth", "place": "dentil", "hour": "159", "titles": ["Cavetto leaf", "Palfrey note", "Knurl order"]},
		{"who": "Seth", "place": "dentil", "hour": "157", "titles": ["Cavetto leaf", "Palfrey note", "Knurl order"]},
		{"who": "Seth", "place": "bullnose", "hour": "158", "titles": ["Cedar slate", "Bullnose card", "Scrape slip"]},
		{"who": "Ida", "place": "dentil", "hour": "158", "titles": ["Thumbnail chit", "Drip sight", "Staff bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Cavetto)
		var result: Dictionary = Verdict.submit(theory, Cavetto)
		var message := str(result["message"])
		_expect(Cavetto.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Cavetto.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Seth" and str(theory["place"]) == "dentil" and str(theory["hour"]) != "158":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Seth" and str(theory["place"]) != "dentil" and str(theory["hour"]) == "158":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Seth" and str(theory["place"]) == "dentil" and str(theory["hour"]) == "158":
			wrong_person_in_bit += 1
	print("cavetto near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four cavetto near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Seth in the dentil at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Seth at 158 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the dentil at 158 for another person")

