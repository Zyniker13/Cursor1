func _test_metope_unique_model() -> void:
	var models := Solver.enumerate(Metope.EXHIBITS, Metope)
	print("metope models: %d" % models.size())
	_expect(models.size() == 1, "expected exactly one metope model, found %d" % models.size())
	if models.is_empty():
		return
	var model: Dictionary = models[0]
	_expect(str(model["taker"]) == "Aelfric", "metope taker")
	_expect(str(model["place"]) == "clerestory", "metope place")
	_expect(str(model["hour"]) == "238", "metope hour")
	_expect(str(model["pecan"]) == "Leofwine", "metope pecan hand")
	_expect(str(model["pecan_room"]) == "tinttool", "metope pecan room")
	_expect(str(model["pecan_hour"]) == "237", "metope pecan hour")
	_expect(str(model["seen_from"]) == "presbytery", "metope seen from")
	_expect(str(model["presbytery"]) == "Eadgyth", "metope presbytery")
	_expect(str(model["aim"]) == "take_pecan", "metope aim")
	_expect(str(model["presbytery_room"]) == "clerestory", "metope presbytery room")
	_expect(str(model["butternut_room"]) == "tinttool", "metope butternut room")
	_expect(str(model["toast_hour"]) == "236", "metope toast hour")
	_expect(str(model["solder_hour"]) == "239", "metope solder hour")
	_expect(str(model["hang_hour"]) == "240", "metope hang hour")
	for hour in Metope.HOURS:
		var used := false
		for field in Metope.fields():
			if str(model[field]) == hour:
				used = true
		_expect(used, "metope hour %s is blank in the true timeline" % hour)
	for place in Metope.PLACES:
		var place_used := false
		for field in Metope.fields():
			if str(model[field]) == place:
				place_used = true
		_expect(place_used, "metope room %s is blank in the true timeline" % place)
	for person in Metope.PEOPLE:
		var person_used := false
		for field in Metope.fields():
			if str(model[field]) == person:
				person_used = true
		_expect(person_used, "metope person %s is blank in the true timeline" % person)
	_expect(Metope.timeline(model) == METOPE_TIMELINE, "metope timeline drifted:\n%s" % Metope.timeline(model))
	for exhibit in Metope.EXHIBITS:
		_expect(Metope.holds(exhibit, model), "%s rejects the metope timeline" % exhibit["id"])


func _test_metope_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Metope.EXHIBITS, Metope)
	for exhibit in Metope.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Metope.without(exhibit_id), Metope)
		print("metope without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "metope %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Metope.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "metope %s removal did not admit a timeline it forbids" % exhibit_id)


func _test_metope_only_true_theory() -> void:
	var accepted := 0
	var rejected := 0
	var presbytery_miss := {"who": "Leofwine", "place": "presbytery", "hour": "236"}
	_expect(Metope.conflicting_ids(presbytery_miss).size() == 9, "Leofwine / presbytery / 236 contradicts %d exhibits" % Metope.conflicting_ids(presbytery_miss).size())
	for who in Metope.PEOPLE:
		for place in Metope.PLACES:
			for hour in Metope.HOURS:
				var theory := {"who": who, "place": place, "hour": hour}
				if who == METOPE_TRUE["who"] and place == METOPE_TRUE["place"] and hour == METOPE_TRUE["hour"]:
					var result: Dictionary = Verdict.submit(theory, Metope)
					print("metope true theory: %s" % result["status"])
					_expect(result["status"] == "accepted", "true metope theory status %s" % result["status"])
					_expect(str(result["message"]).find("fits every exhibit") >= 0, "metope acceptance should say it fits every exhibit")
					_expect(str(result["message"]).find(METOPE_TIMELINE) >= 0, "metope acceptance should give the timeline")
					_expect(str(result["message"]).find("Aelfric") >= 0, "metope acceptance omits Aelfric")
