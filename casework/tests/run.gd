func _test_regula_near_misses() -> void:
	var misses := [
		{"who": "Hereward", "place": "dorter", "hour": "249", "titles": ["Regula leaf", "Spike note", "Masticed order"]},
		{"who": "Hereward", "place": "dorter", "hour": "247", "titles": ["Regula leaf", "Spike note", "Masticed order"]},
		{"who": "Hereward", "place": "galilee", "hour": "248", "titles": ["Betanin slate", "Galilee card", "Myrrhed slip"]},
		{"who": "Godiva", "place": "dorter", "hour": "248", "titles": ["Wenge chit", "Lycopene sight", "Sapele bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Regula)
		var result: Dictionary = Verdict.submit(theory, Regula)
		var message := str(result["message"])
		_expect(Regula.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Regula.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Hereward" and str(theory["place"]) == "dorter" and str(theory["hour"]) != "248":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Hereward" and str(theory["place"]) != "dorter" and str(theory["hour"]) == "248":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Hereward" and str(theory["place"]) == "dorter" and str(theory["hour"]) == "248":
			wrong_person_in_bit += 1
	print("regula near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four regula near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Hereward in the dorter at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Hereward at 248 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the dorter at 248 for another person")

