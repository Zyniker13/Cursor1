func _test_scotia_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Scotia.EXHIBITS, Scotia)
	for exhibit in Scotia.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Scotia.without(exhibit_id), Scotia)
		print("scotia without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "scotia %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Scotia.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "scotia %s removal did not admit a timeline it forbids" % exhibit_id)


