func _test_metope_near_misses() -> void:
	var misses := [
		{"who": "Aelfric", "place": "clerestory", "hour": "239", "titles": ["Metope leaf", "Thole note", "Soldered order"]},
		{"who": "Aelfric", "place": "clerestory", "hour": "237", "titles": ["Metope leaf", "Thole note", "Soldered order"]},
		{"who": "Aelfric", "place": "presbytery", "hour": "238", "titles": ["Myricetin slate", "Presbytery card", "Toasted slip"]},
		{"who": "Leofwine", "place": "clerestory", "hour": "238", "titles": ["Pecan chit", "Zeaxanthin sight", "Butternut bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Metope)
		var result: Dictionary = Verdict.submit(theory, Metope)
		var message := str(result["message"])
		_expect(Metope.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Metope.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Aelfric" and str(theory["place"]) == "clerestory" and str(theory["hour"]) != "238":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Aelfric" and str(theory["place"]) != "clerestory" and str(theory["hour"]) == "238":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Aelfric" and str(theory["place"]) == "clerestory" and str(theory["hour"]) == "238":
			wrong_person_in_bit += 1
	print("metope near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four metope near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Aelfric in the clerestory at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Aelfric at 238 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the clerestory at 238 for another person")

