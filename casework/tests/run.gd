func _test_modillion_near_misses() -> void:
	var misses := [
		{"who": "Hilda", "place": "narthex", "hour": "209", "titles": ["Modillion leaf", "Sprig note", "Tawed order"]},
		{"who": "Hilda", "place": "narthex", "hour": "207", "titles": ["Modillion leaf", "Sprig note", "Tawed order"]},
		{"who": "Hilda", "place": "aisle", "hour": "208", "titles": ["Catechu slate", "Aisle card", "Resined slip"]},
		{"who": "Astrid", "place": "narthex", "hour": "208", "titles": ["Cornel chit", "Camwood sight", "Dogwood bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Modillion)
		var result: Dictionary = Verdict.submit(theory, Modillion)
		var message := str(result["message"])
		_expect(Modillion.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Modillion.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Hilda" and str(theory["place"]) == "narthex" and str(theory["hour"]) != "208":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Hilda" and str(theory["place"]) != "narthex" and str(theory["hour"]) == "208":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Hilda" and str(theory["place"]) == "narthex" and str(theory["hour"]) == "208":
			wrong_person_in_bit += 1
	print("modillion near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four modillion near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Hilda in the narthex at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Hilda at 208 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the narthex at 208 for another person")

