func _test_bellcast_near_misses() -> void:
	var misses := [
		{"who": "Cuthbert", "place": "triforium", "hour": "234", "titles": ["Bellcast leaf", "Thimble note", "Cinnabared order"]},
		{"who": "Cuthbert", "place": "triforium", "hour": "232", "titles": ["Bellcast leaf", "Thimble note", "Cinnabared order"]},
		{"who": "Cuthbert", "place": "calefactory", "hour": "233", "titles": ["Fisetin slate", "Calefactory card", "Orpimented slip"]},
		{"who": "Wulfstan", "place": "triforium", "hour": "233", "titles": ["Hickory chit", "Haematoxylin sight", "Paulownia bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Bellcast)
		var result: Dictionary = Verdict.submit(theory, Bellcast)
		var message := str(result["message"])
		_expect(Bellcast.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Bellcast.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Cuthbert" and str(theory["place"]) == "triforium" and str(theory["hour"]) != "233":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Cuthbert" and str(theory["place"]) != "triforium" and str(theory["hour"]) == "233":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Cuthbert" and str(theory["place"]) == "triforium" and str(theory["hour"]) == "233":
			wrong_person_in_bit += 1
	print("bellcast near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four bellcast near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Cuthbert in the triforium at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Cuthbert at 233 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the triforium at 233 for another person")

