func _test_triglyph_near_misses() -> void:
	var misses := [
		{"who": "Osric", "place": "retrochoir", "hour": "244", "titles": ["Triglyph leaf", "Rivet note", "Storaxed order"]},
		{"who": "Osric", "place": "retrochoir", "hour": "242", "titles": ["Triglyph leaf", "Rivet note", "Storaxed order"]},
		{"who": "Osric", "place": "refectory", "hour": "243", "titles": ["Quercetin slate", "Refectory card", "Smalted slip"]},
		{"who": "Wulfrun", "place": "retrochoir", "hour": "243", "titles": ["Teak chit", "Astaxanthin sight", "Iroko bill"]},
	]
	var wrong_hour_in_bit := 0
	var wrong_place_at_hour := 0
	var wrong_person_in_bit := 0
	for theory in misses:
		_expect_rejected(theory, Triglyph)
		var result: Dictionary = Verdict.submit(theory, Triglyph)
		var message := str(result["message"])
		_expect(Triglyph.conflicting_ids(theory).size() >= 2, "near-miss should contradict at least two exhibits: %s" % message)
		_expect(Triglyph.conflicting_ids(theory).size() == 3, "near-miss should name three exhibits: %s" % message)
		var named_at := -1
		for title in theory["titles"]:
			var at := message.find(str(title))
			_expect(at >= 0, "near-miss omits %s: %s" % [title, message])
			_expect(at > named_at, "near-miss names %s out of paper order: %s" % [title, message])
			named_at = at
		if str(theory["who"]) == "Osric" and str(theory["place"]) == "retrochoir" and str(theory["hour"]) != "243":
			wrong_hour_in_bit += 1
		if str(theory["who"]) == "Osric" and str(theory["place"]) != "retrochoir" and str(theory["hour"]) == "243":
			wrong_place_at_hour += 1
		if str(theory["who"]) != "Osric" and str(theory["place"]) == "retrochoir" and str(theory["hour"]) == "243":
			wrong_person_in_bit += 1
	print("triglyph near-misses rejected: %d" % misses.size())
	_expect(misses.size() == 4, "need four triglyph near-misses, found %d" % misses.size())
	_expect(wrong_hour_in_bit == 2, "two near-misses should keep Osric in the retrochoir at another hour")
	_expect(wrong_place_at_hour >= 1, "a near-miss should keep Osric at 243 in another room")
	_expect(wrong_person_in_bit >= 1, "a near-miss should keep the retrochoir at 243 for another person")

