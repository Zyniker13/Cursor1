func _test_regula_unique_model() -> void:
	var models := Solver.enumerate(Regula.EXHIBITS, Regula)
	print("regula models: %d" % models.size())
	_expect(models.size() == 1, "expected exactly one regula model, found %d" % models.size())
	if models.is_empty():
		return
	var model: Dictionary = models[0]
	_expect(str(model["taker"]) == "Hereward", "regula taker")
	_expect(str(model["place"]) == "dorter", "regula place")
	_expect(str(model["hour"]) == "248", "regula hour")
	_expect(str(model["wenge"]) == "Godiva", "regula wenge hand")
	_expect(str(model["wenge_room"]) == "dozuki", "regula wenge room")
	_expect(str(model["wenge_hour"]) == "247", "regula wenge hour")
	_expect(str(model["seen_from"]) == "galilee", "regula seen from")
	_expect(str(model["galilee"]) == "Leofric", "regula galilee")
	_expect(str(model["aim"]) == "take_wenge", "regula aim")
	_expect(str(model["galilee_room"]) == "dorter", "regula galilee room")
	_expect(str(model["sapele_room"]) == "dozuki", "regula sapele room")
	_expect(str(model["myrrh_hour"]) == "246", "regula myrrh hour")
	_expect(str(model["mastic_hour"]) == "249", "regula mastic hour")
	_expect(str(model["hang_hour"]) == "250", "regula hang hour")
	for hour in Regula.HOURS:
		var used := false
		for field in Regula.fields():
			if str(model[field]) == hour:
				used = true
		_expect(used, "regula hour %s is blank in the true timeline" % hour)
	for place in Regula.PLACES:
		var place_used := false
		for field in Regula.fields():
			if str(model[field]) == place:
				place_used = true
		_expect(place_used, "regula room %s is blank in the true timeline" % place)
	for person in Regula.PEOPLE:
		var person_used := false
		for field in Regula.fields():
			if str(model[field]) == person:
				person_used = true
		_expect(person_used, "regula person %s is blank in the true timeline" % person)
	_expect(Regula.timeline(model) == REGULA_TIMELINE, "regula timeline drifted:\n%s" % Regula.timeline(model))
	for exhibit in Regula.EXHIBITS:
		_expect(Regula.holds(exhibit, model), "%s rejects the regula timeline" % exhibit["id"])


func _test_regula_each_exhibit_necessary() -> void:
	var full := Solver.enumerate(Regula.EXHIBITS, Regula)
	for exhibit in Regula.EXHIBITS:
		var exhibit_id := str(exhibit["id"])
		var reduced := Solver.enumerate(Regula.without(exhibit_id), Regula)
		print("regula without %s: %d models" % [exhibit_id, reduced.size()])
		_expect(reduced.size() > full.size(), "regula %s is not necessary (%d models)" % [exhibit_id, reduced.size()])
		var opened := false
		for model in reduced:
			if not Regula.holds(exhibit, model):
				opened = true
				break
		_expect(opened, "regula %s removal did not admit a timeline it forbids" % exhibit_id)


