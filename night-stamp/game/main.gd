func _ready() -> void:
	set_anchors_preset(Control.PRESET_FULL_RECT)
	var theme := Theme.new()
	theme.default_font_size = 18
	set_theme(theme)
	_build()
	state = Rules.new_run(12345)
	seed_edit.text = "12345"
	_refresh_ui()
	var viewport := get_viewport()
	if viewport != null:
		viewport.gui_release_focus()


