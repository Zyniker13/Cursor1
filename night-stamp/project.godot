; Engine configuration file.
; Godot 4 project. Play and test from this folder.

config_version=5

[application]

config/name="Night Stamp"
config/description="A border-desk deckbuilder. Stamp a 3x3 form across fifteen nights."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
run/flush_stdout_on_print=true
boot_splash/bg_color=Color(0.08, 0.09, 0.12, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
