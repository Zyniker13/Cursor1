func test_epode_bell_opens() -> void:
	check(Rules.SHIFT_EPODE == 48, "the epode bell is night 49")
	check(Rules.SHIFT_CORRIGENDA == 41, "the corrigenda bell stays night 42")
	check(Rules.SHIFT_ENVOI == 40, "the envoi bell stays night 41")
	check(Rules.SHIFT_ADDENDA == 39, "the addenda bell stays night 40")
	check(Rules.EPODE_BELL.size() == 4, "the epode bell has four travelers")
	check(String(Rules.EPODE_BELL[0]["name"]) == "Alma Hale", "the epode bell begins with Alma Hale")
	check(String(Rules.EPODE_BELL[1]["name"]) == "Stig Voss", "the epode bell's second traveler is Stig Voss")
	check(String(Rules.EPODE_BELL[2]["name"]) == "Rune Brant", "the epode bell's third traveler is Rune Brant")
	check(String(Rules.EPODE_BELL[3]["name"]) == "Cora Okell", "the epode bell ends with Cora Okell")
	check(int(Rules.EPODE_BELL[0]["goal"]) == 18 and int(Rules.EPODE_BELL[1]["goal"]) == 20 and int(Rules.EPODE_BELL[2]["goal"]) == 16 and int(Rules.EPODE_BELL[3]["goal"]) == 22, "the epode goals stay 18, 20, 16, and 22")
	check(Rules.CORRIGENDA_BELL.size() == 4 and String(Rules.CORRIGENDA_BELL[0]["name"]) == "Vera Hale", "the corrigenda bell still begins with Vera Hale")
	check(String(Rules.CORRIGENDA_BELL[1]["name"]) == "Felix Voss" and String(Rules.CORRIGENDA_BELL[2]["name"]) == "Rhea Brant" and String(Rules.CORRIGENDA_BELL[3]["name"]) == "Jasper Okell", "the corrigenda bell still ends with Jasper Okell")
	var epode_run = Rules.new_run(89, Rules.SHIFT_EPODE)
	check(epode_run.shift == Rules.SHIFT_EPODE, "the epode bell is a separate night")
	check(Rules.shift_label(epode_run) == "Epode bell", "the epode bell keeps its name")
	check(String(Rules.traveler(epode_run)["name"]) == "Alma Hale", "the epode bell begins with Alma Hale")
	check(epode_run.hand.size() == Rules.HAND_SIZE, "the epode bell draws 5")
	check(epode_run.ink == Rules.BASE_INK, "the epode bell starts at 3 ink")
	check(epode_run.library.size() == Rules.STARTING_DECK.size(), "the epode bell deals the starting deck")
	check(epode_run.relic_id == "", "an earlier night's relic does not carry")
	check(epode_run.phase == "play", "the epode bell opens in play")
	var dealt: Array = []
	for iid in epode_run.hand:
		dealt.append(Rules.card_id_of(epode_run, int(iid)))
	var before = epode_run.library.size()
	epode_run.progress = 4
	epode_run.patience = 1
	Rules.restart_encounter(epode_run)
	check(epode_run.shift == Rules.SHIFT_EPODE and epode_run.traveler_index == 0, "restart encounter stays on the epode bell")
	check(epode_run.progress == 0 and epode_run.patience == int(Rules.EPODE_BELL[0]["patience"]), "restart encounter resets Alma")
	check(epode_run.library.size() == before and epode_run.hand.size() == 5 and epode_run.phase == "play", "restart keeps the epode-bell deck and deals a hand")
	var redealt: Array = []
	for iid in epode_run.hand:
		redealt.append(Rules.card_id_of(epode_run, int(iid)))
	check(redealt == dealt, "restart deals Alma the same hand")

	var packed = load("res://game/main.tscn")
	var desk = packed.instantiate()
	root.add_child(desk)
	if desk.state == null:
		desk._ready()
	check(desk.state.shift == Rules.SHIFT_FIRST, "the desk still opens on Act 1")
	check(Rules.SHIFT_EPILOGUE == 42, "the epilogue bell stays night 43")
	check(Rules.SHIFT_CODA == 43, "the coda bell stays night 44")
	check(Rules.SHIFT_FINALE == 47, "the finale bell stays night 48")
