func test_explicit_bell_rules() -> void:
	check(Rules.EXPLICIT_BELL.size() == 4, "the explicit bell has four travelers")
	check(String(Rules.EXPLICIT_BELL[0]["name"]) == "Edgar Hale" and String(Rules.EXPLICIT_BELL[0]["form_name"]) == "Stride Toll", "Edgar Hale brings Stride Toll")
	check(String(Rules.EXPLICIT_BELL[1]["name"]) == "Helen Voss" and String(Rules.EXPLICIT_BELL[1]["form_name"]) == "Stride Blank", "Helen Voss brings Stride Blank")
	check(String(Rules.EXPLICIT_BELL[2]["name"]) == "Mira Brant" and String(Rules.EXPLICIT_BELL[2]["form_name"]) == "Bevel Pay", "Mira Brant brings Bevel Pay")
	check(String(Rules.EXPLICIT_BELL[3]["name"]) == "Celia Okell" and String(Rules.EXPLICIT_BELL[3]["form_name"]) == "Stride Fill", "Celia Okell brings Stride Fill")
	check(int(Rules.EXPLICIT_BELL[0]["goal"]) == 18 and int(Rules.EXPLICIT_BELL[1]["goal"]) == 20 and int(Rules.EXPLICIT_BELL[2]["goal"]) == 16 and int(Rules.EXPLICIT_BELL[3]["goal"]) == 22, "the explicit goals stay 18, 20, 16, and 22")
	check(int(Rules.EXPLICIT_BELL[0]["patience"]) == 5 and int(Rules.EXPLICIT_BELL[1]["patience"]) == 5 and int(Rules.EXPLICIT_BELL[2]["patience"]) == 5 and int(Rules.EXPLICIT_BELL[3]["patience"]) == 5, "explicit patience stays 5")
