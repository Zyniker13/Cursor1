	check(ines_pair.last_progress_gained == 4, "one filled neighbor is not enough for Twin Fill")
	var jasper_row = Rules.scripted_encounter(434, 3, ["entry_mark", "entry_mark", "entry_mark"], 3, Rules.SHIFT_CORRIGENDA)
