func test_valediction_bell_opens() -> void:
	check(Rules.SHIFT_VALEDICTION == 49, "the valediction bell is night 50")
	check(Rules.SHIFT_CORRIGENDA == 41, "the corrigenda bell stays night 42")
	check(Rules.SHIFT_ENVOI == 40, "the envoi bell stays night 41")
	check(Rules.SHIFT_ADDENDA == 39, "the addenda bell stays night 40")
	check(Rules.VALEDICTION_BELL.size() == 4, "the valediction bell has four travelers")
	check(String(Rules.VALEDICTION_BELL[0]["name"]) == "Theo Hale", "the valediction bell begins with Theo Hale")
	check(String(Rules.VALEDICTION_BELL[1]["name"]) == "Rolf Voss", "the valediction bell's second traveler is Rolf Voss")
	check(String(Rules.VALEDICTION_BELL[2]["name"]) == "Inga Brant", "the valediction bell's third traveler is Inga Brant")
	check(String(Rules.VALEDICTION_BELL[3]["name"]) == "Elin Okell", "the valediction bell ends with Elin Okell")
	check(int(Rules.VALEDICTION_BELL[0]["goal"]) == 18 and int(Rules.VALEDICTION_BELL[1]["goal"]) == 20 and int(Rules.VALEDICTION_BELL[2]["goal"]) == 16 and int(Rules.VALEDICTION_BELL[3]["goal"]) == 22, "the valediction goals stay 18, 20, 16, and 22")
	check(Rules.CORRIGENDA_BELL.size() == 4 and String(Rules.CORRIGENDA_BELL[0]["name"]) == "Vera Hale", "the corrigenda bell still begins with Vera Hale")
	check(String(Rules.CORRIGENDA_BELL[1]["name"]) == "Felix Voss" and String(Rules.CORRIGENDA_BELL[2]["name"]) == "Rhea Brant" and String(Rules.CORRIGENDA_BELL[3]["name"]) == "Jasper Okell", "the corrigenda bell still ends with Jasper Okell")
	var valediction_run = Rules.new_run(89, Rules.SHIFT_VALEDICTION)
	check(valediction_run.shift == Rules.SHIFT_VALEDICTION, "the valediction bell is a separate night")
	check(Rules.shift_label(valediction_run) == "Valediction bell", "the valediction bell keeps its name")
	check(String(Rules.traveler(valediction_run)["name"]) == "Theo Hale", "the valediction bell begins with Theo Hale")
	check(valediction_run.hand.size() == Rules.HAND_SIZE, "the valediction bell draws 5")
	check(valediction_run.ink == Rules.BASE_INK, "the valediction bell starts at 3 ink")
	check(valediction_run.library.size() == Rules.STARTING_DECK.size(), "the valediction bell deals the starting deck")
	check(valediction_run.relic_id == "", "an earlier night's relic does not carry")
	check(valediction_run.phase == "play", "the valediction bell opens in play")
	var dealt: Array = []
	for iid in valediction_run.hand:
		dealt.append(Rules.card_id_of(valediction_run, int(iid)))
	var before = valediction_run.library.size()
	valediction_run.progress = 4
	valediction_run.patience = 1
	Rules.restart_encounter(valediction_run)
	check(valediction_run.shift == Rules.SHIFT_VALEDICTION and valediction_run.traveler_index == 0, "restart encounter stays on the valediction bell")
	check(valediction_run.progress == 0 and valediction_run.patience == int(Rules.VALEDICTION_BELL[0]["patience"]), "restart encounter resets Theo")
	check(valediction_run.library.size() == before and valediction_run.hand.size() == 5 and valediction_run.phase == "play", "restart keeps the valediction-bell deck and deals a hand")
	var redealt: Array = []
