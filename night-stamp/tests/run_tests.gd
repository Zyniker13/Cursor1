func test_policy_clears_contents_bell() -> void:
	var started = Time.get_ticks_msec()
	var state = Rules.new_run(12345, Rules.SHIFT_CONTENTS)
	var steps = 0
	var seen = 0
	while state.phase != "victory":
		steps += 1
		if steps > 500 or state.phase == "defeat":
			check(false, "policy lost or stalled on the contents bell, seed 12345: " + Rules.debug_summary(state))
			return
		var action = Policy.choose(state)
		if not Rules.apply_action(state, action):
			check(false, "contents-bell policy action was rejected: %s / %s" % [str(action), Rules.debug_summary(state)])
			return
		if state.encounters_cleared != seen:
			seen = state.encounters_cleared
			print("cleared contents encounter %d after %d actions" % [seen, steps])
	var elapsed = Time.get_ticks_msec() - started
	check(state.encounters_cleared == 4, "policy cleared all 4 contents-bell encounters on seed 12345")
	check(state.phase == "victory", "contents bell ends in victory")
	check(state.shift == Rules.SHIFT_CONTENTS, "the clear stayed on the contents bell")
	check(steps == 24, "seed 12345 clears the contents bell in 24 actions")
	print("contents bell finished in %d actions, %d ms" % [steps, elapsed])


func test_introduction_bell_rules() -> void:
	var quin = Rules.scripted_encounter(331, 0, ["entry_mark", "entry_mark"], 2, Rules.SHIFT_INTRODUCTION)
	check(String(Rules.traveler(quin)["name"]) == "Quin Hale", "the introduction bell's first form is Quin Hale")
	check(String(Rules.traveler(quin)["form_name"]) == "Span Toll", "Quin brings the Span Toll")
	check(String(Rules.traveler(quin)["rule_text"]) == "Patience drops by 2 when the number of filled cells is 5 or 6.", "Quin's form states the span toll")
	check(String(Rules.traveler(quin)["rule"]) == "drop_if_span_count", "Quin's rule is the span toll")
	check(int(Rules.traveler(quin)["lane"]) == 1 and int(Rules.traveler(quin)["exemption_row"]) == 1, "Quin waits in column 2 and exempts the middle row")
	check(int(Rules.traveler(quin)["goal"]) == 18, "Quin's goal is 18")
	check(int(Rules.traveler(quin)["patience"]) == 5, "Quin's patience is 5")
	check(Rules.preview_progress(quin, "duty", 2, 2) == 4, "preview leaves a duty at its own number")
	check(play_named(quin, "entry_mark", 0, 0), "the first stamp leaves Quin's turn open")
	check(quin.phase == "play", "Quin's first stamp does not end the turn")
	check(play_named(quin, "entry_mark", 0, 1), "the stamp beside it, the correct stamp")
	check(quin.last_progress_gained == 4, "two stamps score their own numbers (%d)" % quin.last_progress_gained)
	check(quin.last_patience_loss == 1 and quin.patience == 4, "a count of two keeps the drop at 1")

	var quin_one = Rules.scripted_encounter(331, 0, ["duty"], 1, Rules.SHIFT_INTRODUCTION)
	check(play_named(quin_one, "duty", 2, 2), "Quin receives one bottom-row duty, the correct stamp")
	check(quin_one.last_progress_gained == 4, "one stamp scores its own number (%d)" % quin_one.last_progress_gained)
	check(quin_one.last_patience_loss == 1, "one filled cell keeps the drop at 1")

	var quin_empty = Rules.scripted_encounter(331, 0, ["entry_mark"], 3, Rules.SHIFT_INTRODUCTION)
	Rules.end_turn(quin_empty)
	check(quin_empty.last_progress_gained == 0, "an empty form scores nothing")
	check(quin_empty.last_patience_loss == 1, "an empty form keeps the drop at 1")

	var quin_five = Rules.scripted_encounter(331, 0, ["entry_mark", "entry_mark", "entry_mark", "entry_mark", "entry_mark"], 5, Rules.SHIFT_INTRODUCTION)
	check(play_named(quin_five, "entry_mark", 0, 0), "a stamp")
	check(play_named(quin_five, "entry_mark", 0, 1), "a second stamp")
	check(play_named(quin_five, "entry_mark", 0, 2), "a third stamp")
	check(play_named(quin_five, "entry_mark", 1, 0), "a fourth stamp")
	check(play_named(quin_five, "entry_mark", 1, 1), "Quin receives the fifth stamp, the wrong stamp")
	check(quin_five.last_progress_gained == 10, "five stamps score their own numbers (%d)" % quin_five.last_progress_gained)
	check(quin_five.last_patience_loss == 2, "a count of five drops patience by 2")

	expect_toll(Rules.SHIFT_INTRODUCTION, 0, 0, 1, "a count of zero keeps the drop at 1")
	expect_toll(Rules.SHIFT_INTRODUCTION, 0, 1, 1, "a count of one keeps the drop at 1")
	expect_toll(Rules.SHIFT_INTRODUCTION, 0, 2, 1, "a count of two keeps the drop at 1")
	expect_toll(Rules.SHIFT_INTRODUCTION, 0, 3, 1, "a count of three keeps the drop at 1")
	expect_toll(Rules.SHIFT_INTRODUCTION, 0, 4, 1, "a count of four keeps the drop at 1")
	expect_toll(Rules.SHIFT_INTRODUCTION, 0, 5, 2, "a count of five drops patience by 2")
	expect_toll(Rules.SHIFT_INTRODUCTION, 0, 6, 2, "a count of six drops patience by 2")
	expect_toll(Rules.SHIFT_INTRODUCTION, 0, 7, 1, "a count of seven keeps the drop at 1")
	expect_toll(Rules.SHIFT_INTRODUCTION, 0, 8, 1, "a count of eight keeps the drop at 1")
	expect_toll(Rules.SHIFT_INTRODUCTION, 0, 9, 1, "a count of nine keeps the drop at 1", 0, 0)

