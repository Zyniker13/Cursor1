func test_introduction_bell_opens() -> void:
	check(Rules.SHIFT_INTRODUCTION == 32, "the introduction bell is night 33")
	check(Rules.SHIFT_CONTENTS == 31, "the contents bell stays night 32")
	check(Rules.SHIFT_FOREWORD == 30, "the foreword bell stays night 31")
	check(Rules.SHIFT_PREFACE == 29, "the preface bell stays night 30")
	check(Rules.SHIFT_EPIGRAPH == 28, "the epigraph bell stays night 29")
	check(Rules.INTRODUCTION_BELL.size() == 4, "the introduction bell has four travelers")
	check(String(Rules.INTRODUCTION_BELL[0]["name"]) == "Quin Hale", "the introduction bell begins with Quin Hale")
	check(String(Rules.INTRODUCTION_BELL[1]["name"]) == "Brea Voss", "the introduction bell's second traveler is Brea Voss")
