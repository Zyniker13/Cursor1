	check(desk.finale_button.text == "Finale bell", "the desk still offers the finale bell")
	check(desk.envoy_button.text == "Envoy bell", "the desk still offers the envoy bell")
	check(desk.finis_button.text == "Finis bell", "the desk still offers the finis bell")
	check(desk.finale_button.get_index() + 1 == desk.epode_button.get_index(), "the epode button sits immediately right of finale")
	check(desk.envoy_button.get_index() + 1 == desk.finale_button.get_index(), "envoy stays left of finale")
	check(desk.finis_button.get_index() + 1 == desk.envoy_button.get_index(), "finis stays left of envoy")
