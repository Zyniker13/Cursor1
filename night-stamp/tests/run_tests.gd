func test_prime_bell_opens() -> void:
	check(Rules.SHIFT_PRIME == 57, "the prime bell is night 58")
	check(Rules.SHIFT_LAUDS == 56, "the lauds bell stays night 57")
	check(Rules.SHIFT_MATINS == 55, "the matins bell stays night 56")
	check(Rules.SHIFT_AUBADE == 54, "the aubade bell stays night 55")
	check(Rules.SHIFT_VESPERS == 53, "the vespers bell stays night 54")
	check(Rules.SHIFT_COMPLINE == 52, "the compline bell stays night 53")
	check(Rules.SHIFT_NOCTURNE == 51, "the nocturne bell stays night 52")
	check(Rules.SHIFT_RECESSIONAL == 50, "the recessional bell stays night 51")
	check(Rules.SHIFT_VALEDICTION == 49, "the valediction bell stays night 50")
	check(Rules.SHIFT_CORRIGENDA == 41, "the corrigenda bell stays night 42")
	check(Rules.SHIFT_ENVOI == 40, "the envoi bell stays night 41")
	check(Rules.SHIFT_ADDENDA == 39, "the addenda bell stays night 40")
	check(Rules.PRIME_BELL.size() == 4, "the prime bell has four travelers")
	check(String(Rules.PRIME_BELL[0]["name"]) == "Siv Moen", "the prime bell begins with Siv Moen")
	check(String(Rules.PRIME_BELL[1]["name"]) == "Halvard Falk", "the prime bell's second traveler is Halvard Falk")
	check(String(Rules.PRIME_BELL[2]["name"]) == "Eira Skog", "the prime bell's third traveler is Eira Skog")
	check(String(Rules.PRIME_BELL[3]["name"]) == "Runar Nore", "the prime bell ends with Runar Nore")
	check(int(Rules.PRIME_BELL[0]["goal"]) == 18 and int(Rules.PRIME_BELL[1]["goal"]) == 20 and int(Rules.PRIME_BELL[2]["goal"]) == 16 and int(Rules.PRIME_BELL[3]["goal"]) == 22, "the prime goals stay 18, 20, 16, and 22")
	check(Rules.CORRIGENDA_BELL.size() == 4 and String(Rules.CORRIGENDA_BELL[0]["name"]) == "Vera Hale", "the corrigenda bell still begins with Vera Hale")
	check(String(Rules.CORRIGENDA_BELL[1]["name"]) == "Felix Voss" and String(Rules.CORRIGENDA_BELL[2]["name"]) == "Rhea Brant" and String(Rules.CORRIGENDA_BELL[3]["name"]) == "Jasper Okell", "the corrigenda bell still ends with Jasper Okell")
	var prime_run = Rules.new_run(89, Rules.SHIFT_PRIME)
	check(prime_run.shift == Rules.SHIFT_PRIME, "the prime bell is a separate night")
	check(Rules.shift_label(prime_run) == "Prime bell", "the prime bell keeps its name")
	check(String(Rules.traveler(prime_run)["name"]) == "Siv Moen", "the prime bell begins with Siv Moen")
	check(prime_run.hand.size() == Rules.HAND_SIZE, "the prime bell draws 5")
	check(prime_run.ink == Rules.BASE_INK, "the prime bell starts at 3 ink")
	check(prime_run.library.size() == Rules.STARTING_DECK.size(), "the prime bell deals the starting deck")
	check(prime_run.relic_id == "", "an earlier night's relic does not carry")
	check(prime_run.phase == "play", "the prime bell opens in play")
	var dealt: Array = []
	for iid in prime_run.hand:
		dealt.append(Rules.card_id_of(prime_run, int(iid)))
	var before = prime_run.library.size()
	prime_run.progress = 4
	prime_run.patience = 1
	Rules.restart_encounter(prime_run)
	check(prime_run.shift == Rules.SHIFT_PRIME and prime_run.traveler_index == 0, "restart encounter stays on the prime bell")
	check(prime_run.progress == 0 and prime_run.patience == int(Rules.PRIME_BELL[0]["patience"]), "restart encounter resets Siv")
	check(prime_run.library.size() == before and prime_run.hand.size() == 5 and prime_run.phase == "play", "restart keeps the prime-bell deck and deals a hand")
	var redealt: Array = []
	for iid in prime_run.hand:
		redealt.append(Rules.card_id_of(prime_run, int(iid)))
	check(redealt == dealt, "restart deals Siv the same hand")

	var packed = load("res://game/main.tscn")
	var desk = packed.instantiate()
	root.add_child(desk)
	if desk.state == null:
		desk._ready()
	check(desk.state.shift == Rules.SHIFT_FIRST, "the desk still opens on Act 1")
	check(Rules.SHIFT_EPILOGUE == 42, "the epilogue bell stays night 43")
	check(Rules.SHIFT_CODA == 43, "the coda bell stays night 44")
	check(Rules.SHIFT_EPODE == 48, "the epode bell stays night 49")
	check(Rules.SHIFT_FINALE == 47, "the finale bell stays night 48")
	check(Rules.SHIFT_ENVOY == 46, "the envoy bell stays night 47")
	check(Rules.SHIFT_FINIS == 45, "the finis bell stays night 46")
