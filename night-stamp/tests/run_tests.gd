	var simon_spared = Rules.scripted_encounter(442, 1, ["exemption", "entry_mark", "entry_mark"], 3, Rules.SHIFT_CODA)
	check(play_named(simon_spared, "exemption", 0, 1), "exemption on Simon's top row")
