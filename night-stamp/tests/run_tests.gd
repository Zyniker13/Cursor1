func test_policy_clears_prime_bell() -> void:
	var started = Time.get_ticks_msec()
	var state = Rules.new_run(12345, Rules.SHIFT_PRIME)
	var steps = 0
	var seen = 0
	while state.phase != "victory":
		steps += 1
		if steps > 500 or state.phase == "defeat":
			check(false, "policy lost or stalled on the prime bell, seed 12345: " + Rules.debug_summary(state))
			return
		var action = Policy.choose(state)
		if not Rules.apply_action(state, action):
			check(false, "prime-bell policy action was rejected: %s / %s" % [str(action), Rules.debug_summary(state)])
			return
		if state.encounters_cleared != seen:
			seen = state.encounters_cleared
			print("cleared prime encounter %d after %d actions" % [seen, steps])
	var elapsed = Time.get_ticks_msec() - started
	check(state.encounters_cleared == 4, "policy cleared all 4 prime-bell encounters on seed 12345")
	check(state.phase == "victory", "prime bell ends in victory")
	check(state.shift == Rules.SHIFT_PRIME, "the clear stayed on the prime bell")
	check(steps == 32, "seed 12345 clears the prime bell in 32 actions")
	print("prime bell finished in %d actions, %d ms" % [steps, elapsed])
