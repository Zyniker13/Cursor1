	check(colin_wing.last_progress_gained == 2, "Lane Pay does not add 2 to the left middle (%d)" % colin_wing.last_progress_gained)

	var weske_wing = Rules.scripted_encounter(204, 3, ["entry_mark"], 1, Rules.SHIFT_ERRATA)
