func test_policy_clears_epode_bell() -> void:
	var started = Time.get_ticks_msec()
	var state = Rules.new_run(12345, Rules.SHIFT_EPODE)
	var steps = 0
	var seen = 0
	while state.phase != "victory":
		steps += 1
		if steps > 500 or state.phase == "defeat":
			check(false, "policy lost or stalled on the epode bell, seed 12345: " + Rules.debug_summary(state))
			return
		var action = Policy.choose(state)
		if not Rules.apply_action(state, action):
			check(false, "epode-bell policy action was rejected: %s / %s" % [str(action), Rules.debug_summary(state)])
			return
		if state.encounters_cleared != seen:
			seen = state.encounters_cleared
			print("cleared epode encounter %d after %d actions" % [seen, steps])
	var elapsed = Time.get_ticks_msec() - started
	check(state.encounters_cleared == 4, "policy cleared all 4 epode-bell encounters on seed 12345")
	check(state.phase == "victory", "epode bell ends in victory")
	check(state.shift == Rules.SHIFT_EPODE, "the clear stayed on the epode bell")
	check(steps == 30, "seed 12345 clears the epode bell in 30 actions")
	print("epode bell finished in %d actions, %d ms" % [steps, elapsed])


func test_valediction_bell_rules() -> void:
	check(Rules.VALEDICTION_BELL.size() == 4, "the valediction bell has four travelers")
	check(String(Rules.VALEDICTION_BELL[0]["name"]) == "Theo Hale" and String(Rules.VALEDICTION_BELL[0]["form_name"]) == "Dent Toll", "Theo Hale brings Dent Toll")
	check(String(Rules.VALEDICTION_BELL[1]["name"]) == "Rolf Voss" and String(Rules.VALEDICTION_BELL[1]["form_name"]) == "Peg Fill", "Rolf Voss brings Peg Fill")
	check(String(Rules.VALEDICTION_BELL[2]["name"]) == "Inga Brant" and String(Rules.VALEDICTION_BELL[2]["form_name"]) == "Bolt Pay", "Inga Brant brings Bolt Pay")
	check(String(Rules.VALEDICTION_BELL[3]["name"]) == "Elin Okell" and String(Rules.VALEDICTION_BELL[3]["form_name"]) == "Peg Blank", "Elin Okell brings Peg Blank")
	check(int(Rules.VALEDICTION_BELL[0]["goal"]) == 18 and int(Rules.VALEDICTION_BELL[1]["goal"]) == 20 and int(Rules.VALEDICTION_BELL[2]["goal"]) == 16 and int(Rules.VALEDICTION_BELL[3]["goal"]) == 22, "the valediction goals stay 18, 20, 16, and 22")
	check(int(Rules.VALEDICTION_BELL[0]["patience"]) == 5 and int(Rules.VALEDICTION_BELL[1]["patience"]) == 5 and int(Rules.VALEDICTION_BELL[2]["patience"]) == 5 and int(Rules.VALEDICTION_BELL[3]["patience"]) == 5, "valediction patience stays 5")
	check(int(Rules.VALEDICTION_BELL[0]["lane"]) == 0 and int(Rules.VALEDICTION_BELL[0]["exemption_row"]) == 1, "Theo stands in column 1 with a middle exemption")
	check(int(Rules.VALEDICTION_BELL[1]["lane"]) == 1 and int(Rules.VALEDICTION_BELL[1]["exemption_row"]) == 0, "Rolf stands in column 2 with a top exemption")
	check(int(Rules.VALEDICTION_BELL[2]["lane"]) == 2 and int(Rules.VALEDICTION_BELL[2]["exemption_row"]) == 1, "Inga stands in column 3 with a middle exemption")
	check(int(Rules.VALEDICTION_BELL[3]["lane"]) == 1 and int(Rules.VALEDICTION_BELL[3]["exemption_row"]) == 2, "Elin stands in column 2 with a bottom exemption")
	check(String(Rules.EPODE_BELL[0]["name"]) == "Alma Hale" and String(Rules.EPODE_BELL[0]["form_name"]) == "Fork Toll", "the epode bell still begins with Alma Hale")
	check(String(Rules.EPODE_BELL[1]["form_name"]) == "Yoke Fill" and String(Rules.EPODE_BELL[2]["form_name"]) == "Hasp Pay" and String(Rules.EPODE_BELL[3]["form_name"]) == "Yoke Blank", "the epode forms stay Fork Toll, Yoke Fill, Hasp Pay, and Yoke Blank")
