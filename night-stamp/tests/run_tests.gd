func test_explicit_bell_opens() -> void:
	check(Rules.SHIFT_EXPLICIT == 44, "the explicit bell is night 45")
	check(Rules.SHIFT_CORRIGENDA == 41, "the corrigenda bell stays night 42")
	check(Rules.SHIFT_ENVOI == 40, "the envoi bell stays night 41")
	check(Rules.SHIFT_ADDENDA == 39, "the addenda bell stays night 40")
	check(Rules.EXPLICIT_BELL.size() == 4, "the explicit bell has four travelers")
	check(String(Rules.EXPLICIT_BELL[0]["name"]) == "Edgar Hale", "the explicit bell begins with Edgar Hale")
	check(String(Rules.EXPLICIT_BELL[1]["name"]) == "Helen Voss", "the explicit bell's second traveler is Helen Voss")
	check(String(Rules.EXPLICIT_BELL[2]["name"]) == "Mira Brant", "the explicit bell's third traveler is Mira Brant")
	check(String(Rules.EXPLICIT_BELL[3]["name"]) == "Celia Okell", "the explicit bell ends with Celia Okell")
	check(int(Rules.EXPLICIT_BELL[0]["goal"]) == 18 and int(Rules.EXPLICIT_BELL[1]["goal"]) == 20 and int(Rules.EXPLICIT_BELL[2]["goal"]) == 16 and int(Rules.EXPLICIT_BELL[3]["goal"]) == 22, "the explicit goals stay 18, 20, 16, and 22")
	check(Rules.CORRIGENDA_BELL.size() == 4 and String(Rules.CORRIGENDA_BELL[0]["name"]) == "Vera Hale", "the corrigenda bell still begins with Vera Hale")
	check(String(Rules.CORRIGENDA_BELL[1]["name"]) == "Felix Voss" and String(Rules.CORRIGENDA_BELL[2]["name"]) == "Rhea Brant" and String(Rules.CORRIGENDA_BELL[3]["name"]) == "Jasper Okell", "the corrigenda bell still ends with Jasper Okell")
	var explicit_run = Rules.new_run(89, Rules.SHIFT_EXPLICIT)
	check(explicit_run.shift == Rules.SHIFT_EXPLICIT, "the explicit bell is a separate night")
	check(Rules.shift_label(explicit_run) == "Explicit bell", "the explicit bell keeps its name")
	check(String(Rules.traveler(explicit_run)["name"]) == "Edgar Hale", "the explicit bell begins with Edgar Hale")
	check(explicit_run.hand.size() == Rules.HAND_SIZE, "the explicit bell draws 5")
	check(explicit_run.ink == Rules.BASE_INK, "the explicit bell starts at 3 ink")
	check(explicit_run.library.size() == Rules.STARTING_DECK.size(), "the explicit bell deals the starting deck")
	check(explicit_run.relic_id == "", "an earlier night's relic does not carry")
	check(explicit_run.phase == "play", "the explicit bell opens in play")
	var dealt: Array = []
	for iid in explicit_run.hand:
		dealt.append(Rules.card_id_of(explicit_run, int(iid)))
	var before = explicit_run.library.size()
	explicit_run.progress = 4
	explicit_run.patience = 1
	Rules.restart_encounter(explicit_run)
	check(explicit_run.shift == Rules.SHIFT_EXPLICIT and explicit_run.traveler_index == 0, "restart encounter stays on the explicit bell")
	check(explicit_run.progress == 0 and explicit_run.patience == int(Rules.EXPLICIT_BELL[0]["patience"]), "restart encounter resets Edgar")
	check(explicit_run.library.size() == before and explicit_run.hand.size() == 5 and explicit_run.phase == "play", "restart keeps the explicit-bell deck and deals a hand")
	var redealt: Array = []
	for iid in explicit_run.hand:
		redealt.append(Rules.card_id_of(explicit_run, int(iid)))
	check(redealt == dealt, "restart deals Edgar the same hand")

	var packed = load("res://game/main.tscn")
	var desk = packed.instantiate()
	root.add_child(desk)
	if desk.state == null:
		desk._ready()
	check(desk.state.shift == Rules.SHIFT_FIRST, "the desk still opens on Act 1")
	check(Rules.SHIFT_EPILOGUE == 42, "the epilogue bell stays night 43")
	check(Rules.SHIFT_CODA == 43, "the coda bell stays night 44")
	check(desk.explicit_button != desk.coda_button, "the explicit button does not replace the coda button")
