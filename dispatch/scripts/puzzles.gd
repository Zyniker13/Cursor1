static func unlocked_at(index: int) -> Array:
	var puzzles := all()
	var names: Array = []
	var last := mini(index, puzzles.size() - 1)
	for i in range(last + 1):
		var introduced := str(puzzles[i].get("unlocks", ""))
		if introduced != "" and not names.has(introduced):
			names.append(introduced)
	return names


static func _puzzle(id: int, title: String, unlocks: String, brief: String, how_to: String, hint: String, width: int, height: int, walls: Array, sources: Array, dock: Dictionary, order: Array, reference: Array) -> Dictionary:
	return {
		"id": id,
		"title": title,
		"unlocks": unlocks,
		"brief": brief,
		"how_to": how_to,
		"hint": hint,
		"width": width,
		"height": height,
		"walls": walls,
		"sources": sources,
		"dock": dock,
		"order": order,
		"reference": reference,
		"building": 23 if id >= 163 else 22 if id >= 156 else 21 if id >= 149 else 20 if id >= 142 else 19 if id >= 135 else 18 if id >= 128 else 17 if id >= 121 else 16 if id >= 114 else 15 if id >= 107 else 14 if id >= 100 else 13 if id >= 93 else 12 if id >= 86 else 11 if id >= 79 else 10 if id >= 72 else 9 if id >= 65 else 8 if id >= 58 else 7 if id >= 51 else 6 if id >= 44 else 5 if id >= 37 else 4 if id >= 30 else 3 if id >= 23 else 2 if id >= 16 else 1,
	}


static func _source(x: int, y: int, dir: int, colors: Array) -> Dictionary:
	var parcels: Array = []
	for color in colors:
		parcels.append({"color": str(color), "count": 0})
	return {"x": x, "y": y, "dir": dir, "parcels": parcels}


static func _block(type: String, x: int, y: int, dir: int, color: String = "") -> Dictionary:
	var block := {"type": type, "x": x, "y": y, "dir": dir}
	if color != "":
		block["color"] = color
	return block


static func _cell(x: int, y: int) -> Dictionary:
	return {"x": x, "y": y}
