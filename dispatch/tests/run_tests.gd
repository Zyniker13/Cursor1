	var hop := {
		"width": 5, "height": 1, "walls": [{"x": 2, "y": 0}],
		"sources": [{"x": 0, "y": 0, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 4, "y": 0},
		"order": [{"color": "gray"}],
