	_check(_color_at(_frame(counted, 6), 29, 1) == "red" and _count_at(_frame(counted, 6), 29, 1) == 2, "route 340's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(341), _by_id(341)["reference"])
