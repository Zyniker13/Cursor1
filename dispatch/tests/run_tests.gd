	var gap := {
		"width": 28, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 24, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 27, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
