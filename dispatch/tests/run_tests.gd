		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
