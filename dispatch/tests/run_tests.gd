	_check(not skipped, "the cranse does not enter any of the twenty-one cells in front")
	var short_whisker: Dictionary = Sim.run(hop, [
		{"type": "whisker", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 22, "y": 1, "dir": 0},
