			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the futtock block is rotated" % id)
		for kind in ["loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "futtock", kind))
			_check(not bool(swapped["success"]), "route %d fails if the futtock is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "futtock":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the futtock is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(184), _by_id(184)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 184 starts the parcel facing east on the futtock")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 184 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 6, 1) and _dir_at(_frame(lesson, 4), 6, 1) == 0, "route 184 jumps four cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 184 does not enter the cells in front")
	_check(str(Sim.run(_by_id(184), _swap(_by_id(184), "futtock", "loft"))["reason"]) == "stuck", "route 184's loft lands on the last brick")
	_check(str(Sim.run(_by_id(184), _swap(_by_id(184), "futtock", "vault"))["reason"]) == "stuck", "route 184's vault lands on the middle brick")
	_check(str(Sim.run(_by_id(184), _swap(_by_id(184), "futtock", "keel"))["reason"]) == "stuck", "route 184's keel jumps three cells back")

	var let_futtock: Dictionary = Sim.run(_by_id(185), _by_id(185)["reference"])
	_check(_color_at(_frame(let_futtock, 4), 2, 1) == "red" and _dir_at(_frame(let_futtock, 4), 2, 1) == 0 and _color_at(_frame(let_futtock, 4), 6, 1) == "blue", "route 185 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_futtock, 5), 6, 1) == "red" and _dir_at(_frame(let_futtock, 5), 6, 1) == 0 and _frame(let_futtock, 5).get("delivered", []).size() == 1, "route 185 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(186), _by_id(186)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 186 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 186 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 5, 1) == "red" and _dir_at(_frame(counted, 3), 5, 1) == 0, "route 186 jumps four cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 7, 1) == "red" and _count_at(_frame(counted, 6), 7, 1) == 2, "route 186's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(187), _by_id(187)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 187 waits facing east")
	_check(_at(_frame(clear, 3), 5, 1) and _dir_at(_frame(clear, 3), 5, 1) == 0, "route 187 lands four cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1):
			brick_entered = true
	_check(not brick_entered, "route 187 does not enter any brick")
	_check(str(Sim.run(_by_id(187), _swap(_by_id(187), "futtock", "loft"))["reason"]) == "stuck", "route 187's loft tries to land on the last brick")
	_check(str(Sim.run(_by_id(187), _swap(_by_id(187), "futtock", "vault"))["reason"]) == "stuck", "route 187's vault tries to land on the middle brick")

	var paired: Dictionary = Sim.run(_by_id(188), _by_id(188)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 7) == "red" and _dir_at(_frame(paired, 2), 1, 7) == 0, "route 188 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 6, 2) == "blue" and _dir_at(_frame(paired, 4), 6, 2) == 1, "route 188 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 188 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 188 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 7), Vector2i(6, 2)]:
		for kind in ["loft", "vault", "keel"]:
			var one: Dictionary = Sim.run(_by_id(188), _swap_cell(_by_id(188), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 188 misses the dock if the futtock at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(189), _by_id(189)["reference"])
	_check(_at(_frame(second, 2), 1, 5) and _dir_at(_frame(second, 2), 1, 5) == 0, "route 189 waits on the first futtock facing east")
	_check(_at(_frame(second, 3), 5, 5) and _dir_at(_frame(second, 3), 5, 5) == 0, "route 189 jumps four cells forward and still faces east")
	_check(_at(_frame(second, 5), 5, 4) and _dir_at(_frame(second, 5), 5, 4) == 3, "route 189 reaches the second futtock facing north")
	_check(_at(_frame(second, 6), 5, 4) and _dir_at(_frame(second, 6), 5, 4) == 3, "route 189 waits on the second futtock facing north")
	_check(int(second["cycles"]) == 7, "route 189 jumps four cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(189), _omit_cell(_by_id(189), 1, 5))["success"]), "route 189 fails without the first futtock")
	_check(not bool(Sim.run(_by_id(189), _omit_cell(_by_id(189), 5, 4))["success"]), "route 189 fails without the second futtock")
	for cell in [Vector2i(1, 5), Vector2i(5, 4)]:
		for kind in ["loft", "vault", "keel"]:
			var missed: Dictionary = Sim.run(_by_id(189), _swap_cell(_by_id(189), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 189 misses the dock if the futtock at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(190), _by_id(190)["reference"])
	_check(int(night["cycles"]) < 250, "route 190 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 190 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 190 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 190 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 190 holds red facing east")
	_check(_color_at(_frame(night, 8), 7, 3) == "red" and _dir_at(_frame(night, 8), 7, 3) == 0, "route 190 jumps red four cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 8, 3) == "red" and _dir_at(_frame(night, 10), 8, 3) == 0 and _count_at(_frame(night, 10), 8, 3) == 0, "route 190 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 190 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(190), _swap(_by_id(190), "futtock", "loft"))["success"]), "route 190's loft misses the pause")
	_check(not bool(Sim.run(_by_id(190), _swap(_by_id(190), "futtock", "vault"))["success"]), "route 190's vault misses the pause")
	_check(not bool(Sim.run(_by_id(190), _swap(_by_id(190), "futtock", "keel"))["success"]), "route 190's keel misses the pause")
	_check(not bool(Sim.run(_by_id(190), _swap(_by_id(190), "primer", "painter"))["success"]), "route 190 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(190), _swap(_by_id(190), "filter", "conveyor"))["success"]), "route 190 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(190), _swap(_by_id(190), "counter", "conveyor"))["success"]), "route 190 fails without the counter")


func _keelson_rules() -> void:
	print("keelson")
	var hop := {
		"width": 7, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 6, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "keelson", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a keelson jumps five cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the keelson waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 6, 1), "the keelson does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a keelson does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "keelson", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a keelson is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a keelson does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "keelson", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the keelson")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1):
			skipped = true
	_check(not skipped, "the keelson does not enter any of the four cells in front")
	var short_futtock: Dictionary = Sim.run(hop, [
		{"type": "futtock", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
	])
	_check(not bool(short_futtock["success"]) and _at(_frame(short_futtock, 3), 5, 1) and _dir_at(_frame(short_futtock, 3), 5, 1) == 0, "a futtock lands one cell short of a keelson")
	var short_loft: Dictionary = Sim.run(hop, [
		{"type": "loft", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
	])
	_check(not bool(short_loft["success"]) and _at(_frame(short_loft, 3), 4, 1) and _dir_at(_frame(short_loft, 3), 4, 1) == 0, "a loft lands two cells short of a keelson")
	var short_vault: Dictionary = Sim.run(hop, [
		{"type": "vault", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
	])
	_check(not bool(short_vault["success"]) and _at(_frame(short_vault, 3), 3, 1) and _dir_at(_frame(short_vault, 3), 3, 1) == 0, "a vault lands three cells short of a keelson")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "keelson": Vector2i(1, 4), "land": Vector2i(6, 4), "dock": Vector2i(7, 4), "size": Vector2i(8, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "keelson": Vector2i(1, 1), "land": Vector2i(1, 6), "dock": Vector2i(1, 7), "size": Vector2i(3, 8)},
		{"name": "west", "src": Vector2i(7, 1), "arrival": 2, "keelson": Vector2i(6, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(8, 3)},
		{"name": "north", "src": Vector2i(2, 7), "arrival": 3, "keelson": Vector2i(2, 6), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 8)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var keelson_at: Vector2i = spec["keelson"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "keelson", "x": keelson_at.x, "y": keelson_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps five cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the five-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 8, "height": 6, "walls": [{"x": 7, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 5, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 7, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "keelson", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 6, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "a keelson keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 6, 4) == "blue", "the keelson keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 8, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 4, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 7, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "keelson", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 5, "y": 4, "dir": 0},
		{"type": "pause", "x": 6, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "a keelson can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 6, 4) == "gray" and _dir_at(into, 6, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_twenty_seven() -> void:
	print("building 27")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 197, "building 27 adds routes 191 through 197")
	_check(int(puzzles[189]["id"]) == 190, "route 190 is the last route before the keelson")
	_check(int(puzzles[190]["id"]) == 191, "the keelson begins at route 191")
	_check(Puzzles.INTRO.size() >= 31 and Puzzles.INTRO[30] == "keelson", "the keelson is the block building 27 teaches")
	_check(not Puzzles.unlocked_at(189).has("keelson"), "the keelson stays locked through route 190")
	_check(Puzzles.unlocked_at(190).has("keelson"), "route 191 unlocks the keelson")
	_check(Puzzles.unlocked_at(196).size() == 31, "building 27 ends with every block")
	var pars := {
		191: [6, 3],
		192: [7, 4],
		193: [7, 5],
		194: [5, 2],
		195: [7, 5],
		196: [7, 3],
		197: [17, 16],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 190:
			_check(int(puzzle.get("building", 1)) < 27, "route %d stays out of building 27" % id)
			if id >= 184:
				_check(int(puzzle.get("building", 1)) == 26, "route %d stays in building 26" % id)
			continue
		if id > 197:
			continue
		_check(int(puzzle.get("building", 1)) == 27, "route %d is building 27" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 191:
			_check(str(puzzle.get("unlocks", "")) == "keelson", "route 191 teaches the keelson")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_keelson := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "keelson":
				uses_keelson = true
		_check(uses_keelson, "route %d reference uses the keelson" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [191, 192, 193, 194, 195, 196, 197]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "keelson":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the keelson block is rotated" % id)
		for kind in ["futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "keelson", kind))
			_check(not bool(swapped["success"]), "route %d fails if the keelson is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "keelson":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the keelson is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(191), _by_id(191)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 191 starts the parcel facing east on the keelson")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 191 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 7, 1) and _dir_at(_frame(lesson, 4), 7, 1) == 0, "route 191 jumps five cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 191 does not enter the cells in front")
	_check(str(Sim.run(_by_id(191), _swap(_by_id(191), "keelson", "futtock"))["reason"]) == "stuck", "route 191's futtock lands on the last brick")
	_check(str(Sim.run(_by_id(191), _swap(_by_id(191), "keelson", "loft"))["reason"]) == "stuck", "route 191's loft lands two cells short")
	_check(str(Sim.run(_by_id(191), _swap(_by_id(191), "keelson", "vault"))["reason"]) == "stuck", "route 191's vault lands three cells short")
	_check(str(Sim.run(_by_id(191), _swap(_by_id(191), "keelson", "keel"))["reason"]) == "stuck", "route 191's keel jumps three cells back")

	var let_keelson: Dictionary = Sim.run(_by_id(192), _by_id(192)["reference"])
	_check(_color_at(_frame(let_keelson, 4), 2, 1) == "red" and _dir_at(_frame(let_keelson, 4), 2, 1) == 0 and _color_at(_frame(let_keelson, 4), 7, 1) == "blue", "route 192 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_keelson, 5), 7, 1) == "red" and _dir_at(_frame(let_keelson, 5), 7, 1) == 0 and _frame(let_keelson, 5).get("delivered", []).size() == 1, "route 192 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(193), _by_id(193)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 193 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 193 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 6, 1) == "red" and _dir_at(_frame(counted, 3), 6, 1) == 0, "route 193 jumps five cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 8, 1) == "red" and _count_at(_frame(counted, 6), 8, 1) == 2, "route 193's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(194), _by_id(194)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 194 waits facing east")
	_check(_at(_frame(clear, 3), 6, 1) and _dir_at(_frame(clear, 3), 6, 1) == 0, "route 194 lands five cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1):
			brick_entered = true
	_check(not brick_entered, "route 194 does not enter any brick")
	_check(str(Sim.run(_by_id(194), _swap(_by_id(194), "keelson", "futtock"))["reason"]) == "stuck", "route 194's futtock tries to land on the last brick")
	_check(str(Sim.run(_by_id(194), _swap(_by_id(194), "keelson", "loft"))["reason"]) == "stuck", "route 194's loft lands two cells short")

	var paired: Dictionary = Sim.run(_by_id(195), _by_id(195)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 8) == "red" and _dir_at(_frame(paired, 2), 1, 8) == 0, "route 195 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 7, 2) == "blue" and _dir_at(_frame(paired, 4), 7, 2) == 1, "route 195 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 195 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 195 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 8), Vector2i(7, 2)]:
		for kind in ["futtock", "loft", "vault", "keel"]:
			var one: Dictionary = Sim.run(_by_id(195), _swap_cell(_by_id(195), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 195 misses the dock if the keelson at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(196), _by_id(196)["reference"])
	_check(_at(_frame(second, 2), 1, 6) and _dir_at(_frame(second, 2), 1, 6) == 0, "route 196 waits on the first keelson facing east")
	_check(_at(_frame(second, 3), 6, 6) and _dir_at(_frame(second, 3), 6, 6) == 0, "route 196 jumps five cells forward and still faces east")
	_check(_at(_frame(second, 5), 6, 5) and _dir_at(_frame(second, 5), 6, 5) == 3, "route 196 reaches the second keelson facing north")
	_check(_at(_frame(second, 6), 6, 5) and _dir_at(_frame(second, 6), 6, 5) == 3, "route 196 waits on the second keelson facing north")
	_check(int(second["cycles"]) == 7, "route 196 jumps five cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(196), _omit_cell(_by_id(196), 1, 6))["success"]), "route 196 fails without the first keelson")
	_check(not bool(Sim.run(_by_id(196), _omit_cell(_by_id(196), 6, 5))["success"]), "route 196 fails without the second keelson")
	for cell in [Vector2i(1, 6), Vector2i(6, 5)]:
		for kind in ["futtock", "loft", "vault", "keel"]:
			var missed: Dictionary = Sim.run(_by_id(196), _swap_cell(_by_id(196), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 196 misses the dock if the keelson at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(197), _by_id(197)["reference"])
	_check(int(night["cycles"]) < 250, "route 197 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 197 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 197 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 197 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 197 holds red facing east")
	_check(_color_at(_frame(night, 8), 8, 3) == "red" and _dir_at(_frame(night, 8), 8, 3) == 0, "route 197 jumps red five cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 9, 3) == "red" and _dir_at(_frame(night, 10), 9, 3) == 0 and _count_at(_frame(night, 10), 9, 3) == 0, "route 197 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 197 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(197), _swap(_by_id(197), "keelson", "futtock"))["success"]), "route 197's futtock misses the pause")
	_check(not bool(Sim.run(_by_id(197), _swap(_by_id(197), "keelson", "loft"))["success"]), "route 197's loft misses the pause")
	_check(not bool(Sim.run(_by_id(197), _swap(_by_id(197), "keelson", "vault"))["success"]), "route 197's vault misses the pause")
	_check(not bool(Sim.run(_by_id(197), _swap(_by_id(197), "keelson", "keel"))["success"]), "route 197's keel misses the pause")
	_check(not bool(Sim.run(_by_id(197), _swap(_by_id(197), "primer", "painter"))["success"]), "route 197 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(197), _swap(_by_id(197), "filter", "conveyor"))["success"]), "route 197 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(197), _swap(_by_id(197), "counter", "conveyor"))["success"]), "route 197 fails without the counter")


func _stemson_rules() -> void:
	print("stemson")
	var hop := {
		"width": 8, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 7, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "stemson", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a stemson jumps six cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the stemson waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 7, 1), "the stemson does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a stemson does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "stemson", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a stemson is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a stemson does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "stemson", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the stemson")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1):
			skipped = true
	_check(not skipped, "the stemson does not enter any of the five cells in front")
	var short_keelson: Dictionary = Sim.run(hop, [
		{"type": "keelson", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
	])
	_check(not bool(short_keelson["success"]) and _at(_frame(short_keelson, 3), 6, 1) and _dir_at(_frame(short_keelson, 3), 6, 1) == 0, "a keelson lands one cell short of a stemson")
	var short_futtock: Dictionary = Sim.run(hop, [
		{"type": "futtock", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
	])
	_check(not bool(short_futtock["success"]) and _at(_frame(short_futtock, 3), 5, 1) and _dir_at(_frame(short_futtock, 3), 5, 1) == 0, "a futtock lands two cells short of a stemson")
	var short_loft: Dictionary = Sim.run(hop, [
		{"type": "loft", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
	])
	_check(not bool(short_loft["success"]) and _at(_frame(short_loft, 3), 4, 1) and _dir_at(_frame(short_loft, 3), 4, 1) == 0, "a loft lands three cells short of a stemson")
	var short_vault: Dictionary = Sim.run(hop, [
		{"type": "vault", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
	])
	_check(not bool(short_vault["success"]) and _at(_frame(short_vault, 3), 3, 1) and _dir_at(_frame(short_vault, 3), 3, 1) == 0, "a vault lands four cells short of a stemson")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "stemson": Vector2i(1, 4), "land": Vector2i(7, 4), "dock": Vector2i(8, 4), "size": Vector2i(9, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "stemson": Vector2i(1, 1), "land": Vector2i(1, 7), "dock": Vector2i(1, 8), "size": Vector2i(3, 9)},
		{"name": "west", "src": Vector2i(8, 1), "arrival": 2, "stemson": Vector2i(7, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(9, 3)},
		{"name": "north", "src": Vector2i(2, 8), "arrival": 3, "stemson": Vector2i(2, 7), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 9)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var stemson_at: Vector2i = spec["stemson"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "stemson", "x": stemson_at.x, "y": stemson_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps six cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the six-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 9, "height": 6, "walls": [{"x": 8, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 6, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 8, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "stemson", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 7, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "a stemson keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 7, 4) == "blue", "the stemson keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 9, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 5, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 8, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "stemson", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 6, "y": 4, "dir": 0},
		{"type": "pause", "x": 7, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "a stemson can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 7, 4) == "gray" and _dir_at(into, 7, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_twenty_eight() -> void:
	print("building 28")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 204, "building 28 adds routes 198 through 204")
	_check(int(puzzles[196]["id"]) == 197, "route 197 is the last route before the stemson")
	_check(int(puzzles[197]["id"]) == 198, "the stemson begins at route 198")
	_check(Puzzles.INTRO.size() >= 32 and Puzzles.INTRO[31] == "stemson", "the stemson is the block building 28 teaches")
	_check(not Puzzles.unlocked_at(196).has("stemson"), "the stemson stays locked through route 197")
	_check(Puzzles.unlocked_at(197).has("stemson"), "route 198 unlocks the stemson")
	_check(Puzzles.unlocked_at(203).size() == 32, "building 28 ends with every block")
	var pars := {
		198: [6, 3],
		199: [7, 4],
		200: [7, 5],
		201: [5, 2],
		202: [7, 5],
		203: [7, 3],
		204: [18, 17],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 197:
			_check(int(puzzle.get("building", 1)) < 28, "route %d stays out of building 28" % id)
			if id >= 191:
				_check(int(puzzle.get("building", 1)) == 27, "route %d stays in building 27" % id)
			continue
		if id > 204:
			continue
		_check(int(puzzle.get("building", 1)) == 28, "route %d is building 28" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 198:
			_check(str(puzzle.get("unlocks", "")) == "stemson", "route 198 teaches the stemson")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_stemson := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "stemson":
				uses_stemson = true
		_check(uses_stemson, "route %d reference uses the stemson" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [198, 199, 200, 201, 202, 203, 204]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "stemson":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the stemson block is rotated" % id)
		for kind in ["keelson", "futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "stemson", kind))
			_check(not bool(swapped["success"]), "route %d fails if the stemson is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "stemson":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the stemson is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(198), _by_id(198)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 198 starts the parcel facing east on the stemson")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 198 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 8, 1) and _dir_at(_frame(lesson, 4), 8, 1) == 0, "route 198 jumps six cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 198 does not enter the cells in front")
	_check(str(Sim.run(_by_id(198), _swap(_by_id(198), "stemson", "keelson"))["reason"]) == "stuck", "route 198's keelson lands on the last brick")
	_check(str(Sim.run(_by_id(198), _swap(_by_id(198), "stemson", "futtock"))["reason"]) == "stuck", "route 198's futtock lands two cells short")
	_check(str(Sim.run(_by_id(198), _swap(_by_id(198), "stemson", "loft"))["reason"]) == "stuck", "route 198's loft lands three cells short")
	_check(str(Sim.run(_by_id(198), _swap(_by_id(198), "stemson", "vault"))["reason"]) == "stuck", "route 198's vault lands four cells short")
	_check(str(Sim.run(_by_id(198), _swap(_by_id(198), "stemson", "keel"))["reason"]) == "stuck", "route 198's keel jumps three cells back")

	var let_stemson: Dictionary = Sim.run(_by_id(199), _by_id(199)["reference"])
	_check(_color_at(_frame(let_stemson, 4), 2, 1) == "red" and _dir_at(_frame(let_stemson, 4), 2, 1) == 0 and _color_at(_frame(let_stemson, 4), 8, 1) == "blue", "route 199 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_stemson, 5), 8, 1) == "red" and _dir_at(_frame(let_stemson, 5), 8, 1) == 0 and _frame(let_stemson, 5).get("delivered", []).size() == 1, "route 199 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(200), _by_id(200)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 200 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 200 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 7, 1) == "red" and _dir_at(_frame(counted, 3), 7, 1) == 0, "route 200 jumps six cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 9, 1) == "red" and _count_at(_frame(counted, 6), 9, 1) == 2, "route 200's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(201), _by_id(201)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 201 waits facing east")
	_check(_at(_frame(clear, 3), 7, 1) and _dir_at(_frame(clear, 3), 7, 1) == 0, "route 201 lands six cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1):
			brick_entered = true
	_check(not brick_entered, "route 201 does not enter any brick")
	_check(str(Sim.run(_by_id(201), _swap(_by_id(201), "stemson", "keelson"))["reason"]) == "stuck", "route 201's keelson tries to land on the last brick")
	_check(str(Sim.run(_by_id(201), _swap(_by_id(201), "stemson", "futtock"))["reason"]) == "stuck", "route 201's futtock lands two cells short")

	var paired: Dictionary = Sim.run(_by_id(202), _by_id(202)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 9) == "red" and _dir_at(_frame(paired, 2), 1, 9) == 0, "route 202 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 8, 2) == "blue" and _dir_at(_frame(paired, 4), 8, 2) == 1, "route 202 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 202 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 202 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 9), Vector2i(8, 2)]:
		for kind in ["keelson", "futtock", "loft", "vault"]:
			var one: Dictionary = Sim.run(_by_id(202), _swap_cell(_by_id(202), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 202 misses the dock if the stemson at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(203), _by_id(203)["reference"])
	_check(_at(_frame(second, 2), 1, 7) and _dir_at(_frame(second, 2), 1, 7) == 0, "route 203 waits on the first stemson facing east")
	_check(_at(_frame(second, 3), 7, 7) and _dir_at(_frame(second, 3), 7, 7) == 0, "route 203 jumps six cells forward and still faces east")
	_check(_at(_frame(second, 5), 7, 6) and _dir_at(_frame(second, 5), 7, 6) == 3, "route 203 reaches the second stemson facing north")
	_check(_at(_frame(second, 6), 7, 6) and _dir_at(_frame(second, 6), 7, 6) == 3, "route 203 waits on the second stemson facing north")
	_check(int(second["cycles"]) == 7, "route 203 jumps six cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(203), _omit_cell(_by_id(203), 1, 7))["success"]), "route 203 fails without the first stemson")
	_check(not bool(Sim.run(_by_id(203), _omit_cell(_by_id(203), 7, 6))["success"]), "route 203 fails without the second stemson")
	for cell in [Vector2i(1, 7), Vector2i(7, 6)]:
		for kind in ["keelson", "futtock", "loft", "vault"]:
			var missed: Dictionary = Sim.run(_by_id(203), _swap_cell(_by_id(203), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 203 misses the dock if the stemson at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(204), _by_id(204)["reference"])
	_check(int(night["cycles"]) < 250, "route 204 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 204 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 204 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 204 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 204 holds red facing east")
	_check(_color_at(_frame(night, 8), 9, 3) == "red" and _dir_at(_frame(night, 8), 9, 3) == 0, "route 204 jumps red six cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 10, 3) == "red" and _dir_at(_frame(night, 10), 10, 3) == 0 and _count_at(_frame(night, 10), 10, 3) == 0, "route 204 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red" or _color_at(frame, 8, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 204 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(204), _swap(_by_id(204), "stemson", "keelson"))["success"]), "route 204's keelson misses the pause")
	_check(not bool(Sim.run(_by_id(204), _swap(_by_id(204), "stemson", "futtock"))["success"]), "route 204's futtock misses the pause")
	_check(not bool(Sim.run(_by_id(204), _swap(_by_id(204), "stemson", "loft"))["success"]), "route 204's loft misses the pause")
	_check(not bool(Sim.run(_by_id(204), _swap(_by_id(204), "stemson", "vault"))["success"]), "route 204's vault misses the pause")
	_check(not bool(Sim.run(_by_id(204), _swap(_by_id(204), "primer", "painter"))["success"]), "route 204 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(204), _swap(_by_id(204), "filter", "conveyor"))["success"]), "route 204 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(204), _swap(_by_id(204), "counter", "conveyor"))["success"]), "route 204 fails without the counter")


func _apron_rules() -> void:
	print("apron")
	var hop := {
		"width": 9, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 8, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "apron", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "an apron jumps seven cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the apron waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 8, 1), "the apron does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "an apron does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "apron", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on an apron is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating an apron does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "apron", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the apron")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1):
			skipped = true
	_check(not skipped, "the apron does not enter any of the six cells in front")
	var short_stemson: Dictionary = Sim.run(hop, [
		{"type": "stemson", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
	])
	_check(not bool(short_stemson["success"]) and _at(_frame(short_stemson, 3), 7, 1) and _dir_at(_frame(short_stemson, 3), 7, 1) == 0, "a stemson lands one cell short of an apron")
	var short_keelson: Dictionary = Sim.run(hop, [
		{"type": "keelson", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
	])
	_check(not bool(short_keelson["success"]) and _at(_frame(short_keelson, 3), 6, 1) and _dir_at(_frame(short_keelson, 3), 6, 1) == 0, "a keelson lands two cells short of an apron")
	var short_futtock: Dictionary = Sim.run(hop, [
		{"type": "futtock", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
	])
	_check(not bool(short_futtock["success"]) and _at(_frame(short_futtock, 3), 5, 1) and _dir_at(_frame(short_futtock, 3), 5, 1) == 0, "a futtock lands three cells short of an apron")
	var short_loft: Dictionary = Sim.run(hop, [
		{"type": "loft", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
	])
	_check(not bool(short_loft["success"]) and _at(_frame(short_loft, 3), 4, 1) and _dir_at(_frame(short_loft, 3), 4, 1) == 0, "a loft lands four cells short of an apron")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "apron": Vector2i(1, 4), "land": Vector2i(8, 4), "dock": Vector2i(9, 4), "size": Vector2i(10, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "apron": Vector2i(1, 1), "land": Vector2i(1, 8), "dock": Vector2i(1, 9), "size": Vector2i(3, 10)},
		{"name": "west", "src": Vector2i(9, 1), "arrival": 2, "apron": Vector2i(8, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(10, 3)},
		{"name": "north", "src": Vector2i(2, 9), "arrival": 3, "apron": Vector2i(2, 8), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 10)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var apron_at: Vector2i = spec["apron"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "apron", "x": apron_at.x, "y": apron_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps seven cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the seven-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 10, "height": 6, "walls": [{"x": 9, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 7, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 9, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "apron", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 8, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "an apron keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 8, 4) == "blue", "the apron keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 10, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 6, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 9, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "apron", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 7, "y": 4, "dir": 0},
		{"type": "pause", "x": 8, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "an apron can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 8, 4) == "gray" and _dir_at(into, 8, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_twenty_nine() -> void:
	print("building 29")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 211, "building 29 adds routes 205 through 211")
	_check(int(puzzles[203]["id"]) == 204, "route 204 is the last route before the apron")
	_check(int(puzzles[204]["id"]) == 205, "the apron begins at route 205")
	_check(Puzzles.INTRO.size() >= 33 and Puzzles.INTRO[32] == "apron", "the apron is the block building 29 teaches")
	_check(not Puzzles.unlocked_at(203).has("apron"), "the apron stays locked through route 204")
	_check(Puzzles.unlocked_at(204).has("apron"), "route 205 unlocks the apron")
	_check(Puzzles.unlocked_at(210).size() == 33, "building 29 ends with every block")
	var pars := {
		205: [6, 3],
		206: [7, 4],
		207: [7, 5],
		208: [5, 2],
		209: [7, 5],
		210: [7, 3],
		211: [19, 18],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 204:
			_check(int(puzzle.get("building", 1)) < 29, "route %d stays out of building 29" % id)
			if id >= 198:
				_check(int(puzzle.get("building", 1)) == 28, "route %d stays in building 28" % id)
			continue
		if id > 211:
			continue
		_check(int(puzzle.get("building", 1)) == 29, "route %d is building 29" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 205:
			_check(str(puzzle.get("unlocks", "")) == "apron", "route 205 teaches the apron")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_apron := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "apron":
				uses_apron = true
		_check(uses_apron, "route %d reference uses the apron" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [205, 206, 207, 208, 209, 210, 211]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "apron":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the apron block is rotated" % id)
		for kind in ["stemson", "keelson", "futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "apron", kind))
			_check(not bool(swapped["success"]), "route %d fails if the apron is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "apron":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the apron is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(205), _by_id(205)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 205 starts the parcel facing east on the apron")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 205 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 9, 1) and _dir_at(_frame(lesson, 4), 9, 1) == 0, "route 205 jumps seven cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 205 does not enter the cells in front")
	_check(str(Sim.run(_by_id(205), _swap(_by_id(205), "apron", "stemson"))["reason"]) == "stuck", "route 205's stemson lands on the last brick")
	_check(str(Sim.run(_by_id(205), _swap(_by_id(205), "apron", "keelson"))["reason"]) == "stuck", "route 205's keelson lands two cells short")
	_check(str(Sim.run(_by_id(205), _swap(_by_id(205), "apron", "futtock"))["reason"]) == "stuck", "route 205's futtock lands three cells short")
	_check(str(Sim.run(_by_id(205), _swap(_by_id(205), "apron", "loft"))["reason"]) == "stuck", "route 205's loft lands four cells short")

	var let_apron: Dictionary = Sim.run(_by_id(206), _by_id(206)["reference"])
	_check(_color_at(_frame(let_apron, 4), 2, 1) == "red" and _dir_at(_frame(let_apron, 4), 2, 1) == 0 and _color_at(_frame(let_apron, 4), 9, 1) == "blue", "route 206 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_apron, 5), 9, 1) == "red" and _dir_at(_frame(let_apron, 5), 9, 1) == 0 and _frame(let_apron, 5).get("delivered", []).size() == 1, "route 206 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(207), _by_id(207)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 207 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 207 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 8, 1) == "red" and _dir_at(_frame(counted, 3), 8, 1) == 0, "route 207 jumps seven cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 10, 1) == "red" and _count_at(_frame(counted, 6), 10, 1) == 2, "route 207's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(208), _by_id(208)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 208 waits facing east")
	_check(_at(_frame(clear, 3), 8, 1) and _dir_at(_frame(clear, 3), 8, 1) == 0, "route 208 lands seven cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1):
			brick_entered = true
	_check(not brick_entered, "route 208 does not enter any brick")
	_check(str(Sim.run(_by_id(208), _swap(_by_id(208), "apron", "stemson"))["reason"]) == "stuck", "route 208's stemson tries to land on the last brick")
	_check(str(Sim.run(_by_id(208), _swap(_by_id(208), "apron", "keelson"))["reason"]) == "stuck", "route 208's keelson lands two cells short")

	var paired: Dictionary = Sim.run(_by_id(209), _by_id(209)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 10) == "red" and _dir_at(_frame(paired, 2), 1, 10) == 0, "route 209 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 9, 2) == "blue" and _dir_at(_frame(paired, 4), 9, 2) == 1, "route 209 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 209 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 209 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 10), Vector2i(9, 2)]:
		for kind in ["stemson", "keelson", "futtock", "loft"]:
			var one: Dictionary = Sim.run(_by_id(209), _swap_cell(_by_id(209), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 209 misses the dock if the apron at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(210), _by_id(210)["reference"])
	_check(_at(_frame(second, 2), 1, 8) and _dir_at(_frame(second, 2), 1, 8) == 0, "route 210 waits on the first apron facing east")
	_check(_at(_frame(second, 3), 8, 8) and _dir_at(_frame(second, 3), 8, 8) == 0, "route 210 jumps seven cells forward and still faces east")
	_check(_at(_frame(second, 5), 8, 7) and _dir_at(_frame(second, 5), 8, 7) == 3, "route 210 reaches the second apron facing north")
	_check(_at(_frame(second, 6), 8, 7) and _dir_at(_frame(second, 6), 8, 7) == 3, "route 210 waits on the second apron facing north")
	_check(int(second["cycles"]) == 7, "route 210 jumps seven cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(210), _omit_cell(_by_id(210), 1, 8))["success"]), "route 210 fails without the first apron")
	_check(not bool(Sim.run(_by_id(210), _omit_cell(_by_id(210), 8, 7))["success"]), "route 210 fails without the second apron")
	for cell in [Vector2i(1, 8), Vector2i(8, 7)]:
		for kind in ["stemson", "keelson", "futtock", "loft"]:
			var missed: Dictionary = Sim.run(_by_id(210), _swap_cell(_by_id(210), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 210 misses the dock if the apron at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(211), _by_id(211)["reference"])
	_check(int(night["cycles"]) < 250, "route 211 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 211 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 211 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 211 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 211 holds red facing east")
	_check(_color_at(_frame(night, 8), 10, 3) == "red" and _dir_at(_frame(night, 8), 10, 3) == 0, "route 211 jumps red seven cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 11, 3) == "red" and _dir_at(_frame(night, 10), 11, 3) == 0 and _count_at(_frame(night, 10), 11, 3) == 0, "route 211 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red" or _color_at(frame, 8, 3) == "red" or _color_at(frame, 9, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 211 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(211), _swap(_by_id(211), "apron", "stemson"))["success"]), "route 211's stemson misses the pause")
	_check(not bool(Sim.run(_by_id(211), _swap(_by_id(211), "apron", "keelson"))["success"]), "route 211's keelson misses the pause")
	_check(not bool(Sim.run(_by_id(211), _swap(_by_id(211), "apron", "futtock"))["success"]), "route 211's futtock misses the pause")
	_check(not bool(Sim.run(_by_id(211), _swap(_by_id(211), "primer", "painter"))["success"]), "route 211 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(211), _swap(_by_id(211), "filter", "conveyor"))["success"]), "route 211 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(211), _swap(_by_id(211), "counter", "conveyor"))["success"]), "route 211 fails without the counter")


func _deadwood_rules() -> void:
	print("deadwood")
	var hop := {
		"width": 10, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 9, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "deadwood", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a deadwood jumps eight cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the deadwood waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 9, 1), "the deadwood does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a deadwood does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "deadwood", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a deadwood is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a deadwood does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "deadwood", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the deadwood")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1):
			skipped = true
	_check(not skipped, "the deadwood does not enter any of the seven cells in front")
	var short_apron: Dictionary = Sim.run(hop, [
		{"type": "apron", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
	])
	_check(not bool(short_apron["success"]) and _at(_frame(short_apron, 3), 8, 1) and _dir_at(_frame(short_apron, 3), 8, 1) == 0, "an apron lands one cell short of a deadwood")
	var short_stemson: Dictionary = Sim.run(hop, [
		{"type": "stemson", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
	])
	_check(not bool(short_stemson["success"]) and _at(_frame(short_stemson, 3), 7, 1) and _dir_at(_frame(short_stemson, 3), 7, 1) == 0, "a stemson lands two cells short of a deadwood")
	var short_keelson: Dictionary = Sim.run(hop, [
		{"type": "keelson", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
	])
	_check(not bool(short_keelson["success"]) and _at(_frame(short_keelson, 3), 6, 1) and _dir_at(_frame(short_keelson, 3), 6, 1) == 0, "a keelson lands three cells short of a deadwood")
	var short_futtock: Dictionary = Sim.run(hop, [
		{"type": "futtock", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
	])
	_check(not bool(short_futtock["success"]) and _at(_frame(short_futtock, 3), 5, 1) and _dir_at(_frame(short_futtock, 3), 5, 1) == 0, "a futtock lands four cells short of a deadwood")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "deadwood": Vector2i(1, 4), "land": Vector2i(9, 4), "dock": Vector2i(10, 4), "size": Vector2i(11, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "deadwood": Vector2i(1, 1), "land": Vector2i(1, 9), "dock": Vector2i(1, 10), "size": Vector2i(3, 11)},
		{"name": "west", "src": Vector2i(10, 1), "arrival": 2, "deadwood": Vector2i(9, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(11, 3)},
		{"name": "north", "src": Vector2i(2, 10), "arrival": 3, "deadwood": Vector2i(2, 9), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 11)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var deadwood_at: Vector2i = spec["deadwood"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "deadwood", "x": deadwood_at.x, "y": deadwood_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps eight cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the eight-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 11, "height": 6, "walls": [{"x": 10, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 8, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 10, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "deadwood", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 9, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "a deadwood keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 9, 4) == "blue", "the deadwood keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 11, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 7, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 10, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "deadwood", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 8, "y": 4, "dir": 0},
		{"type": "pause", "x": 9, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "a deadwood can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 9, 4) == "gray" and _dir_at(into, 9, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_thirty() -> void:
	print("building 30")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 218, "building 30 adds routes 212 through 218")
	_check(int(puzzles[210]["id"]) == 211, "route 211 is the last route before the deadwood")
	_check(int(puzzles[211]["id"]) == 212, "the deadwood begins at route 212")
	_check(Puzzles.INTRO.size() >= 34 and Puzzles.INTRO[33] == "deadwood", "the deadwood is the block building 30 teaches")
	_check(not Puzzles.unlocked_at(210).has("deadwood"), "the deadwood stays locked through route 211")
	_check(Puzzles.unlocked_at(211).has("deadwood"), "route 212 unlocks the deadwood")
	_check(Puzzles.unlocked_at(217).size() == 34, "building 30 ends with every block")
	var pars := {
		212: [6, 3],
		213: [7, 4],
		214: [7, 5],
		215: [5, 2],
		216: [7, 5],
		217: [7, 3],
		218: [20, 19],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 211:
			_check(int(puzzle.get("building", 1)) < 30, "route %d stays out of building 30" % id)
			if id >= 205:
				_check(int(puzzle.get("building", 1)) == 29, "route %d stays in building 29" % id)
			continue
		if id > 218:
			continue
		_check(int(puzzle.get("building", 1)) == 30, "route %d is building 30" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 212:
			_check(str(puzzle.get("unlocks", "")) == "deadwood", "route 212 teaches the deadwood")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_deadwood := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "deadwood":
				uses_deadwood = true
		_check(uses_deadwood, "route %d reference uses the deadwood" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [212, 213, 214, 215, 216, 217, 218]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "deadwood":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the deadwood block is rotated" % id)
		for kind in ["apron", "stemson", "keelson", "futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "deadwood", kind))
			_check(not bool(swapped["success"]), "route %d fails if the deadwood is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "deadwood":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the deadwood is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(212), _by_id(212)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 212 starts the parcel facing east on the deadwood")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 212 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 10, 1) and _dir_at(_frame(lesson, 4), 10, 1) == 0, "route 212 jumps eight cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 212 does not enter the cells in front")
	_check(str(Sim.run(_by_id(212), _swap(_by_id(212), "deadwood", "apron"))["reason"]) == "stuck", "route 212's apron lands on the last brick")
	_check(str(Sim.run(_by_id(212), _swap(_by_id(212), "deadwood", "stemson"))["reason"]) == "stuck", "route 212's stemson lands two cells short")
	_check(str(Sim.run(_by_id(212), _swap(_by_id(212), "deadwood", "keelson"))["reason"]) == "stuck", "route 212's keelson lands three cells short")
	_check(str(Sim.run(_by_id(212), _swap(_by_id(212), "deadwood", "futtock"))["reason"]) == "stuck", "route 212's futtock lands four cells short")

	var let_deadwood: Dictionary = Sim.run(_by_id(213), _by_id(213)["reference"])
	_check(_color_at(_frame(let_deadwood, 4), 2, 1) == "red" and _dir_at(_frame(let_deadwood, 4), 2, 1) == 0 and _color_at(_frame(let_deadwood, 4), 10, 1) == "blue", "route 213 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_deadwood, 5), 10, 1) == "red" and _dir_at(_frame(let_deadwood, 5), 10, 1) == 0 and _frame(let_deadwood, 5).get("delivered", []).size() == 1, "route 213 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(214), _by_id(214)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 214 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 214 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 9, 1) == "red" and _dir_at(_frame(counted, 3), 9, 1) == 0, "route 214 jumps eight cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 11, 1) == "red" and _count_at(_frame(counted, 6), 11, 1) == 2, "route 214's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(215), _by_id(215)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 215 waits facing east")
	_check(_at(_frame(clear, 3), 9, 1) and _dir_at(_frame(clear, 3), 9, 1) == 0, "route 215 lands eight cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1):
			brick_entered = true
	_check(not brick_entered, "route 215 does not enter any brick")
	_check(str(Sim.run(_by_id(215), _swap(_by_id(215), "deadwood", "apron"))["reason"]) == "stuck", "route 215's apron tries to land on the last brick")
	_check(str(Sim.run(_by_id(215), _swap(_by_id(215), "deadwood", "stemson"))["reason"]) == "stuck", "route 215's stemson lands two cells short")

	var paired: Dictionary = Sim.run(_by_id(216), _by_id(216)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 11) == "red" and _dir_at(_frame(paired, 2), 1, 11) == 0, "route 216 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 10, 2) == "blue" and _dir_at(_frame(paired, 4), 10, 2) == 1, "route 216 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 216 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 216 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 11), Vector2i(10, 2)]:
		for kind in ["apron", "stemson", "keelson", "futtock"]:
			var one: Dictionary = Sim.run(_by_id(216), _swap_cell(_by_id(216), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 216 misses the dock if the deadwood at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(217), _by_id(217)["reference"])
	_check(_at(_frame(second, 2), 1, 9) and _dir_at(_frame(second, 2), 1, 9) == 0, "route 217 waits on the first deadwood facing east")
	_check(_at(_frame(second, 3), 9, 9) and _dir_at(_frame(second, 3), 9, 9) == 0, "route 217 jumps eight cells forward and still faces east")
	_check(_at(_frame(second, 5), 9, 8) and _dir_at(_frame(second, 5), 9, 8) == 3, "route 217 reaches the second deadwood facing north")
	_check(_at(_frame(second, 6), 9, 8) and _dir_at(_frame(second, 6), 9, 8) == 3, "route 217 waits on the second deadwood facing north")
	_check(int(second["cycles"]) == 7, "route 217 jumps eight cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(217), _omit_cell(_by_id(217), 1, 9))["success"]), "route 217 fails without the first deadwood")
	_check(not bool(Sim.run(_by_id(217), _omit_cell(_by_id(217), 9, 8))["success"]), "route 217 fails without the second deadwood")
	for cell in [Vector2i(1, 9), Vector2i(9, 8)]:
		for kind in ["apron", "stemson", "keelson", "futtock"]:
			var missed: Dictionary = Sim.run(_by_id(217), _swap_cell(_by_id(217), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 217 misses the dock if the deadwood at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(218), _by_id(218)["reference"])
	_check(int(night["cycles"]) < 250, "route 218 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 218 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 218 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 218 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 218 holds red facing east")
	_check(_color_at(_frame(night, 8), 11, 3) == "red" and _dir_at(_frame(night, 8), 11, 3) == 0, "route 218 jumps red eight cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 12, 3) == "red" and _dir_at(_frame(night, 10), 12, 3) == 0 and _count_at(_frame(night, 10), 12, 3) == 0, "route 218 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red" or _color_at(frame, 8, 3) == "red" or _color_at(frame, 9, 3) == "red" or _color_at(frame, 10, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 218 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(218), _swap(_by_id(218), "deadwood", "apron"))["success"]), "route 218's apron misses the pause")
	_check(not bool(Sim.run(_by_id(218), _swap(_by_id(218), "deadwood", "stemson"))["success"]), "route 218's stemson misses the pause")
	_check(not bool(Sim.run(_by_id(218), _swap(_by_id(218), "deadwood", "keelson"))["success"]), "route 218's keelson misses the pause")
	_check(not bool(Sim.run(_by_id(218), _swap(_by_id(218), "primer", "painter"))["success"]), "route 218 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(218), _swap(_by_id(218), "filter", "conveyor"))["success"]), "route 218 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(218), _swap(_by_id(218), "counter", "conveyor"))["success"]), "route 218 fails without the counter")


func _gripe_rules() -> void:
	print("gripe")
	var hop := {
		"width": 11, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 10, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "gripe", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a gripe jumps nine cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the gripe waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 10, 1), "the gripe does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a gripe does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "gripe", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a gripe is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a gripe does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "gripe", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the gripe")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1):
			skipped = true
	_check(not skipped, "the gripe does not enter any of the eight cells in front")
	var short_deadwood: Dictionary = Sim.run(hop, [
		{"type": "deadwood", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
	])
	_check(not bool(short_deadwood["success"]) and _at(_frame(short_deadwood, 3), 9, 1) and _dir_at(_frame(short_deadwood, 3), 9, 1) == 0, "a deadwood lands one cell short of a gripe")
	var short_apron: Dictionary = Sim.run(hop, [
		{"type": "apron", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
	])
	_check(not bool(short_apron["success"]) and _at(_frame(short_apron, 3), 8, 1) and _dir_at(_frame(short_apron, 3), 8, 1) == 0, "an apron lands two cells short of a gripe")
	var short_stemson: Dictionary = Sim.run(hop, [
		{"type": "stemson", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
	])
	_check(not bool(short_stemson["success"]) and _at(_frame(short_stemson, 3), 7, 1) and _dir_at(_frame(short_stemson, 3), 7, 1) == 0, "a stemson lands three cells short of a gripe")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "gripe": Vector2i(1, 4), "land": Vector2i(10, 4), "dock": Vector2i(11, 4), "size": Vector2i(12, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "gripe": Vector2i(1, 1), "land": Vector2i(1, 10), "dock": Vector2i(1, 11), "size": Vector2i(3, 12)},
		{"name": "west", "src": Vector2i(11, 1), "arrival": 2, "gripe": Vector2i(10, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(12, 3)},
		{"name": "north", "src": Vector2i(2, 11), "arrival": 3, "gripe": Vector2i(2, 10), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 12)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var gripe_at: Vector2i = spec["gripe"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "gripe", "x": gripe_at.x, "y": gripe_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps nine cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the nine-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 12, "height": 6, "walls": [{"x": 11, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 9, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 11, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "gripe", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 10, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "a gripe keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 10, 4) == "blue", "the gripe keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 12, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 8, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 11, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "gripe", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 9, "y": 4, "dir": 0},
		{"type": "pause", "x": 10, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "a gripe can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 10, 4) == "gray" and _dir_at(into, 10, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_thirty_one() -> void:
	print("building 31")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 225, "building 31 adds routes 219 through 225")
	_check(int(puzzles[217]["id"]) == 218, "route 218 is the last route before the gripe")
	_check(int(puzzles[218]["id"]) == 219, "the gripe begins at route 219")
	_check(Puzzles.INTRO.size() >= 35 and Puzzles.INTRO[34] == "gripe", "the gripe is the block building 31 teaches")
	_check(not Puzzles.unlocked_at(217).has("gripe"), "the gripe stays locked through route 218")
	_check(Puzzles.unlocked_at(218).has("gripe"), "route 219 unlocks the gripe")
	_check(Puzzles.unlocked_at(224).size() == 35, "building 31 ends with every block")
	var pars := {
		219: [6, 3],
		220: [7, 4],
		221: [7, 5],
		222: [5, 2],
		223: [7, 5],
		224: [7, 3],
		225: [21, 20],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 218:
			_check(int(puzzle.get("building", 1)) < 31, "route %d stays out of building 31" % id)
			if id >= 212:
				_check(int(puzzle.get("building", 1)) == 30, "route %d stays in building 30" % id)
			continue
		if id > 225:
			continue
		_check(int(puzzle.get("building", 1)) == 31, "route %d is building 31" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 219:
			_check(str(puzzle.get("unlocks", "")) == "gripe", "route 219 teaches the gripe")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_gripe := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "gripe":
				uses_gripe = true
		_check(uses_gripe, "route %d reference uses the gripe" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [219, 220, 221, 222, 223, 224, 225]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "gripe":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the gripe block is rotated" % id)
		for kind in ["deadwood", "apron", "stemson", "keelson", "futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "gripe", kind))
			_check(not bool(swapped["success"]), "route %d fails if the gripe is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "gripe":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the gripe is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(219), _by_id(219)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 219 starts the parcel facing east on the gripe")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 219 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 11, 1) and _dir_at(_frame(lesson, 4), 11, 1) == 0, "route 219 jumps nine cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 219 does not enter the cells in front")
	_check(str(Sim.run(_by_id(219), _swap(_by_id(219), "gripe", "deadwood"))["reason"]) == "stuck", "route 219's deadwood lands on the last brick")
	_check(str(Sim.run(_by_id(219), _swap(_by_id(219), "gripe", "apron"))["reason"]) == "stuck", "route 219's apron lands two cells short")

	var let_gripe: Dictionary = Sim.run(_by_id(220), _by_id(220)["reference"])
	_check(_color_at(_frame(let_gripe, 4), 2, 1) == "red" and _dir_at(_frame(let_gripe, 4), 2, 1) == 0 and _color_at(_frame(let_gripe, 4), 11, 1) == "blue", "route 220 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_gripe, 5), 11, 1) == "red" and _dir_at(_frame(let_gripe, 5), 11, 1) == 0 and _frame(let_gripe, 5).get("delivered", []).size() == 1, "route 220 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(221), _by_id(221)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 221 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 221 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 10, 1) == "red" and _dir_at(_frame(counted, 3), 10, 1) == 0, "route 221 jumps nine cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 12, 1) == "red" and _count_at(_frame(counted, 6), 12, 1) == 2, "route 221's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(222), _by_id(222)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 222 waits facing east")
	_check(_at(_frame(clear, 3), 10, 1) and _dir_at(_frame(clear, 3), 10, 1) == 0, "route 222 lands nine cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1):
			brick_entered = true
	_check(not brick_entered, "route 222 does not enter any brick")
	_check(str(Sim.run(_by_id(222), _swap(_by_id(222), "gripe", "deadwood"))["reason"]) == "stuck", "route 222's deadwood tries to land on the last brick")
	_check(str(Sim.run(_by_id(222), _swap(_by_id(222), "gripe", "apron"))["reason"]) == "stuck", "route 222's apron lands two cells short")

	var paired: Dictionary = Sim.run(_by_id(223), _by_id(223)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 12) == "red" and _dir_at(_frame(paired, 2), 1, 12) == 0, "route 223 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 11, 2) == "blue" and _dir_at(_frame(paired, 4), 11, 2) == 1, "route 223 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 223 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 223 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 12), Vector2i(11, 2)]:
		for kind in ["deadwood", "apron", "stemson", "keelson"]:
			var one: Dictionary = Sim.run(_by_id(223), _swap_cell(_by_id(223), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 223 misses the dock if the gripe at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(224), _by_id(224)["reference"])
	_check(_at(_frame(second, 2), 1, 10) and _dir_at(_frame(second, 2), 1, 10) == 0, "route 224 waits on the first gripe facing east")
	_check(_at(_frame(second, 3), 10, 10) and _dir_at(_frame(second, 3), 10, 10) == 0, "route 224 jumps nine cells forward and still faces east")
	_check(_at(_frame(second, 5), 10, 9) and _dir_at(_frame(second, 5), 10, 9) == 3, "route 224 reaches the second gripe facing north")
	_check(_at(_frame(second, 6), 10, 9) and _dir_at(_frame(second, 6), 10, 9) == 3, "route 224 waits on the second gripe facing north")
	_check(int(second["cycles"]) == 7, "route 224 jumps nine cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(224), _omit_cell(_by_id(224), 1, 10))["success"]), "route 224 fails without the first gripe")
	_check(not bool(Sim.run(_by_id(224), _omit_cell(_by_id(224), 10, 9))["success"]), "route 224 fails without the second gripe")
	for cell in [Vector2i(1, 10), Vector2i(10, 9)]:
		for kind in ["deadwood", "apron", "stemson", "keelson"]:
			var missed: Dictionary = Sim.run(_by_id(224), _swap_cell(_by_id(224), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 224 misses the dock if the gripe at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(225), _by_id(225)["reference"])
	_check(int(night["cycles"]) < 250, "route 225 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 225 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 225 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 225 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 225 holds red facing east")
	_check(_color_at(_frame(night, 8), 12, 3) == "red" and _dir_at(_frame(night, 8), 12, 3) == 0, "route 225 jumps red nine cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 13, 3) == "red" and _dir_at(_frame(night, 10), 13, 3) == 0 and _count_at(_frame(night, 10), 13, 3) == 0, "route 225 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red" or _color_at(frame, 8, 3) == "red" or _color_at(frame, 9, 3) == "red" or _color_at(frame, 10, 3) == "red" or _color_at(frame, 11, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 225 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(225), _swap(_by_id(225), "gripe", "deadwood"))["success"]), "route 225's deadwood misses the pause")
	_check(not bool(Sim.run(_by_id(225), _swap(_by_id(225), "gripe", "apron"))["success"]), "route 225's apron misses the pause")
	_check(not bool(Sim.run(_by_id(225), _swap(_by_id(225), "primer", "painter"))["success"]), "route 225 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(225), _swap(_by_id(225), "filter", "conveyor"))["success"]), "route 225 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(225), _swap(_by_id(225), "counter", "conveyor"))["success"]), "route 225 fails without the counter")


func _forefoot_rules() -> void:
	print("forefoot")
	var hop := {
		"width": 12, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 11, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "forefoot", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a forefoot jumps ten cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the forefoot waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 11, 1), "the forefoot does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a forefoot does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "forefoot", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a forefoot is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a forefoot does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "forefoot", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
		{"type": "bin", "x": 10, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the forefoot")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1):
			skipped = true
	_check(not skipped, "the forefoot does not enter any of the nine cells in front")
	var short_gripe: Dictionary = Sim.run(hop, [
		{"type": "gripe", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 10, "y": 1, "dir": 0},
	])
	_check(not bool(short_gripe["success"]) and _at(_frame(short_gripe, 3), 10, 1) and _dir_at(_frame(short_gripe, 3), 10, 1) == 0, "a gripe lands one cell short of a forefoot")
	var short_deadwood: Dictionary = Sim.run(hop, [
		{"type": "deadwood", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
	])
	_check(not bool(short_deadwood["success"]) and _at(_frame(short_deadwood, 3), 9, 1) and _dir_at(_frame(short_deadwood, 3), 9, 1) == 0, "a deadwood lands two cells short of a forefoot")
	var short_apron: Dictionary = Sim.run(hop, [
		{"type": "apron", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
	])
	_check(not bool(short_apron["success"]) and _at(_frame(short_apron, 3), 8, 1) and _dir_at(_frame(short_apron, 3), 8, 1) == 0, "an apron lands three cells short of a forefoot")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "forefoot": Vector2i(1, 4), "land": Vector2i(11, 4), "dock": Vector2i(12, 4), "size": Vector2i(13, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "forefoot": Vector2i(1, 1), "land": Vector2i(1, 11), "dock": Vector2i(1, 12), "size": Vector2i(3, 13)},
		{"name": "west", "src": Vector2i(12, 1), "arrival": 2, "forefoot": Vector2i(11, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(13, 3)},
		{"name": "north", "src": Vector2i(2, 12), "arrival": 3, "forefoot": Vector2i(2, 11), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 13)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var forefoot_at: Vector2i = spec["forefoot"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "forefoot", "x": forefoot_at.x, "y": forefoot_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps ten cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the ten-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 13, "height": 6, "walls": [{"x": 12, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 10, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 12, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "forefoot", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 11, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "a forefoot keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 11, 4) == "blue", "the forefoot keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 13, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 9, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 12, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "forefoot", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 10, "y": 4, "dir": 0},
		{"type": "pause", "x": 11, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "a forefoot can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 11, 4) == "gray" and _dir_at(into, 11, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_thirty_two() -> void:
	print("building 32")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 232, "building 32 adds routes 226 through 232")
	_check(int(puzzles[224]["id"]) == 225, "route 225 is the last route before the forefoot")
	_check(int(puzzles[225]["id"]) == 226, "the forefoot begins at route 226")
	_check(Puzzles.INTRO.size() >= 36 and Puzzles.INTRO[35] == "forefoot", "the forefoot is the block building 32 teaches")
	_check(not Puzzles.unlocked_at(224).has("forefoot"), "the forefoot stays locked through route 225")
	_check(Puzzles.unlocked_at(225).has("forefoot"), "route 226 unlocks the forefoot")
	_check(Puzzles.unlocked_at(231).size() == 36, "building 32 ends with every block")
	var pars := {
		226: [6, 3],
		227: [7, 4],
		228: [7, 5],
		229: [5, 2],
		230: [7, 5],
		231: [7, 3],
		232: [22, 21],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 225:
			_check(int(puzzle.get("building", 1)) < 32, "route %d stays out of building 32" % id)
			if id >= 219:
				_check(int(puzzle.get("building", 1)) == 31, "route %d stays in building 31" % id)
			continue
		if id > 232:
			continue
		_check(int(puzzle.get("building", 1)) == 32, "route %d is building 32" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 226:
			_check(str(puzzle.get("unlocks", "")) == "forefoot", "route 226 teaches the forefoot")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_forefoot := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "forefoot":
				uses_forefoot = true
		_check(uses_forefoot, "route %d reference uses the forefoot" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [226, 227, 228, 229, 230, 231, 232]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "forefoot":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the forefoot block is rotated" % id)
		for kind in ["gripe", "deadwood", "apron", "stemson", "keelson", "futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "forefoot", kind))
			_check(not bool(swapped["success"]), "route %d fails if the forefoot is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "forefoot":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the forefoot is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(226), _by_id(226)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 226 starts the parcel facing east on the forefoot")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 226 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 12, 1) and _dir_at(_frame(lesson, 4), 12, 1) == 0, "route 226 jumps ten cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 226 does not enter the cells in front")
	_check(str(Sim.run(_by_id(226), _swap(_by_id(226), "forefoot", "gripe"))["reason"]) == "stuck", "route 226's gripe lands on the last brick")
	_check(str(Sim.run(_by_id(226), _swap(_by_id(226), "forefoot", "deadwood"))["reason"]) == "stuck", "route 226's deadwood lands two cells short")

	var let_forefoot: Dictionary = Sim.run(_by_id(227), _by_id(227)["reference"])
	_check(_color_at(_frame(let_forefoot, 4), 2, 1) == "red" and _dir_at(_frame(let_forefoot, 4), 2, 1) == 0 and _color_at(_frame(let_forefoot, 4), 12, 1) == "blue", "route 227 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_forefoot, 5), 12, 1) == "red" and _dir_at(_frame(let_forefoot, 5), 12, 1) == 0 and _frame(let_forefoot, 5).get("delivered", []).size() == 1, "route 227 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(228), _by_id(228)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 228 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 228 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 11, 1) == "red" and _dir_at(_frame(counted, 3), 11, 1) == 0, "route 228 jumps ten cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 13, 1) == "red" and _count_at(_frame(counted, 6), 13, 1) == 2, "route 228's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(229), _by_id(229)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 229 waits facing east")
	_check(_at(_frame(clear, 3), 11, 1) and _dir_at(_frame(clear, 3), 11, 1) == 0, "route 229 lands ten cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1):
			brick_entered = true
	_check(not brick_entered, "route 229 does not enter any brick")
	_check(str(Sim.run(_by_id(229), _swap(_by_id(229), "forefoot", "gripe"))["reason"]) == "stuck", "route 229's gripe tries to land on the last brick")
	_check(str(Sim.run(_by_id(229), _swap(_by_id(229), "forefoot", "deadwood"))["reason"]) == "stuck", "route 229's deadwood lands two cells short")

	var paired: Dictionary = Sim.run(_by_id(230), _by_id(230)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 13) == "red" and _dir_at(_frame(paired, 2), 1, 13) == 0, "route 230 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 12, 2) == "blue" and _dir_at(_frame(paired, 4), 12, 2) == 1, "route 230 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 230 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 230 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 13), Vector2i(12, 2)]:
		for kind in ["gripe", "deadwood", "apron", "stemson"]:
			var one: Dictionary = Sim.run(_by_id(230), _swap_cell(_by_id(230), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 230 misses the dock if the forefoot at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(231), _by_id(231)["reference"])
	_check(_at(_frame(second, 2), 1, 11) and _dir_at(_frame(second, 2), 1, 11) == 0, "route 231 waits on the first forefoot facing east")
	_check(_at(_frame(second, 3), 11, 11) and _dir_at(_frame(second, 3), 11, 11) == 0, "route 231 jumps ten cells forward and still faces east")
	_check(_at(_frame(second, 5), 11, 10) and _dir_at(_frame(second, 5), 11, 10) == 3, "route 231 reaches the second forefoot facing north")
	_check(_at(_frame(second, 6), 11, 10) and _dir_at(_frame(second, 6), 11, 10) == 3, "route 231 waits on the second forefoot facing north")
	_check(int(second["cycles"]) == 7, "route 231 jumps ten cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(231), _omit_cell(_by_id(231), 1, 11))["success"]), "route 231 fails without the first forefoot")
	_check(not bool(Sim.run(_by_id(231), _omit_cell(_by_id(231), 11, 10))["success"]), "route 231 fails without the second forefoot")
	for cell in [Vector2i(1, 11), Vector2i(11, 10)]:
		for kind in ["gripe", "deadwood", "apron", "stemson"]:
			var missed: Dictionary = Sim.run(_by_id(231), _swap_cell(_by_id(231), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 231 misses the dock if the forefoot at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(232), _by_id(232)["reference"])
	_check(int(night["cycles"]) < 250, "route 232 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 232 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 232 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 232 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 232 holds red facing east")
	_check(_color_at(_frame(night, 8), 13, 3) == "red" and _dir_at(_frame(night, 8), 13, 3) == 0, "route 232 jumps red ten cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 14, 3) == "red" and _dir_at(_frame(night, 10), 14, 3) == 0 and _count_at(_frame(night, 10), 14, 3) == 0, "route 232 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red" or _color_at(frame, 8, 3) == "red" or _color_at(frame, 9, 3) == "red" or _color_at(frame, 10, 3) == "red" or _color_at(frame, 11, 3) == "red" or _color_at(frame, 12, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 232 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(232), _swap(_by_id(232), "forefoot", "gripe"))["success"]), "route 232's gripe misses the pause")
	_check(not bool(Sim.run(_by_id(232), _swap(_by_id(232), "forefoot", "deadwood"))["success"]), "route 232's deadwood misses the pause")
	_check(not bool(Sim.run(_by_id(232), _swap(_by_id(232), "primer", "painter"))["success"]), "route 232 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(232), _swap(_by_id(232), "filter", "conveyor"))["success"]), "route 232 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(232), _swap(_by_id(232), "counter", "conveyor"))["success"]), "route 232 fails without the counter")


func _knighthead_rules() -> void:
	print("knighthead")
	var hop := {
		"width": 13, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 12, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "knighthead", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a knighthead jumps eleven cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the knighthead waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 12, 1), "the knighthead does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a knighthead does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "knighthead", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a knighthead is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a knighthead does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "knighthead", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
		{"type": "bin", "x": 10, "y": 1, "dir": 0},
		{"type": "bin", "x": 11, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the knighthead")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1):
			skipped = true
	_check(not skipped, "the knighthead does not enter any of the ten cells in front")
	var short_forefoot: Dictionary = Sim.run(hop, [
		{"type": "forefoot", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 11, "y": 1, "dir": 0},
	])
	_check(not bool(short_forefoot["success"]) and _at(_frame(short_forefoot, 3), 11, 1) and _dir_at(_frame(short_forefoot, 3), 11, 1) == 0, "a forefoot lands one cell short of a knighthead")
	var short_gripe: Dictionary = Sim.run(hop, [
		{"type": "gripe", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 10, "y": 1, "dir": 0},
	])
	_check(not bool(short_gripe["success"]) and _at(_frame(short_gripe, 3), 10, 1) and _dir_at(_frame(short_gripe, 3), 10, 1) == 0, "a gripe lands two cells short of a knighthead")
	var short_deadwood: Dictionary = Sim.run(hop, [
		{"type": "deadwood", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
	])
	_check(not bool(short_deadwood["success"]) and _at(_frame(short_deadwood, 3), 9, 1) and _dir_at(_frame(short_deadwood, 3), 9, 1) == 0, "a deadwood lands three cells short of a knighthead")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "knighthead": Vector2i(1, 4), "land": Vector2i(12, 4), "dock": Vector2i(13, 4), "size": Vector2i(14, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "knighthead": Vector2i(1, 1), "land": Vector2i(1, 12), "dock": Vector2i(1, 13), "size": Vector2i(3, 14)},
		{"name": "west", "src": Vector2i(13, 1), "arrival": 2, "knighthead": Vector2i(12, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(14, 3)},
		{"name": "north", "src": Vector2i(2, 13), "arrival": 3, "knighthead": Vector2i(2, 12), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 14)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var knighthead_at: Vector2i = spec["knighthead"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "knighthead", "x": knighthead_at.x, "y": knighthead_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps eleven cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the eleven-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 14, "height": 6, "walls": [{"x": 13, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 11, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 13, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "knighthead", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 12, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "a knighthead keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 12, 4) == "blue", "the knighthead keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 14, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 10, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 13, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "knighthead", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 11, "y": 4, "dir": 0},
		{"type": "pause", "x": 12, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "a knighthead can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 12, 4) == "gray" and _dir_at(into, 12, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_thirty_three() -> void:
	print("building 33")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 239, "building 33 adds routes 233 through 239")
	_check(int(puzzles[231]["id"]) == 232, "route 232 is the last route before the knighthead")
	_check(int(puzzles[232]["id"]) == 233, "the knighthead begins at route 233")
	_check(Puzzles.INTRO.size() >= 37 and Puzzles.INTRO[36] == "knighthead", "the knighthead is the block building 33 teaches")
	_check(not Puzzles.unlocked_at(231).has("knighthead"), "the knighthead stays locked through route 232")
	_check(Puzzles.unlocked_at(232).has("knighthead"), "route 233 unlocks the knighthead")
	_check(Puzzles.unlocked_at(238).size() == 37, "building 33 ends with every block")
	var pars := {
		233: [6, 3],
		234: [7, 4],
		235: [7, 5],
		236: [5, 2],
		237: [7, 5],
		238: [7, 3],
		239: [23, 22],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 232:
			_check(int(puzzle.get("building", 1)) < 33, "route %d stays out of building 33" % id)
			if id >= 226:
				_check(int(puzzle.get("building", 1)) == 32, "route %d stays in building 32" % id)
			continue
		if id > 239:
			continue
		_check(int(puzzle.get("building", 1)) == 33, "route %d is building 33" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 233:
			_check(str(puzzle.get("unlocks", "")) == "knighthead", "route 233 teaches the knighthead")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_knighthead := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "knighthead":
				uses_knighthead = true
		_check(uses_knighthead, "route %d reference uses the knighthead" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [233, 234, 235, 236, 237, 238, 239]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "knighthead":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the knighthead block is rotated" % id)
		for kind in ["forefoot", "gripe", "deadwood", "apron", "stemson", "keelson", "futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "knighthead", kind))
			_check(not bool(swapped["success"]), "route %d fails if the knighthead is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "knighthead":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the knighthead is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(233), _by_id(233)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 233 starts the parcel facing east on the knighthead")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 233 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 13, 1) and _dir_at(_frame(lesson, 4), 13, 1) == 0, "route 233 jumps eleven cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 233 does not enter the cells in front")
	_check(str(Sim.run(_by_id(233), _swap(_by_id(233), "knighthead", "forefoot"))["reason"]) == "stuck", "route 233's forefoot lands on the last brick")
	_check(str(Sim.run(_by_id(233), _swap(_by_id(233), "knighthead", "gripe"))["reason"]) == "stuck", "route 233's gripe lands two cells short")

	var let_knighthead: Dictionary = Sim.run(_by_id(234), _by_id(234)["reference"])
	_check(_color_at(_frame(let_knighthead, 4), 2, 1) == "red" and _dir_at(_frame(let_knighthead, 4), 2, 1) == 0 and _color_at(_frame(let_knighthead, 4), 13, 1) == "blue", "route 234 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_knighthead, 5), 13, 1) == "red" and _dir_at(_frame(let_knighthead, 5), 13, 1) == 0 and _frame(let_knighthead, 5).get("delivered", []).size() == 1, "route 234 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(235), _by_id(235)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 235 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 235 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 12, 1) == "red" and _dir_at(_frame(counted, 3), 12, 1) == 0, "route 235 jumps eleven cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 14, 1) == "red" and _count_at(_frame(counted, 6), 14, 1) == 2, "route 235's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(236), _by_id(236)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 236 waits facing east")
	_check(_at(_frame(clear, 3), 12, 1) and _dir_at(_frame(clear, 3), 12, 1) == 0, "route 236 lands eleven cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1):
			brick_entered = true
	_check(not brick_entered, "route 236 does not enter any brick")
	_check(str(Sim.run(_by_id(236), _swap(_by_id(236), "knighthead", "forefoot"))["reason"]) == "stuck", "route 236's forefoot tries to land on the last brick")
	_check(str(Sim.run(_by_id(236), _swap(_by_id(236), "knighthead", "gripe"))["reason"]) == "stuck", "route 236's gripe lands two cells short")

	var paired: Dictionary = Sim.run(_by_id(237), _by_id(237)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 14) == "red" and _dir_at(_frame(paired, 2), 1, 14) == 0, "route 237 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 13, 2) == "blue" and _dir_at(_frame(paired, 4), 13, 2) == 1, "route 237 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 237 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 237 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 14), Vector2i(13, 2)]:
		for kind in ["forefoot", "gripe", "deadwood", "apron"]:
			var one: Dictionary = Sim.run(_by_id(237), _swap_cell(_by_id(237), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 237 misses the dock if the knighthead at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(238), _by_id(238)["reference"])
	_check(_at(_frame(second, 2), 1, 12) and _dir_at(_frame(second, 2), 1, 12) == 0, "route 238 waits on the first knighthead facing east")
	_check(_at(_frame(second, 3), 12, 12) and _dir_at(_frame(second, 3), 12, 12) == 0, "route 238 jumps eleven cells forward and still faces east")
	_check(_at(_frame(second, 5), 12, 11) and _dir_at(_frame(second, 5), 12, 11) == 3, "route 238 reaches the second knighthead facing north")
	_check(_at(_frame(second, 6), 12, 11) and _dir_at(_frame(second, 6), 12, 11) == 3, "route 238 waits on the second knighthead facing north")
	_check(int(second["cycles"]) == 7, "route 238 jumps eleven cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(238), _omit_cell(_by_id(238), 1, 12))["success"]), "route 238 fails without the first knighthead")
	_check(not bool(Sim.run(_by_id(238), _omit_cell(_by_id(238), 12, 11))["success"]), "route 238 fails without the second knighthead")
	for cell in [Vector2i(1, 12), Vector2i(12, 11)]:
		for kind in ["forefoot", "gripe", "deadwood", "apron"]:
			var missed: Dictionary = Sim.run(_by_id(238), _swap_cell(_by_id(238), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 238 misses the dock if the knighthead at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(239), _by_id(239)["reference"])
	_check(int(night["cycles"]) < 250, "route 239 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 239 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 239 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 239 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 239 holds red facing east")
	_check(_color_at(_frame(night, 8), 14, 3) == "red" and _dir_at(_frame(night, 8), 14, 3) == 0, "route 239 jumps red eleven cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 15, 3) == "red" and _dir_at(_frame(night, 10), 15, 3) == 0 and _count_at(_frame(night, 10), 15, 3) == 0, "route 239 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red" or _color_at(frame, 8, 3) == "red" or _color_at(frame, 9, 3) == "red" or _color_at(frame, 10, 3) == "red" or _color_at(frame, 11, 3) == "red" or _color_at(frame, 12, 3) == "red" or _color_at(frame, 13, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 239 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(239), _swap(_by_id(239), "knighthead", "forefoot"))["success"]), "route 239's forefoot misses the pause")
	_check(not bool(Sim.run(_by_id(239), _swap(_by_id(239), "knighthead", "gripe"))["success"]), "route 239's gripe misses the pause")
	_check(not bool(Sim.run(_by_id(239), _swap(_by_id(239), "primer", "painter"))["success"]), "route 239 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(239), _swap(_by_id(239), "filter", "conveyor"))["success"]), "route 239 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(239), _swap(_by_id(239), "counter", "conveyor"))["success"]), "route 239 fails without the counter")


func _hawse_rules() -> void:
	print("hawse")
	var hop := {
		"width": 14, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 13, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "hawse", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a hawse jumps twelve cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the hawse waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 13, 1), "the hawse does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a hawse does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "hawse", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a hawse is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a hawse does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "hawse", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
		{"type": "bin", "x": 10, "y": 1, "dir": 0},
		{"type": "bin", "x": 11, "y": 1, "dir": 0},
		{"type": "bin", "x": 12, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the hawse")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1):
			skipped = true
	_check(not skipped, "the hawse does not enter any of the eleven cells in front")
	var short_knighthead: Dictionary = Sim.run(hop, [
		{"type": "knighthead", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 12, "y": 1, "dir": 0},
	])
	_check(not bool(short_knighthead["success"]) and _at(_frame(short_knighthead, 3), 12, 1) and _dir_at(_frame(short_knighthead, 3), 12, 1) == 0, "a knighthead lands one cell short of a hawse")
	var short_forefoot: Dictionary = Sim.run(hop, [
		{"type": "forefoot", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 11, "y": 1, "dir": 0},
	])
	_check(not bool(short_forefoot["success"]) and _at(_frame(short_forefoot, 3), 11, 1) and _dir_at(_frame(short_forefoot, 3), 11, 1) == 0, "a forefoot lands two cells short of a hawse")
	var short_gripe: Dictionary = Sim.run(hop, [
		{"type": "gripe", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 10, "y": 1, "dir": 0},
	])
	_check(not bool(short_gripe["success"]) and _at(_frame(short_gripe, 3), 10, 1) and _dir_at(_frame(short_gripe, 3), 10, 1) == 0, "a gripe lands three cells short of a hawse")
	var short_deadwood: Dictionary = Sim.run(hop, [
		{"type": "deadwood", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
	])
	_check(not bool(short_deadwood["success"]) and _at(_frame(short_deadwood, 3), 9, 1) and _dir_at(_frame(short_deadwood, 3), 9, 1) == 0, "a deadwood lands four cells short of a hawse")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "hawse": Vector2i(1, 4), "land": Vector2i(13, 4), "dock": Vector2i(14, 4), "size": Vector2i(15, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "hawse": Vector2i(1, 1), "land": Vector2i(1, 13), "dock": Vector2i(1, 14), "size": Vector2i(3, 15)},
		{"name": "west", "src": Vector2i(14, 1), "arrival": 2, "hawse": Vector2i(13, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(15, 3)},
		{"name": "north", "src": Vector2i(2, 14), "arrival": 3, "hawse": Vector2i(2, 13), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 15)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var hawse_at: Vector2i = spec["hawse"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "hawse", "x": hawse_at.x, "y": hawse_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps twelve cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the twelve-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 15, "height": 6, "walls": [{"x": 14, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 12, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 14, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "hawse", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 13, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "a hawse keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 13, 4) == "blue", "the hawse keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 15, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 11, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 14, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "hawse", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 12, "y": 4, "dir": 0},
		{"type": "pause", "x": 13, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "a hawse can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 13, 4) == "gray" and _dir_at(into, 13, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_thirty_four() -> void:
	print("building 34")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 246, "building 34 adds routes 240 through 246")
	_check(int(puzzles[238]["id"]) == 239, "route 239 is the last route before the hawse")
	_check(int(puzzles[239]["id"]) == 240, "the hawse begins at route 240")
	_check(Puzzles.INTRO.size() >= 38 and Puzzles.INTRO[37] == "hawse", "the hawse is the block building 34 teaches")
	_check(not Puzzles.unlocked_at(238).has("hawse"), "the hawse stays locked through route 239")
	_check(Puzzles.unlocked_at(239).has("hawse"), "route 240 unlocks the hawse")
	_check(Puzzles.unlocked_at(245).size() == 38, "building 34 ends with every block")
	var pars := {
		240: [6, 3],
		241: [7, 4],
		242: [7, 5],
		243: [5, 2],
		244: [7, 5],
		245: [7, 3],
		246: [24, 23],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 239:
			_check(int(puzzle.get("building", 1)) < 34, "route %d stays out of building 34" % id)
			if id >= 233:
				_check(int(puzzle.get("building", 1)) == 33, "route %d stays in building 33" % id)
			continue
		if id > 246:
			continue
		_check(int(puzzle.get("building", 1)) == 34, "route %d is building 34" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 240:
			_check(str(puzzle.get("unlocks", "")) == "hawse", "route 240 teaches the hawse")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_hawse := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "hawse":
				uses_hawse = true
		_check(uses_hawse, "route %d reference uses the hawse" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [240, 241, 242, 243, 244, 245, 246]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "hawse":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the hawse block is rotated" % id)
		for kind in ["knighthead", "forefoot", "gripe", "deadwood", "apron", "stemson", "keelson", "futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "hawse", kind))
			_check(not bool(swapped["success"]), "route %d fails if the hawse is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "hawse":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the hawse is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(240), _by_id(240)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 240 starts the parcel facing east on the hawse")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 240 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 14, 1) and _dir_at(_frame(lesson, 4), 14, 1) == 0, "route 240 jumps twelve cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 240 does not enter the cells in front")
	_check(str(Sim.run(_by_id(240), _swap(_by_id(240), "hawse", "knighthead"))["reason"]) == "stuck", "route 240's knighthead lands on the last brick")
	_check(str(Sim.run(_by_id(240), _swap(_by_id(240), "hawse", "forefoot"))["reason"]) == "stuck", "route 240's forefoot lands two cells short")

	var let_hawse: Dictionary = Sim.run(_by_id(241), _by_id(241)["reference"])
	_check(_color_at(_frame(let_hawse, 4), 2, 1) == "red" and _dir_at(_frame(let_hawse, 4), 2, 1) == 0 and _color_at(_frame(let_hawse, 4), 14, 1) == "blue", "route 241 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_hawse, 5), 14, 1) == "red" and _dir_at(_frame(let_hawse, 5), 14, 1) == 0 and _frame(let_hawse, 5).get("delivered", []).size() == 1, "route 241 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(242), _by_id(242)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 242 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 242 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 13, 1) == "red" and _dir_at(_frame(counted, 3), 13, 1) == 0, "route 242 jumps twelve cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 15, 1) == "red" and _count_at(_frame(counted, 6), 15, 1) == 2, "route 242's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(243), _by_id(243)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 243 waits facing east")
	_check(_at(_frame(clear, 3), 13, 1) and _dir_at(_frame(clear, 3), 13, 1) == 0, "route 243 lands twelve cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1):
			brick_entered = true
	_check(not brick_entered, "route 243 does not enter any brick")
	_check(str(Sim.run(_by_id(243), _swap(_by_id(243), "hawse", "knighthead"))["reason"]) == "stuck", "route 243's knighthead tries to land on the last brick")
	_check(str(Sim.run(_by_id(243), _swap(_by_id(243), "hawse", "pause"))["reason"]) == "stuck", "route 243's pause tries to enter the first brick")

	var paired: Dictionary = Sim.run(_by_id(244), _by_id(244)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 15) == "red" and _dir_at(_frame(paired, 2), 1, 15) == 0, "route 244 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 14, 2) == "blue" and _dir_at(_frame(paired, 4), 14, 2) == 1, "route 244 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 244 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 244 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 15), Vector2i(14, 2)]:
		for kind in ["knighthead", "forefoot", "gripe", "deadwood"]:
			var one: Dictionary = Sim.run(_by_id(244), _swap_cell(_by_id(244), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 244 misses the dock if the hawse at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(245), _by_id(245)["reference"])
	_check(_at(_frame(second, 2), 1, 13) and _dir_at(_frame(second, 2), 1, 13) == 0, "route 245 waits on the first hawse facing east")
	_check(_at(_frame(second, 3), 13, 13) and _dir_at(_frame(second, 3), 13, 13) == 0, "route 245 jumps twelve cells forward and still faces east")
	_check(_at(_frame(second, 5), 13, 12) and _dir_at(_frame(second, 5), 13, 12) == 3, "route 245 reaches the second hawse facing north")
	_check(_at(_frame(second, 6), 13, 12) and _dir_at(_frame(second, 6), 13, 12) == 3, "route 245 waits on the second hawse facing north")
	_check(int(second["cycles"]) == 7, "route 245 jumps twelve cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(245), _omit_cell(_by_id(245), 1, 13))["success"]), "route 245 fails without the first hawse")
	_check(not bool(Sim.run(_by_id(245), _omit_cell(_by_id(245), 13, 12))["success"]), "route 245 fails without the second hawse")
	for cell in [Vector2i(1, 13), Vector2i(13, 12)]:
		for kind in ["knighthead", "forefoot", "gripe", "deadwood"]:
			var missed: Dictionary = Sim.run(_by_id(245), _swap_cell(_by_id(245), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 245 misses the dock if the hawse at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(246), _by_id(246)["reference"])
	_check(int(night["cycles"]) < 250, "route 246 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 246 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 246 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 246 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 246 holds red facing east")
	_check(_color_at(_frame(night, 8), 15, 3) == "red" and _dir_at(_frame(night, 8), 15, 3) == 0, "route 246 jumps red twelve cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 16, 3) == "red" and _dir_at(_frame(night, 10), 16, 3) == 0 and _count_at(_frame(night, 10), 16, 3) == 0, "route 246 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red" or _color_at(frame, 8, 3) == "red" or _color_at(frame, 9, 3) == "red" or _color_at(frame, 10, 3) == "red" or _color_at(frame, 11, 3) == "red" or _color_at(frame, 12, 3) == "red" or _color_at(frame, 13, 3) == "red" or _color_at(frame, 14, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 246 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(246), _swap(_by_id(246), "hawse", "knighthead"))["success"]), "route 246's knighthead misses the pause")
	_check(not bool(Sim.run(_by_id(246), _swap(_by_id(246), "hawse", "forefoot"))["success"]), "route 246's forefoot misses the pause")
	_check(not bool(Sim.run(_by_id(246), _swap(_by_id(246), "primer", "painter"))["success"]), "route 246 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(246), _swap(_by_id(246), "filter", "conveyor"))["success"]), "route 246 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(246), _swap(_by_id(246), "counter", "conveyor"))["success"]), "route 246 fails without the counter")


func _breasthook_rules() -> void:
	print("breasthook")
	var hop := {
		"width": 15, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 14, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "breasthook", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a breasthook jumps thirteen cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the breasthook waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 14, 1), "the breasthook does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a breasthook does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "breasthook", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a breasthook is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a breasthook does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "breasthook", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
		{"type": "bin", "x": 10, "y": 1, "dir": 0},
		{"type": "bin", "x": 11, "y": 1, "dir": 0},
		{"type": "bin", "x": 12, "y": 1, "dir": 0},
		{"type": "bin", "x": 13, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the breasthook")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1):
			skipped = true
	_check(not skipped, "the breasthook does not enter any of the twelve cells in front")
	var short_hawse: Dictionary = Sim.run(hop, [
		{"type": "hawse", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 13, "y": 1, "dir": 0},
	])
	_check(not bool(short_hawse["success"]) and _at(_frame(short_hawse, 3), 13, 1) and _dir_at(_frame(short_hawse, 3), 13, 1) == 0, "a hawse lands one cell short of a breasthook")
	var short_knighthead: Dictionary = Sim.run(hop, [
		{"type": "knighthead", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 12, "y": 1, "dir": 0},
	])
	_check(not bool(short_knighthead["success"]) and _at(_frame(short_knighthead, 3), 12, 1) and _dir_at(_frame(short_knighthead, 3), 12, 1) == 0, "a knighthead lands two cells short of a breasthook")
	var short_forefoot: Dictionary = Sim.run(hop, [
		{"type": "forefoot", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 11, "y": 1, "dir": 0},
	])
	_check(not bool(short_forefoot["success"]) and _at(_frame(short_forefoot, 3), 11, 1) and _dir_at(_frame(short_forefoot, 3), 11, 1) == 0, "a forefoot lands three cells short of a breasthook")
	var short_gripe: Dictionary = Sim.run(hop, [
		{"type": "gripe", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 10, "y": 1, "dir": 0},
	])
	_check(not bool(short_gripe["success"]) and _at(_frame(short_gripe, 3), 10, 1) and _dir_at(_frame(short_gripe, 3), 10, 1) == 0, "a gripe lands four cells short of a breasthook")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "block": Vector2i(1, 4), "land": Vector2i(14, 4), "dock": Vector2i(15, 4), "size": Vector2i(16, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "block": Vector2i(1, 1), "land": Vector2i(1, 14), "dock": Vector2i(1, 15), "size": Vector2i(3, 16)},
		{"name": "west", "src": Vector2i(15, 1), "arrival": 2, "block": Vector2i(14, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(16, 3)},
		{"name": "north", "src": Vector2i(2, 15), "arrival": 3, "block": Vector2i(2, 14), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 16)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var block_at: Vector2i = spec["block"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "breasthook", "x": block_at.x, "y": block_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps thirteen cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the thirteen-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 16, "height": 6, "walls": [{"x": 15, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 13, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 15, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "breasthook", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 14, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "a breasthook keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 14, 4) == "blue", "the breasthook keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 16, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 12, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 15, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "breasthook", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 13, "y": 4, "dir": 0},
		{"type": "pause", "x": 14, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "a breasthook can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 14, 4) == "gray" and _dir_at(into, 14, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_thirty_five() -> void:
	print("building 35")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 253, "building 35 adds routes 247 through 253")
	_check(int(puzzles[245]["id"]) == 246, "route 246 is the last route before the breasthook")
	_check(int(puzzles[246]["id"]) == 247, "the breasthook begins at route 247")
	_check(Puzzles.INTRO.size() >= 39 and Puzzles.INTRO[38] == "breasthook", "the breasthook is the block building 35 teaches")
	_check(not Puzzles.unlocked_at(245).has("breasthook"), "the breasthook stays locked through route 246")
	_check(Puzzles.unlocked_at(246).has("breasthook"), "route 247 unlocks the breasthook")
	_check(Puzzles.unlocked_at(252).size() == 39, "building 35 ends with every block")
	var pars := {
		247: [6, 3],
		248: [7, 4],
		249: [7, 5],
		250: [5, 2],
		251: [7, 5],
		252: [7, 3],
		253: [25, 24],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 246:
			_check(int(puzzle.get("building", 1)) < 35, "route %d stays out of building 35" % id)
			if id >= 240:
				_check(int(puzzle.get("building", 1)) == 34, "route %d stays in building 34" % id)
			continue
		if id > 253:
			continue
		_check(int(puzzle.get("building", 1)) == 35, "route %d is building 35" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 247:
			_check(str(puzzle.get("unlocks", "")) == "breasthook", "route 247 teaches the breasthook")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_breasthook := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "breasthook":
				uses_breasthook = true
		_check(uses_breasthook, "route %d reference uses the breasthook" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [247, 248, 249, 250, 251, 252, 253]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "breasthook":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the breasthook block is rotated" % id)
		for kind in ["hawse", "knighthead", "forefoot", "gripe", "deadwood", "apron", "stemson", "keelson", "futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "breasthook", kind))
			_check(not bool(swapped["success"]), "route %d fails if the breasthook is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "breasthook":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the breasthook is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(247), _by_id(247)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 247 starts the parcel facing east on the breasthook")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 247 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 15, 1) and _dir_at(_frame(lesson, 4), 15, 1) == 0, "route 247 jumps thirteen cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 247 does not enter the cells in front")
	_check(str(Sim.run(_by_id(247), _swap(_by_id(247), "breasthook", "hawse"))["reason"]) == "stuck", "route 247's hawse lands on the last brick")
	_check(str(Sim.run(_by_id(247), _swap(_by_id(247), "breasthook", "knighthead"))["reason"]) == "stuck", "route 247's knighthead lands two cells short")

	var let_breasthook: Dictionary = Sim.run(_by_id(248), _by_id(248)["reference"])
	_check(_color_at(_frame(let_breasthook, 4), 2, 1) == "red" and _dir_at(_frame(let_breasthook, 4), 2, 1) == 0 and _color_at(_frame(let_breasthook, 4), 15, 1) == "blue", "route 248 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_breasthook, 5), 15, 1) == "red" and _dir_at(_frame(let_breasthook, 5), 15, 1) == 0 and _frame(let_breasthook, 5).get("delivered", []).size() == 1, "route 248 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(249), _by_id(249)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 249 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 249 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 14, 1) == "red" and _dir_at(_frame(counted, 3), 14, 1) == 0, "route 249 jumps thirteen cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 16, 1) == "red" and _count_at(_frame(counted, 6), 16, 1) == 2, "route 249's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(250), _by_id(250)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 250 waits facing east")
	_check(_at(_frame(clear, 3), 14, 1) and _dir_at(_frame(clear, 3), 14, 1) == 0, "route 250 lands thirteen cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1):
			brick_entered = true
	_check(not brick_entered, "route 250 does not enter any brick")
	_check(str(Sim.run(_by_id(250), _swap(_by_id(250), "breasthook", "hawse"))["reason"]) == "stuck", "route 250's hawse tries to land on the last brick")
	_check(str(Sim.run(_by_id(250), _swap(_by_id(250), "breasthook", "pause"))["reason"]) == "stuck", "route 250's pause tries to enter the first brick")

	var paired: Dictionary = Sim.run(_by_id(251), _by_id(251)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 16) == "red" and _dir_at(_frame(paired, 2), 1, 16) == 0, "route 251 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 15, 2) == "blue" and _dir_at(_frame(paired, 4), 15, 2) == 1, "route 251 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 251 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 251 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 16), Vector2i(15, 2)]:
		for kind in ["hawse", "knighthead", "forefoot", "gripe"]:
			var one: Dictionary = Sim.run(_by_id(251), _swap_cell(_by_id(251), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 251 misses the dock if the breasthook at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(252), _by_id(252)["reference"])
	_check(_at(_frame(second, 2), 1, 14) and _dir_at(_frame(second, 2), 1, 14) == 0, "route 252 waits on the first breasthook facing east")
	_check(_at(_frame(second, 3), 14, 14) and _dir_at(_frame(second, 3), 14, 14) == 0, "route 252 jumps thirteen cells forward and still faces east")
	_check(_at(_frame(second, 5), 14, 13) and _dir_at(_frame(second, 5), 14, 13) == 3, "route 252 reaches the second breasthook facing north")
	_check(_at(_frame(second, 6), 14, 13) and _dir_at(_frame(second, 6), 14, 13) == 3, "route 252 waits on the second breasthook facing north")
	_check(int(second["cycles"]) == 7, "route 252 jumps thirteen cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(252), _omit_cell(_by_id(252), 1, 14))["success"]), "route 252 fails without the first breasthook")
	_check(not bool(Sim.run(_by_id(252), _omit_cell(_by_id(252), 14, 13))["success"]), "route 252 fails without the second breasthook")
	for cell in [Vector2i(1, 14), Vector2i(14, 13)]:
		for kind in ["hawse", "knighthead", "forefoot", "gripe"]:
			var missed: Dictionary = Sim.run(_by_id(252), _swap_cell(_by_id(252), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 252 misses the dock if the breasthook at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(253), _by_id(253)["reference"])
	_check(int(night["cycles"]) < 250, "route 253 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 253 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 253 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 253 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 253 holds red facing east")
	_check(_color_at(_frame(night, 8), 16, 3) == "red" and _dir_at(_frame(night, 8), 16, 3) == 0, "route 253 jumps red thirteen cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 17, 3) == "red" and _dir_at(_frame(night, 10), 17, 3) == 0 and _count_at(_frame(night, 10), 17, 3) == 0, "route 253 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red" or _color_at(frame, 8, 3) == "red" or _color_at(frame, 9, 3) == "red" or _color_at(frame, 10, 3) == "red" or _color_at(frame, 11, 3) == "red" or _color_at(frame, 12, 3) == "red" or _color_at(frame, 13, 3) == "red" or _color_at(frame, 14, 3) == "red" or _color_at(frame, 15, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 253 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(253), _swap(_by_id(253), "breasthook", "hawse"))["success"]), "route 253's hawse misses the pause")
	_check(not bool(Sim.run(_by_id(253), _swap(_by_id(253), "breasthook", "knighthead"))["success"]), "route 253's knighthead misses the pause")
	_check(not bool(Sim.run(_by_id(253), _swap(_by_id(253), "primer", "painter"))["success"]), "route 253 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(253), _swap(_by_id(253), "filter", "conveyor"))["success"]), "route 253 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(253), _swap(_by_id(253), "counter", "conveyor"))["success"]), "route 253 fails without the counter")


func _cathead_rules() -> void:
	print("cathead")
	var hop := {
		"width": 16, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 15, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "cathead", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a cathead jumps fourteen cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the cathead waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 15, 1), "the cathead does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a cathead does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "cathead", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a cathead is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a cathead does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "cathead", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
		{"type": "bin", "x": 10, "y": 1, "dir": 0},
		{"type": "bin", "x": 11, "y": 1, "dir": 0},
		{"type": "bin", "x": 12, "y": 1, "dir": 0},
		{"type": "bin", "x": 13, "y": 1, "dir": 0},
		{"type": "bin", "x": 14, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the cathead")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1):
			skipped = true
	_check(not skipped, "the cathead does not enter any of the thirteen cells in front")
	var short_breasthook: Dictionary = Sim.run(hop, [
		{"type": "breasthook", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 14, "y": 1, "dir": 0},
	])
	_check(not bool(short_breasthook["success"]) and _at(_frame(short_breasthook, 3), 14, 1) and _dir_at(_frame(short_breasthook, 3), 14, 1) == 0, "a breasthook lands one cell short of a cathead")
	var short_hawse: Dictionary = Sim.run(hop, [
		{"type": "hawse", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 13, "y": 1, "dir": 0},
	])
	_check(not bool(short_hawse["success"]) and _at(_frame(short_hawse, 3), 13, 1) and _dir_at(_frame(short_hawse, 3), 13, 1) == 0, "a hawse lands two cells short of a cathead")
	var short_knighthead: Dictionary = Sim.run(hop, [
		{"type": "knighthead", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 12, "y": 1, "dir": 0},
	])
	_check(not bool(short_knighthead["success"]) and _at(_frame(short_knighthead, 3), 12, 1) and _dir_at(_frame(short_knighthead, 3), 12, 1) == 0, "a knighthead lands three cells short of a cathead")
	var short_forefoot: Dictionary = Sim.run(hop, [
		{"type": "forefoot", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 11, "y": 1, "dir": 0},
	])
	_check(not bool(short_forefoot["success"]) and _at(_frame(short_forefoot, 3), 11, 1) and _dir_at(_frame(short_forefoot, 3), 11, 1) == 0, "a forefoot lands four cells short of a cathead")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "block": Vector2i(1, 4), "land": Vector2i(15, 4), "dock": Vector2i(16, 4), "size": Vector2i(17, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "block": Vector2i(1, 1), "land": Vector2i(1, 15), "dock": Vector2i(1, 16), "size": Vector2i(3, 17)},
		{"name": "west", "src": Vector2i(16, 1), "arrival": 2, "block": Vector2i(15, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(17, 3)},
		{"name": "north", "src": Vector2i(2, 16), "arrival": 3, "block": Vector2i(2, 15), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 17)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var block_at: Vector2i = spec["block"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "cathead", "x": block_at.x, "y": block_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps fourteen cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the fourteen-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 17, "height": 6, "walls": [{"x": 16, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 14, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 16, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "cathead", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 15, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "a cathead keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 15, 4) == "blue", "the cathead keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 17, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 13, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 16, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "cathead", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 14, "y": 4, "dir": 0},
		{"type": "pause", "x": 15, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "a cathead can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 15, 4) == "gray" and _dir_at(into, 15, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_thirty_six() -> void:
	print("building 36")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 260, "building 36 adds routes 254 through 260")
	_check(int(puzzles[252]["id"]) == 253, "route 253 is the last route before the cathead")
	_check(int(puzzles[253]["id"]) == 254, "the cathead begins at route 254")
	_check(Puzzles.INTRO.size() >= 40 and Puzzles.INTRO[39] == "cathead", "the cathead is the block building 36 teaches")
	_check(not Puzzles.unlocked_at(252).has("cathead"), "the cathead stays locked through route 253")
	_check(Puzzles.unlocked_at(253).has("cathead"), "route 254 unlocks the cathead")
	_check(Puzzles.unlocked_at(259).size() == 40, "building 36 ends with every block")
	var pars := {
		254: [6, 3],
		255: [7, 4],
		256: [7, 5],
		257: [5, 2],
		258: [7, 5],
		259: [7, 3],
		260: [26, 25],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 253:
			_check(int(puzzle.get("building", 1)) < 36, "route %d stays out of building 36" % id)
			if id >= 247:
				_check(int(puzzle.get("building", 1)) == 35, "route %d stays in building 35" % id)
			continue
		if id > 260:
			continue
		_check(int(puzzle.get("building", 1)) == 36, "route %d is building 36" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 254:
			_check(str(puzzle.get("unlocks", "")) == "cathead", "route 254 teaches the cathead")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_cathead := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "cathead":
				uses_cathead = true
		_check(uses_cathead, "route %d reference uses the cathead" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [254, 255, 256, 257, 258, 259, 260]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "cathead":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the cathead block is rotated" % id)
		for kind in ["breasthook", "hawse", "knighthead", "forefoot", "gripe", "deadwood", "apron", "stemson", "keelson", "futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "cathead", kind))
			_check(not bool(swapped["success"]), "route %d fails if the cathead is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "cathead":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the cathead is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(254), _by_id(254)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 254 starts the parcel facing east on the cathead")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 254 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 16, 1) and _dir_at(_frame(lesson, 4), 16, 1) == 0, "route 254 jumps fourteen cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 254 does not enter the cells in front")
	_check(str(Sim.run(_by_id(254), _swap(_by_id(254), "cathead", "breasthook"))["reason"]) == "stuck", "route 254's breasthook lands on the last brick")
	_check(str(Sim.run(_by_id(254), _swap(_by_id(254), "cathead", "hawse"))["reason"]) == "stuck", "route 254's hawse lands two cells short")

	var let_cathead: Dictionary = Sim.run(_by_id(255), _by_id(255)["reference"])
	_check(_color_at(_frame(let_cathead, 4), 2, 1) == "red" and _dir_at(_frame(let_cathead, 4), 2, 1) == 0 and _color_at(_frame(let_cathead, 4), 16, 1) == "blue", "route 255 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_cathead, 5), 16, 1) == "red" and _dir_at(_frame(let_cathead, 5), 16, 1) == 0 and _frame(let_cathead, 5).get("delivered", []).size() == 1, "route 255 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(256), _by_id(256)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 256 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 256 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 15, 1) == "red" and _dir_at(_frame(counted, 3), 15, 1) == 0, "route 256 jumps fourteen cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 17, 1) == "red" and _count_at(_frame(counted, 6), 17, 1) == 2, "route 256's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(257), _by_id(257)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 257 waits facing east")
	_check(_at(_frame(clear, 3), 15, 1) and _dir_at(_frame(clear, 3), 15, 1) == 0, "route 257 lands fourteen cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1):
			brick_entered = true
	_check(not brick_entered, "route 257 does not enter any brick")
	_check(str(Sim.run(_by_id(257), _swap(_by_id(257), "cathead", "breasthook"))["reason"]) == "stuck", "route 257's breasthook tries to land on the last brick")
	_check(str(Sim.run(_by_id(257), _swap(_by_id(257), "cathead", "pause"))["reason"]) == "stuck", "route 257's pause tries to enter the first brick")

	var paired: Dictionary = Sim.run(_by_id(258), _by_id(258)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 17) == "red" and _dir_at(_frame(paired, 2), 1, 17) == 0, "route 258 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 16, 2) == "blue" and _dir_at(_frame(paired, 4), 16, 2) == 1, "route 258 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 258 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 258 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 17), Vector2i(16, 2)]:
		for kind in ["breasthook", "hawse", "knighthead", "forefoot"]:
			var one: Dictionary = Sim.run(_by_id(258), _swap_cell(_by_id(258), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 258 misses the dock if the cathead at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(259), _by_id(259)["reference"])
	_check(_at(_frame(second, 2), 1, 15) and _dir_at(_frame(second, 2), 1, 15) == 0, "route 259 waits on the first cathead facing east")
	_check(_at(_frame(second, 3), 15, 15) and _dir_at(_frame(second, 3), 15, 15) == 0, "route 259 jumps fourteen cells forward and still faces east")
	_check(_at(_frame(second, 5), 15, 14) and _dir_at(_frame(second, 5), 15, 14) == 3, "route 259 reaches the second cathead facing north")
	_check(_at(_frame(second, 6), 15, 14) and _dir_at(_frame(second, 6), 15, 14) == 3, "route 259 waits on the second cathead facing north")
	_check(int(second["cycles"]) == 7, "route 259 jumps fourteen cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(259), _omit_cell(_by_id(259), 1, 15))["success"]), "route 259 fails without the first cathead")
	_check(not bool(Sim.run(_by_id(259), _omit_cell(_by_id(259), 15, 14))["success"]), "route 259 fails without the second cathead")
	for cell in [Vector2i(1, 15), Vector2i(15, 14)]:
		for kind in ["breasthook", "hawse", "knighthead", "forefoot"]:
			var missed: Dictionary = Sim.run(_by_id(259), _swap_cell(_by_id(259), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 259 misses the dock if the cathead at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(260), _by_id(260)["reference"])
	_check(int(night["cycles"]) < 250, "route 260 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 260 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 260 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 260 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 260 holds red facing east")
	_check(_color_at(_frame(night, 8), 17, 3) == "red" and _dir_at(_frame(night, 8), 17, 3) == 0, "route 260 jumps red fourteen cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 18, 3) == "red" and _dir_at(_frame(night, 10), 18, 3) == 0 and _count_at(_frame(night, 10), 18, 3) == 0, "route 260 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red" or _color_at(frame, 8, 3) == "red" or _color_at(frame, 9, 3) == "red" or _color_at(frame, 10, 3) == "red" or _color_at(frame, 11, 3) == "red" or _color_at(frame, 12, 3) == "red" or _color_at(frame, 13, 3) == "red" or _color_at(frame, 14, 3) == "red" or _color_at(frame, 15, 3) == "red" or _color_at(frame, 16, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 260 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(260), _swap(_by_id(260), "cathead", "breasthook"))["success"]), "route 260's breasthook misses the pause")
	_check(not bool(Sim.run(_by_id(260), _swap(_by_id(260), "cathead", "hawse"))["success"]), "route 260's hawse misses the pause")
	_check(not bool(Sim.run(_by_id(260), _swap(_by_id(260), "primer", "painter"))["success"]), "route 260 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(260), _swap(_by_id(260), "filter", "conveyor"))["success"]), "route 260 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(260), _swap(_by_id(260), "counter", "conveyor"))["success"]), "route 260 fails without the counter")


func _gammon_rules() -> void:
	print("gammon")
	var hop := {
		"width": 17, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 16, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "gammon", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a gammon jumps fifteen cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the gammon waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 16, 1), "the gammon does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a gammon does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "gammon", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a gammon is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a gammon does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "gammon", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
		{"type": "bin", "x": 10, "y": 1, "dir": 0},
		{"type": "bin", "x": 11, "y": 1, "dir": 0},
		{"type": "bin", "x": 12, "y": 1, "dir": 0},
		{"type": "bin", "x": 13, "y": 1, "dir": 0},
		{"type": "bin", "x": 14, "y": 1, "dir": 0},
		{"type": "bin", "x": 15, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the gammon")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1):
			skipped = true
	_check(not skipped, "the gammon does not enter any of the fourteen cells in front")
	var short_cathead: Dictionary = Sim.run(hop, [
		{"type": "cathead", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 15, "y": 1, "dir": 0},
	])
	_check(not bool(short_cathead["success"]) and _at(_frame(short_cathead, 3), 15, 1) and _dir_at(_frame(short_cathead, 3), 15, 1) == 0, "a cathead lands one cell short of a gammon")
	var short_breasthook: Dictionary = Sim.run(hop, [
		{"type": "breasthook", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 14, "y": 1, "dir": 0},
	])
	_check(not bool(short_breasthook["success"]) and _at(_frame(short_breasthook, 3), 14, 1) and _dir_at(_frame(short_breasthook, 3), 14, 1) == 0, "a breasthook lands two cells short of a gammon")
	var short_hawse: Dictionary = Sim.run(hop, [
		{"type": "hawse", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 13, "y": 1, "dir": 0},
	])
	_check(not bool(short_hawse["success"]) and _at(_frame(short_hawse, 3), 13, 1) and _dir_at(_frame(short_hawse, 3), 13, 1) == 0, "a hawse lands three cells short of a gammon")
	var short_knighthead: Dictionary = Sim.run(hop, [
		{"type": "knighthead", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 12, "y": 1, "dir": 0},
	])
	_check(not bool(short_knighthead["success"]) and _at(_frame(short_knighthead, 3), 12, 1) and _dir_at(_frame(short_knighthead, 3), 12, 1) == 0, "a knighthead lands four cells short of a gammon")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "block": Vector2i(1, 4), "land": Vector2i(16, 4), "dock": Vector2i(17, 4), "size": Vector2i(18, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "block": Vector2i(1, 1), "land": Vector2i(1, 16), "dock": Vector2i(1, 17), "size": Vector2i(3, 18)},
		{"name": "west", "src": Vector2i(17, 1), "arrival": 2, "block": Vector2i(16, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(18, 3)},
		{"name": "north", "src": Vector2i(2, 17), "arrival": 3, "block": Vector2i(2, 16), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 18)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var block_at: Vector2i = spec["block"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "gammon", "x": block_at.x, "y": block_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps fifteen cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the fifteen-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 18, "height": 6, "walls": [{"x": 17, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 15, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 17, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "gammon", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 16, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "a gammon keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 16, 4) == "blue", "the gammon keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 18, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 14, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 17, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "gammon", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 15, "y": 4, "dir": 0},
		{"type": "pause", "x": 16, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "a gammon can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 16, 4) == "gray" and _dir_at(into, 16, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_thirty_seven() -> void:
	print("building 37")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 267, "building 37 adds routes 261 through 267")
	_check(int(puzzles[259]["id"]) == 260, "route 260 is the last route before the gammon")
	_check(int(puzzles[260]["id"]) == 261, "the gammon begins at route 261")
	_check(Puzzles.INTRO.size() >= 41 and Puzzles.INTRO[40] == "gammon", "the gammon is the block building 37 teaches")
	_check(not Puzzles.unlocked_at(259).has("gammon"), "the gammon stays locked through route 260")
	_check(Puzzles.unlocked_at(260).has("gammon"), "route 261 unlocks the gammon")
	_check(Puzzles.unlocked_at(266).size() == 41, "building 37 ends with every block")
	var pars := {
		261: [6, 3],
		262: [7, 4],
		263: [7, 5],
		264: [5, 2],
		265: [7, 5],
		266: [7, 3],
		267: [27, 26],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 260:
			_check(int(puzzle.get("building", 1)) < 37, "route %d stays out of building 37" % id)
			if id >= 254:
				_check(int(puzzle.get("building", 1)) == 36, "route %d stays in building 36" % id)
			continue
		if id > 267:
			continue
		_check(int(puzzle.get("building", 1)) == 37, "route %d is building 37" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 261:
			_check(str(puzzle.get("unlocks", "")) == "gammon", "route 261 teaches the gammon")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_gammon := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "gammon":
				uses_gammon = true
		_check(uses_gammon, "route %d reference uses the gammon" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [261, 262, 263, 264, 265, 266, 267]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "gammon":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the gammon block is rotated" % id)
		for kind in ["cathead", "breasthook", "hawse", "knighthead", "forefoot", "gripe", "deadwood", "apron", "stemson", "keelson", "futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "gammon", kind))
			_check(not bool(swapped["success"]), "route %d fails if the gammon is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "gammon":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the gammon is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(261), _by_id(261)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 261 starts the parcel facing east on the gammon")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 261 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 17, 1) and _dir_at(_frame(lesson, 4), 17, 1) == 0, "route 261 jumps fifteen cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 261 does not enter the cells in front")
	_check(str(Sim.run(_by_id(261), _swap(_by_id(261), "gammon", "cathead"))["reason"]) == "stuck", "route 261's cathead lands on the last brick")
	_check(str(Sim.run(_by_id(261), _swap(_by_id(261), "gammon", "breasthook"))["reason"]) == "stuck", "route 261's breasthook lands two cells short")

	var let_gammon: Dictionary = Sim.run(_by_id(262), _by_id(262)["reference"])
	_check(_color_at(_frame(let_gammon, 4), 2, 1) == "red" and _dir_at(_frame(let_gammon, 4), 2, 1) == 0 and _color_at(_frame(let_gammon, 4), 17, 1) == "blue", "route 262 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_gammon, 5), 17, 1) == "red" and _dir_at(_frame(let_gammon, 5), 17, 1) == 0 and _frame(let_gammon, 5).get("delivered", []).size() == 1, "route 262 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(263), _by_id(263)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 263 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 263 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 16, 1) == "red" and _dir_at(_frame(counted, 3), 16, 1) == 0, "route 263 jumps fifteen cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 18, 1) == "red" and _count_at(_frame(counted, 6), 18, 1) == 2, "route 263's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(264), _by_id(264)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 264 waits facing east")
	_check(_at(_frame(clear, 3), 16, 1) and _dir_at(_frame(clear, 3), 16, 1) == 0, "route 264 lands fifteen cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1):
			brick_entered = true
	_check(not brick_entered, "route 264 does not enter any brick")
	_check(str(Sim.run(_by_id(264), _swap(_by_id(264), "gammon", "cathead"))["reason"]) == "stuck", "route 264's cathead tries to land on the last brick")
	_check(str(Sim.run(_by_id(264), _swap(_by_id(264), "gammon", "pause"))["reason"]) == "stuck", "route 264's pause tries to enter the first brick")

	var paired: Dictionary = Sim.run(_by_id(265), _by_id(265)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 18) == "red" and _dir_at(_frame(paired, 2), 1, 18) == 0, "route 265 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 17, 2) == "blue" and _dir_at(_frame(paired, 4), 17, 2) == 1, "route 265 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 265 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 265 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 18), Vector2i(17, 2)]:
		for kind in ["cathead", "breasthook", "hawse", "knighthead"]:
			var one: Dictionary = Sim.run(_by_id(265), _swap_cell(_by_id(265), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 265 misses the dock if the gammon at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(266), _by_id(266)["reference"])
	_check(_at(_frame(second, 2), 1, 16) and _dir_at(_frame(second, 2), 1, 16) == 0, "route 266 waits on the first gammon facing east")
	_check(_at(_frame(second, 3), 16, 16) and _dir_at(_frame(second, 3), 16, 16) == 0, "route 266 jumps fifteen cells forward and still faces east")
	_check(_at(_frame(second, 5), 16, 15) and _dir_at(_frame(second, 5), 16, 15) == 3, "route 266 reaches the second gammon facing north")
	_check(_at(_frame(second, 6), 16, 15) and _dir_at(_frame(second, 6), 16, 15) == 3, "route 266 waits on the second gammon facing north")
	_check(int(second["cycles"]) == 7, "route 266 jumps fifteen cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(266), _omit_cell(_by_id(266), 1, 16))["success"]), "route 266 fails without the first gammon")
	_check(not bool(Sim.run(_by_id(266), _omit_cell(_by_id(266), 16, 15))["success"]), "route 266 fails without the second gammon")
	for cell in [Vector2i(1, 16), Vector2i(16, 15)]:
		for kind in ["cathead", "breasthook", "hawse", "knighthead"]:
			var missed: Dictionary = Sim.run(_by_id(266), _swap_cell(_by_id(266), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 266 misses the dock if the gammon at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(267), _by_id(267)["reference"])
	_check(int(night["cycles"]) < 250, "route 267 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 267 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 267 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 267 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 267 holds red facing east")
	_check(_color_at(_frame(night, 8), 18, 3) == "red" and _dir_at(_frame(night, 8), 18, 3) == 0, "route 267 jumps red fifteen cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 19, 3) == "red" and _dir_at(_frame(night, 10), 19, 3) == 0 and _count_at(_frame(night, 10), 19, 3) == 0, "route 267 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red" or _color_at(frame, 8, 3) == "red" or _color_at(frame, 9, 3) == "red" or _color_at(frame, 10, 3) == "red" or _color_at(frame, 11, 3) == "red" or _color_at(frame, 12, 3) == "red" or _color_at(frame, 13, 3) == "red" or _color_at(frame, 14, 3) == "red" or _color_at(frame, 15, 3) == "red" or _color_at(frame, 16, 3) == "red" or _color_at(frame, 17, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 267 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(267), _swap(_by_id(267), "gammon", "cathead"))["success"]), "route 267's cathead misses the pause")
	_check(not bool(Sim.run(_by_id(267), _swap(_by_id(267), "gammon", "breasthook"))["success"]), "route 267's breasthook misses the pause")
	_check(not bool(Sim.run(_by_id(267), _swap(_by_id(267), "primer", "painter"))["success"]), "route 267 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(267), _swap(_by_id(267), "filter", "conveyor"))["success"]), "route 267 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(267), _swap(_by_id(267), "counter", "conveyor"))["success"]), "route 267 fails without the counter")


func _bobstay_rules() -> void:
	print("bobstay")
	var hop := {
		"width": 18, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 17, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "bobstay", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a bobstay jumps sixteen cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the bobstay waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 17, 1), "the bobstay does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a bobstay does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "bobstay", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a bobstay is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a bobstay does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "bobstay", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
		{"type": "bin", "x": 10, "y": 1, "dir": 0},
		{"type": "bin", "x": 11, "y": 1, "dir": 0},
		{"type": "bin", "x": 12, "y": 1, "dir": 0},
		{"type": "bin", "x": 13, "y": 1, "dir": 0},
		{"type": "bin", "x": 14, "y": 1, "dir": 0},
		{"type": "bin", "x": 15, "y": 1, "dir": 0},
		{"type": "bin", "x": 16, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the bobstay")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1):
			skipped = true
	_check(not skipped, "the bobstay does not enter any of the fifteen cells in front")
	var short_gammon: Dictionary = Sim.run(hop, [
		{"type": "gammon", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 16, "y": 1, "dir": 0},
	])
	_check(not bool(short_gammon["success"]) and _at(_frame(short_gammon, 3), 16, 1) and _dir_at(_frame(short_gammon, 3), 16, 1) == 0, "a gammon lands one cell short of a bobstay")
	var short_cathead: Dictionary = Sim.run(hop, [
		{"type": "cathead", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 15, "y": 1, "dir": 0},
	])
	_check(not bool(short_cathead["success"]) and _at(_frame(short_cathead, 3), 15, 1) and _dir_at(_frame(short_cathead, 3), 15, 1) == 0, "a cathead lands two cells short of a bobstay")
	var short_breasthook: Dictionary = Sim.run(hop, [
		{"type": "breasthook", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 14, "y": 1, "dir": 0},
	])
	_check(not bool(short_breasthook["success"]) and _at(_frame(short_breasthook, 3), 14, 1) and _dir_at(_frame(short_breasthook, 3), 14, 1) == 0, "a breasthook lands three cells short of a bobstay")
	var short_hawse: Dictionary = Sim.run(hop, [
		{"type": "hawse", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 13, "y": 1, "dir": 0},
	])
	_check(not bool(short_hawse["success"]) and _at(_frame(short_hawse, 3), 13, 1) and _dir_at(_frame(short_hawse, 3), 13, 1) == 0, "a hawse lands four cells short of a bobstay")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "block": Vector2i(1, 4), "land": Vector2i(17, 4), "dock": Vector2i(18, 4), "size": Vector2i(19, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "block": Vector2i(1, 1), "land": Vector2i(1, 17), "dock": Vector2i(1, 18), "size": Vector2i(3, 19)},
		{"name": "west", "src": Vector2i(18, 1), "arrival": 2, "block": Vector2i(17, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(19, 3)},
		{"name": "north", "src": Vector2i(2, 18), "arrival": 3, "block": Vector2i(2, 17), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 19)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var block_at: Vector2i = spec["block"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "bobstay", "x": block_at.x, "y": block_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps sixteen cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the sixteen-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 19, "height": 6, "walls": [{"x": 18, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 16, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 18, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "bobstay", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 17, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "a bobstay keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 17, 4) == "blue", "the bobstay keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 19, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 15, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 18, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "bobstay", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 16, "y": 4, "dir": 0},
		{"type": "pause", "x": 17, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "a bobstay can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 17, 4) == "gray" and _dir_at(into, 17, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_thirty_eight() -> void:
	print("building 38")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 274, "building 38 adds routes 268 through 274")
	_check(int(puzzles[266]["id"]) == 267, "route 267 is the last route before the bobstay")
	_check(int(puzzles[267]["id"]) == 268, "the bobstay begins at route 268")
	_check(Puzzles.INTRO.size() >= 42 and Puzzles.INTRO[41] == "bobstay", "the bobstay is the block building 38 teaches")
	_check(not Puzzles.unlocked_at(266).has("bobstay"), "the bobstay stays locked through route 267")
	_check(Puzzles.unlocked_at(267).has("bobstay"), "route 268 unlocks the bobstay")
	_check(Puzzles.unlocked_at(273).size() == 42, "building 38 ends with every block")
	var pars := {
		268: [6, 3],
		269: [7, 4],
		270: [7, 5],
		271: [5, 2],
		272: [7, 5],
		273: [7, 3],
		274: [28, 27],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 267:
			_check(int(puzzle.get("building", 1)) < 38, "route %d stays out of building 38" % id)
			if id >= 261:
				_check(int(puzzle.get("building", 1)) == 37, "route %d stays in building 37" % id)
			continue
		if id > 274:
			continue
		_check(int(puzzle.get("building", 1)) == 38, "route %d is building 38" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 268:
			_check(str(puzzle.get("unlocks", "")) == "bobstay", "route 268 teaches the bobstay")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_bobstay := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "bobstay":
				uses_bobstay = true
		_check(uses_bobstay, "route %d reference uses the bobstay" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [268, 269, 270, 271, 272, 273, 274]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "bobstay":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the bobstay block is rotated" % id)
		for kind in ["gammon", "cathead", "breasthook", "hawse", "knighthead", "forefoot", "gripe", "deadwood", "apron", "stemson", "keelson", "futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "bobstay", kind))
			_check(not bool(swapped["success"]), "route %d fails if the bobstay is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "bobstay":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the bobstay is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(268), _by_id(268)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 268 starts the parcel facing east on the bobstay")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 268 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 18, 1) and _dir_at(_frame(lesson, 4), 18, 1) == 0, "route 268 jumps sixteen cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1) or _at(frame, 17, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 268 does not enter the cells in front")
	_check(str(Sim.run(_by_id(268), _swap(_by_id(268), "bobstay", "gammon"))["reason"]) == "stuck", "route 268's gammon lands on the last brick")
	_check(str(Sim.run(_by_id(268), _swap(_by_id(268), "bobstay", "cathead"))["reason"]) == "stuck", "route 268's cathead lands two cells short")

	var let_bobstay: Dictionary = Sim.run(_by_id(269), _by_id(269)["reference"])
	_check(_color_at(_frame(let_bobstay, 4), 2, 1) == "red" and _dir_at(_frame(let_bobstay, 4), 2, 1) == 0 and _color_at(_frame(let_bobstay, 4), 18, 1) == "blue", "route 269 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_bobstay, 5), 18, 1) == "red" and _dir_at(_frame(let_bobstay, 5), 18, 1) == 0 and _frame(let_bobstay, 5).get("delivered", []).size() == 1, "route 269 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(270), _by_id(270)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 270 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 270 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 17, 1) == "red" and _dir_at(_frame(counted, 3), 17, 1) == 0, "route 270 jumps sixteen cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 19, 1) == "red" and _count_at(_frame(counted, 6), 19, 1) == 2, "route 270's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(271), _by_id(271)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 271 waits facing east")
	_check(_at(_frame(clear, 3), 17, 1) and _dir_at(_frame(clear, 3), 17, 1) == 0, "route 271 lands sixteen cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1):
			brick_entered = true
	_check(not brick_entered, "route 271 does not enter any brick")
	_check(str(Sim.run(_by_id(271), _swap(_by_id(271), "bobstay", "gammon"))["reason"]) == "stuck", "route 271's gammon tries to land on the last brick")
	_check(str(Sim.run(_by_id(271), _swap(_by_id(271), "bobstay", "pause"))["reason"]) == "stuck", "route 271's pause tries to enter the first brick")

	var paired: Dictionary = Sim.run(_by_id(272), _by_id(272)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 19) == "red" and _dir_at(_frame(paired, 2), 1, 19) == 0, "route 272 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 18, 2) == "blue" and _dir_at(_frame(paired, 4), 18, 2) == 1, "route 272 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 272 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 272 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 19), Vector2i(18, 2)]:
		for kind in ["gammon", "cathead", "breasthook", "hawse"]:
			var one: Dictionary = Sim.run(_by_id(272), _swap_cell(_by_id(272), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 272 misses the dock if the bobstay at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(273), _by_id(273)["reference"])
	_check(_at(_frame(second, 2), 1, 17) and _dir_at(_frame(second, 2), 1, 17) == 0, "route 273 waits on the first bobstay facing east")
	_check(_at(_frame(second, 3), 17, 17) and _dir_at(_frame(second, 3), 17, 17) == 0, "route 273 jumps sixteen cells forward and still faces east")
	_check(_at(_frame(second, 5), 17, 16) and _dir_at(_frame(second, 5), 17, 16) == 3, "route 273 reaches the second bobstay facing north")
	_check(_at(_frame(second, 6), 17, 16) and _dir_at(_frame(second, 6), 17, 16) == 3, "route 273 waits on the second bobstay facing north")
	_check(int(second["cycles"]) == 7, "route 273 jumps sixteen cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(273), _omit_cell(_by_id(273), 1, 17))["success"]), "route 273 fails without the first bobstay")
	_check(not bool(Sim.run(_by_id(273), _omit_cell(_by_id(273), 17, 16))["success"]), "route 273 fails without the second bobstay")
	for cell in [Vector2i(1, 17), Vector2i(17, 16)]:
		for kind in ["gammon", "cathead", "breasthook", "hawse"]:
			var missed: Dictionary = Sim.run(_by_id(273), _swap_cell(_by_id(273), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 273 misses the dock if the bobstay at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(274), _by_id(274)["reference"])
	_check(int(night["cycles"]) < 250, "route 274 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 274 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 274 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 274 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 274 holds red facing east")
	_check(_color_at(_frame(night, 8), 19, 3) == "red" and _dir_at(_frame(night, 8), 19, 3) == 0, "route 274 jumps red sixteen cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 20, 3) == "red" and _dir_at(_frame(night, 10), 20, 3) == 0 and _count_at(_frame(night, 10), 20, 3) == 0, "route 274 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red" or _color_at(frame, 8, 3) == "red" or _color_at(frame, 9, 3) == "red" or _color_at(frame, 10, 3) == "red" or _color_at(frame, 11, 3) == "red" or _color_at(frame, 12, 3) == "red" or _color_at(frame, 13, 3) == "red" or _color_at(frame, 14, 3) == "red" or _color_at(frame, 15, 3) == "red" or _color_at(frame, 16, 3) == "red" or _color_at(frame, 17, 3) == "red" or _color_at(frame, 18, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 274 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(274), _swap(_by_id(274), "bobstay", "gammon"))["success"]), "route 274's gammon misses the pause")
	_check(not bool(Sim.run(_by_id(274), _swap(_by_id(274), "bobstay", "cathead"))["success"]), "route 274's cathead misses the pause")
	_check(not bool(Sim.run(_by_id(274), _swap(_by_id(274), "primer", "painter"))["success"]), "route 274 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(274), _swap(_by_id(274), "filter", "conveyor"))["success"]), "route 274 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(274), _swap(_by_id(274), "counter", "conveyor"))["success"]), "route 274 fails without the counter")


func _bumpkin_rules() -> void:
	print("bumpkin")
	var hop := {
		"width": 19, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 18, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "bumpkin", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a bumpkin jumps seventeen cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the bumpkin waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 18, 1), "the bumpkin does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a bumpkin does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "bumpkin", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a bumpkin is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a bumpkin does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "bumpkin", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
		{"type": "bin", "x": 10, "y": 1, "dir": 0},
		{"type": "bin", "x": 11, "y": 1, "dir": 0},
		{"type": "bin", "x": 12, "y": 1, "dir": 0},
		{"type": "bin", "x": 13, "y": 1, "dir": 0},
		{"type": "bin", "x": 14, "y": 1, "dir": 0},
		{"type": "bin", "x": 15, "y": 1, "dir": 0},
		{"type": "bin", "x": 16, "y": 1, "dir": 0},
		{"type": "bin", "x": 17, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the bumpkin")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1) or _at(frame, 17, 1):
			skipped = true
	_check(not skipped, "the bumpkin does not enter any of the sixteen cells in front")
	var short_bobstay: Dictionary = Sim.run(hop, [
		{"type": "bobstay", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 17, "y": 1, "dir": 0},
	])
	_check(not bool(short_bobstay["success"]) and _at(_frame(short_bobstay, 3), 17, 1) and _dir_at(_frame(short_bobstay, 3), 17, 1) == 0, "a bobstay lands one cell short of a bumpkin")
	var short_gammon: Dictionary = Sim.run(hop, [
		{"type": "gammon", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 16, "y": 1, "dir": 0},
	])
	_check(not bool(short_gammon["success"]) and _at(_frame(short_gammon, 3), 16, 1) and _dir_at(_frame(short_gammon, 3), 16, 1) == 0, "a gammon lands two cells short of a bumpkin")
	var short_cathead: Dictionary = Sim.run(hop, [
		{"type": "cathead", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 15, "y": 1, "dir": 0},
	])
	_check(not bool(short_cathead["success"]) and _at(_frame(short_cathead, 3), 15, 1) and _dir_at(_frame(short_cathead, 3), 15, 1) == 0, "a cathead lands three cells short of a bumpkin")
	var short_breasthook: Dictionary = Sim.run(hop, [
		{"type": "breasthook", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 14, "y": 1, "dir": 0},
	])
	_check(not bool(short_breasthook["success"]) and _at(_frame(short_breasthook, 3), 14, 1) and _dir_at(_frame(short_breasthook, 3), 14, 1) == 0, "a breasthook lands four cells short of a bumpkin")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "block": Vector2i(1, 4), "land": Vector2i(18, 4), "dock": Vector2i(19, 4), "size": Vector2i(20, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "block": Vector2i(1, 1), "land": Vector2i(1, 18), "dock": Vector2i(1, 19), "size": Vector2i(3, 20)},
		{"name": "west", "src": Vector2i(19, 1), "arrival": 2, "block": Vector2i(18, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(20, 3)},
		{"name": "north", "src": Vector2i(2, 19), "arrival": 3, "block": Vector2i(2, 18), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 20)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var block_at: Vector2i = spec["block"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "bumpkin", "x": block_at.x, "y": block_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps seventeen cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the seventeen-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 20, "height": 6, "walls": [{"x": 19, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 17, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 19, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "bumpkin", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 18, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "a bumpkin keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 18, 4) == "blue", "the bumpkin keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 20, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 16, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 19, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "bumpkin", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 17, "y": 4, "dir": 0},
		{"type": "pause", "x": 18, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "a bumpkin can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 18, 4) == "gray" and _dir_at(into, 18, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_thirty_nine() -> void:
	print("building 39")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 281, "building 39 adds routes 275 through 281")
	_check(int(puzzles[273]["id"]) == 274, "route 274 is the last route before the bumpkin")
	_check(int(puzzles[274]["id"]) == 275, "the bumpkin begins at route 275")
	_check(Puzzles.INTRO.size() >= 43 and Puzzles.INTRO[42] == "bumpkin", "the bumpkin is the block building 39 teaches")
	_check(not Puzzles.unlocked_at(273).has("bumpkin"), "the bumpkin stays locked through route 274")
	_check(Puzzles.unlocked_at(274).has("bumpkin"), "route 275 unlocks the bumpkin")
	_check(Puzzles.unlocked_at(280).size() == 43, "building 39 ends with every block")
	var pars := {
		275: [6, 3],
		276: [7, 4],
		277: [7, 5],
		278: [5, 2],
		279: [7, 5],
		280: [7, 3],
		281: [29, 28],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 274:
			_check(int(puzzle.get("building", 1)) < 39, "route %d stays out of building 39" % id)
			if id >= 268:
				_check(int(puzzle.get("building", 1)) == 38, "route %d stays in building 38" % id)
			continue
		if id > 281:
			continue
		_check(int(puzzle.get("building", 1)) == 39, "route %d is building 39" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 275:
			_check(str(puzzle.get("unlocks", "")) == "bumpkin", "route 275 teaches the bumpkin")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_bumpkin := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "bumpkin":
				uses_bumpkin = true
		_check(uses_bumpkin, "route %d reference uses the bumpkin" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [275, 276, 277, 278, 279, 280, 281]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "bumpkin":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the bumpkin block is rotated" % id)
		for kind in ["bobstay", "gammon", "cathead", "breasthook", "hawse", "knighthead", "forefoot", "gripe", "deadwood", "apron", "stemson", "keelson", "futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "bumpkin", kind))
			_check(not bool(swapped["success"]), "route %d fails if the bumpkin is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "bumpkin":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the bumpkin is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(275), _by_id(275)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 275 starts the parcel facing east on the bumpkin")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 275 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 19, 1) and _dir_at(_frame(lesson, 4), 19, 1) == 0, "route 275 jumps seventeen cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1) or _at(frame, 17, 1) or _at(frame, 18, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 275 does not enter the cells in front")
	_check(str(Sim.run(_by_id(275), _swap(_by_id(275), "bumpkin", "bobstay"))["reason"]) == "stuck", "route 275's bobstay lands on the last brick")
	_check(str(Sim.run(_by_id(275), _swap(_by_id(275), "bumpkin", "gammon"))["reason"]) == "stuck", "route 275's gammon lands two cells short")

	var let_bumpkin: Dictionary = Sim.run(_by_id(276), _by_id(276)["reference"])
	_check(_color_at(_frame(let_bumpkin, 4), 2, 1) == "red" and _dir_at(_frame(let_bumpkin, 4), 2, 1) == 0 and _color_at(_frame(let_bumpkin, 4), 19, 1) == "blue", "route 276 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_bumpkin, 5), 19, 1) == "red" and _dir_at(_frame(let_bumpkin, 5), 19, 1) == 0 and _frame(let_bumpkin, 5).get("delivered", []).size() == 1, "route 276 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(277), _by_id(277)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 277 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 277 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 18, 1) == "red" and _dir_at(_frame(counted, 3), 18, 1) == 0, "route 277 jumps seventeen cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 20, 1) == "red" and _count_at(_frame(counted, 6), 20, 1) == 2, "route 277's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(278), _by_id(278)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 278 waits facing east")
	_check(_at(_frame(clear, 3), 18, 1) and _dir_at(_frame(clear, 3), 18, 1) == 0, "route 278 lands seventeen cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1) or _at(frame, 17, 1):
			brick_entered = true
	_check(not brick_entered, "route 278 does not enter any brick")
	_check(str(Sim.run(_by_id(278), _swap(_by_id(278), "bumpkin", "bobstay"))["reason"]) == "stuck", "route 278's bobstay tries to land on the last brick")
	_check(str(Sim.run(_by_id(278), _swap(_by_id(278), "bumpkin", "pause"))["reason"]) == "stuck", "route 278's pause tries to enter the first brick")

	var paired: Dictionary = Sim.run(_by_id(279), _by_id(279)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 20) == "red" and _dir_at(_frame(paired, 2), 1, 20) == 0, "route 279 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 19, 2) == "blue" and _dir_at(_frame(paired, 4), 19, 2) == 1, "route 279 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 279 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 279 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 20), Vector2i(19, 2)]:
		for kind in ["bobstay", "gammon", "cathead", "breasthook"]:
			var one: Dictionary = Sim.run(_by_id(279), _swap_cell(_by_id(279), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 279 misses the dock if the bumpkin at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(280), _by_id(280)["reference"])
	_check(_at(_frame(second, 2), 1, 18) and _dir_at(_frame(second, 2), 1, 18) == 0, "route 280 waits on the first bumpkin facing east")
	_check(_at(_frame(second, 3), 18, 18) and _dir_at(_frame(second, 3), 18, 18) == 0, "route 280 jumps seventeen cells forward and still faces east")
	_check(_at(_frame(second, 5), 18, 17) and _dir_at(_frame(second, 5), 18, 17) == 3, "route 280 reaches the second bumpkin facing north")
	_check(_at(_frame(second, 6), 18, 17) and _dir_at(_frame(second, 6), 18, 17) == 3, "route 280 waits on the second bumpkin facing north")
	_check(int(second["cycles"]) == 7, "route 280 jumps seventeen cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(280), _omit_cell(_by_id(280), 1, 18))["success"]), "route 280 fails without the first bumpkin")
	_check(not bool(Sim.run(_by_id(280), _omit_cell(_by_id(280), 18, 17))["success"]), "route 280 fails without the second bumpkin")
	for cell in [Vector2i(1, 18), Vector2i(18, 17)]:
		for kind in ["bobstay", "gammon", "cathead", "breasthook"]:
			var missed: Dictionary = Sim.run(_by_id(280), _swap_cell(_by_id(280), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 280 misses the dock if the bumpkin at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(281), _by_id(281)["reference"])
	_check(int(night["cycles"]) < 250, "route 281 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 281 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 281 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 281 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 281 holds red facing east")
	_check(_color_at(_frame(night, 8), 20, 3) == "red" and _dir_at(_frame(night, 8), 20, 3) == 0, "route 281 jumps red seventeen cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 21, 3) == "red" and _dir_at(_frame(night, 10), 21, 3) == 0 and _count_at(_frame(night, 10), 21, 3) == 0, "route 281 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red" or _color_at(frame, 8, 3) == "red" or _color_at(frame, 9, 3) == "red" or _color_at(frame, 10, 3) == "red" or _color_at(frame, 11, 3) == "red" or _color_at(frame, 12, 3) == "red" or _color_at(frame, 13, 3) == "red" or _color_at(frame, 14, 3) == "red" or _color_at(frame, 15, 3) == "red" or _color_at(frame, 16, 3) == "red" or _color_at(frame, 17, 3) == "red" or _color_at(frame, 18, 3) == "red" or _color_at(frame, 19, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 281 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(281), _swap(_by_id(281), "bumpkin", "bobstay"))["success"]), "route 281's bobstay misses the pause")
	_check(not bool(Sim.run(_by_id(281), _swap(_by_id(281), "bumpkin", "gammon"))["success"]), "route 281's gammon misses the pause")
	_check(not bool(Sim.run(_by_id(281), _swap(_by_id(281), "primer", "painter"))["success"]), "route 281 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(281), _swap(_by_id(281), "filter", "conveyor"))["success"]), "route 281 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(281), _swap(_by_id(281), "counter", "conveyor"))["success"]), "route 281 fails without the counter")


func _dolphin_rules() -> void:
	print("dolphin")
	var hop := {
		"width": 20, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 19, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "dolphin", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a dolphin jumps eighteen cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the dolphin waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 19, 1), "the dolphin does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a dolphin does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "dolphin", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a dolphin is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a dolphin does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "dolphin", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
		{"type": "bin", "x": 10, "y": 1, "dir": 0},
		{"type": "bin", "x": 11, "y": 1, "dir": 0},
		{"type": "bin", "x": 12, "y": 1, "dir": 0},
		{"type": "bin", "x": 13, "y": 1, "dir": 0},
		{"type": "bin", "x": 14, "y": 1, "dir": 0},
		{"type": "bin", "x": 15, "y": 1, "dir": 0},
		{"type": "bin", "x": 16, "y": 1, "dir": 0},
		{"type": "bin", "x": 17, "y": 1, "dir": 0},
		{"type": "bin", "x": 18, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the dolphin")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1) or _at(frame, 17, 1) or _at(frame, 18, 1):
			skipped = true
	_check(not skipped, "the dolphin does not enter any of the seventeen cells in front")
	var short_bumpkin: Dictionary = Sim.run(hop, [
		{"type": "bumpkin", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 18, "y": 1, "dir": 0},
	])
	_check(not bool(short_bumpkin["success"]) and _at(_frame(short_bumpkin, 3), 18, 1) and _dir_at(_frame(short_bumpkin, 3), 18, 1) == 0, "a bumpkin lands one cell short of a dolphin")
	var short_bobstay: Dictionary = Sim.run(hop, [
		{"type": "bobstay", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 17, "y": 1, "dir": 0},
	])
	_check(not bool(short_bobstay["success"]) and _at(_frame(short_bobstay, 3), 17, 1) and _dir_at(_frame(short_bobstay, 3), 17, 1) == 0, "a bobstay lands two cells short of a dolphin")
	var short_gammon: Dictionary = Sim.run(hop, [
		{"type": "gammon", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 16, "y": 1, "dir": 0},
	])
	_check(not bool(short_gammon["success"]) and _at(_frame(short_gammon, 3), 16, 1) and _dir_at(_frame(short_gammon, 3), 16, 1) == 0, "a gammon lands three cells short of a dolphin")
	var short_cathead: Dictionary = Sim.run(hop, [
		{"type": "cathead", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 15, "y": 1, "dir": 0},
	])
	_check(not bool(short_cathead["success"]) and _at(_frame(short_cathead, 3), 15, 1) and _dir_at(_frame(short_cathead, 3), 15, 1) == 0, "a cathead lands four cells short of a dolphin")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "block": Vector2i(1, 4), "land": Vector2i(19, 4), "dock": Vector2i(20, 4), "size": Vector2i(21, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "block": Vector2i(1, 1), "land": Vector2i(1, 19), "dock": Vector2i(1, 20), "size": Vector2i(3, 21)},
		{"name": "west", "src": Vector2i(20, 1), "arrival": 2, "block": Vector2i(19, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(21, 3)},
		{"name": "north", "src": Vector2i(2, 20), "arrival": 3, "block": Vector2i(2, 19), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 21)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var block_at: Vector2i = spec["block"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "dolphin", "x": block_at.x, "y": block_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps eighteen cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the eighteen-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 21, "height": 6, "walls": [{"x": 20, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 18, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 20, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "dolphin", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 19, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "a dolphin keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 19, 4) == "blue", "the dolphin keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 21, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 17, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 20, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "dolphin", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 18, "y": 4, "dir": 0},
		{"type": "pause", "x": 19, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "a dolphin can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 19, 4) == "gray" and _dir_at(into, 19, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_forty() -> void:
	print("building 40")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 288, "building 40 adds routes 282 through 288")
	_check(int(puzzles[280]["id"]) == 281, "route 281 is the last route before the dolphin")
	_check(int(puzzles[281]["id"]) == 282, "the dolphin begins at route 282")
	_check(Puzzles.INTRO.size() >= 44 and Puzzles.INTRO[43] == "dolphin", "the dolphin is the block building 40 teaches")
	_check(not Puzzles.unlocked_at(280).has("dolphin"), "the dolphin stays locked through route 281")
	_check(Puzzles.unlocked_at(281).has("dolphin"), "route 282 unlocks the dolphin")
	_check(Puzzles.unlocked_at(287).size() == 44, "building 40 ends with every block")
	var pars := {
		282: [6, 3],
		283: [7, 4],
		284: [7, 5],
		285: [5, 2],
		286: [7, 5],
		287: [7, 3],
		288: [30, 29],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 281:
			_check(int(puzzle.get("building", 1)) < 40, "route %d stays out of building 40" % id)
			if id >= 275:
				_check(int(puzzle.get("building", 1)) == 39, "route %d stays in building 39" % id)
			continue
		if id > 288:
			continue
		_check(int(puzzle.get("building", 1)) == 40, "route %d is building 40" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 282:
			_check(str(puzzle.get("unlocks", "")) == "dolphin", "route 282 teaches the dolphin")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_dolphin := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "dolphin":
				uses_dolphin = true
		_check(uses_dolphin, "route %d reference uses the dolphin" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [282, 283, 284, 285, 286, 287, 288]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "dolphin":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the dolphin block is rotated" % id)
		for kind in ["bumpkin", "bobstay", "gammon", "cathead", "breasthook", "hawse", "knighthead", "forefoot", "gripe", "deadwood", "apron", "stemson", "keelson", "futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "dolphin", kind))
			_check(not bool(swapped["success"]), "route %d fails if the dolphin is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "dolphin":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the dolphin is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(282), _by_id(282)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 282 starts the parcel facing east on the dolphin")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 282 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 20, 1) and _dir_at(_frame(lesson, 4), 20, 1) == 0, "route 282 jumps eighteen cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1) or _at(frame, 17, 1) or _at(frame, 18, 1) or _at(frame, 19, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 282 does not enter the cells in front")
	_check(str(Sim.run(_by_id(282), _swap(_by_id(282), "dolphin", "bumpkin"))["reason"]) == "stuck", "route 282's bumpkin lands on the last brick")
	_check(str(Sim.run(_by_id(282), _swap(_by_id(282), "dolphin", "bobstay"))["reason"]) == "stuck", "route 282's bobstay lands two cells short")

	var let_dolphin: Dictionary = Sim.run(_by_id(283), _by_id(283)["reference"])
	_check(_color_at(_frame(let_dolphin, 4), 2, 1) == "red" and _dir_at(_frame(let_dolphin, 4), 2, 1) == 0 and _color_at(_frame(let_dolphin, 4), 20, 1) == "blue", "route 283 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_dolphin, 5), 20, 1) == "red" and _dir_at(_frame(let_dolphin, 5), 20, 1) == 0 and _frame(let_dolphin, 5).get("delivered", []).size() == 1, "route 283 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(284), _by_id(284)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 284 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 284 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 19, 1) == "red" and _dir_at(_frame(counted, 3), 19, 1) == 0, "route 284 jumps eighteen cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 21, 1) == "red" and _count_at(_frame(counted, 6), 21, 1) == 2, "route 284's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(285), _by_id(285)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 285 waits facing east")
	_check(_at(_frame(clear, 3), 19, 1) and _dir_at(_frame(clear, 3), 19, 1) == 0, "route 285 lands eighteen cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1) or _at(frame, 17, 1) or _at(frame, 18, 1):
			brick_entered = true
	_check(not brick_entered, "route 285 does not enter any brick")
	_check(str(Sim.run(_by_id(285), _swap(_by_id(285), "dolphin", "bumpkin"))["reason"]) == "stuck", "route 285's bumpkin tries to land on the last brick")
	_check(str(Sim.run(_by_id(285), _swap(_by_id(285), "dolphin", "pause"))["reason"]) == "stuck", "route 285's pause tries to enter the first brick")

	var paired: Dictionary = Sim.run(_by_id(286), _by_id(286)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 21) == "red" and _dir_at(_frame(paired, 2), 1, 21) == 0, "route 286 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 20, 2) == "blue" and _dir_at(_frame(paired, 4), 20, 2) == 1, "route 286 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 286 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 286 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 21), Vector2i(20, 2)]:
		for kind in ["bumpkin", "bobstay", "gammon"]:
			var one: Dictionary = Sim.run(_by_id(286), _swap_cell(_by_id(286), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 286 misses the dock if the dolphin at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(287), _by_id(287)["reference"])
	_check(_at(_frame(second, 2), 1, 19) and _dir_at(_frame(second, 2), 1, 19) == 0, "route 287 waits on the first dolphin facing east")
	_check(_at(_frame(second, 3), 19, 19) and _dir_at(_frame(second, 3), 19, 19) == 0, "route 287 jumps eighteen cells forward and still faces east")
	_check(_at(_frame(second, 5), 19, 18) and _dir_at(_frame(second, 5), 19, 18) == 3, "route 287 reaches the second dolphin facing north")
	_check(_at(_frame(second, 6), 19, 18) and _dir_at(_frame(second, 6), 19, 18) == 3, "route 287 waits on the second dolphin facing north")
	_check(int(second["cycles"]) == 7, "route 287 jumps eighteen cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(287), _omit_cell(_by_id(287), 1, 19))["success"]), "route 287 fails without the first dolphin")
	_check(not bool(Sim.run(_by_id(287), _omit_cell(_by_id(287), 19, 18))["success"]), "route 287 fails without the second dolphin")
	for cell in [Vector2i(1, 19), Vector2i(19, 18)]:
		for kind in ["bumpkin", "bobstay", "gammon"]:
			var missed: Dictionary = Sim.run(_by_id(287), _swap_cell(_by_id(287), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 287 misses the dock if the dolphin at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(288), _by_id(288)["reference"])
	_check(int(night["cycles"]) < 250, "route 288 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 288 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 288 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 288 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 288 holds red facing east")
	_check(_color_at(_frame(night, 8), 21, 3) == "red" and _dir_at(_frame(night, 8), 21, 3) == 0, "route 288 jumps red eighteen cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 22, 3) == "red" and _dir_at(_frame(night, 10), 22, 3) == 0 and _count_at(_frame(night, 10), 22, 3) == 0, "route 288 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red" or _color_at(frame, 8, 3) == "red" or _color_at(frame, 9, 3) == "red" or _color_at(frame, 10, 3) == "red" or _color_at(frame, 11, 3) == "red" or _color_at(frame, 12, 3) == "red" or _color_at(frame, 13, 3) == "red" or _color_at(frame, 14, 3) == "red" or _color_at(frame, 15, 3) == "red" or _color_at(frame, 16, 3) == "red" or _color_at(frame, 17, 3) == "red" or _color_at(frame, 18, 3) == "red" or _color_at(frame, 19, 3) == "red" or _color_at(frame, 20, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 288 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(288), _swap(_by_id(288), "dolphin", "bumpkin"))["success"]), "route 288's bumpkin misses the pause")
	_check(not bool(Sim.run(_by_id(288), _swap(_by_id(288), "dolphin", "bobstay"))["success"]), "route 288's bobstay misses the pause")
	_check(not bool(Sim.run(_by_id(288), _swap(_by_id(288), "primer", "painter"))["success"]), "route 288 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(288), _swap(_by_id(288), "filter", "conveyor"))["success"]), "route 288 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(288), _swap(_by_id(288), "counter", "conveyor"))["success"]), "route 288 fails without the counter")


func _martingale_rules() -> void:
	print("martingale")
	var hop := {
		"width": 21, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 20, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "martingale", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a martingale jumps nineteen cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the martingale waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 20, 1), "the martingale does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a martingale does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "martingale", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a martingale is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a martingale does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "martingale", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
		{"type": "bin", "x": 10, "y": 1, "dir": 0},
		{"type": "bin", "x": 11, "y": 1, "dir": 0},
		{"type": "bin", "x": 12, "y": 1, "dir": 0},
		{"type": "bin", "x": 13, "y": 1, "dir": 0},
		{"type": "bin", "x": 14, "y": 1, "dir": 0},
		{"type": "bin", "x": 15, "y": 1, "dir": 0},
		{"type": "bin", "x": 16, "y": 1, "dir": 0},
		{"type": "bin", "x": 17, "y": 1, "dir": 0},
		{"type": "bin", "x": 18, "y": 1, "dir": 0},
		{"type": "bin", "x": 19, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the martingale")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1) or _at(frame, 17, 1) or _at(frame, 18, 1) or _at(frame, 19, 1):
			skipped = true
	_check(not skipped, "the martingale does not enter any of the eighteen cells in front")
	var short_dolphin: Dictionary = Sim.run(hop, [
		{"type": "dolphin", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 19, "y": 1, "dir": 0},
	])
	_check(not bool(short_dolphin["success"]) and _at(_frame(short_dolphin, 3), 19, 1) and _dir_at(_frame(short_dolphin, 3), 19, 1) == 0, "a dolphin lands one cell short of a martingale")
	var short_bumpkin: Dictionary = Sim.run(hop, [
		{"type": "bumpkin", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 18, "y": 1, "dir": 0},
	])
	_check(not bool(short_bumpkin["success"]) and _at(_frame(short_bumpkin, 3), 18, 1) and _dir_at(_frame(short_bumpkin, 3), 18, 1) == 0, "a bumpkin lands two cells short of a martingale")
	var short_bobstay: Dictionary = Sim.run(hop, [
		{"type": "bobstay", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 17, "y": 1, "dir": 0},
	])
	_check(not bool(short_bobstay["success"]) and _at(_frame(short_bobstay, 3), 17, 1) and _dir_at(_frame(short_bobstay, 3), 17, 1) == 0, "a bobstay lands three cells short of a martingale")
	var short_gammon: Dictionary = Sim.run(hop, [
		{"type": "gammon", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 16, "y": 1, "dir": 0},
	])
	_check(not bool(short_gammon["success"]) and _at(_frame(short_gammon, 3), 16, 1) and _dir_at(_frame(short_gammon, 3), 16, 1) == 0, "a gammon lands four cells short of a martingale")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "block": Vector2i(1, 4), "land": Vector2i(20, 4), "dock": Vector2i(21, 4), "size": Vector2i(22, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "block": Vector2i(1, 1), "land": Vector2i(1, 20), "dock": Vector2i(1, 21), "size": Vector2i(3, 22)},
		{"name": "west", "src": Vector2i(21, 1), "arrival": 2, "block": Vector2i(20, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(22, 3)},
		{"name": "north", "src": Vector2i(2, 21), "arrival": 3, "block": Vector2i(2, 20), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 22)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var block_at: Vector2i = spec["block"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "martingale", "x": block_at.x, "y": block_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps nineteen cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the nineteen-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 22, "height": 6, "walls": [{"x": 21, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 19, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 21, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "martingale", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 20, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "a martingale keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 20, 4) == "blue", "the martingale keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 22, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 18, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 21, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "martingale", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 19, "y": 4, "dir": 0},
		{"type": "pause", "x": 20, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "a martingale can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 20, 4) == "gray" and _dir_at(into, 20, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_forty_one() -> void:
	print("building 41")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 295, "building 41 adds routes 289 through 295")
	_check(int(puzzles[287]["id"]) == 288, "route 288 is the last route before the martingale")
	_check(int(puzzles[288]["id"]) == 289, "the martingale begins at route 289")
	_check(Puzzles.INTRO.size() >= 45 and Puzzles.INTRO[44] == "martingale", "the martingale is the block building 41 teaches")
	_check(not Puzzles.unlocked_at(287).has("martingale"), "the martingale stays locked through route 288")
	_check(Puzzles.unlocked_at(288).has("martingale"), "route 289 unlocks the martingale")
	_check(Puzzles.unlocked_at(294).size() == 45, "building 41 ends with every block")
	var pars := {
		289: [6, 3],
		290: [7, 4],
		291: [7, 5],
		292: [5, 2],
		293: [7, 5],
		294: [7, 3],
		295: [31, 30],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 288:
			_check(int(puzzle.get("building", 1)) < 41, "route %d stays out of building 41" % id)
			if id >= 282:
				_check(int(puzzle.get("building", 1)) == 40, "route %d stays in building 40" % id)
			continue
		if id > 295:
			continue
		_check(int(puzzle.get("building", 1)) == 41, "route %d is building 41" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 289:
			_check(str(puzzle.get("unlocks", "")) == "martingale", "route 289 teaches the martingale")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_martingale := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "martingale":
				uses_martingale = true
		_check(uses_martingale, "route %d reference uses the martingale" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [289, 290, 291, 292, 293, 294, 295]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "martingale":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the martingale block is rotated" % id)
		for kind in ["dolphin", "bumpkin", "bobstay", "gammon", "cathead", "breasthook", "hawse", "knighthead", "forefoot", "gripe", "deadwood", "apron", "stemson", "keelson", "futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "martingale", kind))
			_check(not bool(swapped["success"]), "route %d fails if the martingale is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "martingale":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the martingale is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(289), _by_id(289)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 289 starts the parcel facing east on the martingale")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 289 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 21, 1) and _dir_at(_frame(lesson, 4), 21, 1) == 0, "route 289 jumps nineteen cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1) or _at(frame, 17, 1) or _at(frame, 18, 1) or _at(frame, 19, 1) or _at(frame, 20, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 289 does not enter the cells in front")
	_check(str(Sim.run(_by_id(289), _swap(_by_id(289), "martingale", "dolphin"))["reason"]) == "stuck", "route 289's dolphin lands on the last brick")
	_check(str(Sim.run(_by_id(289), _swap(_by_id(289), "martingale", "bumpkin"))["reason"]) == "stuck", "route 289's bumpkin lands two cells short")

	var let_martingale: Dictionary = Sim.run(_by_id(290), _by_id(290)["reference"])
	_check(_color_at(_frame(let_martingale, 4), 2, 1) == "red" and _dir_at(_frame(let_martingale, 4), 2, 1) == 0 and _color_at(_frame(let_martingale, 4), 21, 1) == "blue", "route 290 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_martingale, 5), 21, 1) == "red" and _dir_at(_frame(let_martingale, 5), 21, 1) == 0 and _frame(let_martingale, 5).get("delivered", []).size() == 1, "route 290 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(291), _by_id(291)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 291 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 291 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 20, 1) == "red" and _dir_at(_frame(counted, 3), 20, 1) == 0, "route 291 jumps nineteen cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 22, 1) == "red" and _count_at(_frame(counted, 6), 22, 1) == 2, "route 291's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(292), _by_id(292)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 292 waits facing east")
	_check(_at(_frame(clear, 3), 20, 1) and _dir_at(_frame(clear, 3), 20, 1) == 0, "route 292 lands nineteen cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1) or _at(frame, 17, 1) or _at(frame, 18, 1) or _at(frame, 19, 1):
			brick_entered = true
	_check(not brick_entered, "route 292 does not enter any brick")
	_check(str(Sim.run(_by_id(292), _swap(_by_id(292), "martingale", "dolphin"))["reason"]) == "stuck", "route 292's dolphin tries to land on the last brick")
	_check(str(Sim.run(_by_id(292), _swap(_by_id(292), "martingale", "pause"))["reason"]) == "stuck", "route 292's pause tries to enter the first brick")

	var paired: Dictionary = Sim.run(_by_id(293), _by_id(293)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 22) == "red" and _dir_at(_frame(paired, 2), 1, 22) == 0, "route 293 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 21, 2) == "blue" and _dir_at(_frame(paired, 4), 21, 2) == 1, "route 293 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 293 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 293 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 22), Vector2i(21, 2)]:
		for kind in ["dolphin", "bumpkin", "bobstay"]:
			var one: Dictionary = Sim.run(_by_id(293), _swap_cell(_by_id(293), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 293 misses the dock if the martingale at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(294), _by_id(294)["reference"])
	_check(_at(_frame(second, 2), 1, 20) and _dir_at(_frame(second, 2), 1, 20) == 0, "route 294 waits on the first martingale facing east")
	_check(_at(_frame(second, 3), 20, 20) and _dir_at(_frame(second, 3), 20, 20) == 0, "route 294 jumps nineteen cells forward and still faces east")
	_check(_at(_frame(second, 5), 20, 19) and _dir_at(_frame(second, 5), 20, 19) == 3, "route 294 reaches the second martingale facing north")
	_check(_at(_frame(second, 6), 20, 19) and _dir_at(_frame(second, 6), 20, 19) == 3, "route 294 waits on the second martingale facing north")
	_check(int(second["cycles"]) == 7, "route 294 jumps nineteen cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(294), _omit_cell(_by_id(294), 1, 20))["success"]), "route 294 fails without the first martingale")
	_check(not bool(Sim.run(_by_id(294), _omit_cell(_by_id(294), 20, 19))["success"]), "route 294 fails without the second martingale")
	for cell in [Vector2i(1, 20), Vector2i(20, 19)]:
		for kind in ["dolphin", "bumpkin", "bobstay"]:
			var missed: Dictionary = Sim.run(_by_id(294), _swap_cell(_by_id(294), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 294 misses the dock if the martingale at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(295), _by_id(295)["reference"])
	_check(int(night["cycles"]) < 250, "route 295 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 295 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 295 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 295 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 295 holds red facing east")
	_check(_color_at(_frame(night, 8), 22, 3) == "red" and _dir_at(_frame(night, 8), 22, 3) == 0, "route 295 jumps red nineteen cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 23, 3) == "red" and _dir_at(_frame(night, 10), 23, 3) == 0 and _count_at(_frame(night, 10), 23, 3) == 0, "route 295 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red" or _color_at(frame, 8, 3) == "red" or _color_at(frame, 9, 3) == "red" or _color_at(frame, 10, 3) == "red" or _color_at(frame, 11, 3) == "red" or _color_at(frame, 12, 3) == "red" or _color_at(frame, 13, 3) == "red" or _color_at(frame, 14, 3) == "red" or _color_at(frame, 15, 3) == "red" or _color_at(frame, 16, 3) == "red" or _color_at(frame, 17, 3) == "red" or _color_at(frame, 18, 3) == "red" or _color_at(frame, 19, 3) == "red" or _color_at(frame, 20, 3) == "red" or _color_at(frame, 21, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 295 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(295), _swap(_by_id(295), "martingale", "dolphin"))["success"]), "route 295's dolphin misses the pause")
	_check(not bool(Sim.run(_by_id(295), _swap(_by_id(295), "martingale", "bumpkin"))["success"]), "route 295's bumpkin misses the pause")
	_check(not bool(Sim.run(_by_id(295), _swap(_by_id(295), "primer", "painter"))["success"]), "route 295 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(295), _swap(_by_id(295), "filter", "conveyor"))["success"]), "route 295 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(295), _swap(_by_id(295), "counter", "conveyor"))["success"]), "route 295 fails without the counter")


func _jibboom_rules() -> void:
	print("jibboom")
	var hop := {
		"width": 22, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 21, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "jibboom", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a jibboom jumps twenty cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the jibboom waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 21, 1), "the jibboom does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a jibboom does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "jibboom", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a jibboom is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a jibboom does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "jibboom", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
		{"type": "bin", "x": 10, "y": 1, "dir": 0},
		{"type": "bin", "x": 11, "y": 1, "dir": 0},
		{"type": "bin", "x": 12, "y": 1, "dir": 0},
		{"type": "bin", "x": 13, "y": 1, "dir": 0},
		{"type": "bin", "x": 14, "y": 1, "dir": 0},
		{"type": "bin", "x": 15, "y": 1, "dir": 0},
		{"type": "bin", "x": 16, "y": 1, "dir": 0},
		{"type": "bin", "x": 17, "y": 1, "dir": 0},
		{"type": "bin", "x": 18, "y": 1, "dir": 0},
		{"type": "bin", "x": 19, "y": 1, "dir": 0},
		{"type": "bin", "x": 20, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the jibboom")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1) or _at(frame, 17, 1) or _at(frame, 18, 1) or _at(frame, 19, 1) or _at(frame, 20, 1):
			skipped = true
	_check(not skipped, "the jibboom does not enter any of the nineteen cells in front")
	var short_martingale: Dictionary = Sim.run(hop, [
		{"type": "martingale", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 20, "y": 1, "dir": 0},
	])
	_check(not bool(short_martingale["success"]) and _at(_frame(short_martingale, 3), 20, 1) and _dir_at(_frame(short_martingale, 3), 20, 1) == 0, "a martingale lands one cell short of a jibboom")
	var short_dolphin: Dictionary = Sim.run(hop, [
		{"type": "dolphin", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 19, "y": 1, "dir": 0},
	])
	_check(not bool(short_dolphin["success"]) and _at(_frame(short_dolphin, 3), 19, 1) and _dir_at(_frame(short_dolphin, 3), 19, 1) == 0, "a dolphin lands two cells short of a jibboom")
	var short_bumpkin: Dictionary = Sim.run(hop, [
		{"type": "bumpkin", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 18, "y": 1, "dir": 0},
	])
	_check(not bool(short_bumpkin["success"]) and _at(_frame(short_bumpkin, 3), 18, 1) and _dir_at(_frame(short_bumpkin, 3), 18, 1) == 0, "a bumpkin lands three cells short of a jibboom")
	var short_bobstay: Dictionary = Sim.run(hop, [
		{"type": "bobstay", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 17, "y": 1, "dir": 0},
	])
	_check(not bool(short_bobstay["success"]) and _at(_frame(short_bobstay, 3), 17, 1) and _dir_at(_frame(short_bobstay, 3), 17, 1) == 0, "a bobstay lands four cells short of a jibboom")
	var short_gammon: Dictionary = Sim.run(hop, [
		{"type": "gammon", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 16, "y": 1, "dir": 0},
	])
	_check(not bool(short_gammon["success"]) and _at(_frame(short_gammon, 3), 16, 1) and _dir_at(_frame(short_gammon, 3), 16, 1) == 0, "a gammon lands five cells short of a jibboom")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "block": Vector2i(1, 4), "land": Vector2i(21, 4), "dock": Vector2i(22, 4), "size": Vector2i(23, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "block": Vector2i(1, 1), "land": Vector2i(1, 21), "dock": Vector2i(1, 22), "size": Vector2i(3, 23)},
		{"name": "west", "src": Vector2i(22, 1), "arrival": 2, "block": Vector2i(21, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(23, 3)},
		{"name": "north", "src": Vector2i(2, 22), "arrival": 3, "block": Vector2i(2, 21), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 23)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var block_at: Vector2i = spec["block"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "jibboom", "x": block_at.x, "y": block_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps twenty cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the twenty-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 23, "height": 6, "walls": [{"x": 22, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 20, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 22, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "jibboom", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 21, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "a jibboom keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 21, 4) == "blue", "the jibboom keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 23, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 19, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 22, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "jibboom", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 20, "y": 4, "dir": 0},
		{"type": "pause", "x": 21, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "a jibboom can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 21, 4) == "gray" and _dir_at(into, 21, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_forty_two() -> void:
	print("building 42")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 302, "building 42 adds routes 296 through 302")
	_check(int(puzzles[294]["id"]) == 295, "route 295 is the last route before the jibboom")
	_check(int(puzzles[295]["id"]) == 296, "the jibboom begins at route 296")
	_check(Puzzles.INTRO.size() >= 46 and Puzzles.INTRO[45] == "jibboom", "the jibboom is the block building 42 teaches")
	_check(not Puzzles.unlocked_at(294).has("jibboom"), "the jibboom stays locked through route 295")
	_check(Puzzles.unlocked_at(295).has("jibboom"), "route 296 unlocks the jibboom")
	_check(Puzzles.unlocked_at(301).size() == 46, "building 42 ends with every block")
	var pars := {
		296: [6, 3],
		297: [7, 4],
		298: [7, 5],
		299: [5, 2],
		300: [7, 5],
		301: [7, 3],
		302: [32, 31],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 295:
			_check(int(puzzle.get("building", 1)) < 42, "route %d stays out of building 42" % id)
			if id >= 289:
				_check(int(puzzle.get("building", 1)) == 41, "route %d stays in building 41" % id)
			continue
		if id > 302:
			continue
		_check(int(puzzle.get("building", 1)) == 42, "route %d is building 42" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 296:
			_check(str(puzzle.get("unlocks", "")) == "jibboom", "route 296 teaches the jibboom")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_jibboom := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "jibboom":
				uses_jibboom = true
		_check(uses_jibboom, "route %d reference uses the jibboom" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [296, 297, 298, 299, 300, 301, 302]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "jibboom":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the jibboom block is rotated" % id)
		for kind in ["martingale", "dolphin", "bumpkin", "bobstay", "gammon", "cathead", "breasthook", "hawse", "knighthead", "forefoot", "gripe", "deadwood", "apron", "stemson", "keelson", "futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "jibboom", kind))
			_check(not bool(swapped["success"]), "route %d fails if the jibboom is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "jibboom":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the jibboom is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(296), _by_id(296)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 296 starts the parcel facing east on the jibboom")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 296 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 22, 1) and _dir_at(_frame(lesson, 4), 22, 1) == 0, "route 296 jumps twenty cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1) or _at(frame, 17, 1) or _at(frame, 18, 1) or _at(frame, 19, 1) or _at(frame, 20, 1) or _at(frame, 21, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 296 does not enter the cells in front")
	_check(str(Sim.run(_by_id(296), _swap(_by_id(296), "jibboom", "martingale"))["reason"]) == "stuck", "route 296's martingale lands on the last brick")
	_check(str(Sim.run(_by_id(296), _swap(_by_id(296), "jibboom", "dolphin"))["reason"]) == "stuck", "route 296's dolphin lands two cells short")

	var let_jibboom: Dictionary = Sim.run(_by_id(297), _by_id(297)["reference"])
	_check(_color_at(_frame(let_jibboom, 4), 2, 1) == "red" and _dir_at(_frame(let_jibboom, 4), 2, 1) == 0 and _color_at(_frame(let_jibboom, 4), 22, 1) == "blue", "route 297 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_jibboom, 5), 22, 1) == "red" and _dir_at(_frame(let_jibboom, 5), 22, 1) == 0 and _frame(let_jibboom, 5).get("delivered", []).size() == 1, "route 297 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(298), _by_id(298)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 298 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 298 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 21, 1) == "red" and _dir_at(_frame(counted, 3), 21, 1) == 0, "route 298 jumps twenty cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 23, 1) == "red" and _count_at(_frame(counted, 6), 23, 1) == 2, "route 298's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(299), _by_id(299)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 299 waits facing east")
	_check(_at(_frame(clear, 3), 21, 1) and _dir_at(_frame(clear, 3), 21, 1) == 0, "route 299 lands twenty cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1) or _at(frame, 17, 1) or _at(frame, 18, 1) or _at(frame, 19, 1) or _at(frame, 20, 1):
			brick_entered = true
	_check(not brick_entered, "route 299 does not enter any brick")
	_check(str(Sim.run(_by_id(299), _swap(_by_id(299), "jibboom", "martingale"))["reason"]) == "stuck", "route 299's martingale tries to land on the last brick")
	_check(str(Sim.run(_by_id(299), _swap(_by_id(299), "jibboom", "pause"))["reason"]) == "stuck", "route 299's pause tries to enter the first brick")

	var paired: Dictionary = Sim.run(_by_id(300), _by_id(300)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 23) == "red" and _dir_at(_frame(paired, 2), 1, 23) == 0, "route 300 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 22, 2) == "blue" and _dir_at(_frame(paired, 4), 22, 2) == 1, "route 300 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 300 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 300 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 23), Vector2i(22, 2)]:
		for kind in ["martingale", "dolphin", "bumpkin"]:
			var one: Dictionary = Sim.run(_by_id(300), _swap_cell(_by_id(300), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 300 misses the dock if the jibboom at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(301), _by_id(301)["reference"])
	_check(_at(_frame(second, 2), 1, 21) and _dir_at(_frame(second, 2), 1, 21) == 0, "route 301 waits on the first jibboom facing east")
	_check(_at(_frame(second, 3), 21, 21) and _dir_at(_frame(second, 3), 21, 21) == 0, "route 301 jumps twenty cells forward and still faces east")
	_check(_at(_frame(second, 5), 21, 20) and _dir_at(_frame(second, 5), 21, 20) == 3, "route 301 reaches the second jibboom facing north")
	_check(_at(_frame(second, 6), 21, 20) and _dir_at(_frame(second, 6), 21, 20) == 3, "route 301 waits on the second jibboom facing north")
	_check(int(second["cycles"]) == 7, "route 301 jumps twenty cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(301), _omit_cell(_by_id(301), 1, 21))["success"]), "route 301 fails without the first jibboom")
	_check(not bool(Sim.run(_by_id(301), _omit_cell(_by_id(301), 21, 20))["success"]), "route 301 fails without the second jibboom")
	for cell in [Vector2i(1, 21), Vector2i(21, 20)]:
		for kind in ["martingale", "dolphin", "bumpkin"]:
			var missed: Dictionary = Sim.run(_by_id(301), _swap_cell(_by_id(301), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 301 misses the dock if the jibboom at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(302), _by_id(302)["reference"])
	_check(int(night["cycles"]) < 250, "route 302 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 302 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 302 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 302 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 302 holds red facing east")
	_check(_color_at(_frame(night, 8), 23, 3) == "red" and _dir_at(_frame(night, 8), 23, 3) == 0, "route 302 jumps red twenty cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 24, 3) == "red" and _dir_at(_frame(night, 10), 24, 3) == 0 and _count_at(_frame(night, 10), 24, 3) == 0, "route 302 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red" or _color_at(frame, 8, 3) == "red" or _color_at(frame, 9, 3) == "red" or _color_at(frame, 10, 3) == "red" or _color_at(frame, 11, 3) == "red" or _color_at(frame, 12, 3) == "red" or _color_at(frame, 13, 3) == "red" or _color_at(frame, 14, 3) == "red" or _color_at(frame, 15, 3) == "red" or _color_at(frame, 16, 3) == "red" or _color_at(frame, 17, 3) == "red" or _color_at(frame, 18, 3) == "red" or _color_at(frame, 19, 3) == "red" or _color_at(frame, 20, 3) == "red" or _color_at(frame, 21, 3) == "red" or _color_at(frame, 22, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 302 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(302), _swap(_by_id(302), "jibboom", "martingale"))["success"]), "route 302's martingale misses the pause")
	_check(not bool(Sim.run(_by_id(302), _swap(_by_id(302), "jibboom", "dolphin"))["success"]), "route 302's dolphin misses the pause")
	_check(not bool(Sim.run(_by_id(302), _swap(_by_id(302), "primer", "painter"))["success"]), "route 302 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(302), _swap(_by_id(302), "filter", "conveyor"))["success"]), "route 302 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(302), _swap(_by_id(302), "counter", "conveyor"))["success"]), "route 302 fails without the counter")


func _whisker_rules() -> void:
	print("whisker")
	var hop := {
		"width": 23, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 22, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "whisker", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a whisker jumps twenty-one cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the whisker waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 22, 1), "the whisker does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a whisker does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "whisker", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a whisker is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a whisker does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
		{"type": "whisker", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 2, "y": 1, "dir": 0},
		{"type": "bin", "x": 3, "y": 1, "dir": 0},
		{"type": "bin", "x": 4, "y": 1, "dir": 0},
		{"type": "bin", "x": 5, "y": 1, "dir": 0},
		{"type": "bin", "x": 6, "y": 1, "dir": 0},
		{"type": "bin", "x": 7, "y": 1, "dir": 0},
		{"type": "bin", "x": 8, "y": 1, "dir": 0},
		{"type": "bin", "x": 9, "y": 1, "dir": 0},
		{"type": "bin", "x": 10, "y": 1, "dir": 0},
		{"type": "bin", "x": 11, "y": 1, "dir": 0},
		{"type": "bin", "x": 12, "y": 1, "dir": 0},
		{"type": "bin", "x": 13, "y": 1, "dir": 0},
		{"type": "bin", "x": 14, "y": 1, "dir": 0},
		{"type": "bin", "x": 15, "y": 1, "dir": 0},
		{"type": "bin", "x": 16, "y": 1, "dir": 0},
		{"type": "bin", "x": 17, "y": 1, "dir": 0},
		{"type": "bin", "x": 18, "y": 1, "dir": 0},
		{"type": "bin", "x": 19, "y": 1, "dir": 0},
		{"type": "bin", "x": 20, "y": 1, "dir": 0},
		{"type": "bin", "x": 21, "y": 1, "dir": 0},
	])
	_check(bool(over_bin["success"]) and int(over_bin["cycles"]) == 3, "bins in the skipped cells do not stop the whisker")
	var skipped := false
	for frame in over_bin["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1) or _at(frame, 17, 1) or _at(frame, 18, 1) or _at(frame, 19, 1) or _at(frame, 20, 1) or _at(frame, 21, 1):
			skipped = true
	_check(not skipped, "the whisker does not enter any of the twenty cells in front")
	var short_jibboom: Dictionary = Sim.run(hop, [
		{"type": "jibboom", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 21, "y": 1, "dir": 0},
	])
	_check(not bool(short_jibboom["success"]) and _at(_frame(short_jibboom, 3), 21, 1) and _dir_at(_frame(short_jibboom, 3), 21, 1) == 0, "a jibboom lands one cell short of a whisker")
	var short_martingale: Dictionary = Sim.run(hop, [
		{"type": "martingale", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 20, "y": 1, "dir": 0},
	])
	_check(not bool(short_martingale["success"]) and _at(_frame(short_martingale, 3), 20, 1) and _dir_at(_frame(short_martingale, 3), 20, 1) == 0, "a martingale lands two cells short of a whisker")
	var short_dolphin: Dictionary = Sim.run(hop, [
		{"type": "dolphin", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 19, "y": 1, "dir": 0},
	])
	_check(not bool(short_dolphin["success"]) and _at(_frame(short_dolphin, 3), 19, 1) and _dir_at(_frame(short_dolphin, 3), 19, 1) == 0, "a dolphin lands three cells short of a whisker")
	var short_bumpkin: Dictionary = Sim.run(hop, [
		{"type": "bumpkin", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 18, "y": 1, "dir": 0},
	])
	_check(not bool(short_bumpkin["success"]) and _at(_frame(short_bumpkin, 3), 18, 1) and _dir_at(_frame(short_bumpkin, 3), 18, 1) == 0, "a bumpkin lands four cells short of a whisker")
	var short_bobstay: Dictionary = Sim.run(hop, [
		{"type": "bobstay", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 17, "y": 1, "dir": 0},
	])
	_check(not bool(short_bobstay["success"]) and _at(_frame(short_bobstay, 3), 17, 1) and _dir_at(_frame(short_bobstay, 3), 17, 1) == 0, "a bobstay lands five cells short of a whisker")
	var short_gammon: Dictionary = Sim.run(hop, [
		{"type": "gammon", "x": 1, "y": 1, "dir": 0},
		{"type": "bin", "x": 16, "y": 1, "dir": 0},
	])
	_check(not bool(short_gammon["success"]) and _at(_frame(short_gammon, 3), 16, 1) and _dir_at(_frame(short_gammon, 3), 16, 1) == 0, "a gammon lands six cells short of a whisker")
	var keeled: Dictionary = Sim.run(hop, [{"type": "keel", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(keeled["success"]) and str(keeled["reason"]) == "stuck", "a keel jumps three cells back and misses the forward jump")
	var rabbeted: Dictionary = Sim.run(hop, [{"type": "rabbet", "x": 1, "y": 1, "dir": 0}])
	_check(not bool(rabbeted["success"]) and str(rabbeted["reason"]) == "stuck", "a rabbet jumps one cell back and misses the forward jump")
	var jumps := [
		{"name": "east", "src": Vector2i(0, 4), "arrival": 0, "block": Vector2i(1, 4), "land": Vector2i(22, 4), "dock": Vector2i(23, 4), "size": Vector2i(24, 6)},
		{"name": "south", "src": Vector2i(1, 0), "arrival": 1, "block": Vector2i(1, 1), "land": Vector2i(1, 22), "dock": Vector2i(1, 23), "size": Vector2i(3, 24)},
		{"name": "west", "src": Vector2i(23, 1), "arrival": 2, "block": Vector2i(22, 1), "land": Vector2i(1, 1), "dock": Vector2i(0, 1), "size": Vector2i(24, 3)},
		{"name": "north", "src": Vector2i(2, 23), "arrival": 3, "block": Vector2i(2, 22), "land": Vector2i(2, 1), "dock": Vector2i(2, 0), "size": Vector2i(3, 24)},
	]
	for spec in jumps:
		var src_at: Vector2i = spec["src"]
		var block_at: Vector2i = spec["block"]
		var land_at: Vector2i = spec["land"]
		var dock_at: Vector2i = spec["dock"]
		var size_at: Vector2i = spec["size"]
		var arrival := int(spec["arrival"])
		var strip := {
			"width": size_at.x, "height": size_at.y, "walls": [],
			"sources": [{"x": src_at.x, "y": src_at.y, "dir": arrival, "parcels": [{"color": "gray"}]}],
			"dock": {"x": dock_at.x, "y": dock_at.y},
			"order": [{"color": "gray"}],
		}
		var blocks := [
			{"type": "whisker", "x": block_at.x, "y": block_at.y, "dir": 0},
			{"type": "pause", "x": land_at.x, "y": land_at.y, "dir": 0},
		]
		var side_run: Dictionary = Sim.run(strip, blocks)
		var moved := _frame(side_run, 3)
		_check(bool(side_run["success"]) and int(side_run["cycles"]) == 5, "a %s parcel jumps twenty-one cells forward and the pause follows the old facing" % str(spec["name"]))
		_check(not moved.is_empty() and _at(moved, land_at.x, land_at.y) and _dir_at(moved, land_at.x, land_at.y) == arrival, "a %s parcel still faces %s after the twenty-one-cell jump" % [str(spec["name"]), str(spec["name"])])
	var held_board := {
		"width": 24, "height": 6, "walls": [{"x": 23, "y": 4}],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 21, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 23, "y": 5},
		"order": [{"color": "gray"}],
	}
	var waiting: Dictionary = Sim.run(held_board, [
		{"type": "whisker", "x": 1, "y": 4, "dir": 0},
		{"type": "pause", "x": 22, "y": 4, "dir": 0},
	])
	_check(not bool(waiting["success"]) and str(waiting["reason"]) == "tick_cap", "a whisker keeps waiting while its landing stays blocked")
	_check(_at(_frame(waiting, 3), 1, 4) and _dir_at(_frame(waiting, 3), 1, 4) == 0 and _color_at(_frame(waiting, 5), 22, 4) == "blue", "the whisker keeps the arrival facing while the other parcel stays")
	var gap := {
		"width": 24, "height": 6, "walls": [],
		"sources": [
			{"x": 0, "y": 4, "dir": 0, "parcels": [{"color": "gray"}]},
			{"x": 20, "y": 4, "dir": 0, "parcels": [{"color": "blue"}]},
		],
		"dock": {"x": 23, "y": 4},
		"order": [{"color": "blue"}, {"color": "gray"}],
	}
	var followed: Dictionary = Sim.run(gap, [
		{"type": "whisker", "x": 1, "y": 4, "dir": 0},
		{"type": "conveyor", "x": 21, "y": 4, "dir": 0},
		{"type": "pause", "x": 22, "y": 4, "dir": 0},
	])
	_check(bool(followed["success"]) and int(followed["cycles"]) == 6, "a whisker can land in a cell another parcel is leaving")
	var into := _frame(followed, 4)
	_check(not into.is_empty() and _color_at(into, 22, 4) == "gray" and _dir_at(into, 22, 4) == 0 and into.get("delivered", []).size() == 1, "the jump lands in the cell the other parcel left and still faces east")


func _building_forty_three() -> void:
	print("building 43")
	var puzzles := Puzzles.all()
	_check(puzzles.size() >= 309, "building 43 adds routes 303 through 309")
	_check(int(puzzles[301]["id"]) == 302, "route 302 is the last route before the whisker")
	_check(int(puzzles[302]["id"]) == 303, "the whisker begins at route 303")
	_check(Puzzles.INTRO.size() >= 47 and Puzzles.INTRO[46] == "whisker", "the whisker is the block building 43 teaches")
	_check(not Puzzles.unlocked_at(301).has("whisker"), "the whisker stays locked through route 302")
	_check(Puzzles.unlocked_at(302).has("whisker"), "route 303 unlocks the whisker")
	_check(Puzzles.unlocked_at(308).size() == 47, "building 43 ends with every block")
	var pars := {
		303: [6, 3],
		304: [7, 4],
		305: [7, 5],
		306: [5, 2],
		307: [7, 5],
		308: [7, 3],
		309: [33, 32],
	}
	for puzzle in puzzles:
		var id := int(puzzle["id"])
		if id <= 302:
			_check(int(puzzle.get("building", 1)) < 43, "route %d stays out of building 43" % id)
			if id >= 296:
				_check(int(puzzle.get("building", 1)) == 42, "route %d stays in building 42" % id)
			continue
		if id > 309:
			continue
		_check(int(puzzle.get("building", 1)) == 43, "route %d is building 43" % id)
		var result: Dictionary = Sim.run(puzzle, puzzle["reference"])
		var par: Dictionary = Scoring.compute_par(puzzle)
		_check(bool(result["success"]), "route %d reference delivers" % id)
		_check(int(result["cycles"]) == int(par["cycles"]), "route %d reference meets par cycles" % id)
		_check(int(result["blocks"]) == int(par["blocks"]), "route %d reference meets par blocks" % id)
		_check(int(result["blocks"]) == puzzle["reference"].size(), "route %d plays the reference block count" % id)
		var locked: Array = pars[id]
		_check(int(par["cycles"]) == int(locked[0]) and int(par["blocks"]) == int(locked[1]), "route %d par is %d cycles and %d blocks" % [id, int(locked[0]), int(locked[1])])
		if id == 303:
			_check(str(puzzle.get("unlocks", "")) == "whisker", "route 303 teaches the whisker")
		else:
			_check(str(puzzle.get("unlocks", "")) == "", "route %d adds no further block" % id)
		var uses_whisker := false
		for block in puzzle["reference"]:
			if str(block["type"]) == "whisker":
				uses_whisker = true
		_check(uses_whisker, "route %d reference uses the whisker" % id)
		if not bool(result["success"]):
			_dump(result)
		print("    par route %d  cycles %d  blocks %d" % [id, int(par["cycles"]), int(par["blocks"])])

	for id in [303, 304, 305, 306, 307, 308, 309]:
		for dir in range(4):
			var spun: Array = _by_id(id)["reference"].duplicate(true)
			for block in spun:
				if str(block["type"]) == "whisker":
					block["dir"] = dir
			var spun_run: Dictionary = Sim.run(_by_id(id), spun)
			_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == int(pars[id][0]), "route %d ignores which way the whisker block is rotated" % id)
		for kind in ["jibboom", "martingale", "dolphin", "bumpkin", "bobstay", "gammon", "cathead", "breasthook", "hawse", "knighthead", "forefoot", "gripe", "deadwood", "apron", "stemson", "keelson", "futtock", "loft", "vault", "keel", "rabbet", "balk", "return", "turn", "hook", "pause", "conveyor", "slide", "garboard", "stealer", "bias", "cant", "strake", "wale", "shunt", "sheer", "sling", "bridge", "chute"]:
			var swapped: Dictionary = Sim.run(_by_id(id), _swap(_by_id(id), "whisker", kind))
			_check(not bool(swapped["success"]), "route %d fails if the whisker is a %s" % [id, kind])
		var omitted: Array = []
		for block in _by_id(id)["reference"]:
			if str(block["type"]) != "whisker":
				omitted.append(block)
		_check(not bool(Sim.run(_by_id(id), omitted)["success"]), "route %d fails if the whisker is missing" % id)

	var lesson: Dictionary = Sim.run(_by_id(303), _by_id(303)["reference"])
	_check(_at(_frame(lesson, 2), 2, 1) and _dir_at(_frame(lesson, 2), 2, 1) == 0, "route 303 starts the parcel facing east on the whisker")
	_check(_at(_frame(lesson, 3), 2, 1) and _dir_at(_frame(lesson, 3), 2, 1) == 0, "route 303 keeps the parcel facing east without moving it")
	_check(_at(_frame(lesson, 4), 23, 1) and _dir_at(_frame(lesson, 4), 23, 1) == 0, "route 303 jumps twenty-one cells east and still faces east")
	var lesson_entered := false
	for frame in lesson["frames"]:
		if _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1) or _at(frame, 17, 1) or _at(frame, 18, 1) or _at(frame, 19, 1) or _at(frame, 20, 1) or _at(frame, 21, 1) or _at(frame, 22, 1):
			lesson_entered = true
	_check(not lesson_entered, "route 303 does not enter the cells in front")
	_check(str(Sim.run(_by_id(303), _swap(_by_id(303), "whisker", "jibboom"))["reason"]) == "stuck", "route 303's jibboom lands on the last brick")
	_check(str(Sim.run(_by_id(303), _swap(_by_id(303), "whisker", "martingale"))["reason"]) == "stuck", "route 303's martingale lands two cells short")

	var let_whisker: Dictionary = Sim.run(_by_id(304), _by_id(304)["reference"])
	_check(_color_at(_frame(let_whisker, 4), 2, 1) == "red" and _dir_at(_frame(let_whisker, 4), 2, 1) == 0 and _color_at(_frame(let_whisker, 4), 23, 1) == "blue", "route 304 holds red while blue stands on the landing")
	_check(_color_at(_frame(let_whisker, 5), 23, 1) == "red" and _dir_at(_frame(let_whisker, 5), 23, 1) == 0 and _frame(let_whisker, 5).get("delivered", []).size() == 1, "route 304 jumps once the landing is free and still faces east")

	var counted: Dictionary = Sim.run(_by_id(305), _by_id(305)["reference"])
	_check(str(counted["delivered"][0]["color"]) == "blue" and int(counted["delivered"][0]["count"]) == 1, "route 305 delivers blue count 1")
	_check(str(counted["delivered"][1]["color"]) == "red" and int(counted["delivered"][1]["count"]) == 2, "route 305 delivers red count 2")
	_check(_color_at(_frame(counted, 3), 22, 1) == "red" and _dir_at(_frame(counted, 3), 22, 1) == 0, "route 305 jumps twenty-one cells east and still faces east")
	_check(_color_at(_frame(counted, 6), 24, 1) == "red" and _count_at(_frame(counted, 6), 24, 1) == 2, "route 305's counter stamps 2")

	var clear: Dictionary = Sim.run(_by_id(306), _by_id(306)["reference"])
	_check(_at(_frame(clear, 2), 1, 1) and _dir_at(_frame(clear, 2), 1, 1) == 0, "route 306 waits facing east")
	_check(_at(_frame(clear, 3), 22, 1) and _dir_at(_frame(clear, 3), 22, 1) == 0, "route 306 lands twenty-one cells east and still faces east")
	var brick_entered := false
	for frame in clear["frames"]:
		if _at(frame, 2, 1) or _at(frame, 3, 1) or _at(frame, 4, 1) or _at(frame, 5, 1) or _at(frame, 6, 1) or _at(frame, 7, 1) or _at(frame, 8, 1) or _at(frame, 9, 1) or _at(frame, 10, 1) or _at(frame, 11, 1) or _at(frame, 12, 1) or _at(frame, 13, 1) or _at(frame, 14, 1) or _at(frame, 15, 1) or _at(frame, 16, 1) or _at(frame, 17, 1) or _at(frame, 18, 1) or _at(frame, 19, 1) or _at(frame, 20, 1) or _at(frame, 21, 1):
			brick_entered = true
	_check(not brick_entered, "route 306 does not enter any brick")
	_check(str(Sim.run(_by_id(306), _swap(_by_id(306), "whisker", "jibboom"))["reason"]) == "stuck", "route 306's jibboom tries to land on the last brick")
	_check(str(Sim.run(_by_id(306), _swap(_by_id(306), "whisker", "pause"))["reason"]) == "stuck", "route 306's pause tries to enter the first brick")

	var paired: Dictionary = Sim.run(_by_id(307), _by_id(307)["reference"])
	_check(_color_at(_frame(paired, 2), 1, 24) == "red" and _dir_at(_frame(paired, 2), 1, 24) == 0, "route 307 holds the east-facing parcel")
	_check(_color_at(_frame(paired, 4), 23, 2) == "blue" and _dir_at(_frame(paired, 4), 23, 2) == 1, "route 307 holds the south-facing parcel")
	_check(_frame(paired, 5).get("delivered", []).size() == 1 and str(_frame(paired, 5)["delivered"][0]["color"]) == "red", "route 307 delivers the east-facing parcel first")
	_check(int(paired["cycles"]) == 7, "route 307 delivers the south-facing parcel second")
	for cell in [Vector2i(1, 24), Vector2i(23, 2)]:
		for kind in ["jibboom", "martingale", "dolphin"]:
			var one: Dictionary = Sim.run(_by_id(307), _swap_cell(_by_id(307), cell.x, cell.y, kind))
			_check(not bool(one["success"]), "route 307 misses the dock if the whisker at %d,%d is a %s" % [cell.x, cell.y, kind])

	var second: Dictionary = Sim.run(_by_id(308), _by_id(308)["reference"])
	_check(_at(_frame(second, 2), 1, 22) and _dir_at(_frame(second, 2), 1, 22) == 0, "route 308 waits on the first whisker facing east")
	_check(_at(_frame(second, 3), 22, 22) and _dir_at(_frame(second, 3), 22, 22) == 0, "route 308 jumps twenty-one cells forward and still faces east")
	_check(_at(_frame(second, 5), 22, 21) and _dir_at(_frame(second, 5), 22, 21) == 3, "route 308 reaches the second whisker facing north")
	_check(_at(_frame(second, 6), 22, 21) and _dir_at(_frame(second, 6), 22, 21) == 3, "route 308 waits on the second whisker facing north")
	_check(int(second["cycles"]) == 7, "route 308 jumps twenty-one cells forward on the new facing")
	_check(not bool(Sim.run(_by_id(308), _omit_cell(_by_id(308), 1, 22))["success"]), "route 308 fails without the first whisker")
	_check(not bool(Sim.run(_by_id(308), _omit_cell(_by_id(308), 22, 21))["success"]), "route 308 fails without the second whisker")
	for cell in [Vector2i(1, 22), Vector2i(22, 21)]:
		for kind in ["jibboom", "martingale", "dolphin"]:
			var missed: Dictionary = Sim.run(_by_id(308), _swap_cell(_by_id(308), cell.x, cell.y, kind))
			_check(not bool(missed["success"]), "route 308 misses the dock if the whisker at %d,%d is a %s" % [cell.x, cell.y, kind])

	var night: Dictionary = Sim.run(_by_id(309), _by_id(309)["reference"])
	_check(int(night["cycles"]) < 250, "route 309 finishes before tick 250")
	_check(str(night["delivered"][0]["color"]) == "red" and int(night["delivered"][0]["count"]) == 1, "route 309 stamps red 1")
	_check(str(night["delivered"][1]["color"]) == "yellow" and int(night["delivered"][1]["count"]) == 2, "route 309 stamps yellow 2")
	_check(str(night["delivered"][2]["color"]) == "blue" and int(night["delivered"][2]["count"]) == 3, "route 309 stamps blue 3")
	_check(_color_at(_frame(night, 6), 3, 3) == "red" and _dir_at(_frame(night, 6), 3, 3) == 0, "route 309 holds red facing east")
	_check(_color_at(_frame(night, 8), 24, 3) == "red" and _dir_at(_frame(night, 8), 24, 3) == 0, "route 309 jumps red twenty-one cells east and leaves it facing east")
	_check(_color_at(_frame(night, 10), 25, 3) == "red" and _dir_at(_frame(night, 10), 25, 3) == 0 and _count_at(_frame(night, 10), 25, 3) == 0, "route 309 reaches the counter still facing east")
	var night_entered := false
	for frame in night["frames"]:
		if _color_at(frame, 4, 3) == "red" or _color_at(frame, 5, 3) == "red" or _color_at(frame, 6, 3) == "red" or _color_at(frame, 7, 3) == "red" or _color_at(frame, 8, 3) == "red" or _color_at(frame, 9, 3) == "red" or _color_at(frame, 10, 3) == "red" or _color_at(frame, 11, 3) == "red" or _color_at(frame, 12, 3) == "red" or _color_at(frame, 13, 3) == "red" or _color_at(frame, 14, 3) == "red" or _color_at(frame, 15, 3) == "red" or _color_at(frame, 16, 3) == "red" or _color_at(frame, 17, 3) == "red" or _color_at(frame, 18, 3) == "red" or _color_at(frame, 19, 3) == "red" or _color_at(frame, 20, 3) == "red" or _color_at(frame, 21, 3) == "red" or _color_at(frame, 22, 3) == "red" or _color_at(frame, 23, 3) == "red":
			night_entered = true
	_check(not night_entered, "route 309 does not enter the cells in front")
	_check(not bool(Sim.run(_by_id(309), _swap(_by_id(309), "whisker", "jibboom"))["success"]), "route 309's jibboom misses the pause")
	_check(not bool(Sim.run(_by_id(309), _swap(_by_id(309), "whisker", "martingale"))["success"]), "route 309's martingale misses the pause")
	_check(not bool(Sim.run(_by_id(309), _swap(_by_id(309), "primer", "painter"))["success"]), "route 309 fails if blue is painted yellow")
	_check(not bool(Sim.run(_by_id(309), _swap(_by_id(309), "filter", "conveyor"))["success"]), "route 309 fails if red is not pulled ahead")
	_check(not bool(Sim.run(_by_id(309), _swap(_by_id(309), "counter", "conveyor"))["success"]), "route 309 fails without the counter")


func _cranse_rules() -> void:
	print("cranse")
	var hop := {
		"width": 24, "height": 3, "walls": [],
		"sources": [{"x": 0, "y": 1, "dir": 0, "parcels": [{"color": "gray"}]}],
		"dock": {"x": 23, "y": 1},
		"order": [{"color": "gray"}],
	}
	var graph := [{"type": "cranse", "x": 1, "y": 1, "dir": 0}]
	var sent: Dictionary = Sim.run(hop, graph)
	_check(bool(sent["success"]), "a cranse jumps twenty-two cells forward and delivers")
	_check(int(sent["cycles"]) == 3 and int(sent["blocks"]) == 1, "the cranse waits a tick and delivers on tick 3")
	var born := _frame(sent, 1)
	var waited := _frame(sent, 2)
	_check(not born.is_empty() and _at(born, 1, 1) and _dir_at(born, 1, 1) == 0, "the parcel arrives facing east")
	_check(not waited.is_empty() and _at(waited, 1, 1) and _dir_at(waited, 1, 1) == 0 and not _at(waited, 23, 1), "the cranse does not move the parcel on that tick")
	_check(_count_at(waited, 1, 1) == 0 and _color_at(waited, 1, 1) == "gray", "a cranse does not stamp or paint")
	var tinted: Dictionary = Sim.run(hop, [{"type": "cranse", "x": 1, "y": 1, "dir": 0, "color": "red"}])
	_check(bool(tinted["success"]) and str(tinted["delivered"][0]["color"]) == "gray" and int(tinted["delivered"][0]["count"]) == 0, "a color on a cranse is ignored")
	for dir in range(4):
		var spun: Array = graph.duplicate(true)
		spun[0]["dir"] = dir
		var spun_run: Dictionary = Sim.run(hop, spun)
		_check(bool(spun_run["success"]) and int(spun_run["cycles"]) == 3, "rotating a cranse does not change the jump")
	var over_bin: Dictionary = Sim.run(hop, [
