func _cenotaph_return() -> String:
	var game_script = load("res://scripts/game.gd")
	var select_script = load("res://scripts/floor_select_view.gd")
	if game_script == null or select_script == null:
		return "game or floor select did not load"
	if float(select_script.WINDOW_W) != 4044.0:
		return "floor select window width is %s" % select_script.WINDOW_W
	var game = game_script.new()
	root.add_child(game)
	if game.town == null or game.floor_select == null or game.descent == null:
		game.free()
		return "the game did not build its screens"
	if game.floor_select.record_for("cenotaph") != Rules.CENOTAPH_RECORD:
		game.free()
		return "floor select does not offer the cenotaph census"
	if Rules.floor_named("cenotaph").title != "The Cenotaph":
		game.free()
		return "floor select does not name the Cenotaph"
	if Rules.floors().size() != 53:
		game.free()
		return "floor select does not list fifty-three floors"
	var pyre_card: Control = game.floor_select._record["pyre"].get_parent()
	var cenotaph_card: Control = game.floor_select._record["cenotaph"].get_parent()
	var pyre_rect := Rect2(pyre_card.position, pyre_card.size)
	var cenotaph_rect := Rect2(cenotaph_card.position, cenotaph_card.size)
	if cenotaph_rect.intersects(pyre_rect):
		game.free()
		return "the cenotaph card covers the pyre card"
	if absf(cenotaph_rect.position.x - (pyre_rect.position.x + pyre_rect.size.x + 8.0)) > 0.5:
		game.free()
		return "the cenotaph card is not immediately to the right of the pyre"
	var window_w: float = select_script.WINDOW_W
	if cenotaph_rect.position.x + cenotaph_rect.size.x > window_w + 0.5:
		game.free()
		return "the cenotaph card sits outside the window"
	if cenotaph_rect.position.x < 12.0 or window_w - (cenotaph_rect.position.x + cenotaph_rect.size.x) < 11.5:
		game.free()
		return "the cenotaph card has no spare at the window edge"
	var saw := {}
	var previous: Control = null
	for listed in Rules.floors():
		var card: Control = game.floor_select._record[listed.id].get_parent()
		var card_rect := Rect2(card.position, card.size)
		if card_rect.position.x < 0.0 or card_rect.position.x + card_rect.size.x > window_w + 0.5:
			game.free()
			return "the %s card sits outside the window" % listed.title
		if card_rect.position.y < 0.0 or card_rect.position.y + card_rect.size.y > 720.0:
			game.free()
			return "the %s card is clipped by the window height" % listed.title
		if previous != null and card_rect.intersects(Rect2(previous.position, previous.size)):
			game.free()
			return "the %s card covers another card" % listed.title
		var heading: Label = card.get_child(2)
		if heading == null or heading.text != listed.title:
			game.free()
			return "the %s card title is missing" % listed.title
		for glyph_i in heading.text.length():
			var glyph := heading.text.substr(glyph_i, 1)
			if glyph == " ":
				continue
			var glyph_bounds := heading.get_character_bounds(glyph_i)
			if glyph_bounds.size.x <= 0.0 or glyph_bounds.position.y + glyph_bounds.size.y > heading.size.y + 0.01 or glyph_bounds.position.x + glyph_bounds.size.x > heading.size.x + 0.01:
				game.free()
				return "the %s title hides %s" % [listed.title, glyph]
		saw[listed.title] = true
		previous = card
	for title in ["The Scriptorium", "The Ambulatory", "The Chevet", "The Retrochoir", "The Lady Chapel", "The Feretory", "The Chantry", "The Sacristy", "The Pyx Chamber", "The Aumbry", "The Piscina", "The Sedilia", "The Credence", "The Reredos", "The Predella", "The Dossal", "The Retable", "The Tester", "The Riddel", "The Frontal", "The Pall", "The Herse", "The Catafalque", "The Bier", "The Cerecloth", "The Hearse", "The Shroud", "The Pyre", "The Cenotaph"]:
		if not saw.has(title):
			game.free()
			return "the floor select is missing %s" % title
	var narrow_w := (3211.0 - 24.0 - 8.0 * 46.0) / 47.0
	var narrow_heading := narrow_w - 8.0
	var probe := Label.new()
	probe.add_theme_font_size_override("font_size", 9)
	probe.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	probe.clip_text = true
	probe.size = Vector2(narrow_heading, 44)
	game.add_child(probe)
	probe.text = "The Scriptorium"
	if probe.get_character_bounds(probe.text.length() - 1).size.x > 0.0:
		probe.free()
		game.free()
		return "3211 already shows the last letter of The Scriptorium, so 3212 is not the smallest width"
	probe.text = "The Ambulatory"
	if probe.get_character_bounds(probe.text.length() - 1).size.x > 0.0:
		probe.free()
		game.free()
		return "3211 already shows the last letter of The Ambulatory, so 3212 is not the smallest width"
	probe.free()
	game._on_descend_floor("cenotaph")
	if game.descent.state == null or game.descent.state.floor.id != "cenotaph":
		game.free()
		return "descend did not open the cenotaph"
	var state = game.descent.state
	state.marks = Rules.accurate_sheet(state.floor)
	var lift: Vector2i = Rules.lift_pos(state.floor)
	var approach: Vector2i = Rules.walkable_approach(lift, state.floor)
	state.pos = approach
	state.oil = 5
	var done: Dictionary = Rules.step(state, lift - approach)
	if not bool(done.extracted) or not Rules.census_accepted(state.marks, state.floor):
		game.free()
		return "the finished sheet did not extract as an accepted census"
	game.descent._open_return()
	if game.descent.return_button.text != "Return to floor select":
		game.free()
		return "a finished census did not offer the floor select"
	game._on_return(state)
	if not game.floor_select.visible or game.town.visible or game.descent.visible:
		game.free()
		return "a finished census did not return to the floor select"
	if not bool(game.campaign.completed.get("cenotaph", false)):
		game.free()
		return "the finished census was not recorded"
	if bool(game.campaign.completed.get("pyre", false)):
		game.free()
		return "the finished cenotaph census also closed the pyre"
	if int(game.campaign.last_bill.total) != 565 or game.campaign.purse < 565:
		game.free()
		return "the finished census was not paid"
	game.free()
	return ""

func _winding_layout() -> String:
	if Rules.CORRIDOR_VALUE != 3 or Rules.HAZARD_VALUE != 8 or Rules.LOOP_VALUE != 15:
		return "payout rates changed"
	if Rules.MOVE_OIL != 1 or Rules.HIT_OIL != 3:
		return "oil costs changed"
	if Rules.SMALL_FLASK_OIL != 24 or Rules.LARGE_FLASK_OIL != 120 or Rules.LARGE_FLASK_COST != 40:
		return "flask sizes changed"
	var floor = Rules.floor_named("winding")
	if floor == null:
		return "winding floor is missing"
	if floor.record != Rules.WINDING_RECORD:
		return "winding record drifted from its constant"
	if Rules.WINDING_RECORD != "Record every corridor, the forty-eight winding cracks, and the ring around the winding.":
		return "the winding no longer asks for the winding cracks and the ring"
	if Rules.width(floor) != 51 or Rules.height(floor) != 21:
		return "winding sheet is %d by %d" % [Rules.width(floor), Rules.height(floor)]
	var mark_count := 0
	for row in floor.rows:
		mark_count += str(row).count(":")
		if str(row).find(";") >= 0 or str(row).find(",") >= 0 or str(row).find(")") >= 0 or str(row).find("(") >= 0:
			return "the winding sheet still uses an earlier glyph"
		if str(row).substr(str(row).length() - 1, 1) != "#":
			return "the new east column is not wall"
	if mark_count != 84:
		return "the winding block is not 14 by 6"
	for other in Rules.floors():
		if other.id == floor.id:
			continue
		for row in other.rows:
			if str(row).find(":") >= 0:
				return "glyph colon is already used on " + str(other.id)
	var cenotaph = Rules.floor_named("cenotaph")
	var pyre = Rules.floor_named("pyre")
	var shroud = Rules.floor_named("shroud")
	var hearse = Rules.floor_named("hearse")
	var cerecloth = Rules.floor_named("cerecloth")
	var bier = Rules.floor_named("bier")
	var catafalque = Rules.floor_named("catafalque")
	var herse = Rules.floor_named("herse")
	var pall = Rules.floor_named("pall")
	var frontal = Rules.floor_named("frontal")
	var riddel = Rules.floor_named("riddel")
	if cenotaph == null or pyre == null or shroud == null or hearse == null or cerecloth == null or bier == null or catafalque == null or herse == null or pall == null or frontal == null or riddel == null:
		return "an earlier floor is missing"
	if Rules.glyph_at(Vector2i(7, 4), hearse) != "(":
		return "parenthesis is no longer the hearse"
	if Rules.glyph_at(Vector2i(7, 4), shroud) != ")":
		return "close parenthesis is no longer the shroud"
	if Rules.glyph_at(Vector2i(7, 4), pyre) != ",":
		return "comma is no longer the pyre"
	if Rules.glyph_at(Vector2i(7, 4), cenotaph) != ";":
		return "semicolon is no longer the cenotaph"
	if Rules.glyph_at(Vector2i(7, 4), floor) != ":":
		return "colon is not the winding"
	if Rules.tile_at(Vector2i(7, 4), floor) != Rules.Tile.WALL or Rules.is_walkable(Vector2i(7, 4), floor):
		return "the winding glyph does not ink as one wall"
	if Rules.glyph_at(Vector2i(19, 10), cenotaph) != "#" or Rules.glyph_at(Vector2i(18, 11), cenotaph) != "." or Rules.glyph_at(Vector2i(18, 10), cenotaph) != ".":
		return "the cenotaph closure moved"
	if Rules.start_pos(floor) != Vector2i(1, 1) or Rules.lift_pos(floor) != Vector2i(10, 11) or Rules.enemy_pos(floor) != Vector2i(9, 12):
		return "start, lift, or warden moved"
	if Rules.glyph_at(Vector2i(44, 15), floor) != "H":
		return "the new crack is not (44,15)"
	if Rules.glyph_at(Vector2i(43, 15), floor) != "H" or Rules.glyph_at(Vector2i(45, 15), floor) != "#":
		return "the crack is not the wall immediately east of (43,15)"
	if Rules.glyph_at(Vector2i(20, 10), floor) != "#" or Rules.glyph_at(Vector2i(21, 10), floor) != "#" or Rules.glyph_at(Vector2i(21, 9), floor) != "#" or Rules.glyph_at(Vector2i(21, 8), floor) != "#" or Rules.glyph_at(Vector2i(21, 7), floor) != "#" or Rules.glyph_at(Vector2i(21, 6), floor) != "#" or Rules.glyph_at(Vector2i(21, 5), floor) != "#" or Rules.glyph_at(Vector2i(21, 4), floor) != "#":
		return "a required closure was left open"
	if Rules.glyph_at(Vector2i(19, 10), floor) != "#" or Rules.glyph_at(Vector2i(18, 10), floor) != "#" or Rules.glyph_at(Vector2i(18, 11), floor) != "." or Rules.glyph_at(Vector2i(17, 11), floor) != ".":
		return "the closure or the detour moved"
	if Rules.glyph_at(Vector2i(21, 11), floor) != "#" or Rules.glyph_at(Vector2i(22, 10), floor) != "#" or Rules.glyph_at(Vector2i(20, 11), floor) != "#" or Rules.glyph_at(Vector2i(20, 9), floor) != ":":
		return "a wall around the walk moved"
	if Rules.glyph_at(Vector2i(10, 10), floor) != "#" or Rules.glyph_at(Vector2i(11, 11), floor) != "." or Rules.glyph_at(Vector2i(6, 11), floor) != ".":
		return "a carried opening moved"
	if Rules.glyph_at(Vector2i(7, 10), floor) != "#" or Rules.glyph_at(Vector2i(8, 10), floor) != "#" or Rules.glyph_at(Vector2i(9, 10), floor) != "#":
		return "a carried closure was reopened"
	if Rules.glyph_at(Vector2i(8, 12), floor) != "." or Rules.is_walkable(Vector2i(10, 12), floor):
		return "a swing moved"
	var hazards := Rules.hazard_cells(floor)
	if hazards.size() != 48:
		return "expected forty-eight winding cracks, found %d" % hazards.size()
	if not hazards.has(Vector2i(44, 15)) or not hazards.has(Vector2i(43, 15)):
		return "the crack set drifted"
	if Rules.corridor_cells(floor).size() != 58:
		return "corridors %d" % Rules.corridor_cells(floor).size()
	var kept := {}
	for cell in Rules.corridor_cells(cenotaph):
		kept[cell] = true
	for cell in Rules.corridor_cells(floor):
		if not kept.has(cell) and cell != Vector2i(17, 11):
			return "a new corridor was opened at %s" % cell
	if not kept.has(Vector2i(18, 10)) or Rules.is_corridor_cell(Vector2i(18, 10), floor):
		return "(18,10) was not closed"
	if not Rules.is_corridor_cell(Vector2i(17, 11), floor) or Rules.is_corridor_cell(Vector2i(17, 11), cenotaph):
		return "(17,11) was not the opened detour"
	for cell in kept:
		if cell != Vector2i(18, 10) and not Rules.is_corridor_cell(cell, floor):
			return "a corridor besides (18,10) was closed at %s" % cell
	var ring_err := _winding_ring(floor)
	if ring_err != "":
		return ring_err
	for other in Rules.floors():
		if other.id == floor.id:
			continue
		if floor.rows == other.rows:
			return "the winding copies %s" % other.id
		if Rules.width(floor) == Rules.width(other) and Rules.height(floor) == Rules.height(other):
			return "the winding reuses the %s grid" % other.id
		if Rules.enemy_pos(floor) == Rules.enemy_pos(other) and str(other.id) != "font" and str(other.id) != "apse" and str(other.id) != "choir" and str(other.id) != "rood" and str(other.id) != "crossing" and str(other.id) != "transept" and str(other.id) != "ambulatory" and str(other.id) != "chevet" and str(other.id) != "retrochoir" and str(other.id) != "ladychapel" and str(other.id) != "feretory" and str(other.id) != "chantry" and str(other.id) != "sacristy" and str(other.id) != "pyx" and str(other.id) != "aumbry" and str(other.id) != "piscina" and str(other.id) != "sedilia" and str(other.id) != "credence" and str(other.id) != "reredos" and str(other.id) != "predella" and str(other.id) != "dossal" and str(other.id) != "retable" and str(other.id) != "tester" and str(other.id) != "riddel" and str(other.id) != "frontal" and str(other.id) != "pall" and str(other.id) != "herse" and str(other.id) != "catafalque" and str(other.id) != "bier" and str(other.id) != "cerecloth" and str(other.id) != "hearse" and str(other.id) != "shroud" and str(other.id) != "pyre" and str(other.id) != "cenotaph" and str(other.id) != "charnel" and str(other.id) != "sepulchre" and str(other.id) != "vault" and str(other.id) != "cairn" and str(other.id) != "columbarium":
			return "the winding reuses the %s warden cell" % other.id
		if _ring_key(floor) == _ring_key(other):
			return "the winding reuses the %s ring" % other.id
	var path: Array = Rules.shortest_path_cells(floor)
	var earlier_path: Array = Rules.shortest_path_cells(cenotaph)
	if path.size() != 20 or path.size() != earlier_path.size():
		return "the 19-step path cells changed"
	for i in path.size():
		if path[i] != earlier_path[i]:
			return "the 19-step path moved at %s" % path[i]
	if path.has(Vector2i(44, 15)) or path.has(Vector2i(17, 11)) or path.has(Vector2i(18, 10)):
		return "the crack or the detour is on the tour"
	if Rules.shortest_path_steps(floor) != 19:
		return "shortest winding path is %d, expected 19" % Rules.shortest_path_steps(floor)
	var cover := Rules.safe_survey_steps(floor)
	if cover != 124:
		return "safe survey is %d, expected 124" % cover
	var bare := Rules.Floor.new()
	var bare_rows := PackedStringArray()
	for i in floor.rows.size():
		var bare_row := str(floor.rows[i])
		if i == 15:
			bare_row = bare_row.left(44) + "#" + bare_row.substr(45)
		bare_rows.append(bare_row)
	bare.rows = bare_rows
	if Rules.glyph_at(Vector2i(44, 15), bare) != "#" or Rules.glyph_at(Vector2i(18, 10), bare) != "#" or Rules.glyph_at(Vector2i(17, 11), bare) != ".":
		return "the sheet without the new crack was not built"
	if Rules.safe_survey_steps(bare) != 122 or Rules.shortest_path_cells(bare) != path:
		return "removing the new crack surveys at %d" % Rules.safe_survey_steps(bare)
	var only := Rules.Floor.new()
	var only_rows := PackedStringArray()
	for i in floor.rows.size():
		var only_row := str(floor.rows[i])
		if i == 10:
			only_row = only_row.left(18) + "." + only_row.substr(19)
		if i == 11:
			only_row = only_row.left(17) + "#" + only_row.substr(18)
		only_rows.append(only_row)
	only.rows = only_rows
	if Rules.glyph_at(Vector2i(18, 10), only) != "." or Rules.glyph_at(Vector2i(17, 11), only) != "#" or Rules.glyph_at(Vector2i(44, 15), only) != "H":
		return "the crack-only sheet was not built"
	if Rules.safe_survey_steps(only) != 124 or Rules.shortest_path_cells(only) != path:
		return "adding only (44,15) surveys at %d" % Rules.safe_survey_steps(only)
	var blocked := Rules.Floor.new()
	var blocked_rows := PackedStringArray()
	for i in floor.rows.size():
		var blocked_row := str(floor.rows[i])
		if i == 11:
			blocked_row = blocked_row.left(17) + "#" + blocked_row.substr(18)
		blocked_rows.append(blocked_row)
	blocked.rows = blocked_rows
	if Rules.glyph_at(Vector2i(17, 11), blocked) != "#" or Rules.glyph_at(Vector2i(18, 10), blocked) != "#":
		return "the closed sheet without the detour was not built"
	if Rules.safe_survey_steps(blocked) != 178 or Rules.shortest_path_cells(blocked) != path:
		return "closing (18,10) without the detour surveys at %d" % Rules.safe_survey_steps(blocked)
	if Rules.safe_survey_steps(cenotaph) != 122 or Rules.corridor_cells(cenotaph).size() != 58 or Rules.hazard_cells(cenotaph).size() != 47:
		return "the cenotaph solution changed"
	if Rules.safe_survey_steps(pyre) != 120 or Rules.corridor_cells(pyre).size() != 58 or Rules.hazard_cells(pyre).size() != 46:
		return "the pyre solution changed"
	if Rules.safe_survey_steps(shroud) != 120 or Rules.corridor_cells(shroud).size() != 59 or Rules.hazard_cells(shroud).size() != 45:
		return "the shroud solution changed"
	if Rules.safe_survey_steps(hearse) != 120 or Rules.corridor_cells(hearse).size() != 60 or Rules.hazard_cells(hearse).size() != 44:
		return "the hearse solution changed"
	if Rules.safe_survey_steps(cerecloth) != 120 or Rules.corridor_cells(cerecloth).size() != 61 or Rules.hazard_cells(cerecloth).size() != 43:
		return "the cerecloth solution changed"
	if Rules.safe_survey_steps(bier) != 120 or Rules.corridor_cells(bier).size() != 62 or Rules.hazard_cells(bier).size() != 42:
		return "the bier solution changed"
	if Rules.safe_survey_steps(catafalque) != 120 or Rules.corridor_cells(catafalque).size() != 63 or Rules.hazard_cells(catafalque).size() != 41:
		return "the catafalque solution changed"
	if Rules.safe_survey_steps(herse) != 120 or Rules.corridor_cells(herse).size() != 64 or Rules.hazard_cells(herse).size() != 40:
		return "the herse solution changed"
	if Rules.safe_survey_steps(pall) != 120 or Rules.corridor_cells(pall).size() != 65 or Rules.hazard_cells(pall).size() != 39:
		return "the pall solution changed"
	if Rules.safe_survey_steps(frontal) != 120 or Rules.corridor_cells(frontal).size() != 66 or Rules.hazard_cells(frontal).size() != 38:
		return "the frontal solution changed"
	if Rules.safe_survey_steps(riddel) != 120 or Rules.corridor_cells(riddel).size() != 67 or Rules.hazard_cells(riddel).size() != 37:
		return "the riddel solution changed"
	var cenotaph_bill: Dictionary = Rules.payout(Rules.accurate_sheet(cenotaph), cenotaph)
	var pyre_bill: Dictionary = Rules.payout(Rules.accurate_sheet(pyre), pyre)
	var shroud_bill: Dictionary = Rules.payout(Rules.accurate_sheet(shroud), shroud)
	var hearse_bill: Dictionary = Rules.payout(Rules.accurate_sheet(hearse), hearse)
	var cerecloth_bill: Dictionary = Rules.payout(Rules.accurate_sheet(cerecloth), cerecloth)
	var bier_bill: Dictionary = Rules.payout(Rules.accurate_sheet(bier), bier)
	var catafalque_bill: Dictionary = Rules.payout(Rules.accurate_sheet(catafalque), catafalque)
	var herse_bill: Dictionary = Rules.payout(Rules.accurate_sheet(herse), herse)
	var pall_bill: Dictionary = Rules.payout(Rules.accurate_sheet(pall), pall)
	var frontal_bill: Dictionary = Rules.payout(Rules.accurate_sheet(frontal), frontal)
	var riddel_bill: Dictionary = Rules.payout(Rules.accurate_sheet(riddel), riddel)
	if int(cenotaph_bill.total) != 565 or int(pyre_bill.total) != 557 or int(shroud_bill.total) != 552 or int(hearse_bill.total) != 547 or int(cerecloth_bill.total) != 542 or int(bier_bill.total) != 537 or int(catafalque_bill.total) != 532 or int(herse_bill.total) != 527 or int(pall_bill.total) != 522 or int(frontal_bill.total) != 517 or int(riddel_bill.total) != 512:
		return "an earlier payout changed"
	var bumper = Rules.new_run(Rules.SMALL_FLASK_OIL, floor)
	bumper.pos = Vector2i(6, 4)
	var before_oil: int = bumper.oil
	var tap: Dictionary = Rules.step(bumper, Vector2i(1, 0))
	if bool(tap.moved) or bumper.oil != before_oil:
		return "bumping the winding spent oil or moved"
	if int(bumper.marks.get(Vector2i(7, 4), Rules.Mark.NONE)) != Rules.Mark.WALL:
		return "bumping the winding did not ink a wall"
	if str(tap.message).find("winding") < 0:
		return "bumping the winding did not name it"
	var facing = Rules.new_run(Rules.SMALL_FLASK_OIL, floor)
	facing.pos = Vector2i(1, 2)
	facing.facing = Rules.facing_from_vector(Vector2i(0, 1))
	if Rules.ahead_line(facing).find("winding crack") < 0:
		return "facing a winding crack did not name it"
	print("  winding shortest 19  survey %d  corridors %d  cracks %d" % [cover, Rules.corridor_cells(floor).size(), hazards.size()])
	return ""


func _winding_ring(floor) -> String:
	var cells: Array = Rules.loop_cells(floor)
	if cells.size() != 36:
		return "ring size %d" % cells.size()
	var have := {}
	for cell in cells:
		if have.has(cell):
			return "duplicate ring tile %s" % cell
		have[cell] = true
		if cell == Vector2i(18, 10) or cell == Vector2i(19, 10) or cell == Vector2i(20, 10) or cell == Vector2i(21, 10) or cell == Vector2i(21, 9) or cell == Vector2i(21, 8) or cell == Vector2i(21, 7) or cell == Vector2i(21, 6) or cell == Vector2i(21, 5) or cell == Vector2i(21, 4) or cell == Vector2i(8, 10) or cell == Vector2i(9, 10) or cell == Vector2i(10, 10) or cell == Vector2i(7, 10) or cell == Vector2i(17, 11) or cell == Vector2i(18, 11):
			return "closed ring tile %s is still on the ring" % cell
		if not Rules.is_corridor_cell(cell, floor):
			return "ring tile %s is not a corridor" % cell
	var open_ends := 0
	for cell in cells:
		var degree := 0
		for dir in Rules.cardinals():
			if have.has(cell + dir):
				degree += 1
		if cell == Vector2i(21, 3) or cell == Vector2i(17, 10):
			if degree != 1:
				return "the open end %s has %d neighbors in the ring" % [cell, degree]
			open_ends += 1
		elif degree != 2:
			return "ring tile %s has %d neighbors in the ring" % [cell, degree]
	if open_ends != 2:
		return "the walk should be open between (21,3) and (17,10)"
	if not have.has(Vector2i(11, 11)) or not have.has(Vector2i(6, 11)) or not have.has(Vector2i(21, 3)) or not have.has(Vector2i(17, 10)):
		return "the ring does not keep the carried walk"
	if have.has(Vector2i(18, 10)):
		return "the ring still steps on (18,10)"
	if str(floor.loop_name) != "Winding ring":
		return "ring name is %s" % floor.loop_name
	var bill: Dictionary = Rules.payout(Rules.accurate_sheet(floor), floor)
	if int(bill.loop) != 1 or int(bill.total) != 573:
		return "the ring did not pay %s" % bill.total
	return ""


