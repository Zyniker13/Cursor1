		"charnel": 581,
		"sepulchre": 589,
		"vault": 597,
		"cairn": 605,
		"columbarium": 613,
	}
	var expect_loop := {
		"cellar": "East square",
		"cistern": "Cistern ring",
		"cloister": "Cloister walk",
		"crypt": "Crypt ring",
		"ossuary": "Ossuary ring",
