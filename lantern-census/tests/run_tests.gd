	if Rules.safe_survey_steps(sedilia) != 120 or Rules.shortest_path_steps(sedilia) != 19 or Rules.shortest_path_cells(sedilia) != path:
		return "the sedilia survey or path changed"
	if Rules.width(sedilia) != 33 or Rules.glyph_at(Vector2i(7, 4), sedilia) != "?":
		return "the sedilia glyph or size changed"
	if Rules.corridor_cells(sedilia).size() != 70 or Rules.hazard_cells(sedilia).size() != 30:
