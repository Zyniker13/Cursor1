	if Rules.glyph_at(Vector2i(6, 12), sedilia) != "#" or Rules.glyph_at(Vector2i(10, 12), sedilia) != "." or Rules.glyph_at(Vector2i(31, 16), sedilia) != "H":
		return "the sedilia oil cells changed"
	print("  credence shortest %d  survey %d  column %d  closeeast %d  reopen21 %d  reopen412 %d  reopen512 %d  reopen612 %d  close223 %d  west %d  full %d" % [steps, cover, Rules.safe_survey_steps(column_only), Rules.safe_survey_steps(closed_east), Rules.safe_survey_steps(reopened), Rules.safe_survey_steps(reopened_four), Rules.safe_survey_steps(reopened_five), Rules.safe_survey_steps(reopened_six), Rules.safe_survey_steps(closed_passage), Rules.safe_survey_steps(closed_west), full])
	return ""


func _credence_ring(floor) -> String:
	var cells: Array = Rules.loop_cells(floor)
	if cells.size() != 44:
		return "ring size %d" % cells.size()
	var have := {}
	for cell in cells:
		if have.has(cell):
			return "duplicate ring tile %s" % cell
		have[cell] = true
		if Rules.glyph_at(cell, floor) != "." or not Rules.is_corridor_cell(cell, floor):
			return "ring tile %s is not an open corridor" % cell
		if cell == Rules.enemy_pos(floor):
			return "ring tile %s is the warden" % cell
	for cell in cells:
		var degree := 0
		for dir in Rules.cardinals():
			if have.has(cell + dir):
				degree += 1
		if degree != 2:
			return "ring tile %s has %d neighbors in the ring" % [cell, degree]
	if str(floor.loop_name) != "Credence ring":
		return "ring name is %s" % floor.loop_name
	return ""


func _credence_census() -> String:
	var floor = Rules.floor_named("credence")
	var truth: Dictionary = Rules.accurate_sheet(floor)
	if not Rules.census_accepted(truth, floor):
		return "the true credence census was rejected"
	var bill: Dictionary = Rules.payout(truth, floor)
	if int(bill.corridors) != 69 or int(bill.hazards) != 31 or int(bill.loop) != 1:
		return "true counts %s/%s loop %s" % [bill.corridors, bill.hazards, bill.loop]
	if int(bill.total) != 470 or str(bill.loop_name) != "Credence ring":
		return "full credence payout is %s" % bill.total
	var crack: Vector2i = Vector2i(32, 16)
	var missing: Dictionary = truth.duplicate()
	missing.erase(crack)
	if Rules.census_accepted(missing, floor):
		return "a sheet missing a credence crack was accepted"
	var mislabeled: Dictionary = truth.duplicate()
	mislabeled[crack] = Rules.Mark.CORRIDOR
	if Rules.census_accepted(mislabeled, floor):
		return "a credence crack marked as a corridor was accepted"
	var swapped: Dictionary = truth.duplicate()
	swapped[crack] = Rules.Mark.WALL
	swapped[Vector2i(7, 4)] = Rules.Mark.HAZARD
	if Rules.census_accepted(swapped, floor):
		return "a swapped credence sheet was accepted"
	var short_sheet: Dictionary = truth.duplicate()
	short_sheet.erase(Vector2i(1, 2))
	if Rules.census_accepted(short_sheet, floor):
		return "a short credence sheet was accepted"
	var shelf_wall: Dictionary = truth.duplicate()
	shelf_wall[Vector2i(7, 4)] = Rules.Mark.WALL
	if not Rules.census_accepted(shelf_wall, floor):
		return "inking the credence as a wall rejected a true census"
	shelf_wall[Vector2i(7, 4)] = Rules.Mark.HAZARD
	if Rules.census_accepted(shelf_wall, floor):
		return "calling the credence a hazard was accepted"
	var expect_pay := {
