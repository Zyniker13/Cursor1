			continue
		if Rules.census_accepted(truth, other):
			return "the credence sheet was accepted as %s" % other.title
		if Rules.census_accepted(Rules.accurate_sheet(other), floor):
			return "the %s sheet was accepted as the credence" % other.title
		if not Rules.census_accepted(Rules.accurate_sheet(other), other):
			return "the %s true census was rejected" % other.title
		var other_bill: Dictionary = Rules.payout(Rules.accurate_sheet(other), other)
		if int(other_bill.total) != int(expect_pay[other.id]):
			return "the %s payout changed to %s" % [other.title, other_bill.total]
		if str(other_bill.loop_name) != str(expect_loop[other.id]):
			return "the %s ring name changed" % other.title
	var approach: Vector2i = Rules.walkable_approach(crack, floor)
	if approach.x < 0:
		return "credence crack has no approach"
	var walker = Rules.new_run(Rules.SMALL_FLASK_OIL, floor)
	walker.pos = approach
	walker.oil = 10
	var before: int = walker.oil
	var stepped: Dictionary = Rules.step(walker, crack - approach)
	if bool(stepped.hit) or walker.oil != before - Rules.MOVE_OIL:
		return "a credence crack burned extra oil"
	if int(walker.marks.get(crack, Rules.Mark.NONE)) != Rules.Mark.HAZARD:
		return "a credence crack was not inked as a hazard"
	if str(stepped.message).find("credence crack") < 0:
		return "stepping on a credence crack did not name it"
	return ""


func _credence_return() -> String:
	var game_script = load("res://scripts/game.gd")
	var select_script = load("res://scripts/floor_select_view.gd")
	if game_script == null or select_script == null:
		return "game or floor select did not load"
	if float(select_script.WINDOW_W) != 4044.0:
		return "floor select window width is %s" % select_script.WINDOW_W
	var game = game_script.new()
	root.add_child(game)
	if game.town == null or game.floor_select == null or game.descent == null:
		game.free()
		return "the game did not build its screens"
	if game.floor_select.record_for("credence") != Rules.CREDENCE_RECORD:
		game.free()
		return "floor select does not offer the credence census"
	if Rules.floor_named("credence").title != "The Credence":
		game.free()
		return "floor select does not name the Credence"
	if Rules.floors().size() != 53:
		game.free()
		return "floor select does not list fifty-three floors"
	var sedilia_card: Control = game.floor_select._record["sedilia"].get_parent()
	var credence_card: Control = game.floor_select._record["credence"].get_parent()
	var sedilia_rect := Rect2(sedilia_card.position, sedilia_card.size)
	var credence_rect := Rect2(credence_card.position, credence_card.size)
	if credence_rect.intersects(sedilia_rect):
		game.free()
		return "the credence card covers the sedilia card"
	if absf(credence_rect.position.x - (sedilia_rect.position.x + sedilia_rect.size.x + 8.0)) > 0.5:
		game.free()
		return "the credence card is not immediately to the right of the sedilia"
	var window_w: float = select_script.WINDOW_W
	if credence_rect.position.x + credence_rect.size.x > window_w + 0.5:
		game.free()
		return "the credence card sits outside the window"
	var saw := {}
	var previous: Control = null
	for listed in Rules.floors():
		var card: Control = game.floor_select._record[listed.id].get_parent()
		var card_rect := Rect2(card.position, card.size)
		if card_rect.position.x < 0.0 or card_rect.position.x + card_rect.size.x > window_w + 0.5:
			game.free()
			return "the %s card sits outside the window" % listed.title
		if card_rect.position.y < 0.0 or card_rect.position.y + card_rect.size.y > 720.0:
			game.free()
			return "the %s card is clipped by the window height" % listed.title
		if previous != null and card_rect.intersects(Rect2(previous.position, previous.size)):
			game.free()
			return "the %s card covers another card" % listed.title
		var heading: Label = card.get_child(2)
		if heading == null or heading.text != listed.title:
			game.free()
			return "the %s card title is missing" % listed.title
		for glyph_i in heading.text.length():
			var glyph := heading.text.substr(glyph_i, 1)
			if glyph == " ":
				continue
			var glyph_bounds := heading.get_character_bounds(glyph_i)
			if glyph_bounds.size.x <= 0.0 or glyph_bounds.position.y + glyph_bounds.size.y > heading.size.y + 0.01 or glyph_bounds.position.x + glyph_bounds.size.x > heading.size.x + 0.01:
				game.free()
				return "the %s title hides %s" % [listed.title, glyph]
		saw[listed.title] = true
		previous = card
	for title in ["The Scriptorium", "The Ambulatory", "The Chevet", "The Retrochoir", "The Lady Chapel", "The Feretory", "The Chantry", "The Sacristy", "The Pyx Chamber", "The Aumbry", "The Piscina", "The Sedilia", "The Credence"]:
		if not saw.has(title):
			game.free()
			return "the floor select is missing %s" % title
	var narrow_w := (2123.0 - 24.0 - 8.0 * 30.0) / 31.0
	var narrow_heading := narrow_w - 8.0
	var probe := Label.new()
	probe.add_theme_font_size_override("font_size", 9)
	probe.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	probe.clip_text = true
	probe.size = Vector2(narrow_heading, 44)
	game.add_child(probe)
	probe.text = "The Scriptorium"
	if probe.get_character_bounds(probe.text.length() - 1).size.x > 0.0:
		probe.free()
		game.free()
		return "2123 already shows the last letter of The Scriptorium, so 2124 is not the smallest width"
	probe.text = "The Ambulatory"
	if probe.get_character_bounds(probe.text.length() - 1).size.x > 0.0:
		probe.free()
		game.free()
		return "2123 already shows the last letter of The Ambulatory, so 2124 is not the smallest width"
	probe.free()
	game._on_descend_floor("credence")
	if game.descent.state == null or game.descent.state.floor.id != "credence":
		game.free()
		return "descend did not open the credence"
	var state = game.descent.state
	state.marks = Rules.accurate_sheet(state.floor)
	var lift: Vector2i = Rules.lift_pos(state.floor)
	var approach: Vector2i = Rules.walkable_approach(lift, state.floor)
	state.pos = approach
	state.oil = 5
	var done: Dictionary = Rules.step(state, lift - approach)
	if not bool(done.extracted) or not Rules.census_accepted(state.marks, state.floor):
		game.free()
		return "the finished sheet did not extract as an accepted census"
	game.descent._open_return()
	if game.descent.return_button.text != "Return to floor select":
		game.free()
		return "a finished census did not offer the floor select"
	game._on_return(state)
	if not game.floor_select.visible or game.town.visible or game.descent.visible:
		game.free()
		return "a finished census did not return to the floor select"
	if not bool(game.campaign.completed.get("credence", false)):
		game.free()
		return "the finished census was not recorded"
	if bool(game.campaign.completed.get("sedilia", false)):
		game.free()
		return "the finished credence census also closed the sedilia"
	if int(game.campaign.last_bill.total) != 470 or game.campaign.purse < 470:
		game.free()
		return "the finished census was not paid"
	game.free()
	return ""

func _reredos_layout() -> String:
	if Rules.CORRIDOR_VALUE != 3 or Rules.HAZARD_VALUE != 8 or Rules.LOOP_VALUE != 15:
		return "payout rates changed"
	if Rules.MOVE_OIL != 1 or Rules.HIT_OIL != 3:
		return "oil costs changed"
	if Rules.SMALL_FLASK_OIL != 24 or Rules.LARGE_FLASK_OIL != 120 or Rules.LARGE_FLASK_COST != 40:
		return "flask sizes changed"
	var floor = Rules.floor_named("reredos")
	if floor == null:
		return "reredos floor is missing"
	if floor.record != Rules.REREDOS_RECORD:
		return "reredos record drifted from its constant"
	if Rules.REREDOS_RECORD != "Record every corridor, the thirty-two reredos cracks, and the ring around the reredos.":
		return "the reredos no longer asks for the reredos cracks and the ring"
	if Rules.width(floor) != 35 or Rules.height(floor) != 21:
		return "reredos sheet is %d by %d" % [Rules.width(floor), Rules.height(floor)]
	var mark_count := 0
	for row in floor.rows:
		mark_count += str(row).count("<")
		if str(row).find(">") >= 0:
			return "the reredos sheet still uses the credence glyph"
	if mark_count != 84:
		return "the reredos block is not 14 by 6"
	for other in Rules.floors():
		if other.id == floor.id:
			continue
		for row in other.rows:
			if str(row).find("<") >= 0:
				return "glyph < is already used on %s" % other.id
	var credence = Rules.floor_named("credence")
	var sedilia = Rules.floor_named("sedilia")
	if credence == null or sedilia == null:
		return "an earlier floor is missing"
	if Rules.glyph_at(Vector2i(7, 4), credence) != ">":
		return "> is no longer the credence"
	if Rules.glyph_at(Vector2i(7, 4), floor) != "<":
		return "< is not the reredos"
	var start := Vector2i(1, 1)
	var lift := Vector2i(10, 11)
	var enemy := Vector2i(9, 12)
	var east := Vector2i(10, 12)
	var west := Vector2i(8, 12)
	if Rules.start_pos(floor) != start or Rules.lift_pos(floor) != lift or Rules.enemy_pos(floor) != enemy:
		return "start, lift, or warden moved"
	if Rules.glyph_at(Vector2i(33, 16), floor) != "H":
		return "the new crack is not (33,16)"
	if Rules.glyph_at(Vector2i(32, 16), floor) != "H" or Rules.glyph_at(Vector2i(31, 16), floor) != "H" or Rules.glyph_at(Vector2i(30, 16), floor) != "H" or Rules.glyph_at(Vector2i(29, 16), floor) != "H" or Rules.glyph_at(Vector2i(28, 16), floor) != "H" or Rules.glyph_at(Vector2i(28, 15), floor) != "H" or Rules.glyph_at(Vector2i(27, 15), floor) != "H" or Rules.glyph_at(Vector2i(26, 15), floor) != "H":
		return "a carried credence crack was closed"
	if Rules.glyph_at(Vector2i(10, 12), floor) != "#" or Rules.glyph_at(Vector2i(6, 12), floor) != "#" or Rules.glyph_at(Vector2i(5, 12), floor) != "#" or Rules.glyph_at(Vector2i(4, 12), floor) != "#" or Rules.glyph_at(Vector2i(25, 2), floor) != "#" or Rules.glyph_at(Vector2i(3, 12), floor) != "#" or Rules.glyph_at(Vector2i(2, 1), floor) != "#" or Rules.glyph_at(Vector2i(3, 1), floor) != "#":
		return "a carried closure was reopened"
	if Rules.glyph_at(Vector2i(9, 10), floor) != "#":
		return "(9,10) was left open"
	if Rules.glyph_at(Vector2i(21, 4), floor) != "." or Rules.glyph_at(Vector2i(7, 10), floor) != ".":
		return "another 120-oil ring tile was closed"
	var hazards := Rules.hazard_cells(floor)
	if hazards.size() != 32:
		return "expected thirty-two reredos cracks, found %d" % hazards.size()
	if not hazards.has(Vector2i(33, 16)) or hazards.has(Vector2i(9, 10)) or hazards.has(Vector2i(10, 12)):
		return "the crack set drifted"
	if Rules.corridor_cells(floor).size() != 68:
		return "corridors %d" % Rules.corridor_cells(floor).size()
	if Rules.glyph_at(Vector2i(19, 11), floor) != "." or not Rules.is_corridor_cell(Vector2i(19, 11), floor):
		return "(19,11) is not the open door"
	if Rules.glyph_at(west, floor) != "." or not Rules.is_corridor_cell(west, floor):
		return "the warden's west swing was closed"
	if Rules.is_walkable(east, floor) or Rules.is_corridor_cell(east, floor):
		return "the warden's east swing was reopened"
	if _ring_key(floor) == _ring_key(credence):
		return "the reredos ring still includes the closed cell"
	var ring_err := _reredos_ring(floor)
	if ring_err != "":
		return ring_err
	for other in Rules.floors():
		if other.id == floor.id:
			continue
		if floor.rows == other.rows:
			return "the reredos copies %s" % other.id
		if Rules.width(floor) == Rules.width(other) and Rules.height(floor) == Rules.height(other):
			return "the reredos reuses the %s grid" % other.id
		if Rules.enemy_pos(floor) == Rules.enemy_pos(other) and str(other.id) != "font" and str(other.id) != "apse" and str(other.id) != "choir" and str(other.id) != "rood" and str(other.id) != "crossing" and str(other.id) != "transept" and str(other.id) != "ambulatory" and str(other.id) != "chevet" and str(other.id) != "retrochoir" and str(other.id) != "ladychapel" and str(other.id) != "feretory" and str(other.id) != "chantry" and str(other.id) != "sacristy" and str(other.id) != "pyx" and str(other.id) != "aumbry" and str(other.id) != "piscina" and str(other.id) != "sedilia" and str(other.id) != "credence" and str(other.id) != "predella" and str(other.id) != "dossal" and str(other.id) != "retable" and str(other.id) != "tester" and str(other.id) != "riddel" and str(other.id) != "frontal" and str(other.id) != "pall" and str(other.id) != "herse" and str(other.id) != "catafalque" and str(other.id) != "bier" and str(other.id) != "cerecloth" and str(other.id) != "hearse" and str(other.id) != "shroud" and str(other.id) != "pyre" and str(other.id) != "cenotaph" and str(other.id) != "winding" and str(other.id) != "charnel" and str(other.id) != "sepulchre" and str(other.id) != "vault" and str(other.id) != "cairn" and str(other.id) != "columbarium":
			return "the reredos reuses the %s warden cell" % other.id
		if _ring_key(floor) == _ring_key(other) and str(other.id) != "feretory" and str(other.id) != "chantry" and str(other.id) != "sacristy" and str(other.id) != "pyx" and str(other.id) != "aumbry" and str(other.id) != "piscina" and str(other.id) != "sedilia" and str(other.id) != "credence" and str(other.id) != "predella" and str(other.id) != "dossal" and str(other.id) != "retable" and str(other.id) != "tester" and str(other.id) != "riddel" and str(other.id) != "frontal" and str(other.id) != "pall" and str(other.id) != "herse" and str(other.id) != "catafalque" and str(other.id) != "bier" and str(other.id) != "cerecloth" and str(other.id) != "hearse" and str(other.id) != "shroud" and str(other.id) != "pyre" and str(other.id) != "cenotaph" and str(other.id) != "winding" and str(other.id) != "charnel" and str(other.id) != "sepulchre" and str(other.id) != "vault" and str(other.id) != "cairn" and str(other.id) != "columbarium":
			return "the reredos reuses the %s ring" % other.id
	var path: Array = Rules.shortest_path_cells(floor)
	var credence_path: Array = Rules.shortest_path_cells(credence)
	if path.size() != credence_path.size() or path.size() != 20:
		return "the 19-step path cells changed"
	for i in path.size():
		if path[i] != credence_path[i]:
			return "the 19-step path moved at %s" % path[i]
	if path.has(Vector2i(33, 16)) or path.has(Vector2i(9, 10)) or path.has(Vector2i(10, 12)):
		return "an oil cell sits on the 19-step path"
	var swings: Array = Rules.swing_tiles(floor)
	if swings.size() != 2 or swings[0] != east or swings[1] != west:
		return "the warden should telegraph the east tile, then the west tile"
	if Rules.is_corridor_cell(swings[0], floor) or not Rules.is_corridor_cell(swings[1], floor):
		return "the east swing should stay closed and the west swing open"
	var bumper = Rules.new_run(Rules.SMALL_FLASK_OIL, floor)
	bumper.pos = Vector2i(6, 4)
	var before_oil: int = bumper.oil
	var tap: Dictionary = Rules.step(bumper, Vector2i(1, 0))
	if bool(tap.moved) or bumper.oil != before_oil:
		return "bumping the reredos spent oil or moved"
	if int(bumper.marks.get(Vector2i(7, 4), Rules.Mark.NONE)) != Rules.Mark.WALL:
		return "bumping the reredos did not ink a wall"
	if str(tap.message).find("reredos") < 0:
		return "bumping the reredos did not name it"
	if str(tap.message).find("credence") >= 0 or str(tap.message).find("sedilia") >= 0:
		return "bumping the reredos named another floor"
	var facing = Rules.new_run(Rules.SMALL_FLASK_OIL, floor)
	facing.pos = Vector2i(6, 4)
	facing.facing = Rules.facing_from_vector(Vector2i(1, 0))
	if Rules.ahead_line(facing).find("the reredos") < 0:
		return "facing the reredos did not name it"
	facing.pos = Vector2i(1, 2)
	facing.facing = Rules.facing_from_vector(Vector2i(0, 1))
	if Rules.ahead_line(facing).find("reredos crack") < 0:
		return "facing a reredos crack did not name it"
	var steps := Rules.shortest_path_steps(floor)
	if steps != 19:
		return "shortest reredos path is %d, expected 19" % steps
	var cover := Rules.safe_survey_steps(floor)
	if cover != 120:
		return "safe survey is %d, expected 120" % cover
	if cover > Rules.LARGE_FLASK_OIL:
		return "large flask %d is shorter than the safe survey %d" % [Rules.LARGE_FLASK_OIL, cover]
	var column_only := Rules.Floor.new()
	var column_rows := PackedStringArray()
	for i in floor.rows.size():
		var column_row := str(floor.rows[i])
		if i == 10:
			column_row = column_row.left(9) + "." + column_row.substr(10)
		column_rows.append(column_row)
	column_only.rows = column_rows
	if Rules.glyph_at(Vector2i(33, 16), column_only) != "H" or Rules.glyph_at(Vector2i(9, 10), column_only) != "." or Rules.glyph_at(Vector2i(10, 12), column_only) != "#":
		return "the column-only sheet did not keep only the new crack"
	if Rules.shortest_path_cells(column_only) != path:
		return "the new crack changed the path"
	if Rules.safe_survey_steps(column_only) != 122:
		return "column-only survey is %d, expected 122" % Rules.safe_survey_steps(column_only)
	if Rules.hazard_cells(column_only).size() != 32 or Rules.corridor_cells(column_only).size() != 69:
		return "column-only counts drifted"
	var closed_ring := Rules.Floor.new()
	var ring_rows := PackedStringArray()
	for i in column_only.rows.size():
		var ring_row := str(column_only.rows[i])
		if i == 4:
			ring_row = ring_row.left(21) + "#" + ring_row.substr(22)
		ring_rows.append(ring_row)
	closed_ring.rows = ring_rows
	if Rules.safe_survey_steps(closed_ring) != 120 or Rules.shortest_path_cells(closed_ring) != path:
		return "closing (21,4) surveys at %d, expected 120" % Rules.safe_survey_steps(closed_ring)
	var closed_south := Rules.Floor.new()
	var south_rows := PackedStringArray()
	for i in column_only.rows.size():
		var south_row := str(column_only.rows[i])
		if i == 10:
			south_row = south_row.left(7) + "#" + south_row.substr(8)
		south_rows.append(south_row)
	closed_south.rows = south_rows
	if Rules.safe_survey_steps(closed_south) != 120 or Rules.shortest_path_cells(closed_south) != path:
		return "closing (7,10) surveys at %d, expected 120" % Rules.safe_survey_steps(closed_south)
	var closed_west := Rules.Floor.new()
	var west_rows := PackedStringArray()
	for i in column_only.rows.size():
		var west_row := str(column_only.rows[i])
		if i == 12:
			west_row = west_row.left(8) + "#" + west_row.substr(9)
		west_rows.append(west_row)
	closed_west.rows = west_rows
	if Rules.safe_survey_steps(closed_west) != 121 or Rules.shortest_path_cells(closed_west) != path:
		return "closing the west swing surveys at %d, expected 121" % Rules.safe_survey_steps(closed_west)
	var closed_passage := Rules.Floor.new()
	var passage_rows := PackedStringArray()
	for i in column_only.rows.size():
		var passage_row := str(column_only.rows[i])
		if i == 3:
			passage_row = passage_row.left(22) + "#" + passage_row.substr(23)
		passage_rows.append(passage_row)
	closed_passage.rows = passage_rows
	if Rules.safe_survey_steps(closed_passage) != 132 or Rules.shortest_path_cells(closed_passage) != path:
		return "closing (22,3) surveys at %d, expected 132" % Rules.safe_survey_steps(closed_passage)
	var reopened := Rules.Floor.new()
	var reopened_rows := PackedStringArray()
	for i in column_only.rows.size():
		var reopened_row := str(column_only.rows[i])
		if i == 1:
			reopened_row = reopened_row.left(2) + "." + reopened_row.substr(3)
		reopened_rows.append(reopened_row)
	reopened.rows = reopened_rows
	if Rules.safe_survey_steps(reopened) != 124 or Rules.shortest_path_cells(reopened) != path:
		return "reopening (2,1) surveys at %d, expected 124" % Rules.safe_survey_steps(reopened)
	var reopened_six := Rules.Floor.new()
	var six_rows := PackedStringArray()
	for i in column_only.rows.size():
		var six_row := str(column_only.rows[i])
		if i == 12:
			six_row = six_row.left(6) + "." + six_row.substr(7)
		six_rows.append(six_row)
	reopened_six.rows = six_rows
	if Rules.safe_survey_steps(reopened_six) != 124 or Rules.shortest_path_cells(reopened_six) != path:
		return "reopening (6,12) surveys at %d, expected 124" % Rules.safe_survey_steps(reopened_six)
	var reopened_east := Rules.Floor.new()
	var east_rows := PackedStringArray()
	for i in column_only.rows.size():
		var east_row := str(column_only.rows[i])
		if i == 12:
			east_row = east_row.left(10) + "." + east_row.substr(11)
		east_rows.append(east_row)
	reopened_east.rows = east_rows
	if Rules.safe_survey_steps(reopened_east) != 124 or Rules.shortest_path_cells(reopened_east) != path:
		return "reopening (10,12) surveys at %d, expected 124" % Rules.safe_survey_steps(reopened_east)
	if Rules.safe_survey_steps(credence) != 120 or Rules.corridor_cells(credence).size() != 69 or Rules.hazard_cells(credence).size() != 31:
		return "the credence solution changed"
	if Rules.safe_survey_steps(sedilia) != 120 or Rules.corridor_cells(sedilia).size() != 70 or Rules.hazard_cells(sedilia).size() != 30:
		return "the sedilia solution changed"
	var credence_bill: Dictionary = Rules.payout(Rules.accurate_sheet(credence), credence)
	var sedilia_bill: Dictionary = Rules.payout(Rules.accurate_sheet(sedilia), sedilia)
	if int(credence_bill.total) != 470 or int(sedilia_bill.total) != 465:
		return "an earlier payout changed"
	print("  reredos shortest %d  survey %d  corridors %d  cracks %d" % [steps, cover, Rules.corridor_cells(floor).size(), hazards.size()])
	return ""


func _reredos_ring(floor) -> String:
	var cells: Array = Rules.loop_cells(floor)
	if cells.size() != 46:
		return "ring size %d" % cells.size()
	var have := {}
	for cell in cells:
		if have.has(cell):
			return "duplicate ring tile %s" % cell
		have[cell] = true
		if cell == Vector2i(9, 10):
			return "(9,10) is still on the ring"
		if cell == Rules.lift_pos(floor):
			if Rules.glyph_at(cell, floor) != "L" or not Rules.is_corridor_cell(cell, floor):
				return "the lift is not the ring's corridor"
		elif Rules.glyph_at(cell, floor) != "." or not Rules.is_corridor_cell(cell, floor):
			return "ring tile %s is not an open corridor" % cell
		if cell == Rules.enemy_pos(floor):
			return "ring tile %s is the warden" % cell
	for cell in cells:
		var degree := 0
		for dir in Rules.cardinals():
			if have.has(cell + dir):
				degree += 1
		if degree != 2:
			return "ring tile %s has %d neighbors in the ring" % [cell, degree]
	if str(floor.loop_name) != "Reredos ring":
		return "ring name is %s" % floor.loop_name
	var bill: Dictionary = Rules.payout(Rules.accurate_sheet(floor), floor)
	if int(bill.loop) != 1:
		return "the ring did not pay"
	if not have.has(Vector2i(8, 11)) or not have.has(Vector2i(9, 11)) or not have.has(Vector2i(10, 11)) or not have.has(Vector2i(21, 4)) or not have.has(Vector2i(7, 10)):
		return "the ring does not step around (9,10)"
	return ""


