		crack_rows.append(crack_row)
	crack_only.rows = crack_rows
	if Rules.glyph_at(Vector2i(30, 15), crack_only) != "H" or Rules.glyph_at(Vector2i(10, 10), crack_only) != "." or Rules.glyph_at(Vector2i(11, 11), crack_only) != "#":
		return "the crack-only sheet did not keep only the new crack"
	if Rules.shortest_path_cells(crack_only) != path:
		return "the new crack changed the path"
	if Rules.safe_survey_steps(crack_only) != 120:
		return "crack-only survey is %d, expected 120" % Rules.safe_survey_steps(crack_only)
	if Rules.hazard_cells(crack_only).size() != 34 or Rules.corridor_cells(crack_only).size() != 67:
		return "crack-only counts drifted"
	for alt in [Vector2i(24, 13), Vector2i(26, 14)]:
		var absorbed := Rules.Floor.new()
		var absorbed_rows := PackedStringArray()
		for i in crack_only.rows.size():
			var absorbed_row := str(crack_only.rows[i])
			if i == 15:
				absorbed_row = absorbed_row.left(30) + "#" + absorbed_row.substr(31)
			if i == alt.y:
				absorbed_row = absorbed_row.left(alt.x) + "H" + absorbed_row.substr(alt.x + 1)
			absorbed_rows.append(absorbed_row)
		absorbed.rows = absorbed_rows
		if Rules.glyph_at(Vector2i(30, 15), absorbed) != "#" or Rules.glyph_at(alt, absorbed) != "H":
			return "the absorbed spare %s was not built" % alt
		if Rules.safe_survey_steps(absorbed) != 120 or Rules.shortest_path_cells(absorbed) != path:
			return "absorbed crack %s surveys at %d" % [alt, Rules.safe_survey_steps(absorbed)]
	var tip := Rules.Floor.new()
	var tip_rows := PackedStringArray()
	for i in floor.rows.size():
		var tip_row := str(floor.rows[i])
		if i == 15:
			tip_row = tip_row.left(30) + "#" + tip_row.substr(31)
		if i == 16:
			tip_row = tip_row.left(34) + "H" + tip_row.substr(35)
		tip_rows.append(tip_row)
	tip.rows = tip_rows
	if Rules.glyph_at(Vector2i(34, 16), tip) != "H" or Rules.glyph_at(Vector2i(30, 15), tip) != "#" or Rules.glyph_at(Vector2i(10, 10), tip) != "#" or Rules.glyph_at(Vector2i(11, 11), tip) != ".":
		return "the off-tour crack sheet was not built"
	if Rules.safe_survey_steps(tip) != 122 or Rules.shortest_path_cells(tip) != path:
		return "off-tour crack with the dossal closure surveys at %d" % Rules.safe_survey_steps(tip)
	var tip_kept := Rules.Floor.new()
	var kept_rows := PackedStringArray()
	for i in tip.rows.size():
		var kept_row := str(tip.rows[i])
		if i == 10:
			kept_row = kept_row.left(7) + "#" + kept_row.substr(8)
			kept_row = kept_row.left(10) + "." + kept_row.substr(11)
		if i == 11:
			kept_row = kept_row.left(11) + "#" + kept_row.substr(12)
		kept_rows.append(kept_row)
	tip_kept.rows = kept_rows
	if Rules.glyph_at(Vector2i(7, 10), tip_kept) != "#" or Rules.glyph_at(Vector2i(10, 10), tip_kept) != "." or Rules.glyph_at(Vector2i(11, 11), tip_kept) != "#":
		return "the (7,10) counterfactual was not built"
	if Rules.safe_survey_steps(tip_kept) != 120 or Rules.shortest_path_cells(tip_kept) != path:
		return "closing (7,10) on the off-tour crack surveys at %d" % Rules.safe_survey_steps(tip_kept)
	var tip_spur := Rules.Floor.new()
	var spur_rows := PackedStringArray()
	for i in tip.rows.size():
		var spur_row := str(tip.rows[i])
		if i == 4:
			spur_row = spur_row.left(21) + "#" + spur_row.substr(22)
		if i == 10:
			spur_row = spur_row.left(10) + "." + spur_row.substr(11)
		if i == 11:
			spur_row = spur_row.left(11) + "#" + spur_row.substr(12)
		spur_rows.append(spur_row)
	tip_spur.rows = spur_rows
	if Rules.safe_survey_steps(tip_spur) != 120 or Rules.shortest_path_cells(tip_spur) != path:
		return "closing (21,4) on the off-tour crack surveys at %d" % Rules.safe_survey_steps(tip_spur)
	if Rules.safe_survey_steps(predella) != 120 or Rules.corridor_cells(predella).size() != 67 or Rules.hazard_cells(predella).size() != 33:
		return "the predella solution changed"
	if Rules.safe_survey_steps(reredos) != 120 or Rules.corridor_cells(reredos).size() != 68 or Rules.hazard_cells(reredos).size() != 32:
		return "the reredos solution changed"
	if Rules.safe_survey_steps(credence) != 120 or Rules.corridor_cells(credence).size() != 69 or Rules.hazard_cells(credence).size() != 31:
		return "the credence solution changed"
	if Rules.safe_survey_steps(sedilia) != 120 or Rules.corridor_cells(sedilia).size() != 70 or Rules.hazard_cells(sedilia).size() != 30:
		return "the sedilia solution changed"
	var predella_bill: Dictionary = Rules.payout(Rules.accurate_sheet(predella), predella)
	var reredos_bill: Dictionary = Rules.payout(Rules.accurate_sheet(reredos), reredos)
	var credence_bill: Dictionary = Rules.payout(Rules.accurate_sheet(credence), credence)
	var sedilia_bill: Dictionary = Rules.payout(Rules.accurate_sheet(sedilia), sedilia)
	if int(predella_bill.total) != 480 or int(reredos_bill.total) != 475 or int(credence_bill.total) != 470 or int(sedilia_bill.total) != 465:
		return "an earlier payout changed"
	var bumper = Rules.new_run(Rules.SMALL_FLASK_OIL, floor)
	bumper.pos = Vector2i(6, 4)
	var before_oil: int = bumper.oil
	var tap: Dictionary = Rules.step(bumper, Vector2i(1, 0))
	if bool(tap.moved) or bumper.oil != before_oil:
		return "bumping the dossal spent oil or moved"
	if int(bumper.marks.get(Vector2i(7, 4), Rules.Mark.NONE)) != Rules.Mark.WALL:
		return "bumping the dossal did not ink a wall"
	if str(tap.message).find("dossal") < 0:
		return "bumping the dossal did not name it"
	var facing = Rules.new_run(Rules.SMALL_FLASK_OIL, floor)
	facing.pos = Vector2i(1, 2)
	facing.facing = Rules.facing_from_vector(Vector2i(0, 1))
	if Rules.ahead_line(facing).find("dossal crack") < 0:
		return "facing a dossal crack did not name it"
	print("  dossal shortest 19  survey %d  corridors %d  cracks %d" % [cover, Rules.corridor_cells(floor).size(), hazards.size()])
	return ""


func _dossal_ring(floor) -> String:
	var cells: Array = Rules.loop_cells(floor)
	if cells.size() != 46:
		return "ring size %d" % cells.size()
	var have := {}
	for cell in cells:
		if have.has(cell):
			return "duplicate ring tile %s" % cell
		have[cell] = true
		if cell == Vector2i(8, 10) or cell == Vector2i(9, 10) or cell == Vector2i(10, 10):
			return "closed ring tile %s is still on the ring" % cell
		if cell == Rules.lift_pos(floor):
			if Rules.glyph_at(cell, floor) != "L" or not Rules.is_corridor_cell(cell, floor):
				return "the lift is not the ring's corridor"
		elif Rules.glyph_at(cell, floor) != "." or not Rules.is_corridor_cell(cell, floor):
			return "ring tile %s is not an open corridor" % cell
		if cell == Rules.enemy_pos(floor):
			return "ring tile %s is the warden" % cell
	for cell in cells:
		var degree := 0
		for dir in Rules.cardinals():
			if have.has(cell + dir):
				degree += 1
		if degree != 2:
			return "ring tile %s has %d neighbors in the ring" % [cell, degree]
	if not have.has(Vector2i(11, 11)) or not have.has(Vector2i(7, 11)) or not have.has(Vector2i(8, 11)) or not have.has(Vector2i(21, 4)) or not have.has(Vector2i(7, 10)):
		return "the ring does not step around the closed tiles"
	if str(floor.loop_name) != "Dossal ring":
		return "ring name is %s" % floor.loop_name
	var bill: Dictionary = Rules.payout(Rules.accurate_sheet(floor), floor)
	if int(bill.loop) != 1:
		return "the ring did not pay"
	return ""


