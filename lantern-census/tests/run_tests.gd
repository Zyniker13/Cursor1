	if str(stepped.message).find("aumbry crack") < 0:
		return "stepping on an aumbry crack did not name it"
	return ""


func _aumbry_return() -> String:
	var game_script = load("res://scripts/game.gd")
	var select_script = load("res://scripts/floor_select_view.gd")
	if game_script == null or select_script == null:
		return "game or floor select did not load"
	if float(select_script.WINDOW_W) != 4044.0:
		return "floor select window width is %s" % select_script.WINDOW_W
	var game = game_script.new()
	root.add_child(game)
	if game.town == null or game.floor_select == null or game.descent == null:
		game.free()
		return "the game did not build its screens"
	if game.floor_select.record_for("aumbry") != Rules.AUMBRY_RECORD:
		game.free()
		return "floor select does not offer the aumbry census"
	if Rules.floor_named("aumbry").title != "The Aumbry":
		game.free()
		return "floor select does not name the Aumbry"
	if Rules.floors().size() != 53:
		game.free()
		return "floor select does not list fifty-three floors"
	var pyx_card: Control = game.floor_select._record["pyx"].get_parent()
	var aumbry_card: Control = game.floor_select._record["aumbry"].get_parent()
	var pyx_rect := Rect2(pyx_card.position, pyx_card.size)
	var aumbry_rect := Rect2(aumbry_card.position, aumbry_card.size)
	if aumbry_rect.intersects(pyx_rect):
		game.free()
		return "the aumbry card covers the pyx card"
	if absf(aumbry_rect.position.x - (pyx_rect.position.x + pyx_rect.size.x + 8.0)) > 0.5:
		game.free()
		return "the aumbry card is not immediately to the right of the pyx"
	var window_w: float = select_script.WINDOW_W
	if aumbry_rect.position.x + aumbry_rect.size.x > window_w + 0.5:
		game.free()
		return "the aumbry card sits outside the window"
	var saw := {}
	var previous: Control = null
	for listed in Rules.floors():
		var card: Control = game.floor_select._record[listed.id].get_parent()
		var card_rect := Rect2(card.position, card.size)
		if card_rect.position.x < 0.0 or card_rect.position.x + card_rect.size.x > window_w + 0.5:
			game.free()
			return "the %s card sits outside the window" % listed.title
		if card_rect.position.y < 0.0 or card_rect.position.y + card_rect.size.y > 720.0:
			game.free()
			return "the %s card is clipped by the window height" % listed.title
		if previous != null and card_rect.intersects(Rect2(previous.position, previous.size)):
			game.free()
			return "the %s card covers another card" % listed.title
		var heading: Label = card.get_child(2)
		if heading == null or heading.text != listed.title:
			game.free()
			return "the %s card title is missing" % listed.title
		for glyph_i in heading.text.length():
			var glyph := heading.text.substr(glyph_i, 1)
			if glyph == " ":
				continue
			var glyph_bounds := heading.get_character_bounds(glyph_i)
			if glyph_bounds.size.x <= 0.0 or glyph_bounds.position.y + glyph_bounds.size.y > heading.size.y + 0.01 or glyph_bounds.position.x + glyph_bounds.size.x > heading.size.x + 0.01:
				game.free()
				return "the %s title hides %s" % [listed.title, glyph]
		saw[listed.title] = true
		previous = card
	for title in ["The Scriptorium", "The Ambulatory", "The Chevet", "The Retrochoir", "The Lady Chapel", "The Feretory", "The Chantry", "The Sacristy", "The Pyx Chamber", "The Aumbry"]:
		if not saw.has(title):
			game.free()
			return "the floor select is missing %s" % title
	var narrow_w := (1919.0 - 24.0 - 8.0 * 27.0) / 28.0
	var narrow_heading := narrow_w - 8.0
	var probe := Label.new()
	probe.add_theme_font_size_override("font_size", 9)
	probe.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	probe.clip_text = true
	probe.size = Vector2(narrow_heading, 44)
	game.add_child(probe)
	probe.text = "The Scriptorium"
	if probe.get_character_bounds(probe.text.length() - 1).size.x > 0.0:
		probe.free()
		game.free()
		return "1919 already shows the last letter of The Scriptorium, so 1920 is not the smallest width"
	probe.text = "The Ambulatory"
	if probe.get_character_bounds(probe.text.length() - 1).size.x > 0.0:
		probe.free()
		game.free()
		return "1919 already shows the last letter of The Ambulatory, so 1920 is not the smallest width"
	probe.free()
	game._on_descend_floor("aumbry")
	if game.descent.state == null or game.descent.state.floor.id != "aumbry":
		game.free()
		return "descend did not open the aumbry"
	var state = game.descent.state
	state.marks = Rules.accurate_sheet(state.floor)
	var lift: Vector2i = Rules.lift_pos(state.floor)
	var approach: Vector2i = Rules.walkable_approach(lift, state.floor)
	state.pos = approach
	state.oil = 5
	var done: Dictionary = Rules.step(state, lift - approach)
	if not bool(done.extracted) or not Rules.census_accepted(state.marks, state.floor):
		game.free()
		return "the finished sheet did not extract as an accepted census"
	game.descent._open_return()
	if game.descent.return_button.text != "Return to floor select":
		game.free()
		return "a finished census did not offer the floor select"
	game._on_return(state)
	if not game.floor_select.visible or game.town.visible or game.descent.visible:
		game.free()
		return "a finished census did not return to the floor select"
	if not bool(game.campaign.completed.get("aumbry", false)):
		game.free()
		return "the finished census was not recorded"
	if bool(game.campaign.completed.get("pyx", false)):
		game.free()
		return "the finished aumbry census also closed the pyx"
	if int(game.campaign.last_bill.total) != 452 or game.campaign.purse < 452:
		game.free()
		return "the finished census was not paid"
	game.free()
	return ""

func _piscina_layout() -> String:
	if Rules.CORRIDOR_VALUE != 3 or Rules.HAZARD_VALUE != 8 or Rules.LOOP_VALUE != 15:
		return "payout rates changed"
	if Rules.MOVE_OIL != 1 or Rules.HIT_OIL != 3:
		return "oil costs changed"
	if Rules.SMALL_FLASK_OIL != 24 or Rules.LARGE_FLASK_OIL != 120 or Rules.LARGE_FLASK_COST != 40:
		return "flask sizes changed"
	var floor = Rules.floor_named("piscina")
	if floor == null:
		return "piscina floor is missing"
	if floor.record != Rules.PISCINA_RECORD:
		return "piscina record drifted from its constant"
	if Rules.PISCINA_RECORD != "Record every corridor, the twenty-nine piscina cracks, and the ring around the piscina.":
		return "the piscina no longer asks for the piscina cracks and the ring"
	var expected := PackedStringArray([
		"################################",
		"#S##############################",
		"#.##############################",
		"#H####...................H######",
		"#.####.@@@@@@@@@@@@@@.###H######",
		"#H####.@@@@@@@@@@@@@@.###H######",
		"#.####.@@@@@@@@@@@@@@.###H######",
		"#H####.@@@@@@@@@@@@@@.###H######",
		"#.####.@@@@@@@@@@@@@@.###H######",
		"#H####.@@@@@@@@@@@@@@.###H######",
		"#.####................###H######",
		"#H........L########.#####H######",
		"######.H.E.########H.....H######",
		"#########################H######",
		"#########################H######",
		"#########################HHHH###",
		"#########################HHHHHH#",
		"################################",
		"################################",
		"################################",
		"################################",
	])
	if floor.rows != expected:
		return "piscina rows drifted"
	if Rules.width(floor) != 32 or Rules.height(floor) != 21:
		return "piscina sheet is not 32 by 21"
	if Rules.glyph_at(Vector2i(7, 4), floor) != "@":
		return "the piscina glyph is not @"
	var reserved := "SLHEFGDCBAIJMKOPQNXYWVUTRZ*+=x"
	if reserved.find("@") >= 0:
		return "@ is not a free survey glyph"
	var bell = Rules.floor_named("bellloft")
	var y_count := 0
	if bell != null:
		for row in bell.rows:
			y_count += str(row).count("Y")
	if y_count < 1:
		return "Y is not bound on the bell loft"
	var aumbry = Rules.floor_named("aumbry")
	var chantry = Rules.floor_named("chantry")
	if aumbry == null or chantry == null:
		return "an earlier floor is missing"
	var start := Vector2i(1, 1)
	var lift := Vector2i(10, 11)
	var enemy := Vector2i(9, 12)
	var east := Vector2i(10, 12)
	var west := Vector2i(8, 12)
	if Rules.start_pos(floor) != start or Rules.lift_pos(floor) != lift or Rules.enemy_pos(floor) != enemy:
		return "start, lift, or warden moved"
	if Rules.glyph_at(Vector2i(30, 16), floor) != "H":
		return "the new crack is not (30,16)"
	if Rules.glyph_at(Vector2i(29, 16), floor) != "H" or Rules.glyph_at(Vector2i(28, 16), floor) != "H" or Rules.glyph_at(Vector2i(27, 15), floor) != "H" or Rules.glyph_at(Vector2i(26, 15), floor) != "H":
		return "a carried aumbry crack was closed"
	if Rules.glyph_at(Vector2i(28, 15), floor) != "H":
		return "the seam (28,15) is not a crack"
	if Rules.glyph_at(Vector2i(5, 12), floor) != "#":
		return "(5,12) was left open"
	if Rules.glyph_at(Vector2i(25, 2), floor) != "#" or Rules.glyph_at(Vector2i(3, 12), floor) != "#" or Rules.glyph_at(Vector2i(2, 1), floor) != "#" or Rules.glyph_at(Vector2i(3, 1), floor) != "#" or Rules.glyph_at(Vector2i(4, 12), floor) != "#":
		return "a carried closure was reopened"
	if Rules.glyph_at(Vector2i(6, 12), floor) != ".":
		return "(6,12) was closed"
	var hazards := Rules.hazard_cells(floor)
	if hazards.size() != 29:
		return "expected twenty-nine piscina cracks, found %d" % hazards.size()
	if not hazards.has(Vector2i(30, 16)) or not hazards.has(Vector2i(28, 15)) or hazards.has(Vector2i(5, 12)):
		return "the crack set drifted"
	var mark_count := 0
	for row in floor.rows:
		mark_count += str(row).count("@")
	if mark_count != 84:
		return "the piscina block is not 14 by 6"
	for other in Rules.floors():
		if other.id == floor.id:
			continue
		for row in other.rows:
			if str(row).find("@") >= 0:
				return "glyph @ is already used on %s" % other.id
	for x in range(11, 25):
		if x == 19:
			continue
		var closed := Vector2i(x, 11)
		if Rules.glyph_at(closed, floor) != "#" or Rules.is_walkable(closed, floor):
			return "east landing %s was not closed into the pier" % closed
	if Rules.glyph_at(Vector2i(19, 11), floor) != "." or not Rules.is_corridor_cell(Vector2i(19, 11), floor):
		return "(19,11) is not the open door"
	for x in range(4, 32):
		var landing_wall := Vector2i(x, 1)
		if Rules.glyph_at(landing_wall, floor) != "#" or Rules.is_walkable(landing_wall, floor):
			return "north landing %s was not closed" % landing_wall
	if Rules.glyph_at(Vector2i(10, 12), floor) != "." or not Rules.is_corridor_cell(Vector2i(10, 12), floor):
		return "the warden's east swing was closed"
	if Rules.glyph_at(Vector2i(8, 12), floor) != "." or not Rules.is_corridor_cell(Vector2i(8, 12), floor):
		return "the warden's west swing was closed"
	if _ring_key(floor) != _ring_key(aumbry) or _ring_key(floor) != _ring_key(chantry):
		return "the piscina moved the shared ring"
	var ring_err := _piscina_ring(floor)
	if ring_err != "":
		return ring_err
	for other in Rules.floors():
		if other.id == floor.id:
			continue
		if floor.rows == other.rows:
			return "the piscina copies %s" % other.id
		if Rules.width(floor) == Rules.width(other) and Rules.height(floor) == Rules.height(other):
			return "the piscina reuses the %s grid" % other.id
		if Rules.enemy_pos(floor) == Rules.enemy_pos(other) and str(other.id) != "font" and str(other.id) != "apse" and str(other.id) != "choir" and str(other.id) != "rood" and str(other.id) != "crossing" and str(other.id) != "transept" and str(other.id) != "ambulatory" and str(other.id) != "chevet" and str(other.id) != "retrochoir" and str(other.id) != "ladychapel" and str(other.id) != "feretory" and str(other.id) != "chantry" and str(other.id) != "sacristy" and str(other.id) != "pyx" and str(other.id) != "aumbry" and str(other.id) != "sedilia" and str(other.id) != "credence" and str(other.id) != "reredos" and str(other.id) != "predella" and str(other.id) != "dossal" and str(other.id) != "retable" and str(other.id) != "tester" and str(other.id) != "riddel" and str(other.id) != "frontal" and str(other.id) != "pall" and str(other.id) != "herse" and str(other.id) != "catafalque" and str(other.id) != "bier" and str(other.id) != "cerecloth" and str(other.id) != "hearse" and str(other.id) != "shroud" and str(other.id) != "pyre" and str(other.id) != "cenotaph" and str(other.id) != "winding" and str(other.id) != "charnel" and str(other.id) != "sepulchre" and str(other.id) != "vault" and str(other.id) != "cairn" and str(other.id) != "columbarium":
			return "the piscina reuses the %s warden cell" % other.id
		if _ring_key(floor) == _ring_key(other) and str(other.id) != "feretory" and str(other.id) != "chantry" and str(other.id) != "sacristy" and str(other.id) != "pyx" and str(other.id) != "aumbry" and str(other.id) != "sedilia" and str(other.id) != "credence" and str(other.id) != "reredos" and str(other.id) != "predella" and str(other.id) != "dossal" and str(other.id) != "retable" and str(other.id) != "tester" and str(other.id) != "riddel" and str(other.id) != "frontal" and str(other.id) != "pall" and str(other.id) != "herse" and str(other.id) != "catafalque" and str(other.id) != "bier" and str(other.id) != "cerecloth" and str(other.id) != "hearse" and str(other.id) != "shroud" and str(other.id) != "pyre" and str(other.id) != "cenotaph" and str(other.id) != "winding" and str(other.id) != "charnel" and str(other.id) != "sepulchre" and str(other.id) != "vault" and str(other.id) != "cairn" and str(other.id) != "columbarium":
			return "the piscina reuses the %s ring" % other.id
	var path: Array = Rules.shortest_path_cells(floor)
	var aumbry_path: Array = Rules.shortest_path_cells(aumbry)
	var chantry_path: Array = Rules.shortest_path_cells(chantry)
	if path.size() != aumbry_path.size() or path.size() != chantry_path.size() or path.size() != 20:
		return "the 19-step path cells changed"
	for i in path.size():
		if path[i] != aumbry_path[i] or path[i] != chantry_path[i]:
			return "the 19-step path moved at %s" % path[i]
	if path.has(Vector2i(30, 16)) or path.has(Vector2i(5, 12)) or path.has(Vector2i(28, 15)) or path.has(Vector2i(2, 1)) or path.has(Vector2i(4, 12)):
		return "an oil cell sits on the 19-step path"
	var swings: Array = Rules.swing_tiles(floor)
	if swings.size() != 2 or swings[0] != east or swings[1] != west:
		return "the warden should telegraph the east tile, then the west tile"
	for swing in swings:
		if not Rules.is_corridor_cell(swing, floor):
			return "swing tile %s is not an open corridor" % swing
	var bumper = Rules.new_run(Rules.SMALL_FLASK_OIL, floor)
	bumper.pos = Vector2i(6, 4)
	var before_oil: int = bumper.oil
	var tap: Dictionary = Rules.step(bumper, Vector2i(1, 0))
	if bool(tap.moved) or bumper.oil != before_oil:
		return "bumping the piscina spent oil or moved"
	if int(bumper.marks.get(Vector2i(7, 4), Rules.Mark.NONE)) != Rules.Mark.WALL:
		return "bumping the piscina did not ink a wall"
	if str(tap.message).find("piscina") < 0:
		return "bumping the piscina did not name it"
	if str(tap.message).find("aumbry") >= 0 or str(tap.message).find("pyx") >= 0 or str(tap.message).find("sacristy") >= 0:
		return "bumping the piscina named another floor"
	var facing = Rules.new_run(Rules.SMALL_FLASK_OIL, floor)
	facing.pos = Vector2i(6, 4)
	facing.facing = Rules.facing_from_vector(Vector2i(1, 0))
	if Rules.ahead_line(facing).find("the piscina") < 0:
		return "facing the piscina did not name it"
	facing.pos = Vector2i(1, 2)
	facing.facing = Rules.facing_from_vector(Vector2i(0, 1))
	if Rules.ahead_line(facing).find("piscina crack") < 0:
		return "facing a piscina crack did not name it"
	var steps := Rules.shortest_path_steps(floor)
	if steps != 19:
		return "shortest piscina path is %d, expected 19" % steps
	var cover := Rules.safe_survey_steps(floor)
	if cover != 120:
		return "safe survey is %d, expected 120" % cover
	var column_only := Rules.Floor.new()
	var column_rows := PackedStringArray()
	for i in floor.rows.size():
		var column_row := str(floor.rows[i])
		if i == 12:
			column_row = column_row.left(5) + "H" + column_row.substr(6)
		if i == 15:
			column_row = column_row.left(28) + "#" + column_row.substr(29)
		column_rows.append(column_row)
	column_only.rows = column_rows
	if Rules.glyph_at(Vector2i(30, 16), column_only) != "H" or Rules.glyph_at(Vector2i(5, 12), column_only) != "H" or Rules.glyph_at(Vector2i(28, 15), column_only) != "#":
		return "the column-only sheet did not keep only the new crack"
	if Rules.shortest_path_cells(column_only) != path:
		return "the new crack changed the path"
	if Rules.safe_survey_steps(column_only) != 122:
		return "column-only survey is %d, expected 122" % Rules.safe_survey_steps(column_only)
	if Rules.hazard_cells(column_only).size() != 29 or Rules.corridor_cells(column_only).size() != 71:
		return "column-only counts drifted"
	var closed_six := Rules.Floor.new()
	var six_rows := PackedStringArray()
	for i in column_only.rows.size():
		var six_row := str(column_only.rows[i])
		if i == 12:
			six_row = six_row.left(6) + "#" + six_row.substr(7)
		six_rows.append(six_row)
	closed_six.rows = six_rows
	if Rules.safe_survey_steps(closed_six) != 126 or Rules.shortest_path_cells(closed_six) != path:
		return "closing (6,12) surveys at %d" % Rules.safe_survey_steps(closed_six)
	var reopened := Rules.Floor.new()
	var reopened_rows := PackedStringArray()
	for i in column_only.rows.size():
		var reopened_row := str(column_only.rows[i])
		if i == 1:
			reopened_row = reopened_row.left(2) + "." + reopened_row.substr(3)
		reopened_rows.append(reopened_row)
	reopened.rows = reopened_rows
	if Rules.safe_survey_steps(reopened) != 124 or Rules.shortest_path_cells(reopened) != path:
		return "reopening (2,1) surveys at %d, expected 124" % Rules.safe_survey_steps(reopened)
	var reopened_four := Rules.Floor.new()
	var four_rows := PackedStringArray()
	for i in column_only.rows.size():
		var four_row := str(column_only.rows[i])
		if i == 12:
			four_row = four_row.left(4) + "." + four_row.substr(5)
		four_rows.append(four_row)
	reopened_four.rows = four_rows
	if Rules.safe_survey_steps(reopened_four) != 124 or Rules.shortest_path_cells(reopened_four) != path:
		return "reopening (4,12) surveys at %d, expected 124" % Rules.safe_survey_steps(reopened_four)
	var closed_passage := Rules.Floor.new()
	var passage_rows := PackedStringArray()
	for i in column_only.rows.size():
		var passage_row := str(column_only.rows[i])
		if i == 3:
			passage_row = passage_row.left(22) + "#" + passage_row.substr(23)
		passage_rows.append(passage_row)
	closed_passage.rows = passage_rows
	if Rules.safe_survey_steps(closed_passage) != 132 or Rules.shortest_path_cells(closed_passage) != path:
		return "closing the open cell (22,3) surveys at %d, expected 132" % Rules.safe_survey_steps(closed_passage)
	var closed_five := Rules.Floor.new()
	var five_rows := PackedStringArray()
	for i in column_only.rows.size():
		var five_row := str(column_only.rows[i])
		if i == 12:
			five_row = five_row.left(5) + "#" + five_row.substr(6)
		five_rows.append(five_row)
	closed_five.rows = five_rows
	if Rules.safe_survey_steps(closed_five) != 120 or Rules.hazard_cells(closed_five).size() != 28 or Rules.shortest_path_cells(closed_five) != path:
		return "closing (5,12) surveys at %d with %d cracks" % [Rules.safe_survey_steps(closed_five), Rules.hazard_cells(closed_five).size()]
	var full: int = int(Rules.payout(Rules.accurate_sheet(floor), floor).total)
	var arithmetic := 71 * 3 + 29 * 8 + 15
	if full != arithmetic or full != 460:
		return "full pay %d does not match 71 x 3 + 29 x 8 + 15" % full
	if int(Rules.payout(Rules.accurate_sheet(aumbry), aumbry).total) != 452:
		return "the aumbry sheet changed"
	if Rules.safe_survey_steps(aumbry) != 120 or Rules.shortest_path_steps(aumbry) != 19 or Rules.shortest_path_cells(aumbry) != path:
		return "the aumbry survey or path changed"
	if Rules.width(aumbry) != 31 or Rules.glyph_at(Vector2i(7, 4), aumbry) != "Z":
		return "the aumbry glyph or size changed"
	if Rules.glyph_at(Vector2i(5, 12), aumbry) != "H" or Rules.glyph_at(Vector2i(4, 12), aumbry) != "#" or Rules.glyph_at(Vector2i(28, 15), aumbry) != "#":
		return "the aumbry oil cells changed"
	if Rules.glyph_at(Vector2i(6, 12), aumbry) != "." or Rules.glyph_at(Vector2i(2, 1), aumbry) != "#":
		return "the aumbry gallery changed"
	print("  piscina shortest %d  survey %d  column %d  close612 %d  reopen21 %d  reopen412 %d  close223 %d  close512 %d  full %d" % [steps, cover, Rules.safe_survey_steps(column_only), Rules.safe_survey_steps(closed_six), Rules.safe_survey_steps(reopened), Rules.safe_survey_steps(reopened_four), Rules.safe_survey_steps(closed_passage), Rules.safe_survey_steps(closed_five), full])
	return ""


func _piscina_ring(floor) -> String:
	var cells: Array = Rules.loop_cells(floor)
	if cells.size() != 44:
		return "ring size %d" % cells.size()
	var have := {}
	for cell in cells:
		if have.has(cell):
			return "duplicate ring tile %s" % cell
		have[cell] = true
		if Rules.glyph_at(cell, floor) != "." or not Rules.is_corridor_cell(cell, floor):
			return "ring tile %s is not an open corridor" % cell
		if cell == Rules.enemy_pos(floor):
			return "ring tile %s is the warden" % cell
	for cell in cells:
		var degree := 0
		for dir in Rules.cardinals():
			if have.has(cell + dir):
				degree += 1
		if degree != 2:
			return "ring tile %s has %d neighbors in the ring" % [cell, degree]
	if str(floor.loop_name) != "Piscina ring":
		return "ring name is %s" % floor.loop_name
	return ""


func _piscina_census() -> String:
