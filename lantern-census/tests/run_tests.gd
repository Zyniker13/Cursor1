func _columbarium_return() -> String:
	var game_script = load("res://scripts/game.gd")
	var select_script = load("res://scripts/floor_select_view.gd")
	if game_script == null or select_script == null:
		return "game or floor select did not load"
	if float(select_script.WINDOW_W) != 4044.0:
		return "floor select window width is %s" % select_script.WINDOW_W
	var game = game_script.new()
	root.add_child(game)
	if game.town == null or game.floor_select == null or game.descent == null:
		game.free()
		return "the game did not build its screens"
	if game.floor_select.record_for("columbarium") != Rules.COLUMBARIUM_RECORD:
		game.free()
		return "floor select does not offer the columbarium census"
	if Rules.floor_named("columbarium").title != "The Columbarium":
		game.free()
		return "floor select does not name the Columbarium"
	if Rules.floors().size() != 53:
		game.free()
		return "floor select does not list fifty-three floors"
	var cairn_card: Control = game.floor_select._record["cairn"].get_parent()
	var card: Control = game.floor_select._record["columbarium"].get_parent()
	var cairn_rect := Rect2(cairn_card.position, cairn_card.size)
	var card_rect := Rect2(card.position, card.size)
	if card_rect.intersects(cairn_rect):
		game.free()
		return "the columbarium card covers the cairn card"
	if absf(card_rect.position.x - (cairn_rect.position.x + cairn_rect.size.x + 8.0)) > 0.5:
		game.free()
		return "the columbarium card is not immediately to the right of the cairn"
	var window_w: float = select_script.WINDOW_W
	if card_rect.position.x + card_rect.size.x > window_w + 0.5:
		game.free()
		return "the columbarium card sits outside the window"
	if card_rect.position.x < 12.0 or window_w - (card_rect.position.x + card_rect.size.x) < 11.5:
		game.free()
		return "the columbarium card has no spare at the window edge"
	var saw := {}
	var previous: Control = null
	for listed in Rules.floors():
		var listed_card: Control = game.floor_select._record[listed.id].get_parent()
		var listed_rect := Rect2(listed_card.position, listed_card.size)
		if listed_rect.position.x < 0.0 or listed_rect.position.x + listed_rect.size.x > window_w + 0.5:
			game.free()
			return "the %s card sits outside the window" % listed.title
		if listed_rect.position.y < 0.0 or listed_rect.position.y + listed_rect.size.y > 720.0:
			game.free()
			return "the %s card is clipped by the window height" % listed.title
		if previous != null and listed_rect.intersects(Rect2(previous.position, previous.size)):
			game.free()
			return "the %s card covers another card" % listed.title
		var heading: Label = listed_card.get_child(2)
		if heading == null or heading.text != listed.title:
			game.free()
			return "the %s card title is missing" % listed.title
		for glyph_i in heading.text.length():
			var glyph := heading.text.substr(glyph_i, 1)
			if glyph == " ":
				continue
			var glyph_bounds := heading.get_character_bounds(glyph_i)
			if glyph_bounds.size.x <= 0.0 or glyph_bounds.position.y + glyph_bounds.size.y > heading.size.y + 0.01 or glyph_bounds.position.x + glyph_bounds.size.x > heading.size.x + 0.01:
				game.free()
				return "the %s title hides %s" % [listed.title, glyph]
		saw[listed.title] = true
		previous = listed_card
	for title in ["The Scriptorium", "The Ambulatory", "The Chevet", "The Retrochoir", "The Lady Chapel", "The Feretory", "The Chantry", "The Sacristy", "The Pyx Chamber", "The Aumbry", "The Piscina", "The Sedilia", "The Credence", "The Reredos", "The Predella", "The Dossal", "The Retable", "The Tester", "The Riddel", "The Frontal", "The Pall", "The Herse", "The Catafalque", "The Bier", "The Cerecloth", "The Hearse", "The Shroud", "The Pyre", "The Cenotaph", "The Winding", "The Charnel", "The Sepulchre", "The Vault", "The Cairn", "The Columbarium"]:
		if not saw.has(title):
			game.free()
			return "the floor select is missing %s" % title
	var narrow_w := (4043.0 - 24.0 - 8.0 * 52.0) / 53.0
	var narrow_heading := narrow_w - 8.0
	var probe := Label.new()
	probe.add_theme_font_size_override("font_size", 9)
	probe.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	probe.clip_text = true
	probe.size = Vector2(narrow_heading, 44)
	game.add_child(probe)
	probe.text = "The Columbarium"
	if probe.get_character_bounds(probe.text.length() - 1).size.x > 0.0:
		probe.free()
		game.free()
		return "4043 already shows the last letter of The Columbarium, so 4044 is not the smallest width"
	probe.free()
	game._on_descend_floor("columbarium")
	if game.descent.state == null or game.descent.state.floor.id != "columbarium":
		game.free()
		return "descend did not open the columbarium"
	var state = game.descent.state
	state.marks = Rules.accurate_sheet(state.floor)
	var lift: Vector2i = Rules.lift_pos(state.floor)
	var approach: Vector2i = Rules.walkable_approach(lift, state.floor)
	state.pos = approach
	state.oil = 5
	var done: Dictionary = Rules.step(state, lift - approach)
	if not bool(done.extracted) or not Rules.census_accepted(state.marks, state.floor):
		game.free()
		return "the finished sheet did not extract as an accepted census"
	game.descent._open_return()
	if game.descent.return_button.text != "Return to floor select":
		game.free()
		return "a finished census did not offer the floor select"
	game._on_return(state)
	if not game.floor_select.visible or game.town.visible or game.descent.visible:
		game.free()
		return "a finished census did not return to the floor select"
	if not bool(game.campaign.completed.get("columbarium", false)):
		game.free()
		return "the finished census was not recorded"
	if bool(game.campaign.completed.get("cairn", false)):
		game.free()
		return "the finished columbarium census also closed the cairn"
	if int(game.campaign.last_bill.total) != 613 or game.campaign.purse < 613:
		game.free()
		return "the finished census was not paid"
	game.free()
	return ""
