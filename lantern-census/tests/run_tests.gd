func _reredos_return() -> String:
	var game_script = load("res://scripts/game.gd")
	var select_script = load("res://scripts/floor_select_view.gd")
	if game_script == null or select_script == null:
		return "game or floor select did not load"
	if float(select_script.WINDOW_W) != 4044.0:
		return "floor select window width is %s" % select_script.WINDOW_W
	var game = game_script.new()
	root.add_child(game)
	if game.town == null or game.floor_select == null or game.descent == null:
		game.free()
		return "the game did not build its screens"
	if game.floor_select.record_for("reredos") != Rules.REREDOS_RECORD:
		game.free()
		return "floor select does not offer the reredos census"
	if Rules.floor_named("reredos").title != "The Reredos":
		game.free()
		return "floor select does not name the Reredos"
	if Rules.floors().size() != 53:
		game.free()
		return "floor select does not list fifty-three floors"
	var credence_card: Control = game.floor_select._record["credence"].get_parent()
	var reredos_card: Control = game.floor_select._record["reredos"].get_parent()
	var credence_rect := Rect2(credence_card.position, credence_card.size)
	var reredos_rect := Rect2(reredos_card.position, reredos_card.size)
	if reredos_rect.intersects(credence_rect):
		game.free()
		return "the reredos card covers the credence card"
	if absf(reredos_rect.position.x - (credence_rect.position.x + credence_rect.size.x + 8.0)) > 0.5:
		game.free()
		return "the reredos card is not immediately to the right of the credence"
	var window_w: float = select_script.WINDOW_W
	if reredos_rect.position.x + reredos_rect.size.x > window_w + 0.5:
		game.free()
		return "the reredos card sits outside the window"
	var saw := {}
	var previous: Control = null
	for listed in Rules.floors():
		var card: Control = game.floor_select._record[listed.id].get_parent()
		var card_rect := Rect2(card.position, card.size)
		if card_rect.position.x < 0.0 or card_rect.position.x + card_rect.size.x > window_w + 0.5:
			game.free()
			return "the %s card sits outside the window" % listed.title
		if card_rect.position.y < 0.0 or card_rect.position.y + card_rect.size.y > 720.0:
			game.free()
			return "the %s card is clipped by the window height" % listed.title
		if previous != null and card_rect.intersects(Rect2(previous.position, previous.size)):
			game.free()
			return "the %s card covers another card" % listed.title
		var heading: Label = card.get_child(2)
		if heading == null or heading.text != listed.title:
			game.free()
			return "the %s card title is missing" % listed.title
		for glyph_i in heading.text.length():
			var glyph := heading.text.substr(glyph_i, 1)
			if glyph == " ":
				continue
			var glyph_bounds := heading.get_character_bounds(glyph_i)
			if glyph_bounds.size.x <= 0.0 or glyph_bounds.position.y + glyph_bounds.size.y > heading.size.y + 0.01 or glyph_bounds.position.x + glyph_bounds.size.x > heading.size.x + 0.01:
				game.free()
				return "the %s title hides %s" % [listed.title, glyph]
		saw[listed.title] = true
		previous = card
	for title in ["The Scriptorium", "The Ambulatory", "The Chevet", "The Retrochoir", "The Lady Chapel", "The Feretory", "The Chantry", "The Sacristy", "The Pyx Chamber", "The Aumbry", "The Piscina", "The Sedilia", "The Credence"]:
		if not saw.has(title):
			game.free()
			return "the floor select is missing %s" % title
	var narrow_w := (2191.0 - 24.0 - 8.0 * 31.0) / 32.0
	var narrow_heading := narrow_w - 8.0
	var probe := Label.new()
	probe.add_theme_font_size_override("font_size", 9)
	probe.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	probe.clip_text = true
	probe.size = Vector2(narrow_heading, 44)
	game.add_child(probe)
	probe.text = "The Scriptorium"
	if probe.get_character_bounds(probe.text.length() - 1).size.x > 0.0:
		probe.free()
		game.free()
		return "2191 already shows the last letter of The Scriptorium, so 2192 is not the smallest width"
	probe.text = "The Ambulatory"
	if probe.get_character_bounds(probe.text.length() - 1).size.x > 0.0:
		probe.free()
		game.free()
		return "2191 already shows the last letter of The Ambulatory, so 2192 is not the smallest width"
	probe.free()
	game._on_descend_floor("reredos")
	if game.descent.state == null or game.descent.state.floor.id != "reredos":
		game.free()
		return "descend did not open the reredos"
	var state = game.descent.state
	state.marks = Rules.accurate_sheet(state.floor)
	var lift: Vector2i = Rules.lift_pos(state.floor)
	var approach: Vector2i = Rules.walkable_approach(lift, state.floor)
	state.pos = approach
	state.oil = 5
	var done: Dictionary = Rules.step(state, lift - approach)
	if not bool(done.extracted) or not Rules.census_accepted(state.marks, state.floor):
		game.free()
		return "the finished sheet did not extract as an accepted census"
	game.descent._open_return()
	if game.descent.return_button.text != "Return to floor select":
		game.free()
		return "a finished census did not offer the floor select"
	game._on_return(state)
	if not game.floor_select.visible or game.town.visible or game.descent.visible:
		game.free()
		return "a finished census did not return to the floor select"
	if not bool(game.campaign.completed.get("reredos", false)):
		game.free()
		return "the finished census was not recorded"
	if bool(game.campaign.completed.get("credence", false)):
		game.free()
		return "the finished reredos census also closed the credence"
	if int(game.campaign.last_bill.total) != 475 or game.campaign.purse < 475:
		game.free()
		return "the finished census was not paid"
	game.free()
	return ""

func _predella_layout() -> String:
	if Rules.CORRIDOR_VALUE != 3 or Rules.HAZARD_VALUE != 8 or Rules.LOOP_VALUE != 15:
		return "payout rates changed"
	if Rules.MOVE_OIL != 1 or Rules.HIT_OIL != 3:
		return "oil costs changed"
	if Rules.SMALL_FLASK_OIL != 24 or Rules.LARGE_FLASK_OIL != 120 or Rules.LARGE_FLASK_COST != 40:
		return "flask sizes changed"
	var floor = Rules.floor_named("predella")
	if floor == null:
		return "predella floor is missing"
	if floor.record != Rules.PREDELLA_RECORD:
		return "predella record drifted from its constant"
	if Rules.PREDELLA_RECORD != "Record every corridor, the thirty-three predella cracks, and the ring around the predella.":
		return "the predella no longer asks for the predella cracks and the ring"
	if Rules.width(floor) != 36 or Rules.height(floor) != 21:
		return "predella sheet is %d by %d" % [Rules.width(floor), Rules.height(floor)]
	var mark_count := 0
	for row in floor.rows:
		mark_count += str(row).count("[")
		if str(row).find("<") >= 0:
			return "the predella sheet still uses the reredos glyph"
	if mark_count != 84:
		return "the predella block is not 14 by 6"
	for other in Rules.floors():
		if other.id == floor.id:
			continue
		for row in other.rows:
			if str(row).find("[") >= 0:
				return "glyph [ is already used on %s" % other.id
	var reredos = Rules.floor_named("reredos")
	var credence = Rules.floor_named("credence")
	var sedilia = Rules.floor_named("sedilia")
	if reredos == null or credence == null or sedilia == null:
		return "an earlier floor is missing"
	if Rules.glyph_at(Vector2i(7, 4), reredos) != "<":
		return "< is no longer the reredos"
	if Rules.glyph_at(Vector2i(7, 4), floor) != "[":
		return "[ is not the predella"
	if Rules.start_pos(floor) != Vector2i(1, 1) or Rules.lift_pos(floor) != Vector2i(10, 11) or Rules.enemy_pos(floor) != Vector2i(9, 12):
		return "start, lift, or warden moved"
	if Rules.glyph_at(Vector2i(29, 15), floor) != "H":
		return "the new crack is not (29,15)"
	if Rules.glyph_at(Vector2i(33, 16), floor) != "H" or Rules.glyph_at(Vector2i(28, 15), floor) != "H" or Rules.glyph_at(Vector2i(32, 16), floor) != "H":
		return "a carried crack was closed"
	if Rules.glyph_at(Vector2i(8, 10), floor) != "#":
		return "(8,10) was left open"
	if Rules.glyph_at(Vector2i(9, 10), floor) != "#" or Rules.glyph_at(Vector2i(10, 12), floor) != "#" or Rules.glyph_at(Vector2i(6, 12), floor) != "#" or Rules.glyph_at(Vector2i(5, 12), floor) != "#" or Rules.glyph_at(Vector2i(4, 12), floor) != "#" or Rules.glyph_at(Vector2i(25, 2), floor) != "#" or Rules.glyph_at(Vector2i(3, 12), floor) != "#" or Rules.glyph_at(Vector2i(2, 1), floor) != "#" or Rules.glyph_at(Vector2i(3, 1), floor) != "#":
		return "a carried closure was reopened"
	if Rules.glyph_at(Vector2i(21, 4), floor) != "." or Rules.glyph_at(Vector2i(7, 10), floor) != ".":
		return "a kept ring tile was closed"
	if Rules.glyph_at(Vector2i(8, 12), floor) != "." or Rules.is_walkable(Vector2i(10, 12), floor):
		return "a swing moved"
	var hazards := Rules.hazard_cells(floor)
	if hazards.size() != 33:
		return "expected thirty-three predella cracks, found %d" % hazards.size()
	if not hazards.has(Vector2i(29, 15)) or not hazards.has(Vector2i(33, 16)):
		return "the crack set drifted"
	if Rules.corridor_cells(floor).size() != 67:
		return "corridors %d" % Rules.corridor_cells(floor).size()
	var ring_err := _predella_ring(floor)
	if ring_err != "":
		return ring_err
	for other in Rules.floors():
		if other.id == floor.id:
			continue
		if floor.rows == other.rows:
			return "the predella copies %s" % other.id
		if Rules.width(floor) == Rules.width(other) and Rules.height(floor) == Rules.height(other):
			return "the predella reuses the %s grid" % other.id
		if Rules.enemy_pos(floor) == Rules.enemy_pos(other) and str(other.id) != "font" and str(other.id) != "apse" and str(other.id) != "choir" and str(other.id) != "rood" and str(other.id) != "crossing" and str(other.id) != "transept" and str(other.id) != "ambulatory" and str(other.id) != "chevet" and str(other.id) != "retrochoir" and str(other.id) != "ladychapel" and str(other.id) != "feretory" and str(other.id) != "chantry" and str(other.id) != "sacristy" and str(other.id) != "pyx" and str(other.id) != "aumbry" and str(other.id) != "piscina" and str(other.id) != "sedilia" and str(other.id) != "credence" and str(other.id) != "reredos" and str(other.id) != "dossal" and str(other.id) != "retable" and str(other.id) != "tester" and str(other.id) != "riddel" and str(other.id) != "frontal" and str(other.id) != "pall" and str(other.id) != "herse" and str(other.id) != "catafalque" and str(other.id) != "bier" and str(other.id) != "cerecloth" and str(other.id) != "hearse" and str(other.id) != "shroud" and str(other.id) != "pyre" and str(other.id) != "cenotaph" and str(other.id) != "winding" and str(other.id) != "charnel" and str(other.id) != "sepulchre" and str(other.id) != "vault" and str(other.id) != "cairn" and str(other.id) != "columbarium":
			return "the predella reuses the %s warden cell" % other.id
		if _ring_key(floor) == _ring_key(other):
			return "the predella reuses the %s ring" % other.id
	var path: Array = Rules.shortest_path_cells(floor)
	var reredos_path: Array = Rules.shortest_path_cells(reredos)
	if path.size() != 20 or path.size() != reredos_path.size():
		return "the 19-step path cells changed"
	for i in path.size():
		if path[i] != reredos_path[i]:
			return "the 19-step path moved at %s" % path[i]
	if Rules.shortest_path_steps(floor) != 19:
		return "shortest predella path is %d, expected 19" % Rules.shortest_path_steps(floor)
	var cover := Rules.safe_survey_steps(floor)
	if cover != 120:
		return "safe survey is %d, expected 120" % cover
	if cover > Rules.LARGE_FLASK_OIL:
		return "large flask cannot finish the predella"
	var crack_only := Rules.Floor.new()
	var crack_rows := PackedStringArray()
	for i in floor.rows.size():
		var crack_row := str(floor.rows[i])
		if i == 10:
			crack_row = crack_row.left(8) + "." + crack_row.substr(9)
		crack_rows.append(crack_row)
	crack_only.rows = crack_rows
	if Rules.glyph_at(Vector2i(29, 15), crack_only) != "H" or Rules.glyph_at(Vector2i(8, 10), crack_only) != ".":
		return "the crack-only sheet did not keep only the new crack"
	if Rules.shortest_path_cells(crack_only) != path:
		return "the new crack changed the path"
	if Rules.safe_survey_steps(crack_only) != 120:
		return "crack-only survey is %d, expected 120" % Rules.safe_survey_steps(crack_only)
	if Rules.hazard_cells(crack_only).size() != 33 or Rules.corridor_cells(crack_only).size() != 68:
		return "crack-only counts drifted"
	var tip := Rules.Floor.new()
	var tip_rows := PackedStringArray()
	for i in floor.rows.size():
		var tip_row := str(floor.rows[i])
		if i == 10:
			tip_row = tip_row.left(8) + "." + tip_row.substr(9)
		if i == 15:
			tip_row = tip_row.left(29) + "#" + tip_row.substr(30)
		if i == 16:
			tip_row = tip_row.left(34) + "H" + tip_row.substr(35)
		tip_rows.append(tip_row)
	tip.rows = tip_rows
	if Rules.glyph_at(Vector2i(34, 16), tip) != "H" or Rules.glyph_at(Vector2i(29, 15), tip) != "#" or Rules.glyph_at(Vector2i(8, 10), tip) != ".":
		return "the new-column crack sheet was not built"
	if Rules.safe_survey_steps(tip) != 122 or Rules.shortest_path_cells(tip) != path:
		return "new-column crack surveys at %d" % Rules.safe_survey_steps(tip)
	var tip_closed := Rules.Floor.new()
	var closed_rows := PackedStringArray()
	for i in tip.rows.size():
		var closed_row := str(tip.rows[i])
		if i == 10:
			closed_row = closed_row.left(8) + "#" + closed_row.substr(9)
		closed_rows.append(closed_row)
	tip_closed.rows = closed_rows
	if Rules.safe_survey_steps(tip_closed) != 122 or Rules.shortest_path_cells(tip_closed) != path:
		return "closing (8,10) on the new-column crack surveys at %d" % Rules.safe_survey_steps(tip_closed)
	var tip_spur := Rules.Floor.new()
	var spur_rows := PackedStringArray()
	for i in tip.rows.size():
		var spur_row := str(tip.rows[i])
		if i == 4:
			spur_row = spur_row.left(21) + "#" + spur_row.substr(22)
		spur_rows.append(spur_row)
	tip_spur.rows = spur_rows
	if Rules.safe_survey_steps(tip_spur) != 120 or Rules.shortest_path_cells(tip_spur) != path:
		return "closing (21,4) on the new-column crack surveys at %d" % Rules.safe_survey_steps(tip_spur)
	if Rules.safe_survey_steps(reredos) != 120 or Rules.corridor_cells(reredos).size() != 68 or Rules.hazard_cells(reredos).size() != 32:
		return "the reredos solution changed"
	if Rules.safe_survey_steps(credence) != 120 or Rules.corridor_cells(credence).size() != 69 or Rules.hazard_cells(credence).size() != 31:
		return "the credence solution changed"
	if Rules.safe_survey_steps(sedilia) != 120 or Rules.corridor_cells(sedilia).size() != 70 or Rules.hazard_cells(sedilia).size() != 30:
		return "the sedilia solution changed"
	var reredos_bill: Dictionary = Rules.payout(Rules.accurate_sheet(reredos), reredos)
	var credence_bill: Dictionary = Rules.payout(Rules.accurate_sheet(credence), credence)
	var sedilia_bill: Dictionary = Rules.payout(Rules.accurate_sheet(sedilia), sedilia)
	if int(reredos_bill.total) != 475 or int(credence_bill.total) != 470 or int(sedilia_bill.total) != 465:
		return "an earlier payout changed"
	var bumper = Rules.new_run(Rules.SMALL_FLASK_OIL, floor)
	bumper.pos = Vector2i(6, 4)
	var before_oil: int = bumper.oil
	var tap: Dictionary = Rules.step(bumper, Vector2i(1, 0))
	if bool(tap.moved) or bumper.oil != before_oil:
		return "bumping the predella spent oil or moved"
	if int(bumper.marks.get(Vector2i(7, 4), Rules.Mark.NONE)) != Rules.Mark.WALL:
		return "bumping the predella did not ink a wall"
	if str(tap.message).find("predella") < 0:
		return "bumping the predella did not name it"
	var facing = Rules.new_run(Rules.SMALL_FLASK_OIL, floor)
	facing.pos = Vector2i(1, 2)
	facing.facing = Rules.facing_from_vector(Vector2i(0, 1))
	if Rules.ahead_line(facing).find("predella crack") < 0:
		return "facing a predella crack did not name it"
	print("  predella shortest 19  survey %d  corridors %d  cracks %d" % [cover, Rules.corridor_cells(floor).size(), hazards.size()])
	return ""


func _predella_ring(floor) -> String:
	var cells: Array = Rules.loop_cells(floor)
	if cells.size() != 46:
		return "ring size %d" % cells.size()
	var have := {}
	for cell in cells:
		if have.has(cell):
			return "duplicate ring tile %s" % cell
		have[cell] = true
		if cell == Vector2i(8, 10) or cell == Vector2i(9, 10):
			return "closed ring tile %s is still on the ring" % cell
		if cell == Rules.lift_pos(floor):
			if Rules.glyph_at(cell, floor) != "L" or not Rules.is_corridor_cell(cell, floor):
				return "the lift is not the ring's corridor"
		elif Rules.glyph_at(cell, floor) != "." or not Rules.is_corridor_cell(cell, floor):
			return "ring tile %s is not an open corridor" % cell
		if cell == Rules.enemy_pos(floor):
			return "ring tile %s is the warden" % cell
	for cell in cells:
		var degree := 0
		for dir in Rules.cardinals():
			if have.has(cell + dir):
				degree += 1
		if degree != 2:
			return "ring tile %s has %d neighbors in the ring" % [cell, degree]
	if not have.has(Vector2i(7, 11)) or not have.has(Vector2i(8, 11)) or not have.has(Vector2i(21, 4)) or not have.has(Vector2i(7, 10)):
		return "the ring does not step around the closed tiles"
	if str(floor.loop_name) != "Predella ring":
		return "ring name is %s" % floor.loop_name
	var bill: Dictionary = Rules.payout(Rules.accurate_sheet(floor), floor)
	if int(bill.loop) != 1:
		return "the ring did not pay"
	return ""


