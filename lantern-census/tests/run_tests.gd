			return "the %s ring name changed" % other.title
	var approach: Vector2i = Rules.walkable_approach(crack, floor)
	if approach.x < 0:
		return "vault crack has no approach"
	var walker = Rules.new_run(Rules.SMALL_FLASK_OIL, floor)
	walker.pos = approach
	walker.oil = 10
	var before: int = walker.oil
	var stepped: Dictionary = Rules.step(walker, crack - approach)
	if bool(stepped.hit) or walker.oil != before - Rules.MOVE_OIL:
		return "a vault crack burned extra oil"
	if int(walker.marks.get(crack, Rules.Mark.NONE)) != Rules.Mark.HAZARD:
		return "a vault crack was not inked as a hazard"
	if str(stepped.message).find("vault crack") < 0:
		return "stepping on a vault crack did not name it"
	return ""


func _vault_return() -> String:
	var game_script = load("res://scripts/game.gd")
	var select_script = load("res://scripts/floor_select_view.gd")
	if game_script == null or select_script == null:
		return "game or floor select did not load"
	if float(select_script.WINDOW_W) != 4044.0:
		return "floor select window width is %s" % select_script.WINDOW_W
	var game = game_script.new()
	root.add_child(game)
	if game.town == null or game.floor_select == null or game.descent == null:
		game.free()
		return "the game did not build its screens"
	if game.floor_select.record_for("vault") != Rules.VAULT_RECORD:
		game.free()
		return "floor select does not offer the vault census"
	if Rules.floor_named("vault").title != "The Vault":
		game.free()
		return "floor select does not name the Vault"
	if Rules.floors().size() != 53:
		game.free()
		return "floor select does not list fifty-three floors"
	var sepulchre_card: Control = game.floor_select._record["sepulchre"].get_parent()
	var vault_card: Control = game.floor_select._record["vault"].get_parent()
	var sepulchre_rect := Rect2(sepulchre_card.position, sepulchre_card.size)
	var vault_rect := Rect2(vault_card.position, vault_card.size)
	if vault_rect.intersects(sepulchre_rect):
		game.free()
		return "the vault card covers the sepulchre card"
	if absf(vault_rect.position.x - (sepulchre_rect.position.x + sepulchre_rect.size.x + 8.0)) > 0.5:
		game.free()
		return "the vault card is not immediately to the right of the sepulchre"
	var window_w: float = select_script.WINDOW_W
	if vault_rect.position.x + vault_rect.size.x > window_w + 0.5:
		game.free()
		return "the vault card sits outside the window"
	if vault_rect.position.x < 12.0 or window_w - (vault_rect.position.x + vault_rect.size.x) < 11.5:
		game.free()
		return "the vault card has no spare at the window edge"
	var saw := {}
	var previous: Control = null
	for listed in Rules.floors():
		var card: Control = game.floor_select._record[listed.id].get_parent()
		var card_rect := Rect2(card.position, card.size)
		if card_rect.position.x < 0.0 or card_rect.position.x + card_rect.size.x > window_w + 0.5:
			game.free()
			return "the %s card sits outside the window" % listed.title
		if card_rect.position.y < 0.0 or card_rect.position.y + card_rect.size.y > 720.0:
			game.free()
			return "the %s card is clipped by the window height" % listed.title
		if previous != null and card_rect.intersects(Rect2(previous.position, previous.size)):
			game.free()
			return "the %s card covers another card" % listed.title
		var heading: Label = card.get_child(2)
		if heading == null or heading.text != listed.title:
			game.free()
			return "the %s card title is missing" % listed.title
		for glyph_i in heading.text.length():
			var glyph := heading.text.substr(glyph_i, 1)
			if glyph == " ":
				continue
			var glyph_bounds := heading.get_character_bounds(glyph_i)
			if glyph_bounds.size.x <= 0.0 or glyph_bounds.position.y + glyph_bounds.size.y > heading.size.y + 0.01 or glyph_bounds.position.x + glyph_bounds.size.x > heading.size.x + 0.01:
				game.free()
				return "the %s title hides %s" % [listed.title, glyph]
		saw[listed.title] = true
		previous = card
	for title in ["The Scriptorium", "The Ambulatory", "The Chevet", "The Retrochoir", "The Lady Chapel", "The Feretory", "The Chantry", "The Sacristy", "The Pyx Chamber", "The Aumbry", "The Piscina", "The Sedilia", "The Credence", "The Reredos", "The Predella", "The Dossal", "The Retable", "The Tester", "The Riddel", "The Frontal", "The Pall", "The Herse", "The Catafalque", "The Bier", "The Cerecloth", "The Hearse", "The Shroud", "The Pyre", "The Cenotaph", "The Winding", "The Charnel", "The Sepulchre", "The Vault"]:
		if not saw.has(title):
			game.free()
			return "the floor select is missing %s" % title
	var narrow_w := (3483.0 - 24.0 - 8.0 * 50.0) / 51.0
	var narrow_heading := narrow_w - 8.0
	var probe := Label.new()
	probe.add_theme_font_size_override("font_size", 9)
	probe.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	probe.clip_text = true
	probe.size = Vector2(narrow_heading, 44)
	game.add_child(probe)
	probe.text = "The Scriptorium"
	if probe.get_character_bounds(probe.text.length() - 1).size.x > 0.0:
		probe.free()
		game.free()
		return "3483 already shows the last letter of The Scriptorium, so 3484 is not the smallest width"
	probe.text = "The Ambulatory"
	if probe.get_character_bounds(probe.text.length() - 1).size.x > 0.0:
		probe.free()
		game.free()
		return "3483 already shows the last letter of The Ambulatory, so 3484 is not the smallest width"
	probe.free()
	game._on_descend_floor("vault")
	if game.descent.state == null or game.descent.state.floor.id != "vault":
		game.free()
		return "descend did not open the vault"
	var state = game.descent.state
	state.marks = Rules.accurate_sheet(state.floor)
	var lift: Vector2i = Rules.lift_pos(state.floor)
	var approach: Vector2i = Rules.walkable_approach(lift, state.floor)
	state.pos = approach
	state.oil = 5
	var done: Dictionary = Rules.step(state, lift - approach)
	if not bool(done.extracted) or not Rules.census_accepted(state.marks, state.floor):
		game.free()
		return "the finished sheet did not extract as an accepted census"
	game.descent._open_return()
	if game.descent.return_button.text != "Return to floor select":
		game.free()
		return "a finished census did not offer the floor select"
	game._on_return(state)
	if not game.floor_select.visible or game.town.visible or game.descent.visible:
		game.free()
		return "a finished census did not return to the floor select"
	if not bool(game.campaign.completed.get("vault", false)):
		game.free()
		return "the finished census was not recorded"
	if bool(game.campaign.completed.get("sepulchre", false)):
		game.free()
		return "the finished vault census also closed the sepulchre"
	if int(game.campaign.last_bill.total) != 597 or game.campaign.purse < 597:
		game.free()
		return "the finished census was not paid"
	game.free()
	return ""

func _cairn_layout() -> String:
	if Rules.CORRIDOR_VALUE != 3 or Rules.HAZARD_VALUE != 8 or Rules.LOOP_VALUE != 15:
		return "payout rates changed"
	if Rules.MOVE_OIL != 1 or Rules.HIT_OIL != 3:
		return "oil costs changed"
	if Rules.SMALL_FLASK_OIL != 24 or Rules.LARGE_FLASK_OIL != 120 or Rules.LARGE_FLASK_COST != 40:
		return "flask sizes changed"
	var floor = Rules.floor_named("cairn")
	if floor == null:
		return "cairn floor is missing"
	if floor.record != Rules.CAIRN_RECORD:
		return "cairn record drifted from its constant"
	if Rules.CAIRN_RECORD != "Record every corridor, the fifty-two cairn cracks, and the ring around the cairn.":
		return "the cairn no longer asks for the cairn cracks and the ring"
	if Rules.width(floor) != 55 or Rules.height(floor) != 21:
		return "cairn sheet is %d by %d" % [Rules.width(floor), Rules.height(floor)]
	var mark_count := 0
	for row in floor.rows:
		mark_count += str(row).count("/")
		if str(row).find("^") >= 0 or str(row).find("_") >= 0 or str(row).find("=") >= 0 or str(row).find("~") >= 0 or str(row).find("*") >= 0 or str(row).find("&") >= 0 or str(row).find("%") >= 0:
			return "the cairn sheet still uses an earlier glyph"
		if str(row).substr(str(row).length() - 1, 1) != "#":
			return "the new east column is not wall"
	if mark_count != 84:
		return "the cairn block is not 14 by 6"
	for other in Rules.floors():
		if other.id == floor.id:
			continue
		for row in other.rows:
			if str(row).find("/") >= 0:
				return "glyph slash is already used on " + str(other.id)
	var vault = Rules.floor_named("vault")
	var sepulchre = Rules.floor_named("sepulchre")
	var charnel = Rules.floor_named("charnel")
	var winding = Rules.floor_named("winding")
	var cenotaph = Rules.floor_named("cenotaph")
	var pyre = Rules.floor_named("pyre")
	var shroud = Rules.floor_named("shroud")
	var hearse = Rules.floor_named("hearse")
	var cerecloth = Rules.floor_named("cerecloth")
	var crypt = Rules.floor_named("crypt")
	var riddel = Rules.floor_named("riddel")
	var bier = Rules.floor_named("bier")
	var catafalque = Rules.floor_named("catafalque")
	var cistern = Rules.floor_named("cistern")
	var herse = Rules.floor_named("herse")
	var pall = Rules.floor_named("pall")
	var frontal = Rules.floor_named("frontal")
	if vault == null or sepulchre == null or charnel == null or winding == null or cenotaph == null or pyre == null or shroud == null or hearse == null or cerecloth == null or crypt == null or riddel == null or bier == null or catafalque == null or cistern == null or herse == null or pall == null or frontal == null:
		return "an earlier floor is missing"
	var star := Rules.find_char("*", cistern)
	if star.x < 0 or Rules.tile_at(star, cistern) != Rules.Tile.WALL:
		return "asterisk is no longer the cistern pit"
	if Rules.glyph_at(Vector2i(7, 4), bier) != "&" or Rules.tile_at(Vector2i(7, 4), bier) != Rules.Tile.WALL:
		return "ampersand is no longer the bier"
	if Rules.glyph_at(Vector2i(7, 4), catafalque) != "%" or Rules.tile_at(Vector2i(7, 4), catafalque) != Rules.Tile.WALL:
		return "percent is no longer the catafalque"
	if Rules.glyph_at(Vector2i(7, 4), vault) != "^":
		return "caret is no longer the vault"
	if Rules.glyph_at(Vector2i(7, 4), crypt) != "=":
		return "equals is no longer the crypt"
	if Rules.glyph_at(Vector2i(7, 4), riddel) != "~":
		return "tilde is no longer the riddel"
	if Rules.glyph_at(Vector2i(7, 4), sepulchre) != "_":
		return "underscore is no longer the sepulchre"
	if Rules.glyph_at(Vector2i(7, 4), floor) != "/":
		return "slash is not the cairn"
	if Rules.tile_at(Vector2i(7, 4), floor) != Rules.Tile.WALL or Rules.is_walkable(Vector2i(7, 4), floor):
		return "the cairn glyph does not ink as one wall"
	if Rules.glyph_at(Vector2i(14, 10), vault) != "." or Rules.glyph_at(Vector2i(13, 11), vault) != "#" or Rules.glyph_at(Vector2i(15, 10), vault) != "#":
		return "the vault closure moved"
	if Rules.start_pos(floor) != Vector2i(1, 1) or Rules.lift_pos(floor) != Vector2i(10, 11) or Rules.enemy_pos(floor) != Vector2i(9, 12):
		return "start, lift, or warden moved"
	if Rules.glyph_at(Vector2i(48, 15), floor) != "H":
		return "the new crack is not (48,15)"
	if Rules.glyph_at(Vector2i(47, 15), floor) != "H" or Rules.glyph_at(Vector2i(49, 15), floor) != "#":
		return "the crack is not the wall immediately east of (47,15)"
	if Rules.glyph_at(Vector2i(20, 10), floor) != "#" or Rules.glyph_at(Vector2i(21, 10), floor) != "#" or Rules.glyph_at(Vector2i(21, 9), floor) != "#" or Rules.glyph_at(Vector2i(21, 8), floor) != "#" or Rules.glyph_at(Vector2i(21, 7), floor) != "#" or Rules.glyph_at(Vector2i(21, 6), floor) != "#" or Rules.glyph_at(Vector2i(21, 5), floor) != "#" or Rules.glyph_at(Vector2i(21, 4), floor) != "#":
		return "a required closure was left open"
	if Rules.glyph_at(Vector2i(19, 10), floor) != "#" or Rules.glyph_at(Vector2i(18, 10), floor) != "#" or Rules.glyph_at(Vector2i(17, 10), floor) != "#" or Rules.glyph_at(Vector2i(16, 10), floor) != "#" or Rules.glyph_at(Vector2i(15, 10), floor) != "#" or Rules.glyph_at(Vector2i(14, 10), floor) != "#" or Rules.glyph_at(Vector2i(14, 11), floor) != "." or Rules.glyph_at(Vector2i(15, 11), floor) != "." or Rules.glyph_at(Vector2i(16, 11), floor) != "." or Rules.glyph_at(Vector2i(17, 11), floor) != "." or Rules.glyph_at(Vector2i(18, 11), floor) != "." or Rules.glyph_at(Vector2i(13, 11), floor) != ".":
		return "the closure or the detour moved"
	if Rules.glyph_at(Vector2i(21, 11), floor) != "#" or Rules.glyph_at(Vector2i(22, 10), floor) != "#" or Rules.glyph_at(Vector2i(20, 11), floor) != "#" or Rules.glyph_at(Vector2i(20, 9), floor) != "/":
		return "a wall around the walk moved"
	if Rules.glyph_at(Vector2i(10, 10), floor) != "#" or Rules.glyph_at(Vector2i(11, 11), floor) != "." or Rules.glyph_at(Vector2i(6, 11), floor) != ".":
		return "a carried opening moved"
	if Rules.glyph_at(Vector2i(7, 10), floor) != "#" or Rules.glyph_at(Vector2i(8, 10), floor) != "#" or Rules.glyph_at(Vector2i(9, 10), floor) != "#":
		return "a carried closure was reopened"
	if Rules.glyph_at(Vector2i(8, 12), floor) != "." or Rules.is_walkable(Vector2i(10, 12), floor):
		return "a swing moved"
	var hazards := Rules.hazard_cells(floor)
	if hazards.size() != 52:
		return "expected fifty-two cairn cracks, found %d" % hazards.size()
	if not hazards.has(Vector2i(48, 15)) or not hazards.has(Vector2i(47, 15)):
		return "the crack set drifted"
	if Rules.corridor_cells(floor).size() != 58:
		return "corridors %d" % Rules.corridor_cells(floor).size()
	var kept := {}
	for cell in Rules.corridor_cells(vault):
		kept[cell] = true
	for cell in Rules.corridor_cells(floor):
		if not kept.has(cell) and cell != Vector2i(13, 11):
			return "a new corridor was opened at %s" % cell
	if not kept.has(Vector2i(14, 10)) or Rules.is_corridor_cell(Vector2i(14, 10), floor):
		return "(14,10) was not closed"
	if not Rules.is_corridor_cell(Vector2i(13, 11), floor) or Rules.is_corridor_cell(Vector2i(13, 11), vault):
		return "(13,11) was not the opened detour"
	for cell in kept:
		if cell != Vector2i(14, 10) and not Rules.is_corridor_cell(cell, floor):
			return "a corridor besides (14,10) was closed at %s" % cell
	var ring_err := _cairn_ring(floor)
	if ring_err != "":
		return ring_err
	for other in Rules.floors():
		if other.id == floor.id:
			continue
		if floor.rows == other.rows:
			return "the cairn copies %s" % other.id
		if Rules.width(floor) == Rules.width(other) and Rules.height(floor) == Rules.height(other):
			return "the cairn reuses the %s grid" % other.id
		if Rules.enemy_pos(floor) == Rules.enemy_pos(other) and str(other.id) != "font" and str(other.id) != "apse" and str(other.id) != "choir" and str(other.id) != "rood" and str(other.id) != "crossing" and str(other.id) != "transept" and str(other.id) != "ambulatory" and str(other.id) != "chevet" and str(other.id) != "retrochoir" and str(other.id) != "ladychapel" and str(other.id) != "feretory" and str(other.id) != "chantry" and str(other.id) != "sacristy" and str(other.id) != "pyx" and str(other.id) != "aumbry" and str(other.id) != "piscina" and str(other.id) != "sedilia" and str(other.id) != "credence" and str(other.id) != "reredos" and str(other.id) != "predella" and str(other.id) != "dossal" and str(other.id) != "retable" and str(other.id) != "tester" and str(other.id) != "riddel" and str(other.id) != "frontal" and str(other.id) != "pall" and str(other.id) != "herse" and str(other.id) != "catafalque" and str(other.id) != "bier" and str(other.id) != "cerecloth" and str(other.id) != "hearse" and str(other.id) != "shroud" and str(other.id) != "pyre" and str(other.id) != "cenotaph" and str(other.id) != "winding" and str(other.id) != "charnel" and str(other.id) != "sepulchre" and str(other.id) != "vault" and str(other.id) != "columbarium":
			return "the cairn reuses the %s warden cell" % other.id
		if _ring_key(floor) == _ring_key(other):
			return "the cairn reuses the %s ring" % other.id
	var path: Array = Rules.shortest_path_cells(floor)
	var earlier_path: Array = Rules.shortest_path_cells(vault)
	if path.size() != 20 or path.size() != earlier_path.size():
		return "the 19-step path cells changed"
	for i in path.size():
		if path[i] != earlier_path[i]:
			return "the 19-step path moved at %s" % path[i]
	if path.has(Vector2i(48, 15)) or path.has(Vector2i(13, 11)) or path.has(Vector2i(14, 10)):
		return "the crack or the detour is on the tour"
	if Rules.shortest_path_steps(floor) != 19:
		return "shortest cairn path is %d, expected 19" % Rules.shortest_path_steps(floor)
	var cover := Rules.safe_survey_steps(floor)
	if cover != 132:
		return "safe survey is %d, expected 132" % cover
	var bare := Rules.Floor.new()
	var bare_rows := PackedStringArray()
	for i in floor.rows.size():
		var bare_row := str(floor.rows[i])
		if i == 15:
			bare_row = bare_row.left(48) + "#" + bare_row.substr(49)
		bare_rows.append(bare_row)
	bare.rows = bare_rows
	if Rules.glyph_at(Vector2i(48, 15), bare) != "#" or Rules.glyph_at(Vector2i(14, 10), bare) != "#" or Rules.glyph_at(Vector2i(13, 11), bare) != ".":
		return "the sheet without the new crack was not built"
	if Rules.safe_survey_steps(bare) != 130 or Rules.shortest_path_cells(bare) != path:
		return "removing the new crack surveys at %d" % Rules.safe_survey_steps(bare)
	var only := Rules.Floor.new()
	var only_rows := PackedStringArray()
	for i in floor.rows.size():
		var only_row := str(floor.rows[i])
		if i == 10:
			only_row = only_row.left(14) + "." + only_row.substr(15)
		if i == 11:
			only_row = only_row.left(13) + "#" + only_row.substr(14)
		only_rows.append(only_row)
	only.rows = only_rows
	if Rules.glyph_at(Vector2i(14, 10), only) != "." or Rules.glyph_at(Vector2i(13, 11), only) != "#" or Rules.glyph_at(Vector2i(48, 15), only) != "H":
		return "the crack-only sheet was not built"
	if Rules.safe_survey_steps(only) != 132 or Rules.shortest_path_cells(only) != path:
		return "adding only (48,15) surveys at %d" % Rules.safe_survey_steps(only)
	var blocked := Rules.Floor.new()
	var blocked_rows := PackedStringArray()
	for i in floor.rows.size():
		var blocked_row := str(floor.rows[i])
		if i == 11:
			blocked_row = blocked_row.left(13) + "#" + blocked_row.substr(14)
		blocked_rows.append(blocked_row)
	blocked.rows = blocked_rows
	if Rules.glyph_at(Vector2i(13, 11), blocked) != "#" or Rules.glyph_at(Vector2i(14, 10), blocked) != "#":
		return "the closed sheet without the detour was not built"
	if Rules.safe_survey_steps(blocked) != 186 or Rules.shortest_path_cells(blocked) != path:
		return "closing (14,10) without the detour surveys at %d" % Rules.safe_survey_steps(blocked)
	if Rules.safe_survey_steps(vault) != 130 or Rules.corridor_cells(vault).size() != 58 or Rules.hazard_cells(vault).size() != 51:
		return "the vault solution changed"
	if Rules.safe_survey_steps(sepulchre) != 128 or Rules.corridor_cells(sepulchre).size() != 58 or Rules.hazard_cells(sepulchre).size() != 50:
		return "the sepulchre solution changed"
	if Rules.safe_survey_steps(charnel) != 126 or Rules.corridor_cells(charnel).size() != 58 or Rules.hazard_cells(charnel).size() != 49:
		return "the charnel solution changed"
	if Rules.safe_survey_steps(winding) != 124 or Rules.corridor_cells(winding).size() != 58 or Rules.hazard_cells(winding).size() != 48:
		return "the winding solution changed"
	if Rules.safe_survey_steps(cenotaph) != 122 or Rules.corridor_cells(cenotaph).size() != 58 or Rules.hazard_cells(cenotaph).size() != 47:
		return "the cenotaph solution changed"
	if Rules.safe_survey_steps(pyre) != 120 or Rules.corridor_cells(pyre).size() != 58 or Rules.hazard_cells(pyre).size() != 46:
		return "the pyre solution changed"
	if Rules.safe_survey_steps(shroud) != 120 or Rules.corridor_cells(shroud).size() != 59 or Rules.hazard_cells(shroud).size() != 45:
		return "the shroud solution changed"
	if Rules.safe_survey_steps(hearse) != 120 or Rules.corridor_cells(hearse).size() != 60 or Rules.hazard_cells(hearse).size() != 44:
		return "the hearse solution changed"
	if Rules.safe_survey_steps(cerecloth) != 120 or Rules.corridor_cells(cerecloth).size() != 61 or Rules.hazard_cells(cerecloth).size() != 43:
		return "the cerecloth solution changed"
	if Rules.safe_survey_steps(bier) != 120 or Rules.corridor_cells(bier).size() != 62 or Rules.hazard_cells(bier).size() != 42:
		return "the bier solution changed"
	if Rules.safe_survey_steps(catafalque) != 120 or Rules.corridor_cells(catafalque).size() != 63 or Rules.hazard_cells(catafalque).size() != 41:
		return "the catafalque solution changed"
	if Rules.safe_survey_steps(herse) != 120 or Rules.corridor_cells(herse).size() != 64 or Rules.hazard_cells(herse).size() != 40:
		return "the herse solution changed"
	if Rules.safe_survey_steps(pall) != 120 or Rules.corridor_cells(pall).size() != 65 or Rules.hazard_cells(pall).size() != 39:
		return "the pall solution changed"
	if Rules.safe_survey_steps(frontal) != 120 or Rules.corridor_cells(frontal).size() != 66 or Rules.hazard_cells(frontal).size() != 38:
		return "the frontal solution changed"
	if Rules.safe_survey_steps(riddel) != 120 or Rules.corridor_cells(riddel).size() != 67 or Rules.hazard_cells(riddel).size() != 37:
		return "the riddel solution changed"
	var vault_bill: Dictionary = Rules.payout(Rules.accurate_sheet(vault), vault)
	var sepulchre_bill: Dictionary = Rules.payout(Rules.accurate_sheet(sepulchre), sepulchre)
	var charnel_bill: Dictionary = Rules.payout(Rules.accurate_sheet(charnel), charnel)
	var winding_bill: Dictionary = Rules.payout(Rules.accurate_sheet(winding), winding)
	var cenotaph_bill: Dictionary = Rules.payout(Rules.accurate_sheet(cenotaph), cenotaph)
	var pyre_bill: Dictionary = Rules.payout(Rules.accurate_sheet(pyre), pyre)
	if int(vault_bill.total) != 597 or int(sepulchre_bill.total) != 589 or int(charnel_bill.total) != 581 or int(winding_bill.total) != 573 or int(cenotaph_bill.total) != 565 or int(pyre_bill.total) != 557:
		return "an earlier payout changed"
	var bumper = Rules.new_run(Rules.SMALL_FLASK_OIL, floor)
	bumper.pos = Vector2i(6, 4)
	var before_oil: int = bumper.oil
	var tap: Dictionary = Rules.step(bumper, Vector2i(1, 0))
	if bool(tap.moved) or bumper.oil != before_oil:
		return "bumping the cairn spent oil or moved"
	if int(bumper.marks.get(Vector2i(7, 4), Rules.Mark.NONE)) != Rules.Mark.WALL:
		return "bumping the cairn did not ink a wall"
	if str(tap.message).find("cairn") < 0:
		return "bumping the cairn did not name it"
	var facing = Rules.new_run(Rules.SMALL_FLASK_OIL, floor)
	facing.pos = Vector2i(1, 2)
	facing.facing = Rules.facing_from_vector(Vector2i(0, 1))
	if Rules.ahead_line(facing).find("cairn crack") < 0:
		return "facing a cairn crack did not name it"
	print("  cairn shortest 19  survey %d  corridors %d  cracks %d" % [cover, Rules.corridor_cells(floor).size(), hazards.size()])
	return ""


func _cairn_ring(floor) -> String:
	var cells: Array = Rules.loop_cells(floor)
	if cells.size() != 32:
		return "ring size %d" % cells.size()
	var have := {}
	for cell in cells:
		if have.has(cell):
			return "duplicate ring tile %s" % cell
		have[cell] = true
		if cell == Vector2i(14, 10) or cell == Vector2i(15, 10) or cell == Vector2i(16, 10) or cell == Vector2i(17, 10) or cell == Vector2i(18, 10) or cell == Vector2i(19, 10) or cell == Vector2i(20, 10) or cell == Vector2i(21, 10) or cell == Vector2i(21, 9) or cell == Vector2i(21, 8) or cell == Vector2i(21, 7) or cell == Vector2i(21, 6) or cell == Vector2i(21, 5) or cell == Vector2i(21, 4) or cell == Vector2i(8, 10) or cell == Vector2i(9, 10) or cell == Vector2i(10, 10) or cell == Vector2i(7, 10) or cell == Vector2i(13, 11) or cell == Vector2i(14, 11) or cell == Vector2i(15, 11) or cell == Vector2i(16, 11) or cell == Vector2i(17, 11) or cell == Vector2i(18, 11):
			return "closed ring tile %s is still on the ring" % cell
		if not Rules.is_corridor_cell(cell, floor):
			return "ring tile %s is not a corridor" % cell
	var open_ends := 0
	for cell in cells:
		var degree := 0
		for dir in Rules.cardinals():
			if have.has(cell + dir):
				degree += 1
		if cell == Vector2i(21, 3) or cell == Vector2i(13, 10):
			if degree != 1:
				return "the open end %s has %d neighbors in the ring" % [cell, degree]
			open_ends += 1
		elif degree != 2:
			return "ring tile %s has %d neighbors in the ring" % [cell, degree]
	if open_ends != 2:
		return "the walk should be open between (21,3) and (13,10)"
	if not have.has(Vector2i(11, 11)) or not have.has(Vector2i(6, 11)) or not have.has(Vector2i(21, 3)) or not have.has(Vector2i(13, 10)):
		return "the ring does not keep the carried walk"
	if have.has(Vector2i(14, 10)):
		return "the ring still steps on (14,10)"
	if str(floor.loop_name) != "Cairn ring":
		return "ring name is %s" % floor.loop_name
	var bill: Dictionary = Rules.payout(Rules.accurate_sheet(floor), floor)
	if int(bill.loop) != 1 or int(bill.total) != 605:
		return "the ring did not pay %s" % bill.total
	return ""


func _cairn_census() -> String:
	var floor = Rules.floor_named("cairn")
	var truth: Dictionary = Rules.accurate_sheet(floor)
	if not Rules.census_accepted(truth, floor):
		return "the true cairn census was rejected"
	var bill: Dictionary = Rules.payout(truth, floor)
	if int(bill.corridors) != 58 or int(bill.hazards) != 52 or int(bill.loop) != 1:
		return "true counts %s/%s loop %s" % [bill.corridors, bill.hazards, bill.loop]
	if int(bill.total) != 605 or str(bill.loop_name) != "Cairn ring":
		return "full cairn payout is %s" % bill.total
	var crack: Vector2i = Vector2i(48, 15)
	var missing: Dictionary = truth.duplicate()
	missing.erase(crack)
	if Rules.census_accepted(missing, floor):
		return "a sheet missing a cairn crack was accepted"
	var mislabeled: Dictionary = truth.duplicate()
	mislabeled[crack] = Rules.Mark.CORRIDOR
	if Rules.census_accepted(mislabeled, floor):
		return "a cairn crack marked as a corridor was accepted"
	var swapped: Dictionary = truth.duplicate()
	swapped[crack] = Rules.Mark.WALL
	swapped[Vector2i(7, 4)] = Rules.Mark.HAZARD
	if Rules.census_accepted(swapped, floor):
		return "a swapped cairn sheet was accepted"
