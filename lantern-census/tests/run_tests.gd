	if Rules.glyph_at(Vector2i(29, 15), floor) != "H" or Rules.glyph_at(Vector2i(33, 16), floor) != "H" or Rules.glyph_at(Vector2i(28, 15), floor) != "H" or Rules.glyph_at(Vector2i(32, 16), floor) != "H":
		return "a carried crack was closed"
	if Rules.glyph_at(Vector2i(10, 10), floor) != "#":
		return "(10,10) was left open"
	if Rules.glyph_at(Vector2i(11, 11), floor) != ".":
		return "(11,11) was not opened for the ring"
	if Rules.glyph_at(Vector2i(8, 10), floor) != "#" or Rules.glyph_at(Vector2i(9, 10), floor) != "#" or Rules.glyph_at(Vector2i(10, 12), floor) != "#" or Rules.glyph_at(Vector2i(6, 12), floor) != "#" or Rules.glyph_at(Vector2i(5, 12), floor) != "#" or Rules.glyph_at(Vector2i(4, 12), floor) != "#" or Rules.glyph_at(Vector2i(25, 2), floor) != "#" or Rules.glyph_at(Vector2i(3, 12), floor) != "#" or Rules.glyph_at(Vector2i(2, 1), floor) != "#" or Rules.glyph_at(Vector2i(3, 1), floor) != "#":
		return "a carried closure was reopened"
	if Rules.glyph_at(Vector2i(21, 4), floor) != "." or Rules.glyph_at(Vector2i(7, 10), floor) != ".":
		return "a kept ring tile was closed"
	if Rules.glyph_at(Vector2i(24, 13), floor) != "#" or Rules.glyph_at(Vector2i(26, 14), floor) != "#":
		return "an absorbed spare crack was opened"
	if Rules.glyph_at(Vector2i(8, 12), floor) != "." or Rules.is_walkable(Vector2i(10, 12), floor):
		return "a swing moved"
	var hazards := Rules.hazard_cells(floor)
	if hazards.size() != 34:
		return "expected thirty-four dossal cracks, found %d" % hazards.size()
	if not hazards.has(Vector2i(30, 15)) or not hazards.has(Vector2i(29, 15)) or not hazards.has(Vector2i(33, 16)):
		return "the crack set drifted"
	if Rules.corridor_cells(floor).size() != 67:
		return "corridors %d" % Rules.corridor_cells(floor).size()
	var ring_err := _dossal_ring(floor)
	if ring_err != "":
		return ring_err
	for other in Rules.floors():
		if other.id == floor.id:
			continue
		if floor.rows == other.rows:
			return "the dossal copies %s" % other.id
		if Rules.width(floor) == Rules.width(other) and Rules.height(floor) == Rules.height(other):
			return "the dossal reuses the %s grid" % other.id
		if Rules.enemy_pos(floor) == Rules.enemy_pos(other) and str(other.id) != "font" and str(other.id) != "apse" and str(other.id) != "choir" and str(other.id) != "rood" and str(other.id) != "crossing" and str(other.id) != "transept" and str(other.id) != "ambulatory" and str(other.id) != "chevet" and str(other.id) != "retrochoir" and str(other.id) != "ladychapel" and str(other.id) != "feretory" and str(other.id) != "chantry" and str(other.id) != "sacristy" and str(other.id) != "pyx" and str(other.id) != "aumbry" and str(other.id) != "piscina" and str(other.id) != "sedilia" and str(other.id) != "credence" and str(other.id) != "reredos" and str(other.id) != "predella" and str(other.id) != "retable" and str(other.id) != "tester" and str(other.id) != "riddel" and str(other.id) != "frontal" and str(other.id) != "pall" and str(other.id) != "herse" and str(other.id) != "catafalque" and str(other.id) != "bier" and str(other.id) != "cerecloth" and str(other.id) != "hearse" and str(other.id) != "shroud" and str(other.id) != "pyre" and str(other.id) != "cenotaph" and str(other.id) != "winding" and str(other.id) != "charnel" and str(other.id) != "sepulchre" and str(other.id) != "vault" and str(other.id) != "cairn" and str(other.id) != "columbarium":
			return "the dossal reuses the %s warden cell" % other.id
		if _ring_key(floor) == _ring_key(other) and str(other.id) != "retable" and str(other.id) != "tester" and str(other.id) != "riddel" and str(other.id) != "frontal" and str(other.id) != "pall" and str(other.id) != "herse" and str(other.id) != "catafalque" and str(other.id) != "bier" and str(other.id) != "cerecloth" and str(other.id) != "hearse" and str(other.id) != "shroud" and str(other.id) != "pyre" and str(other.id) != "cenotaph" and str(other.id) != "winding" and str(other.id) != "charnel" and str(other.id) != "sepulchre" and str(other.id) != "vault" and str(other.id) != "cairn" and str(other.id) != "columbarium":
			return "the dossal reuses the %s ring" % other.id
	var path: Array = Rules.shortest_path_cells(floor)
	var predella_path: Array = Rules.shortest_path_cells(predella)
	if path.size() != 20 or path.size() != predella_path.size():
		return "the 19-step path cells changed"
	for i in path.size():
		if path[i] != predella_path[i]:
			return "the 19-step path moved at %s" % path[i]
	if Rules.shortest_path_steps(floor) != 19:
		return "shortest dossal path is %d, expected 19" % Rules.shortest_path_steps(floor)
	var cover := Rules.safe_survey_steps(floor)
	if cover != 120:
		return "safe survey is %d, expected 120" % cover
	if cover > Rules.LARGE_FLASK_OIL:
		return "large flask cannot finish the dossal"
	var crack_only := Rules.Floor.new()
