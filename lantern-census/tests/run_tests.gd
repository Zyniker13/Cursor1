		return "bumping the columbarium did not name it"
	var facing = Rules.new_run(Rules.SMALL_FLASK_OIL, floor)
	facing.pos = Vector2i(1, 2)
	facing.facing = Rules.facing_from_vector(Vector2i(0, 1))
	if Rules.ahead_line(facing).find("columbarium crack") < 0:
		return "facing a columbarium crack did not name it"
	print("  columbarium shortest 19  survey %d  corridors %d  cracks %d" % [cover, Rules.corridor_cells(floor).size(), hazards.size()])
	return ""
func _columbarium_ring(floor) -> String:
	var cells: Array = Rules.loop_cells(floor)
	if cells.size() != 31:
		return "ring size %d" % cells.size()
	var have := {}
	for cell in cells:
		if have.has(cell):
			return "duplicate ring tile %s" % cell
		have[cell] = true
		if cell == Vector2i(13, 10) or cell == Vector2i(14, 10) or cell == Vector2i(15, 10) or cell == Vector2i(16, 10) or cell == Vector2i(17, 10) or cell == Vector2i(18, 10) or cell == Vector2i(19, 10) or cell == Vector2i(20, 10) or cell == Vector2i(21, 10) or cell == Vector2i(21, 9) or cell == Vector2i(21, 8) or cell == Vector2i(21, 7) or cell == Vector2i(21, 6) or cell == Vector2i(21, 5) or cell == Vector2i(21, 4) or cell == Vector2i(12, 11) or cell == Vector2i(13, 11) or cell == Vector2i(14, 11) or cell == Vector2i(15, 11) or cell == Vector2i(16, 11) or cell == Vector2i(17, 11) or cell == Vector2i(18, 11):
			return "closed ring tile %s is still on the ring" % cell
		if not Rules.is_corridor_cell(cell, floor):
			return "ring tile %s is not a corridor" % cell
	var open_ends := 0
	for cell in cells:
		var degree := 0
		for dir in Rules.cardinals():
			if have.has(cell + dir):
				degree += 1
		if cell == Vector2i(21, 3) or cell == Vector2i(12, 10):
			if degree != 1:
				return "the open end %s has %d neighbors in the ring" % [cell, degree]
			open_ends += 1
		elif degree != 2:
			return "ring tile %s has %d neighbors in the ring" % [cell, degree]
	if open_ends != 2:
		return "the walk should be open between (21,3) and (12,10)"
	if not have.has(Vector2i(11, 11)) or not have.has(Vector2i(6, 11)) or not have.has(Vector2i(21, 3)) or not have.has(Vector2i(12, 10)):
		return "the ring does not keep the carried walk"
	if have.has(Vector2i(13, 10)) or have.has(Vector2i(12, 11)):
		return "the ring still steps on the closure or the detour"
	if str(floor.loop_name) != "Columbarium ring":
		return "ring name is %s" % floor.loop_name
	var bill: Dictionary = Rules.payout(Rules.accurate_sheet(floor), floor)
	if int(bill.loop) != 1 or int(bill.total) != 613:
		return "the ring did not pay %s" % bill.total
	return ""


