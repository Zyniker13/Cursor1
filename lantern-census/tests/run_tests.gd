	if Rules.glyph_at(Vector2i(2, 1), floor) != "#" or Rules.glyph_at(Vector2i(3, 1), floor) != "#":
		return "(2,1) or (3,1) was opened"
	if Rules.glyph_at(Vector2i(4, 12), floor) != "." or Rules.glyph_at(Vector2i(6, 12), floor) != ".":
