		"chantry": 431,
		"sacristy": 439,
		"pyx": 447,
		"aumbry": 452,
		"piscina": 460,
		"sedilia": 465,
		"credence": 470,
		"reredos": 475,
		"predella": 480,
		"dossal": 488,
		"retable": 496,
		"tester": 504,
		"riddel": 512,
		"frontal": 517,
		"pall": 522,
		"herse": 527,
		"catafalque": 532,
		"bier": 537,
		"cerecloth": 542,
		"hearse": 547,
		"shroud": 552,
		"pyre": 557,
		"cenotaph": 565,
		"winding": 573,
		"charnel": 581,
		"sepulchre": 589,
		"vault": 597,
		"cairn": 605,
		"columbarium": 613,
	}
	var expect_loop := {
		"cellar": "East square",
		"cistern": "Cistern ring",
		"cloister": "Cloister walk",
		"crypt": "Crypt ring",
		"ossuary": "Ossuary ring",
		"reliquary": "Reliquary ring",
		"undercroft": "Undercroft ring",
		"wellhouse": "Well ring",
		"scriptorium": "Scriptorium ring",
		"binding": "Binding ring",
		"chartroom": "Chart room ring",
