		"reredos": 475,
		"predella": 480,
		"dossal": 488,
		"retable": 496,
		"tester": 504,
		"riddel": 512,
		"frontal": 517,
		"pall": 522,
		"herse": 527,
		"catafalque": 532,
		"bier": 537,
		"cerecloth": 542,
		"hearse": 547,
