		"pall": 522,
		"herse": 527,
		"catafalque": 532,
		"bier": 537,
		"cerecloth": 542,
		"hearse": 547,
		"shroud": 552,
		"pyre": 557,
		"cenotaph": 565,
		"winding": 573,
		"sepulchre": 589,
		"vault": 597,
		"cairn": 605,
		"columbarium": 613,
	}
	var expect_loop := {
		"cellar": "East square",
		"cistern": "Cistern ring",
		"cloister": "Cloister walk",
		"crypt": "Crypt ring",
		"ossuary": "Ossuary ring",
		"reliquary": "Reliquary ring",
		"undercroft": "Undercroft ring",
		"wellhouse": "Well ring",
		"scriptorium": "Scriptorium ring",
		"binding": "Binding ring",
		"chartroom": "Chart room ring",
		"bellloft": "Bell loft ring",
		"clockroom": "Clock room ring",
		"font": "Font ring",
		"apse": "Apse ring",
		"choir": "Choir ring",
		"rood": "Rood ring",
		"crossing": "Crossing ring",
		"transept": "Transept ring",
		"ambulatory": "Ambulatory ring",
		"chevet": "Chevet ring",
		"retrochoir": "Retrochoir ring",
		"ladychapel": "Lady chapel ring",
		"feretory": "Feretory ring",
		"chantry": "Chantry ring",
		"sacristy": "Sacristy ring",
		"pyx": "Pyx ring",
		"aumbry": "Aumbry ring",
		"piscina": "Piscina ring",
		"sedilia": "Sedilia ring",
		"credence": "Credence ring",
		"reredos": "Reredos ring",
		"predella": "Predella ring",
		"dossal": "Dossal ring",
		"retable": "Retable ring",
		"tester": "Tester ring",
		"riddel": "Riddel ring",
		"frontal": "Frontal ring",
		"pall": "Pall ring",
		"herse": "Herse ring",
		"catafalque": "Catafalque ring",
		"bier": "Bier ring",
		"cerecloth": "Cerecloth ring",
		"hearse": "Hearse ring",
		"shroud": "Shroud ring",
		"pyre": "Pyre ring",
		"cenotaph": "Cenotaph ring",
		"winding": "Winding ring",
		"sepulchre": "Sepulchre ring",
		"vault": "Vault ring",
		"cairn": "Cairn ring",
		"columbarium": "Columbarium ring",
	}
	for other in Rules.floors():
		if other.id == floor.id:
			continue
		if Rules.census_accepted(truth, other):
			return "the charnel sheet was accepted as %s" % other.title
		if Rules.census_accepted(Rules.accurate_sheet(other), floor):
			return "the %s sheet was accepted as the charnel" % other.title
		if not Rules.census_accepted(Rules.accurate_sheet(other), other):
			return "the %s true census was rejected" % other.title
		var other_bill: Dictionary = Rules.payout(Rules.accurate_sheet(other), other)
		if int(other_bill.total) != int(expect_pay[other.id]):
			return "the %s payout changed to %s" % [other.title, other_bill.total]
		if str(other_bill.loop_name) != str(expect_loop[other.id]):
			return "the %s ring name changed" % other.title
	var approach: Vector2i = Rules.walkable_approach(crack, floor)
	if approach.x < 0:
		return "charnel crack has no approach"
	var walker = Rules.new_run(Rules.SMALL_FLASK_OIL, floor)
	walker.pos = approach
	walker.oil = 10
	var before: int = walker.oil
	var stepped: Dictionary = Rules.step(walker, crack - approach)
	if bool(stepped.hit) or walker.oil != before - Rules.MOVE_OIL:
		return "a charnel crack burned extra oil"
	if int(walker.marks.get(crack, Rules.Mark.NONE)) != Rules.Mark.HAZARD:
		return "a charnel crack was not inked as a hazard"
	if str(stepped.message).find("charnel crack") < 0:
		return "stepping on a charnel crack did not name it"
	return ""


func _charnel_return() -> String:
	var game_script = load("res://scripts/game.gd")
	var select_script = load("res://scripts/floor_select_view.gd")
	if game_script == null or select_script == null:
		return "game or floor select did not load"
	if float(select_script.WINDOW_W) != 4044.0:
		return "floor select window width is %s" % select_script.WINDOW_W
	var game = game_script.new()
	root.add_child(game)
	if game.town == null or game.floor_select == null or game.descent == null:
		game.free()
		return "the game did not build its screens"
	if game.floor_select.record_for("charnel") != Rules.CHARNEL_RECORD:
		game.free()
		return "floor select does not offer the charnel census"
	if Rules.floor_named("charnel").title != "The Charnel":
		game.free()
		return "floor select does not name the Charnel"
	if Rules.floors().size() != 53:
		game.free()
		return "floor select does not list fifty-three floors"
	var winding_card: Control = game.floor_select._record["winding"].get_parent()
	var charnel_card: Control = game.floor_select._record["charnel"].get_parent()
	var winding_rect := Rect2(winding_card.position, winding_card.size)
	var charnel_rect := Rect2(charnel_card.position, charnel_card.size)
	if charnel_rect.intersects(winding_rect):
		game.free()
		return "the charnel card covers the winding card"
	if absf(charnel_rect.position.x - (winding_rect.position.x + winding_rect.size.x + 8.0)) > 0.5:
		game.free()
		return "the charnel card is not immediately to the right of the winding"
	var window_w: float = select_script.WINDOW_W
	if charnel_rect.position.x + charnel_rect.size.x > window_w + 0.5:
		game.free()
		return "the charnel card sits outside the window"
	if charnel_rect.position.x < 12.0 or window_w - (charnel_rect.position.x + charnel_rect.size.x) < 11.5:
		game.free()
		return "the charnel card has no spare at the window edge"
	var saw := {}
	var previous: Control = null
	for listed in Rules.floors():
		var card: Control = game.floor_select._record[listed.id].get_parent()
		var card_rect := Rect2(card.position, card.size)
		if card_rect.position.x < 0.0 or card_rect.position.x + card_rect.size.x > window_w + 0.5:
			game.free()
			return "the %s card sits outside the window" % listed.title
		if card_rect.position.y < 0.0 or card_rect.position.y + card_rect.size.y > 720.0:
			game.free()
			return "the %s card is clipped by the window height" % listed.title
		if previous != null and card_rect.intersects(Rect2(previous.position, previous.size)):
			game.free()
			return "the %s card covers another card" % listed.title
		var heading: Label = card.get_child(2)
		if heading == null or heading.text != listed.title:
			game.free()
			return "the %s card title is missing" % listed.title
		for glyph_i in heading.text.length():
			var glyph := heading.text.substr(glyph_i, 1)
			if glyph == " ":
				continue
			var glyph_bounds := heading.get_character_bounds(glyph_i)
			if glyph_bounds.size.x <= 0.0 or glyph_bounds.position.y + glyph_bounds.size.y > heading.size.y + 0.01 or glyph_bounds.position.x + glyph_bounds.size.x > heading.size.x + 0.01:
				game.free()
				return "the %s title hides %s" % [listed.title, glyph]
		saw[listed.title] = true
		previous = card
	for title in ["The Scriptorium", "The Ambulatory", "The Chevet", "The Retrochoir", "The Lady Chapel", "The Feretory", "The Chantry", "The Sacristy", "The Pyx Chamber", "The Aumbry", "The Piscina", "The Sedilia", "The Credence", "The Reredos", "The Predella", "The Dossal", "The Retable", "The Tester", "The Riddel", "The Frontal", "The Pall", "The Herse", "The Catafalque", "The Bier", "The Cerecloth", "The Hearse", "The Shroud", "The Pyre", "The Cenotaph", "The Winding", "The Charnel"]:
		if not saw.has(title):
			game.free()
			return "the floor select is missing %s" % title
	var narrow_w := (3347.0 - 24.0 - 8.0 * 48.0) / 49.0
	var narrow_heading := narrow_w - 8.0
	var probe := Label.new()
	probe.add_theme_font_size_override("font_size", 9)
	probe.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	probe.clip_text = true
	probe.size = Vector2(narrow_heading, 44)
	game.add_child(probe)
	probe.text = "The Scriptorium"
	if probe.get_character_bounds(probe.text.length() - 1).size.x > 0.0:
		probe.free()
		game.free()
		return "3347 already shows the last letter of The Scriptorium, so 3348 is not the smallest width"
	probe.text = "The Ambulatory"
	if probe.get_character_bounds(probe.text.length() - 1).size.x > 0.0:
		probe.free()
		game.free()
		return "3347 already shows the last letter of The Ambulatory, so 3348 is not the smallest width"
	probe.free()
	game._on_descend_floor("charnel")
	if game.descent.state == null or game.descent.state.floor.id != "charnel":
		game.free()
		return "descend did not open the charnel"
	var state = game.descent.state
	state.marks = Rules.accurate_sheet(state.floor)
	var lift: Vector2i = Rules.lift_pos(state.floor)
	var approach: Vector2i = Rules.walkable_approach(lift, state.floor)
	state.pos = approach
	state.oil = 5
	var done: Dictionary = Rules.step(state, lift - approach)
	if not bool(done.extracted) or not Rules.census_accepted(state.marks, state.floor):
		game.free()
		return "the finished sheet did not extract as an accepted census"
	game.descent._open_return()
	if game.descent.return_button.text != "Return to floor select":
		game.free()
		return "a finished census did not offer the floor select"
	game._on_return(state)
	if not game.floor_select.visible or game.town.visible or game.descent.visible:
		game.free()
		return "a finished census did not return to the floor select"
	if not bool(game.campaign.completed.get("charnel", false)):
		game.free()
		return "the finished census was not recorded"
	if bool(game.campaign.completed.get("winding", false)):
		game.free()
		return "the finished charnel census also closed the winding"
	if int(game.campaign.last_bill.total) != 581 or game.campaign.purse < 581:
		game.free()
		return "the finished census was not paid"
	game.free()
	return ""

func _sepulchre_layout() -> String:
	if Rules.CORRIDOR_VALUE != 3 or Rules.HAZARD_VALUE != 8 or Rules.LOOP_VALUE != 15:
		return "payout rates changed"
	if Rules.MOVE_OIL != 1 or Rules.HIT_OIL != 3:
		return "oil costs changed"
	if Rules.SMALL_FLASK_OIL != 24 or Rules.LARGE_FLASK_OIL != 120 or Rules.LARGE_FLASK_COST != 40:
		return "flask sizes changed"
	var floor = Rules.floor_named("sepulchre")
	if floor == null:
		return "sepulchre floor is missing"
	if floor.record != Rules.SEPULCHRE_RECORD:
		return "sepulchre record drifted from its constant"
	if Rules.SEPULCHRE_RECORD != "Record every corridor, the fifty sepulchre cracks, and the ring around the sepulchre.":
		return "the sepulchre no longer asks for the sepulchre cracks and the ring"
	if Rules.width(floor) != 53 or Rules.height(floor) != 21:
		return "sepulchre sheet is %d by %d" % [Rules.width(floor), Rules.height(floor)]
	var mark_count := 0
	for row in floor.rows:
		mark_count += str(row).count("_")
		if str(row).find("-") >= 0 or str(row).find(":") >= 0 or str(row).find("'") >= 0 or str(row).find('"') >= 0:
			return "the sepulchre sheet still uses an earlier glyph"
		if str(row).substr(str(row).length() - 1, 1) != "#":
			return "the new east column is not wall"
	if mark_count != 84:
		return "the sepulchre block is not 14 by 6"
	for other in Rules.floors():
		if other.id == floor.id:
			continue
		for row in other.rows:
			if str(row).find("_") >= 0:
				return "glyph underscore is already used on " + str(other.id)
	var charnel = Rules.floor_named("charnel")
	var winding = Rules.floor_named("winding")
	var cenotaph = Rules.floor_named("cenotaph")
	var pyre = Rules.floor_named("pyre")
	var shroud = Rules.floor_named("shroud")
	var hearse = Rules.floor_named("hearse")
	var cerecloth = Rules.floor_named("cerecloth")
	var cloister = Rules.floor_named("cloister")
	var bier = Rules.floor_named("bier")
	var catafalque = Rules.floor_named("catafalque")
	var herse = Rules.floor_named("herse")
	var pall = Rules.floor_named("pall")
	var frontal = Rules.floor_named("frontal")
	var riddel = Rules.floor_named("riddel")
	if charnel == null or winding == null or cenotaph == null or pyre == null or shroud == null or hearse == null or cerecloth == null or cloister == null or bier == null or catafalque == null or herse == null or pall == null or frontal == null or riddel == null:
		return "an earlier floor is missing"
	if Rules.glyph_at(Vector2i(1, 2), floor) != "." or Rules.tile_at(Vector2i(1, 2), floor) != Rules.Tile.FLOOR:
		return "period no longer inks as floor"
	if Rules.glyph_at(Vector2i(7, 4), cloister) != "+":
		return "plus is no longer the cloister"
	if Rules.glyph_at(Vector2i(7, 4), cerecloth) != "'":
		return "apostrophe is no longer the cerecloth"
	if Rules.glyph_at(Vector2i(7, 4), pall) != '"':
		return "quotation mark is no longer the pall"
	if Rules.glyph_at(Vector2i(7, 4), charnel) != "-":
		return "hyphen is no longer the charnel"
	if Rules.glyph_at(Vector2i(7, 4), floor) != "_":
		return "underscore is not the sepulchre"
	if Rules.tile_at(Vector2i(7, 4), floor) != Rules.Tile.WALL or Rules.is_walkable(Vector2i(7, 4), floor):
		return "the sepulchre glyph does not ink as one wall"
	if Rules.glyph_at(Vector2i(16, 10), charnel) != "." or Rules.glyph_at(Vector2i(15, 11), charnel) != "#" or Rules.glyph_at(Vector2i(17, 10), charnel) != "#":
		return "the charnel closure moved"
	if Rules.start_pos(floor) != Vector2i(1, 1) or Rules.lift_pos(floor) != Vector2i(10, 11) or Rules.enemy_pos(floor) != Vector2i(9, 12):
		return "start, lift, or warden moved"
	if Rules.glyph_at(Vector2i(46, 15), floor) != "H":
		return "the new crack is not (46,15)"
	if Rules.glyph_at(Vector2i(45, 15), floor) != "H" or Rules.glyph_at(Vector2i(47, 15), floor) != "#":
		return "the crack is not the wall immediately east of (45,15)"
	if Rules.glyph_at(Vector2i(20, 10), floor) != "#" or Rules.glyph_at(Vector2i(21, 10), floor) != "#" or Rules.glyph_at(Vector2i(21, 9), floor) != "#" or Rules.glyph_at(Vector2i(21, 8), floor) != "#" or Rules.glyph_at(Vector2i(21, 7), floor) != "#" or Rules.glyph_at(Vector2i(21, 6), floor) != "#" or Rules.glyph_at(Vector2i(21, 5), floor) != "#" or Rules.glyph_at(Vector2i(21, 4), floor) != "#":
		return "a required closure was left open"
	if Rules.glyph_at(Vector2i(19, 10), floor) != "#" or Rules.glyph_at(Vector2i(18, 10), floor) != "#" or Rules.glyph_at(Vector2i(17, 10), floor) != "#" or Rules.glyph_at(Vector2i(16, 10), floor) != "#" or Rules.glyph_at(Vector2i(16, 11), floor) != "." or Rules.glyph_at(Vector2i(17, 11), floor) != "." or Rules.glyph_at(Vector2i(18, 11), floor) != "." or Rules.glyph_at(Vector2i(15, 11), floor) != "." or Rules.glyph_at(Vector2i(15, 10), floor) != ".":
		return "the closure or the detour moved"
	if Rules.glyph_at(Vector2i(21, 11), floor) != "#" or Rules.glyph_at(Vector2i(22, 10), floor) != "#" or Rules.glyph_at(Vector2i(20, 11), floor) != "#" or Rules.glyph_at(Vector2i(20, 9), floor) != "_":
		return "a wall around the walk moved"
	if Rules.glyph_at(Vector2i(10, 10), floor) != "#" or Rules.glyph_at(Vector2i(11, 11), floor) != "." or Rules.glyph_at(Vector2i(6, 11), floor) != ".":
		return "a carried opening moved"
	if Rules.glyph_at(Vector2i(7, 10), floor) != "#" or Rules.glyph_at(Vector2i(8, 10), floor) != "#" or Rules.glyph_at(Vector2i(9, 10), floor) != "#":
		return "a carried closure was reopened"
	if Rules.glyph_at(Vector2i(8, 12), floor) != "." or Rules.is_walkable(Vector2i(10, 12), floor):
		return "a swing moved"
	var hazards := Rules.hazard_cells(floor)
	if hazards.size() != 50:
		return "expected fifty sepulchre cracks, found %d" % hazards.size()
	if not hazards.has(Vector2i(46, 15)) or not hazards.has(Vector2i(45, 15)):
		return "the crack set drifted"
	if Rules.corridor_cells(floor).size() != 58:
		return "corridors %d" % Rules.corridor_cells(floor).size()
	var kept := {}
	for cell in Rules.corridor_cells(charnel):
		kept[cell] = true
	for cell in Rules.corridor_cells(floor):
		if not kept.has(cell) and cell != Vector2i(15, 11):
			return "a new corridor was opened at %s" % cell
	if not kept.has(Vector2i(16, 10)) or Rules.is_corridor_cell(Vector2i(16, 10), floor):
		return "(16,10) was not closed"
	if not Rules.is_corridor_cell(Vector2i(15, 11), floor) or Rules.is_corridor_cell(Vector2i(15, 11), charnel):
		return "(15,11) was not the opened detour"
	for cell in kept:
		if cell != Vector2i(16, 10) and not Rules.is_corridor_cell(cell, floor):
			return "a corridor besides (16,10) was closed at %s" % cell
	var ring_err := _sepulchre_ring(floor)
	if ring_err != "":
		return ring_err
	for other in Rules.floors():
		if other.id == floor.id:
			continue
		if floor.rows == other.rows:
			return "the sepulchre copies %s" % other.id
		if Rules.width(floor) == Rules.width(other) and Rules.height(floor) == Rules.height(other):
			return "the sepulchre reuses the %s grid" % other.id
		if Rules.enemy_pos(floor) == Rules.enemy_pos(other) and str(other.id) != "font" and str(other.id) != "apse" and str(other.id) != "choir" and str(other.id) != "rood" and str(other.id) != "crossing" and str(other.id) != "transept" and str(other.id) != "ambulatory" and str(other.id) != "chevet" and str(other.id) != "retrochoir" and str(other.id) != "ladychapel" and str(other.id) != "feretory" and str(other.id) != "chantry" and str(other.id) != "sacristy" and str(other.id) != "pyx" and str(other.id) != "aumbry" and str(other.id) != "piscina" and str(other.id) != "sedilia" and str(other.id) != "credence" and str(other.id) != "reredos" and str(other.id) != "predella" and str(other.id) != "dossal" and str(other.id) != "retable" and str(other.id) != "tester" and str(other.id) != "riddel" and str(other.id) != "frontal" and str(other.id) != "pall" and str(other.id) != "herse" and str(other.id) != "catafalque" and str(other.id) != "bier" and str(other.id) != "cerecloth" and str(other.id) != "hearse" and str(other.id) != "shroud" and str(other.id) != "pyre" and str(other.id) != "cenotaph" and str(other.id) != "winding" and str(other.id) != "charnel" and str(other.id) != "vault" and str(other.id) != "cairn" and str(other.id) != "columbarium":
			return "the sepulchre reuses the %s warden cell" % other.id
		if _ring_key(floor) == _ring_key(other):
			return "the sepulchre reuses the %s ring" % other.id
	var path: Array = Rules.shortest_path_cells(floor)
	var earlier_path: Array = Rules.shortest_path_cells(charnel)
	if path.size() != 20 or path.size() != earlier_path.size():
		return "the 19-step path cells changed"
	for i in path.size():
		if path[i] != earlier_path[i]:
			return "the 19-step path moved at %s" % path[i]
	if path.has(Vector2i(46, 15)) or path.has(Vector2i(15, 11)) or path.has(Vector2i(16, 10)):
		return "the crack or the detour is on the tour"
	if Rules.shortest_path_steps(floor) != 19:
		return "shortest sepulchre path is %d, expected 19" % Rules.shortest_path_steps(floor)
	var cover := Rules.safe_survey_steps(floor)
	if cover != 128:
		return "safe survey is %d, expected 128" % cover
	var bare := Rules.Floor.new()
	var bare_rows := PackedStringArray()
	for i in floor.rows.size():
		var bare_row := str(floor.rows[i])
		if i == 15:
			bare_row = bare_row.left(46) + "#" + bare_row.substr(47)
		bare_rows.append(bare_row)
	bare.rows = bare_rows
	if Rules.glyph_at(Vector2i(46, 15), bare) != "#" or Rules.glyph_at(Vector2i(16, 10), bare) != "#" or Rules.glyph_at(Vector2i(15, 11), bare) != ".":
		return "the sheet without the new crack was not built"
	if Rules.safe_survey_steps(bare) != 126 or Rules.shortest_path_cells(bare) != path:
		return "removing the new crack surveys at %d" % Rules.safe_survey_steps(bare)
	var only := Rules.Floor.new()
	var only_rows := PackedStringArray()
	for i in floor.rows.size():
		var only_row := str(floor.rows[i])
		if i == 10:
			only_row = only_row.left(16) + "." + only_row.substr(17)
		if i == 11:
			only_row = only_row.left(15) + "#" + only_row.substr(16)
		only_rows.append(only_row)
	only.rows = only_rows
	if Rules.glyph_at(Vector2i(16, 10), only) != "." or Rules.glyph_at(Vector2i(15, 11), only) != "#" or Rules.glyph_at(Vector2i(46, 15), only) != "H":
		return "the crack-only sheet was not built"
	if Rules.safe_survey_steps(only) != 128 or Rules.shortest_path_cells(only) != path:
		return "adding only (46,15) surveys at %d" % Rules.safe_survey_steps(only)
	var blocked := Rules.Floor.new()
	var blocked_rows := PackedStringArray()
	for i in floor.rows.size():
		var blocked_row := str(floor.rows[i])
		if i == 11:
			blocked_row = blocked_row.left(15) + "#" + blocked_row.substr(16)
		blocked_rows.append(blocked_row)
	blocked.rows = blocked_rows
	if Rules.glyph_at(Vector2i(15, 11), blocked) != "#" or Rules.glyph_at(Vector2i(16, 10), blocked) != "#":
		return "the closed sheet without the detour was not built"
	if Rules.safe_survey_steps(blocked) != 182 or Rules.shortest_path_cells(blocked) != path:
		return "closing (16,10) without the detour surveys at %d" % Rules.safe_survey_steps(blocked)
	if Rules.safe_survey_steps(charnel) != 126 or Rules.corridor_cells(charnel).size() != 58 or Rules.hazard_cells(charnel).size() != 49:
		return "the charnel solution changed"
	if Rules.safe_survey_steps(winding) != 124 or Rules.corridor_cells(winding).size() != 58 or Rules.hazard_cells(winding).size() != 48:
		return "the winding solution changed"
	if Rules.safe_survey_steps(cenotaph) != 122 or Rules.corridor_cells(cenotaph).size() != 58 or Rules.hazard_cells(cenotaph).size() != 47:
		return "the cenotaph solution changed"
