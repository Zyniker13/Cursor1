	check(Tracer.trace(swap, swap_left)["docks"]["Rd"].has("blue") and not Tracer.is_cleared(swap, swap_left), "chart 66 unclicked stain fails the dock")
	var swap_down := Charts.duplicate_state(swap_solved)
