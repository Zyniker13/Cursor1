func test_fascia_book() -> void:
	var book: Array = Charts.fascia()
	check(book.size() == 8, "fascia book has eight charts")
	var titles := ["The Dry Fascia", "The Wet Stop", "Color Kept", "No Turn", "Beside the Flood", "Two Fascias", "The Held Fascia", "The Fascia Mark"]
	for i in book.size():
		var chart: Dictionary = book[i]
		check(str(chart["id"]) == str(i + 239), "fascia chart %d keeps its number" % (i + 239))
		check(str(chart["title"]) == str(titles[i]), "fascia chart %d keeps its title" % (i + 239))
		check(str(chart["harbor"]) == Charts.FASCIA, "chart %s belongs to the fascia" % str(chart["id"]))
		var fascia_count := 0
		for raw_piece in chart["pieces"]:
			var piece: Dictionary = raw_piece
			if str(piece["kind"]) == "fascia":
				fascia_count += 1
		check(fascia_count >= 1, "chart %s needs the fascia" % str(chart["id"]))
	for older in Charts.all().slice(0, 238):
		for raw_piece in older["pieces"]:
			var older_piece: Dictionary = raw_piece
			check(str(older_piece["kind"]) != "fascia", "chart %s keeps its pieces" % str(older["id"]))
		for raw_fix in older["fixtures"]:
			var older_fix: Dictionary = raw_fix
			check(str(older_fix["kind"]) != "fascia", "chart %s keeps its fixed glass" % str(older["id"]))
	for i in book.size():
		for raw_piece in book[i]["pieces"]:
			var piece: Dictionary = raw_piece
			if str(piece["kind"]) != "fascia":
				continue
			var piece_id := str(piece["id"])
			var stopped := Tracer.rotate_dir(Tracer.fascia_facing(int(piece["solution_rot"])), 1)
			for crot in [0, 90, 180, 270]:
				if Tracer.ovolo_facing(crot) != stopped:
					_expect_fascia_miss(i, piece_id, "ovolo", crot, "ovolo %d" % crot)
				if Tracer.rotate_dir(Tracer.cavetto_facing(crot), 2) != stopped:
					_expect_fascia_miss(i, piece_id, "cavetto", crot, "cavetto %d" % crot)
				_expect_fascia_miss(i, piece_id, "cyma", crot, "cyma %d" % crot)
				_expect_fascia_miss(i, piece_id, "bead", crot, "bead %d" % crot)
				_expect_fascia_miss(i, piece_id, "quirk", crot, "quirk %d" % crot)
				_expect_fascia_miss(i, piece_id, "fillet", crot, "fillet %d" % crot)
			_expect_fascia_miss(i, piece_id, "jamb", 0, "jamb north")
			_expect_fascia_miss(i, piece_id, "jamb", 90, "jamb east")
			_expect_fascia_miss(i, piece_id, "mullion", 0, "mullion")
			_expect_fascia_miss(i, piece_id, "transom", 0, "transom")
			_expect_fascia_miss(i, piece_id, "lintel", 0, "lintel")
			_expect_fascia_miss(i, piece_id, "shutter", 0, "shutter")
			_expect_fascia_miss(i, piece_id, "well", 0, "well")
			_expect_fascia_miss(i, piece_id, "siphon", 0, "siphon")
			_expect_fascia_miss(i, piece_id, "stain", 0, "red stain")
			_expect_fascia_miss(i, piece_id, "stain", 90, "blue stain")
			_expect_fascia_miss(i, piece_id, "mirror", 0, "mirror")
			_expect_fascia_miss(i, piece_id, "mirror", 90, "turned mirror")
			_expect_fascia_miss(i, piece_id, "corona", int(piece["solution_rot"]), "corona same facing")
			_expect_fascia_miss(i, piece_id, "ogee", int(piece["solution_rot"]), "ogee same facing")
			_expect_fascia_miss(i, piece_id, "torus", int(piece["solution_rot"]), "torus same facing")
			_expect_fascia_miss(i, piece_id, "scotia", int(piece["solution_rot"]), "scotia same facing")
			_expect_fascia_miss(i, piece_id, "astragal", int(piece["solution_rot"]), "astragal same facing")
			_expect_fascia_miss(i, piece_id, "casement", int(piece["solution_rot"]), "casement same facing")
			for facing in [0, 90, 180, 270]:
				_expect_fascia_miss(i, piece_id, "vane", facing, "vane %d" % facing)
				_expect_fascia_miss(i, piece_id, "weir", facing, "weir %d" % facing)
				_expect_fascia_miss(i, piece_id, "sluice", facing, "sluice %d" % facing)
				_expect_fascia_miss(i, piece_id, "prism", facing, "prism %d" % facing)
