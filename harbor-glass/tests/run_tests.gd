	var north_case: Dictionary = Tracer.trace(north_out, Charts.make_state(north_out, true))
	check(_leaves(north_case, 0, 2, "N", "white") and north_case["docks"]["D"].has("white"), "a north casement passes north")
	north_out["pieces"] = [_fixed_scotia("S", 0, 2, 0)]
	var north_scotia: Dictionary = Tracer.trace(north_out, Charts.make_state(north_out, true))
	check(_arrives_from(north_scotia, 0, 2, "N", "white") and _leaves(north_scotia, 0, 2, "N", "white") and north_scotia["docks"]["D"].has("white"), "a north scotia passes north")
	var west_lane := _blank(5, 1)
	west_lane["lanterns"] = [_lamp("L", 4, 0, "W", "white")]
	west_lane["docks"] = [_need("D", 0, 0, "white")]
	west_lane["pieces"] = [_fixed_casement("C", 2, 0, 0)]
	var west_case: Dictionary = Tracer.trace(west_lane, Charts.make_state(west_lane, true))
	check(not _center_hit(west_case, 2, 0) and west_case["docks"]["D"].is_empty(), "a north casement refuses west")
	west_lane["pieces"] = [_fixed_scotia("S", 2, 0, 0)]
	var west_scotia: Dictionary = Tracer.trace(west_lane, Charts.make_state(west_lane, true))
	check(_arrives_from(west_scotia, 2, 0, "W", "white") and _leaves(west_scotia, 2, 0, "W", "white") and west_scotia["docks"]["D"].has("white"), "a north scotia passes west as well")
