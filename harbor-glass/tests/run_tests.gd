func _chart_row_fits(grid: GridContainer, side: Control) -> bool:
	var bounds := side.get_global_rect().grow(1.0)
	var count := 0
	for child in grid.get_children():
		var button := child as Button
		if button == null:
			continue
		count += 1
		var rect := button.get_global_rect()
		var need := button.get_minimum_size()
		if not bounds.encloses(rect):
			print("CLIPPED ", button.text, " ", rect, " outside ", bounds)
			return false
		if rect.size.x + 0.5 < need.x or rect.size.y + 0.5 < need.y:
			print("CRAMPED ", button.text, " got ", rect.size, " need ", need)
			return false
	return count > 0

func _trace_sig(result: Dictionary) -> String:
	var parts := PackedStringArray()
	parts.append("flood=%d" % int(result["flood"]))
	var docks: Dictionary = result["docks"]
	var dock_ids: Array = docks.keys()
	dock_ids.sort()
	for dock_id in dock_ids:
		var hits: Array = docks[dock_id]
		var colors := PackedStringArray()
		for color in hits:
			colors.append(str(color))
		colors.sort()
		parts.append("dock %s=%s" % [str(dock_id), ",".join(colors)])
	var boats: Dictionary = result["boats"]
	var boat_ids: Array = boats.keys()
	boat_ids.sort()
	for boat_id in boat_ids:
		parts.append("boat %s=%s" % [str(boat_id), "1" if bool(boats[boat_id]) else "0"])
	var segs: Array = result["segments"]
	parts.append("segments=%d" % segs.size())
	for raw in segs:
		var seg: Dictionary = raw
		parts.append("%.4f,%.4f>%.4f,%.4f:%s" % [float(seg["x0"]), float(seg["y0"]), float(seg["x1"]), float(seg["y1"]), str(seg["color"])])
	return "|".join(parts)
func _clears(chart: Dictionary) -> Array:
	var found: Array = []
	for candidate in _enumerate(chart):
		if Tracer.is_cleared(chart, candidate):
			found.append(candidate)
	return found

func _enumerate(chart: Dictionary) -> Array:
	var found: Array = []
	_walk(chart, Charts.make_state(chart, false), 0, found)
	return found

func _walk(chart: Dictionary, state: Dictionary, index: int, found: Array) -> void:
	var pieces: Array = chart["pieces"]
	if index >= pieces.size():
		var phases: Array = chart["tide_phases"]
		for t in phases.size():
			var copy := Charts.duplicate_state(state)
			copy["tide_index"] = t
			found.append(copy)
		return
	var piece: Dictionary = pieces[index]
	var id := str(piece["id"])
	var kind := str(piece["kind"])
	# A shutter has no facing, so only one rotation is a distinct state.
	# A well has no facing either. Rotation is ignored.
	# A siphon has no facing either. Rotation is ignored.
	# A stain has no facing either, but 0 (red) and 90 (blue) are different colors.
	# A vane has four facings, the same count as a prism has faces.
	# A sluice has four facings too. The exit follows that facing.
	# A weir has four facings too. The exit follows that facing and swaps color.
	# A lintel has no facing. Rotation is ignored.
	# A mullion has no facing. Rotation is ignored.
	# A transom has no facing. Rotation is ignored.
	# A casement has four facings. Only one of them passes a beam.
	# A jamb has four facings. Both facings of the open axis pass.
	# An astragal has four facings. Each facing opens a different pair.
	# A scotia has four facings. Each facing opens the mirror pair.
	# A torus has four facings. Each facing opens the opposite pair.
	# An ogee has four facings. Each facing opens the mirrored opposite pair.
	# An ovolo has four facings. Each facing stops only itself.
	# A cavetto has four facings. Each facing stops only its opposite.
	# A fillet has four facings. Each facing passes only its opposite.
	# A corona has four facings. Opposite facings open the same perpendicular axis.
	# A bead has four facings. Each facing passes only the next clockwise direction.
	# A quirk has four facings. Each facing passes only the next counterclockwise direction.
	# A cyma has four facings. Each facing passes only that facing.
	# A fascia has four facings. Each facing stops only the next clockwise direction.
	# A soffit has four facings. Each facing stops only the next counterclockwise direction.
	# A drip has four facings. Dry, it stops only the next counterclockwise direction. Flooded, only that direction passes.
	# A beak has four facings. Dry, it stops only the next clockwise direction. Flooded, only that direction passes.
	# A hood has four facings. Dry, it stops its facing. Flooded, only the facing passes.
	# A throat has four facings. Dry, it stops the opposite of its facing. Flooded, only that opposite passes.
	# A larmier has four facings. Dry, it passes the two perpendicular directions. Flooded, only the facing and the opposite pass. Opposite facings share that open set.
	# A cill has four facings. Opposite facings share the open set. Dry, it passes the facing and the opposite. Flooded, only the two perpendicular directions pass.
	# A threshold has four facings. Opposite facings do not share the open set. Dry, only the opposite of the facing passes. Flooded, every direction except that opposite passes.
	# An impost has four facings. Opposite facings do not share the open set. Dry, only the facing passes. Flooded, every direction except that facing passes.
	var rots: Array = [0]
	if kind == "prism" or kind == "vane" or kind == "sluice" or kind == "weir" or kind == "casement" or kind == "jamb" or kind == "astragal" or kind == "scotia" or kind == "torus" or kind == "ogee" or kind == "ovolo" or kind == "cavetto" or kind == "fillet" or kind == "corona" or kind == "bead" or kind == "quirk" or kind == "cyma" or kind == "fascia" or kind == "soffit" or kind == "drip" or kind == "beak" or kind == "hood" or kind == "throat" or kind == "larmier" or kind == "cill" or kind == "threshold" or kind == "impost" or kind == "architrave" or kind == "archivolt" or kind == "abacus" or kind == "rebate":
		rots = [0, 90, 180, 270]
	elif kind != "shutter" and kind != "well" and kind != "siphon" and kind != "lintel" and kind != "mullion" and kind != "transom":
		rots = [0, 90]
	for sock_raw in piece["sockets"]:
		var sock: Dictionary = sock_raw
		for rot in rots:
			state["pieces"][id]["socket"] = str(sock["id"])
			state["pieces"][id]["rot"] = int(rot)
			_walk(chart, state, index + 1, found)

func _same_solution(chart: Dictionary, live: Dictionary, authored: Dictionary) -> bool:
	if int(live["tide_index"]) != int(authored["tide_index"]):
		return false
	for raw in chart["pieces"]:
		var piece: Dictionary = raw
		var id := str(piece["id"])
		var kind := str(piece["kind"])
		var got: Dictionary = live["pieces"][id]
		var want: Dictionary = authored["pieces"][id]
		if str(got["socket"]) != str(want["socket"]):
			return false
		if Tracer.norm_rot(kind, int(got["rot"])) != Tracer.norm_rot(kind, int(want["rot"])):
			return false
	return true

func _solve_piece(chart: Dictionary, state: Dictionary, id: String) -> void:
	if id == "tide":
		state["tide_index"] = int(chart["solution_tide_index"])
		return
	var piece := Charts.piece_def(chart, id)
	state["pieces"][id]["rot"] = int(piece["solution_rot"])
	state["pieces"][id]["socket"] = str(piece["solution_socket"])

func _tap(node: Node, keycode: Key, shift := false) -> void:
	var event := InputEventKey.new()
	event.pressed = true
	event.echo = false
	event.keycode = keycode
	event.physical_keycode = keycode
	event.shift_pressed = shift
	node._unhandled_input(event)


func _click_cell(main, c: int, r: int, right: bool) -> void:
	var board: Node2D = main.board
	var cell_size := float(board.get("cell"))
	var local := Vector2(float(c) + 0.5, float(r) + 0.5) * cell_size
	var event := InputEventMouseButton.new()
	event.pressed = true
	event.button_index = MOUSE_BUTTON_RIGHT if right else MOUSE_BUTTON_LEFT
	event.position = board.get_global_transform_with_canvas() * local
	main._unhandled_input(event)


func _same_row(result: Dictionary, y: int) -> bool:
	var cy := float(y) + 0.5
	var segs: Array = result["segments"]
	if segs.is_empty():
		return false
	for raw in segs:
		var seg: Dictionary = raw
		if not is_equal_approx(float(seg["y0"]), cy) or not is_equal_approx(float(seg["y1"]), cy):
			return false
	return true


func _arrives(result: Dictionary, x: int, y: int, color: String) -> bool:
	var cx := float(x) + 0.5
	var cy := float(y) + 0.5
	for raw in result["segments"]:
		var seg: Dictionary = raw
		if str(seg["color"]) != color:
			continue
		if is_equal_approx(float(seg["x1"]), cx) and is_equal_approx(float(seg["y1"]), cy):
			return true
	return false


func _departs(result: Dictionary, x: int, y: int, color: String) -> bool:
	var cx := float(x) + 0.5
	var cy := float(y) + 0.5
	for raw in result["segments"]:
