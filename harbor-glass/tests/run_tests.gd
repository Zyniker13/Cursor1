func _expect_corona_miss(index: int, piece_id: String, kind: String, rot: int, label: String) -> void:
	var chart: Dictionary = Charts.corona()[index]
	_retarget(chart, piece_id, kind, rot)
	var state := Charts.make_state(chart, true)
	if Tracer.is_cleared(chart, state):
		check(false, "%s clears corona chart %d" % [label, index + 207])
	else:
		check(true, "%s misses corona chart %d" % [label, index + 207])


func test_bead_rule() -> void:
	check(Tracer.norm_rot("bead", 0) == 0 and Tracer.norm_rot("bead", 90) == 90, "a bead keeps a quarter turn")
	check(Tracer.norm_rot("bead", 180) == 180 and Tracer.norm_rot("bead", 270) == 270, "a bead keeps a half turn")
	check(Tracer.norm_rot("bead", 360) == 0 and Tracer.norm_rot("bead", 450) == 90, "a bead wraps a full turn")
	check(Tracer.turn_rot("bead", 0) == 90 and Tracer.turn_rot("bead", 90) == 180, "clicking a bead walks the facing")
	check(Tracer.turn_rot("bead", 180) == 270 and Tracer.turn_rot("bead", 270) == 0, "clicking a bead returns to north")
	check(Tracer.bead_facing(0) == "N" and Tracer.bead_facing(90) == "E" and Tracer.bead_facing(180) == "S" and Tracer.bead_facing(270) == "W", "bead facing follows the quarter turn")
	check(Tracer.bead_passes(0, "E") and not Tracer.bead_passes(0, "N") and not Tracer.bead_passes(0, "S") and not Tracer.bead_passes(0, "W"), "a north bead passes only east")
	check(Tracer.bead_passes(90, "S") and not Tracer.bead_passes(90, "E") and not Tracer.bead_passes(90, "N") and not Tracer.bead_passes(90, "W"), "a bead turned once from north passes only south")
	check(Tracer.bead_passes(180, "W") and not Tracer.bead_passes(180, "E"), "two clicks face south and pass only west")
	check(Tracer.bead_passes(270, "N") and not Tracer.bead_passes(270, "W"), "three clicks face west and pass only north")
	check(Tracer.casement_facing(0) == "N" and not Tracer.bead_passes(0, "N"), "a north casement passes the north a north bead stops")
	check(Tracer.fillet_passes(0, "S") and not Tracer.bead_passes(0, "S"), "a north fillet passes the south a north bead stops")
	check(Tracer.corona_passes(0, "E") and Tracer.corona_passes(0, "W") and not Tracer.bead_passes(0, "W"), "a north corona passes the west a north bead stops")
	check(Tracer.astragal_passes(0, "N") and Tracer.astragal_passes(0, "E") and not Tracer.bead_passes(0, "N"), "a north astragal passes the north a north bead stops")
	var hinted: Dictionary = Charts.bead()[6]
	var solved_hint := Charts.make_state(hinted, true)
	check(not Hints.wrong_pieces(hinted, solved_hint).has("O"), "a hint accepts the held north bead")
	for spun in [90, 180, 270]:
		var turned_hint := Charts.duplicate_state(solved_hint)
		turned_hint["pieces"]["O"]["rot"] = spun
		check(Hints.wrong_pieces(hinted, turned_hint).has("O"), "a hint rejects bead rotation %d" % spun)
		check(not Tracer.is_cleared(hinted, turned_hint), "bead rotation %d is not the held open direction" % spun)
	var carried := {}
	carried[Vector2i(0, 0)] = {"kind": "bead", "rot": 0}
	check(not Tracer._flood_carries(carried, Vector2i(0, 0)), "a flooded bead does not carry the beam")
	var east_lane := _blank(5, 1)
	east_lane["lanterns"] = [_lamp("L", 0, 0, "E", "white")]
	east_lane["docks"] = [_need("D", 4, 0, "white")]
	east_lane["pieces"] = [_fixed_bead("O", 2, 0, 0)]
	var east_hit: Dictionary = Tracer.trace(east_lane, Charts.make_state(east_lane, true))
	check(_arrives_from(east_hit, 2, 0, "E", "white") and _leaves(east_hit, 2, 0, "E", "white") and east_hit["docks"]["D"].has("white"), "a north bead passes east")
	east_lane["pieces"] = [_fixed_fillet("O", 2, 0, 0)]
	check(not _center_hit(Tracer.trace(east_lane, Charts.make_state(east_lane, true)), 2, 0), "a north fillet refuses the east a north bead passes")
	east_lane["pieces"] = [_fixed_casement("C", 2, 0, 90)]
	check(_leaves(Tracer.trace(east_lane, Charts.make_state(east_lane, true)), 2, 0, "E", "white"), "an east casement also passes east")
	var north_stop := _blank(1, 5)
	north_stop["lanterns"] = [_lamp("L", 0, 4, "N", "red")]
	north_stop["docks"] = [_need("D", 0, 0, "red")]
	north_stop["pieces"] = [_fixed_bead("O", 0, 2, 0)]
	check(not _center_hit(Tracer.trace(north_stop, Charts.make_state(north_stop, true)), 0, 2), "a north bead refuses north")
	north_stop["pieces"] = [_fixed_casement("C", 0, 2, 0)]
	check(_leaves(Tracer.trace(north_stop, Charts.make_state(north_stop, true)), 0, 2, "N", "red"), "a north casement passes the north a north bead blocks")
	var south_stop := _blank(1, 5)
	south_stop["lanterns"] = [_lamp("L", 0, 0, "S", "white")]
	south_stop["docks"] = [_need("D", 0, 4, "white")]
	south_stop["pieces"] = [_fixed_bead("O", 0, 2, 0)]
	check(not _center_hit(Tracer.trace(south_stop, Charts.make_state(south_stop, true)), 0, 2), "a north bead refuses south")
	south_stop["pieces"] = [_fixed_fillet("O", 0, 2, 0)]
	check(_leaves(Tracer.trace(south_stop, Charts.make_state(south_stop, true)), 0, 2, "S", "white"), "a north fillet passes the south a north bead blocks")
	var west_stop := _blank(5, 1)
	west_stop["lanterns"] = [_lamp("L", 4, 0, "W", "blue")]
	west_stop["docks"] = [_need("D", 0, 0, "blue")]
	west_stop["pieces"] = [_fixed_bead("O", 2, 0, 0)]
	check(not _center_hit(Tracer.trace(west_stop, Charts.make_state(west_stop, true)), 2, 0), "a north bead refuses west")
	west_stop["pieces"] = [_fixed_corona("O", 2, 0, 0)]
	check(_leaves(Tracer.trace(west_stop, Charts.make_state(west_stop, true)), 2, 0, "W", "blue"), "a north corona passes the west a north bead blocks")
	var clicked := _blank(1, 5)
	clicked["lanterns"] = [_lamp("L", 0, 0, "S", "white")]
	clicked["docks"] = [_need("D", 0, 4, "white")]
	clicked["pieces"] = [_fixed_bead("O", 0, 2, Tracer.turn_rot("bead", 0))]
	var clicked_hit: Dictionary = Tracer.trace(clicked, Charts.make_state(clicked, true))
	check(Tracer.bead_facing(Tracer.turn_rot("bead", 0)) == "E" and _leaves(clicked_hit, 0, 2, "S", "white"), "a bead clicked once from north faces east and passes only south")
	clicked["pieces"] = [_fixed_bead("O", 0, 2, 0)]
	check(not _center_hit(Tracer.trace(clicked, Charts.make_state(clicked, true)), 0, 2), "a north bead still refuses that southbound beam")
	for rot in [0, 90, 180, 270]:
		var facing := Tracer.bead_facing(rot)
		for color in ["red", "blue", "white"]:
			for dir in ["N", "E", "S", "W"]:
				var open := Tracer.bead_passes(rot, dir)
				var lane := _blank(5, 5)
				var at := Vector2i(2, 2)
				var step: Vector2i = Tracer.VEC[dir]
				var lamp_at := at - step
				var dock_at := at + step * 2
				lane["lanterns"] = [_lamp("L", lamp_at.x, lamp_at.y, dir, color)]
				lane["docks"] = [_need("D", dock_at.x, dock_at.y, color)]
				lane["pieces"] = [_fixed_bead("O", at.x, at.y, rot)]
				var hit: Dictionary = Tracer.trace(lane, Charts.make_state(lane, true))
				if open:
					check(hit["docks"]["D"].has(color) and hit["docks"]["D"].size() == 1, "a dry %s bead keeps %s traveling %s" % [facing, color, dir])
					check(_arrives_from(hit, at.x, at.y, dir, color) and _leaves(hit, at.x, at.y, dir, color), "a dry %s bead passes %s straight %s" % [facing, color, dir])
					var other := "red" if color != "red" else "blue"
					check(not _departs(hit, at.x, at.y, other), "a dry %s bead does not recolor %s traveling %s" % [facing, color, dir])
					for other_dir in ["N", "E", "S", "W"]:
						if other_dir == dir:
							continue
						check(not _leaves(hit, at.x, at.y, other_dir, color), "a dry %s bead does not turn %s from %s to %s" % [facing, color, dir, other_dir])
				else:
					check(not _center_hit(hit, at.x, at.y) and not _leaves(hit, at.x, at.y, dir, color) and hit["docks"]["D"].is_empty(), "a dry %s bead stops %s traveling %s before the cell" % [facing, color, dir])
	check(Tracer.trace(_bead_row(20), Charts.make_state(_bead_row(20), true))["docks"]["D"].has("white"), "twenty dry north beads still pass an eastbound beam")
	check(not Tracer.trace(_bead_west_row(20), Charts.make_state(_bead_west_row(20), true))["docks"]["D"].has("white"), "twenty dry north beads stop a westbound beam")
	var north_column := _bead_north_column(20)
	var north_column_hit: Dictionary = Tracer.trace(north_column, Charts.make_state(north_column, true))
	check(north_column_hit["docks"]["D"].is_empty() and not _center_hit(north_column_hit, 0, 20), "twenty dry north beads stop a northbound beam")
	check(not Tracer.trace(_bead_south_column(20), Charts.make_state(_bead_south_column(20), true))["docks"]["D"].has("white"), "twenty dry north beads stop a southbound beam")
	var west_flood := _blank(5, 4)
	west_flood["tide_phases"] = [2]
	west_flood["lanterns"] = [_lamp("L", 0, 1, "S", "white")]
	west_flood["fixtures"] = [
		{"id": "S0", "kind": "shutter", "x": 0, "y": 2, "rot": 0},
		{"id": "T0", "kind": "tide_mirror", "x": 0, "y": 3, "rot": 90},
		{"id": "S1", "kind": "shutter", "x": 1, "y": 3, "rot": 0},
	]
	west_flood["pieces"] = [_fixed_bead("O", 2, 3, 0)]
	var west_state := Charts.make_state(west_flood, true)
	var west_flood_hit: Dictionary = Tracer.trace(west_flood, west_state)
