		check(Hints.wrong_pieces(hinted, turned_hint).has("O"), "a hint rejects impost rotation %d" % spun)
		check(not Tracer.is_cleared(hinted, turned_hint), "impost rotation %d is not the dry north open set" % spun)
	var carried := {}
