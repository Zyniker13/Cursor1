func _expect_torus_miss(index: int, piece_id: String, kind: String, rot: int, label: String) -> void:
	var chart: Dictionary = Charts.torus()[index]
	_retarget(chart, piece_id, kind, rot)
	var state := Charts.make_state(chart, true)
	if Tracer.is_cleared(chart, state):
		check(false, "%s clears torus chart %d" % [label, index + 167])
	else:
		check(true, "%s misses torus chart %d" % [label, index + 167])


