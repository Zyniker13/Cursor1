func test_ovolo_book() -> void:
	var book: Array = Charts.ovolo()
	check(book.size() == 8, "ovolo book has eight charts")
	var titles := ["The Dry Ovolo", "The Wet Stop", "Color Kept", "No Turn", "Beside the Flood", "Two Ovolos", "The Held Ovolo", "The Ovolo Mark"]
	for i in book.size():
		var chart: Dictionary = book[i]
		check(str(chart["id"]) == str(i + 183), "ovolo chart %d keeps its number" % (i + 183))
		check(str(chart["title"]) == str(titles[i]), "ovolo chart %d keeps its title" % (i + 183))
		check(str(chart["harbor"]) == Charts.OVOLO, "chart %s belongs to the ovolo" % str(chart["id"]))
		var ovolo_count := 0
		for raw_piece in chart["pieces"]:
			var piece: Dictionary = raw_piece
			if str(piece["kind"]) == "ovolo":
				ovolo_count += 1
		check(ovolo_count >= 1, "chart %s needs the ovolo" % str(chart["id"]))
	for older in Charts.all().slice(0, 182):
		for raw_piece in older["pieces"]:
			var older_piece: Dictionary = raw_piece
			check(str(older_piece["kind"]) != "ovolo", "chart %s keeps its pieces" % str(older["id"]))
		for raw_fix in older["fixtures"]:
			var older_fix: Dictionary = raw_fix
			check(str(older_fix["kind"]) != "ovolo", "chart %s keeps its fixed glass" % str(older["id"]))
	for i in book.size():
		for raw_piece in book[i]["pieces"]:
			var piece: Dictionary = raw_piece
			if str(piece["kind"]) != "ovolo":
				continue
			var piece_id := str(piece["id"])
			_expect_ovolo_miss(i, piece_id, "casement", 0, "casement north")
			_expect_ovolo_miss(i, piece_id, "casement", 90, "casement east")
			_expect_ovolo_miss(i, piece_id, "casement", 180, "casement south")
			_expect_ovolo_miss(i, piece_id, "casement", 270, "casement west")
			_expect_ovolo_miss(i, piece_id, "jamb", 0, "jamb north")
			_expect_ovolo_miss(i, piece_id, "jamb", 90, "jamb east")
			_expect_ovolo_miss(i, piece_id, "jamb", 180, "jamb south")
			_expect_ovolo_miss(i, piece_id, "jamb", 270, "jamb west")
			_expect_ovolo_miss(i, piece_id, "mullion", 0, "mullion")
			_expect_ovolo_miss(i, piece_id, "transom", 0, "transom")
			_expect_ovolo_miss(i, piece_id, "lintel", 0, "lintel")
			_expect_ovolo_miss(i, piece_id, "shutter", 0, "shutter")
			_expect_ovolo_miss(i, piece_id, "well", 0, "well")
			_expect_ovolo_miss(i, piece_id, "siphon", 0, "siphon")
			_expect_ovolo_miss(i, piece_id, "stain", 0, "red stain")
			_expect_ovolo_miss(i, piece_id, "stain", 90, "blue stain")
			_expect_ovolo_miss(i, piece_id, "mirror", 0, "mirror")
			_expect_ovolo_miss(i, piece_id, "mirror", 90, "turned mirror")
			_expect_ovolo_miss(i, piece_id, "ogee", int(piece["solution_rot"]), "ogee same facing")
			_expect_ovolo_miss(i, piece_id, "torus", int(piece["solution_rot"]), "torus same facing")
			_expect_ovolo_miss(i, piece_id, "scotia", int(piece["solution_rot"]), "scotia same facing")
			_expect_ovolo_miss(i, piece_id, "astragal", int(piece["solution_rot"]), "astragal same facing")
			for facing in [0, 90, 180, 270]:
				_expect_ovolo_miss(i, piece_id, "vane", facing, "vane %d" % facing)
				_expect_ovolo_miss(i, piece_id, "weir", facing, "weir %d" % facing)
				_expect_ovolo_miss(i, piece_id, "sluice", facing, "sluice %d" % facing)
				_expect_ovolo_miss(i, piece_id, "prism", facing, "prism %d" % facing)
	var dry: Dictionary = book[0]
	check(int(dry["tide_phases"][0]) == 0 and int(dry["solution_tide_index"]) == 0, "chart 183 is tide index 0 and flood 0")
	var dry_hit: Dictionary = Tracer.trace(dry, Charts.make_state(dry, true))
	check(_leaves(dry_hit, 3, 3, "S", "white") and dry_hit["docks"]["Sd"].has("white") and dry_hit["docks"]["Sd"].size() == 1, "chart 183 passes the southbound beam")
	check(_leaves(dry_hit, 3, 3, "E", "blue") and dry_hit["docks"]["Ed"].has("blue") and dry_hit["docks"]["Ed"].size() == 1, "chart 183 passes the eastbound beam")
	check(_leaves(dry_hit, 3, 3, "W", "red") and dry_hit["docks"]["Wd"].has("red") and dry_hit["docks"]["Wd"].size() == 1, "chart 183 passes the westbound beam")
	check(dry_hit["docks"]["Kd"].is_empty(), "chart 183 refuses the northbound return")
	var dry_case: Dictionary = Charts.ovolo()[0]
	_retarget(dry_case, "O", "casement", 180)
	var dry_case_hit: Dictionary = Tracer.trace(dry_case, Charts.make_state(dry_case, true))
	check(dry_case_hit["docks"]["Sd"].has("white") and dry_case_hit["docks"]["Wd"].is_empty() and dry_case_hit["docks"]["Ed"].is_empty() and not Tracer.is_cleared(dry_case, Charts.make_state(dry_case, true)), "chart 183 a casement refuses the westbound beam")
	var dry_jamb: Dictionary = Charts.ovolo()[0]
	_retarget(dry_jamb, "O", "jamb", 0)
	var dry_jamb_hit: Dictionary = Tracer.trace(dry_jamb, Charts.make_state(dry_jamb, true))
	check(dry_jamb_hit["docks"]["Wd"].is_empty() and dry_jamb_hit["docks"]["Kd"].has("blue") and not Tracer.is_cleared(dry_jamb, Charts.make_state(dry_jamb, true)), "chart 183 a jamb refuses the westbound beam and passes the northbound return")
	var dry_ogee: Dictionary = Charts.ovolo()[0]
	_retarget(dry_ogee, "O", "ogee", 0)
	var dry_ogee_hit: Dictionary = Tracer.trace(dry_ogee, Charts.make_state(dry_ogee, true))
	check(dry_ogee_hit["docks"]["Sd"].has("white") and dry_ogee_hit["docks"]["Ed"].is_empty() and not Tracer.is_cleared(dry_ogee, Charts.make_state(dry_ogee, true)), "chart 183 an ogee facing north refuses the eastbound beam")
	var dry_torus: Dictionary = Charts.ovolo()[0]
