	check(_leaves(Tracer.trace(east_stop, Charts.make_state(east_stop, true)), 2, 0, "E", "red"), "a north bead passes the east a north cyma blocks")
	var south_stop := _blank(1, 5)
	south_stop["lanterns"] = [_lamp("L", 0, 0, "S", "white")]
