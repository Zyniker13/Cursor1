func test_scotia_book() -> void:
	var book: Array = Charts.scotia()
	check(book.size() == 8, "scotia book has eight charts")
	var titles := ["The Dry Scotia", "The Wet Stop", "Color Kept", "No Turn", "Beside the Flood", "Two Scotias", "The Held Scotia", "The Scotia Mark"]
	for i in book.size():
		var chart: Dictionary = book[i]
		check(str(chart["id"]) == str(i + 159), "scotia chart %d keeps its number" % (i + 159))
		check(str(chart["title"]) == str(titles[i]), "scotia chart %d keeps its title" % (i + 159))
		check(str(chart["harbor"]) == Charts.SCOTIA, "chart %s belongs to the scotia" % str(chart["id"]))
		var scotia_count := 0
		for raw_piece in chart["pieces"]:
			var piece: Dictionary = raw_piece
			if str(piece["kind"]) == "scotia":
				scotia_count += 1
		check(scotia_count >= 1, "chart %s needs the scotia" % str(chart["id"]))
	for older in Charts.all().slice(0, 158):
		for raw_piece in older["pieces"]:
			var older_piece: Dictionary = raw_piece
			check(str(older_piece["kind"]) != "scotia", "chart %s keeps its pieces" % str(older["id"]))
		for raw_fix in older["fixtures"]:
			var older_fix: Dictionary = raw_fix
			check(str(older_fix["kind"]) != "scotia", "chart %s keeps its fixed glass" % str(older["id"]))
	for i in book.size():
		for raw_piece in book[i]["pieces"]:
			var piece: Dictionary = raw_piece
			if str(piece["kind"]) != "scotia":
				continue
			var piece_id := str(piece["id"])
			_expect_scotia_miss(i, piece_id, "casement", 0, "casement north")
			_expect_scotia_miss(i, piece_id, "casement", 90, "casement east")
			_expect_scotia_miss(i, piece_id, "casement", 180, "casement south")
			_expect_scotia_miss(i, piece_id, "casement", 270, "casement west")
			_expect_scotia_miss(i, piece_id, "jamb", 0, "jamb north")
			_expect_scotia_miss(i, piece_id, "jamb", 90, "jamb east")
			_expect_scotia_miss(i, piece_id, "jamb", 180, "jamb south")
			_expect_scotia_miss(i, piece_id, "jamb", 270, "jamb west")
			_expect_scotia_miss(i, piece_id, "mullion", 0, "mullion")
			_expect_scotia_miss(i, piece_id, "transom", 0, "transom")
			_expect_scotia_miss(i, piece_id, "lintel", 0, "lintel")
			_expect_scotia_miss(i, piece_id, "shutter", 0, "shutter")
			_expect_scotia_miss(i, piece_id, "well", 0, "well")
			_expect_scotia_miss(i, piece_id, "siphon", 0, "siphon")
			_expect_scotia_miss(i, piece_id, "stain", 0, "red stain")
			_expect_scotia_miss(i, piece_id, "stain", 90, "blue stain")
			_expect_scotia_miss(i, piece_id, "mirror", 0, "mirror")
			_expect_scotia_miss(i, piece_id, "mirror", 90, "turned mirror")
			_expect_scotia_miss(i, piece_id, "astragal", int(piece["solution_rot"]), "astragal same facing")
			for facing in [0, 90, 180, 270]:
				_expect_scotia_miss(i, piece_id, "vane", facing, "vane %d" % facing)
				_expect_scotia_miss(i, piece_id, "weir", facing, "weir %d" % facing)
				_expect_scotia_miss(i, piece_id, "sluice", facing, "sluice %d" % facing)
				_expect_scotia_miss(i, piece_id, "prism", facing, "prism %d" % facing)
	var dry: Dictionary = book[0]
	check(int(dry["tide_phases"][0]) == 0 and int(dry["solution_tide_index"]) == 0, "chart 159 is tide index 0 and flood 0")
	var dry_hit: Dictionary = Tracer.trace(dry, Charts.make_state(dry, true))
	check(_leaves(dry_hit, 3, 3, "N", "white") and dry_hit["docks"]["Nd"].has("white") and dry_hit["docks"]["Nd"].size() == 1, "chart 159 passes the northbound beam")
	check(_leaves(dry_hit, 3, 3, "W", "red") and dry_hit["docks"]["Wd"].has("red") and dry_hit["docks"]["Wd"].size() == 1, "chart 159 passes the westbound beam")
	check(dry_hit["docks"]["Kd"].is_empty(), "chart 159 refuses the southbound return")
	var dry_case: Dictionary = Charts.scotia()[0]
	_retarget(dry_case, "S", "casement", 0)
	var dry_case_hit: Dictionary = Tracer.trace(dry_case, Charts.make_state(dry_case, true))
	check(dry_case_hit["docks"]["Nd"].has("white") and dry_case_hit["docks"]["Wd"].is_empty() and not Tracer.is_cleared(dry_case, Charts.make_state(dry_case, true)), "chart 159 a casement refuses the westbound beam")
	var dry_jamb: Dictionary = Charts.scotia()[0]
	_retarget(dry_jamb, "S", "jamb", 0)
	var dry_jamb_hit: Dictionary = Tracer.trace(dry_jamb, Charts.make_state(dry_jamb, true))
	check(dry_jamb_hit["docks"]["Wd"].is_empty() and dry_jamb_hit["docks"]["Kd"].has("blue") and not Tracer.is_cleared(dry_jamb, Charts.make_state(dry_jamb, true)), "chart 159 a jamb refuses the westbound beam and passes the southbound return")
	var dry_astra: Dictionary = Charts.scotia()[0]
	_retarget(dry_astra, "S", "astragal", 0)
	var dry_astra_hit: Dictionary = Tracer.trace(dry_astra, Charts.make_state(dry_astra, true))
	check(dry_astra_hit["docks"]["Nd"].has("white") and dry_astra_hit["docks"]["Wd"].is_empty() and not Tracer.is_cleared(dry_astra, Charts.make_state(dry_astra, true)), "chart 159 an astragal facing north refuses the westbound beam")
	var wet: Dictionary = book[1]
	check(int(wet["start_tide_index"]) == 1 and int(wet["solution_tide_index"]) == 0 and int(wet["tide_phases"][1]) == 3, "chart 160 opens under water and solves dry")
	var wet_start: Dictionary = Tracer.trace(wet, Charts.make_state(wet, false))
	check(wet_start["docks"]["Nd"].is_empty() and wet_start["docks"]["Wd"].is_empty() and not _center_hit(wet_start, 3, 4), "chart 160 flooded row stops the beam at the waterline")
	var wet_solved: Dictionary = Tracer.trace(wet, Charts.make_state(wet, true))
	check(_leaves(wet_solved, 3, 4, "N", "white") and _leaves(wet_solved, 3, 4, "W", "red") and wet_solved["docks"]["Nd"].has("white") and wet_solved["docks"]["Wd"].has("red") and wet_solved["docks"]["Kd"].is_empty(), "chart 160 dry tide passes north and west")
	var wet_open: Dictionary = Charts.scotia()[1]
	_retarget(wet_open, "S", "shutter", 0)
	var wet_open_state := Charts.make_state(wet_open, false)
	check(_center_hit(Tracer.trace(wet_open, wet_open_state), 3, 4), "chart 160 a shutter passes while flooded")
	for carrier in ["well", "siphon", "sluice", "weir"]:
		var wet_carry: Dictionary = Charts.scotia()[1]
		_retarget(wet_carry, "S", carrier, 180 if carrier == "sluice" or carrier == "weir" else 0)
		var carry_state := Charts.make_state(wet_carry, false)
		check(_center_hit(Tracer.trace(wet_carry, carry_state), 3, 4), "chart 160 a flooded %s carries the beam" % carrier)
	var kept: Dictionary = Charts.scotia()[2]
	var kept_hit: Dictionary = Tracer.trace(kept, Charts.make_state(kept, true))
	check(_leaves(kept_hit, 3, 3, "N", "red") and kept_hit["docks"]["Rd"].has("red") and kept_hit["docks"]["Rd"].size() == 1, "chart 161 keeps red")
	check(_leaves(kept_hit, 3, 3, "W", "blue") and kept_hit["docks"]["Bd"].has("blue") and kept_hit["docks"]["Bd"].size() == 1, "chart 161 keeps blue")
	var white_pass: Dictionary = Charts.scotia()[2]
	white_pass["lanterns"][0]["color"] = "white"
	white_pass["docks"][0]["color"] = "white"
	var white_hit: Dictionary = Tracer.trace(white_pass, Charts.make_state(white_pass, true))
	check(_leaves(white_hit, 3, 3, "N", "white") and not _leaves(white_hit, 3, 3, "N", "red") and not _leaves(white_hit, 3, 3, "N", "blue") and white_hit["docks"]["Rd"].has("white") and white_hit["docks"]["Rd"].size() == 1 and white_hit["docks"]["Bd"].has("blue") and Tracer.is_cleared(white_pass, Charts.make_state(white_pass, true)), "chart 161 keeps white")
	var straight: Dictionary = book[3]
	var straight_hit: Dictionary = Tracer.trace(straight, Charts.make_state(straight, true))
	check(_arrives_from(straight_hit, 3, 3, "N", "white") and _leaves(straight_hit, 3, 3, "N", "white") and not _leaves(straight_hit, 3, 3, "E", "white") and not _leaves(straight_hit, 3, 3, "S", "white") and not _leaves(straight_hit, 3, 3, "W", "white"), "chart 162 the northbound beam leaves on the same side it entered")
	check(_arrives_from(straight_hit, 3, 3, "W", "red") and _leaves(straight_hit, 3, 3, "W", "red") and not _leaves(straight_hit, 3, 3, "N", "red") and not _leaves(straight_hit, 3, 3, "S", "red") and not _leaves(straight_hit, 3, 3, "E", "red"), "chart 162 the westbound beam leaves on the same side it entered")
	var beside: Dictionary = book[4]
	check(int(beside["tide_phases"][0]) == 2, "chart 163 holds a flooded neighbor")
	var beside_state := Charts.make_state(beside, true)
	check(not Tracer.is_flooded(beside, beside_state, Vector2i(4, 2)) and Tracer.is_flooded(beside, beside_state, Vector2i(1, 4)), "chart 163 scotia row is dry and the next row is flooded")
	var beside_hit: Dictionary = Tracer.trace(beside, beside_state)
	check(_leaves(beside_hit, 4, 2, "W", "white") and _leaves(beside_hit, 4, 2, "N", "blue") and beside_hit["docks"]["Wd"].has("white") and beside_hit["docks"]["Nd"].has("blue") and beside_hit["docks"]["Kd"].is_empty() and not _center_hit(beside_hit, 1, 4), "chart 163 the dry row passes and the flood beam stops at the waterline")
	var pair: Dictionary = book[5]
	var pair_hit: Dictionary = Tracer.trace(pair, Charts.make_state(pair, true))
	check(_leaves(pair_hit, 3, 3, "N", "white") and _leaves(pair_hit, 3, 3, "W", "red") and _leaves(pair_hit, 7, 5, "S", "white") and _leaves(pair_hit, 7, 5, "E", "blue"), "chart 164 each scotia passes its open pair")
	check(pair_hit["docks"]["Ads"].is_empty() and pair_hit["docks"]["Bdn"].is_empty() and pair_hit["docks"]["Bdw"].is_empty(), "chart 164 each blocked direction stays dark")
	var swapped_pair := Charts.duplicate_state(Charts.make_state(pair, true))
	swapped_pair["pieces"]["S"]["rot"] = 180
	swapped_pair["pieces"]["T"]["rot"] = 0
	check(not Tracer.is_cleared(pair, swapped_pair), "chart 164 swapping the facings fails")
	var north_seat: Dictionary = Charts.scotia()[5]
	_retarget(north_seat, "S", "jamb", 0)
	var north_seat_hit: Dictionary = Tracer.trace(north_seat, Charts.make_state(north_seat, true))
