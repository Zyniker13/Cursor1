func _expect_bead_miss(index: int, piece_id: String, kind: String, rot: int, label: String) -> void:
	var chart: Dictionary = Charts.bead()[index]
	_retarget(chart, piece_id, kind, rot)
	var state := Charts.make_state(chart, true)
	if Tracer.is_cleared(chart, state):
		check(false, "%s clears bead chart %d" % [label, index + 215])
	else:
		check(true, "%s misses bead chart %d" % [label, index + 215])


