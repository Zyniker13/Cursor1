func test_astragal_book() -> void:
	var book: Array = Charts.astragal()
	check(book.size() == 8, "astragal book has eight charts")
	var titles := ["The Dry Astragal", "The Wet Stop", "Color Kept", "No Turn", "Beside the Flood", "Two Astragals", "The Held Astragal", "The Astragal Mark"]
	for i in book.size():
		var chart: Dictionary = book[i]
		check(str(chart["id"]) == str(i + 151), "astragal chart %d keeps its number" % (i + 151))
		check(str(chart["title"]) == str(titles[i]), "astragal chart %d keeps its title" % (i + 151))
		check(str(chart["harbor"]) == Charts.ASTRAGAL, "chart %s belongs to the astragal" % str(chart["id"]))
		var astragal_count := 0
		for raw_piece in chart["pieces"]:
			var piece: Dictionary = raw_piece
			if str(piece["kind"]) == "astragal":
				astragal_count += 1
		check(astragal_count >= 1, "chart %s needs the astragal" % str(chart["id"]))
	for older in Charts.all().slice(0, 150):
		for raw_piece in older["pieces"]:
			var older_piece: Dictionary = raw_piece
			check(str(older_piece["kind"]) != "astragal", "chart %s keeps its pieces" % str(older["id"]))
		for raw_fix in older["fixtures"]:
			var older_fix: Dictionary = raw_fix
			check(str(older_fix["kind"]) != "astragal", "chart %s keeps its fixed glass" % str(older["id"]))
	for i in book.size():
		for raw_piece in book[i]["pieces"]:
			var piece: Dictionary = raw_piece
			if str(piece["kind"]) != "astragal":
				continue
			var piece_id := str(piece["id"])
			_expect_astragal_miss(i, piece_id, "casement", 0, "casement north")
			_expect_astragal_miss(i, piece_id, "casement", 90, "casement east")
			_expect_astragal_miss(i, piece_id, "casement", 180, "casement south")
			_expect_astragal_miss(i, piece_id, "casement", 270, "casement west")
			_expect_astragal_miss(i, piece_id, "jamb", 0, "jamb north")
			_expect_astragal_miss(i, piece_id, "jamb", 90, "jamb east")
			_expect_astragal_miss(i, piece_id, "jamb", 180, "jamb south")
			_expect_astragal_miss(i, piece_id, "jamb", 270, "jamb west")
			_expect_astragal_miss(i, piece_id, "mullion", 0, "mullion")
			_expect_astragal_miss(i, piece_id, "transom", 0, "transom")
			_expect_astragal_miss(i, piece_id, "lintel", 0, "lintel")
			_expect_astragal_miss(i, piece_id, "shutter", 0, "shutter")
			_expect_astragal_miss(i, piece_id, "well", 0, "well")
			_expect_astragal_miss(i, piece_id, "siphon", 0, "siphon")
			_expect_astragal_miss(i, piece_id, "stain", 0, "red stain")
			_expect_astragal_miss(i, piece_id, "stain", 90, "blue stain")
			_expect_astragal_miss(i, piece_id, "mirror", 0, "mirror")
			_expect_astragal_miss(i, piece_id, "mirror", 90, "turned mirror")
			for facing in [0, 90, 180, 270]:
				_expect_astragal_miss(i, piece_id, "vane", facing, "vane %d" % facing)
				_expect_astragal_miss(i, piece_id, "weir", facing, "weir %d" % facing)
				_expect_astragal_miss(i, piece_id, "sluice", facing, "sluice %d" % facing)
				_expect_astragal_miss(i, piece_id, "prism", facing, "prism %d" % facing)
	var dry: Dictionary = book[0]
