func _expect_astragal_miss(index: int, piece_id: String, kind: String, rot: int, label: String) -> void:
	var chart: Dictionary = Charts.astragal()[index]
	_retarget(chart, piece_id, kind, rot)
	var state := Charts.make_state(chart, true)
	if Tracer.is_cleared(chart, state):
		check(false, "%s clears astragal chart %d" % [label, index + 151])
	else:
		check(true, "%s misses astragal chart %d" % [label, index + 151])


func test_scotia_rule() -> void:
	check(Tracer.norm_rot("scotia", 0) == 0 and Tracer.norm_rot("scotia", 90) == 90, "a scotia keeps a quarter turn")
	check(Tracer.norm_rot("scotia", 180) == 180 and Tracer.norm_rot("scotia", 270) == 270, "a scotia keeps a half turn")
	check(Tracer.norm_rot("scotia", 360) == 0 and Tracer.norm_rot("scotia", 450) == 90, "a scotia wraps a full turn")
	check(Tracer.turn_rot("scotia", 0) == 90 and Tracer.turn_rot("scotia", 90) == 180, "clicking a scotia walks the facing")
	check(Tracer.turn_rot("scotia", 180) == 270 and Tracer.turn_rot("scotia", 270) == 0, "clicking a scotia returns to north")
	check(Tracer.scotia_facing(0) == "N" and Tracer.scotia_facing(90) == "E" and Tracer.scotia_facing(180) == "S" and Tracer.scotia_facing(270) == "W", "scotia facing follows the quarter turn")
	check(Tracer.rotate_dir("N", -1) == "W" and Tracer.scotia_passes(0, "N") and Tracer.scotia_passes(0, "W"), "a north scotia passes north and west")
	check(not Tracer.scotia_passes(0, "E") and not Tracer.scotia_passes(0, "S"), "a north scotia stops east and south")
	check(Tracer.astragal_passes(0, "N") and Tracer.astragal_passes(0, "E") and not Tracer.astragal_passes(0, "W"), "a north astragal passes north and east, which a north scotia does not")
	var hinted: Dictionary = Charts.scotia()[6]
	var solved_hint := Charts.make_state(hinted, true)
	check(not Hints.wrong_pieces(hinted, solved_hint).has("S"), "a hint accepts the held north scotia")
	for spun in [90, 180, 270]:
		var turned_hint := Charts.duplicate_state(solved_hint)
		turned_hint["pieces"]["S"]["rot"] = spun
		check(Hints.wrong_pieces(hinted, turned_hint).has("S"), "a hint rejects scotia rotation %d" % spun)
		check(not Tracer.is_cleared(hinted, turned_hint), "scotia rotation %d is not the held open pair" % spun)
	var carried := {}
	carried[Vector2i(0, 0)] = {"kind": "scotia", "rot": 0}
	check(not Tracer._flood_carries(carried, Vector2i(0, 0)), "a flooded scotia does not carry the beam")
	# A north casement passes north and refuses west. A north scotia passes west as well.
	var north_out := _blank(1, 5)
	north_out["lanterns"] = [_lamp("L", 0, 4, "N", "white")]
	north_out["docks"] = [_need("D", 0, 0, "white")]
