	mullion_west["pieces"] = [_fixed_scotia("S", 2, 0, 0)]
	check(_leaves(Tracer.trace(mullion_west, Charts.make_state(mullion_west, true)), 2, 0, "W", "white"), "a north scotia passes the west a mullion cannot turn to")
	var transom_north := _blank(1, 5)
