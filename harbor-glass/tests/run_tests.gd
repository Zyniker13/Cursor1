	flood_stop["lanterns"] = [_lamp("L", 1, 2, "S", "blue")]
	flood_stop["fixtures"] = [
		{"id": "M", "kind": "tide_mirror", "x": 1, "y": 4, "rot": 90},
		{"id": "A", "kind": "shutter", "x": 2, "y": 4, "rot": 0},
