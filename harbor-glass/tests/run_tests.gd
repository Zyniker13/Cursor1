func _expect_ogee_miss(index: int, piece_id: String, kind: String, rot: int, label: String) -> void:
	var chart: Dictionary = Charts.ogee()[index]
	_retarget(chart, piece_id, kind, rot)
	var state := Charts.make_state(chart, true)
	if Tracer.is_cleared(chart, state):
		check(false, "%s clears ogee chart %d" % [label, index + 175])
	else:
		check(true, "%s misses ogee chart %d" % [label, index + 175])


func test_ovolo_rule() -> void:
	check(Tracer.norm_rot("ovolo", 0) == 0 and Tracer.norm_rot("ovolo", 90) == 90, "an ovolo keeps a quarter turn")
	check(Tracer.norm_rot("ovolo", 180) == 180 and Tracer.norm_rot("ovolo", 270) == 270, "an ovolo keeps a half turn")
	check(Tracer.norm_rot("ovolo", 360) == 0 and Tracer.norm_rot("ovolo", 450) == 90, "an ovolo wraps a full turn")
	check(Tracer.turn_rot("ovolo", 0) == 90 and Tracer.turn_rot("ovolo", 90) == 180, "clicking an ovolo walks the facing")
	check(Tracer.turn_rot("ovolo", 180) == 270 and Tracer.turn_rot("ovolo", 270) == 0, "clicking an ovolo returns to north")
	check(Tracer.ovolo_facing(0) == "N" and Tracer.ovolo_facing(90) == "E" and Tracer.ovolo_facing(180) == "S" and Tracer.ovolo_facing(270) == "W", "ovolo facing follows the quarter turn")
	check(Tracer.ovolo_passes(0, "E") and Tracer.ovolo_passes(0, "S") and Tracer.ovolo_passes(0, "W") and not Tracer.ovolo_passes(0, "N"), "a north ovolo passes east, south, and west")
	check(Tracer.ogee_passes(0, "S") and Tracer.ogee_passes(0, "W") and not Tracer.ogee_passes(0, "E") and Tracer.ovolo_passes(0, "E"), "a north ovolo passes the east a north ogee stops")
	check(Tracer.torus_passes(0, "S") and Tracer.torus_passes(0, "E") and not Tracer.torus_passes(0, "W") and Tracer.ovolo_passes(0, "W"), "a north ovolo passes the west a north torus stops")
	check(Tracer.scotia_passes(0, "N") and not Tracer.ovolo_passes(0, "N"), "a north ovolo stops the facing a north scotia passes")
	check(Tracer.astragal_passes(0, "N") and Tracer.astragal_passes(0, "E") and not Tracer.ovolo_passes(0, "N"), "a north ovolo is not a north astragal")
	check(Tracer.casement_facing(0) == "N" and not Tracer.ovolo_passes(0, "N"), "a north ovolo does not pass the only direction a north casement passes")
	var hinted: Dictionary = Charts.ovolo()[6]
	var solved_hint := Charts.make_state(hinted, true)
	check(not Hints.wrong_pieces(hinted, solved_hint).has("O"), "a hint accepts the held north ovolo")
	for spun in [90, 180, 270]:
		var turned_hint := Charts.duplicate_state(solved_hint)
		turned_hint["pieces"]["O"]["rot"] = spun
		check(Hints.wrong_pieces(hinted, turned_hint).has("O"), "a hint rejects ovolo rotation %d" % spun)
		check(not Tracer.is_cleared(hinted, turned_hint), "ovolo rotation %d is not the held open set" % spun)
	var carried := {}
	carried[Vector2i(0, 0)] = {"kind": "ovolo", "rot": 0}
	check(not Tracer._flood_carries(carried, Vector2i(0, 0)), "a flooded ovolo does not carry the beam")
	var south_out := _blank(1, 5)
	south_out["lanterns"] = [_lamp("L", 0, 0, "S", "white")]
	south_out["docks"] = [_need("D", 0, 4, "white")]
	south_out["pieces"] = [_fixed_casement("C", 0, 2, 0)]
	check(not _center_hit(Tracer.trace(south_out, Charts.make_state(south_out, true)), 0, 2), "a north casement refuses south")
	south_out["pieces"] = [_fixed_ovolo("O", 0, 2, 0)]
	var south_ovolo: Dictionary = Tracer.trace(south_out, Charts.make_state(south_out, true))
