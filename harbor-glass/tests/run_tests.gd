func test_bead_book() -> void:
	var book: Array = Charts.bead()
	check(book.size() == 8, "bead book has eight charts")
	var titles := ["The Dry Bead", "The Wet Stop", "Color Kept", "No Turn", "Beside the Flood", "Two Beads", "The Held Bead", "The Bead Mark"]
	for i in book.size():
		var chart: Dictionary = book[i]
		check(str(chart["id"]) == str(i + 215), "bead chart %d keeps its number" % (i + 215))
		check(str(chart["title"]) == str(titles[i]), "bead chart %d keeps its title" % (i + 215))
		check(str(chart["harbor"]) == Charts.BEAD, "chart %s belongs to the bead" % str(chart["id"]))
		var bead_count := 0
		for raw_piece in chart["pieces"]:
			var piece: Dictionary = raw_piece
			if str(piece["kind"]) == "bead":
				bead_count += 1
		check(bead_count >= 1, "chart %s needs the bead" % str(chart["id"]))
	for older in Charts.all().slice(0, 214):
		for raw_piece in older["pieces"]:
			var older_piece: Dictionary = raw_piece
			check(str(older_piece["kind"]) != "bead", "chart %s keeps its pieces" % str(older["id"]))
		for raw_fix in older["fixtures"]:
			var older_fix: Dictionary = raw_fix
			check(str(older_fix["kind"]) != "bead", "chart %s keeps its fixed glass" % str(older["id"]))
	for i in book.size():
		for raw_piece in book[i]["pieces"]:
			var piece: Dictionary = raw_piece
			if str(piece["kind"]) != "bead":
				continue
			var piece_id := str(piece["id"])
			var open_dir := Tracer.rotate_dir(Tracer.bead_facing(int(piece["solution_rot"])), 1)
			for crot in [0, 90, 180, 270]:
				if Tracer.casement_facing(crot) != open_dir:
					_expect_bead_miss(i, piece_id, "casement", crot, "casement %d" % crot)
				if Tracer.rotate_dir(Tracer.fillet_facing(crot), 2) != open_dir:
					_expect_bead_miss(i, piece_id, "fillet", crot, "fillet %d" % crot)
			_expect_bead_miss(i, piece_id, "jamb", 0, "jamb north")
			_expect_bead_miss(i, piece_id, "jamb", 90, "jamb east")
			_expect_bead_miss(i, piece_id, "mullion", 0, "mullion")
			_expect_bead_miss(i, piece_id, "transom", 0, "transom")
			_expect_bead_miss(i, piece_id, "lintel", 0, "lintel")
			_expect_bead_miss(i, piece_id, "shutter", 0, "shutter")
			_expect_bead_miss(i, piece_id, "well", 0, "well")
			_expect_bead_miss(i, piece_id, "siphon", 0, "siphon")
			_expect_bead_miss(i, piece_id, "stain", 0, "red stain")
			_expect_bead_miss(i, piece_id, "stain", 90, "blue stain")
			_expect_bead_miss(i, piece_id, "mirror", 0, "mirror")
			_expect_bead_miss(i, piece_id, "mirror", 90, "turned mirror")
			_expect_bead_miss(i, piece_id, "corona", int(piece["solution_rot"]), "corona same facing")
			_expect_bead_miss(i, piece_id, "cavetto", int(piece["solution_rot"]), "cavetto same facing")
			_expect_bead_miss(i, piece_id, "ovolo", int(piece["solution_rot"]), "ovolo same facing")
			_expect_bead_miss(i, piece_id, "ogee", int(piece["solution_rot"]), "ogee same facing")
			_expect_bead_miss(i, piece_id, "torus", int(piece["solution_rot"]), "torus same facing")
			_expect_bead_miss(i, piece_id, "scotia", int(piece["solution_rot"]), "scotia same facing")
			_expect_bead_miss(i, piece_id, "astragal", int(piece["solution_rot"]), "astragal same facing")
			for facing in [0, 90, 180, 270]:
				_expect_bead_miss(i, piece_id, "vane", facing, "vane %d" % facing)
				_expect_bead_miss(i, piece_id, "weir", facing, "weir %d" % facing)
				_expect_bead_miss(i, piece_id, "sluice", facing, "sluice %d" % facing)
				_expect_bead_miss(i, piece_id, "prism", facing, "prism %d" % facing)
	var dry: Dictionary = book[0]
	check(int(dry["tide_phases"][0]) == 0 and int(dry["solution_tide_index"]) == 0, "chart 215 is tide index 0 and flood 0")
	var dry_hit: Dictionary = Tracer.trace(dry, Charts.make_state(dry, true))
	check(_leaves(dry_hit, 3, 3, "E", "white") and dry_hit["docks"]["Ed"].has("white") and dry_hit["docks"]["Ed"].size() == 1, "chart 215 passes only the eastbound beam")
	check(dry_hit["docks"]["Nd"].is_empty() and dry_hit["docks"]["Sd"].is_empty() and dry_hit["docks"]["Wd"].is_empty() and dry_hit["docks"]["Te"].is_empty(), "chart 215 refuses north, south, and west")
	var dry_once := Charts.duplicate_state(Charts.make_state(dry, true))
	dry_once["pieces"]["O"]["rot"] = 90
	var dry_once_hit: Dictionary = Tracer.trace(dry, dry_once)
	check(_leaves(dry_once_hit, 3, 3, "S", "blue") and not _leaves(dry_once_hit, 3, 3, "E", "white") and not Tracer.is_cleared(dry, dry_once), "chart 215 one click from north passes only south")
	var dry_case: Dictionary = Charts.bead()[0]
	_retarget(dry_case, "O", "casement", 0)
	check(Tracer.trace(dry_case, Charts.make_state(dry_case, true))["docks"]["Ed"].is_empty() and not Tracer.is_cleared(dry_case, Charts.make_state(dry_case, true)), "chart 215 a north casement passes only north")
	var dry_fillet: Dictionary = Charts.bead()[0]
	_retarget(dry_fillet, "O", "fillet", 0)
	check(Tracer.trace(dry_fillet, Charts.make_state(dry_fillet, true))["docks"]["Sd"].has("blue") and not Tracer.is_cleared(dry_fillet, Charts.make_state(dry_fillet, true)), "chart 215 a north fillet passes only south")
	var dry_corona: Dictionary = Charts.bead()[0]
	_retarget(dry_corona, "O", "corona", 0)
	check(Tracer.trace(dry_corona, Charts.make_state(dry_corona, true))["docks"]["Wd"].has("red") and not Tracer.is_cleared(dry_corona, Charts.make_state(dry_corona, true)), "chart 215 a north corona passes east and west")
	var dry_astra: Dictionary = Charts.bead()[0]
	_retarget(dry_astra, "O", "astragal", 0)
	check(Tracer.trace(dry_astra, Charts.make_state(dry_astra, true))["docks"]["Nd"].has("red") and not Tracer.is_cleared(dry_astra, Charts.make_state(dry_astra, true)), "chart 215 a north astragal passes north and east")
	var wet: Dictionary = book[1]
	check(int(wet["start_tide_index"]) == 1 and int(wet["solution_tide_index"]) == 0 and int(wet["tide_phases"][1]) == 4, "chart 216 opens under water and solves dry")
	var wet_start: Dictionary = Tracer.trace(wet, Charts.make_state(wet, false))
	check(wet_start["docks"]["Nd"].is_empty() and wet_start["docks"]["Ed"].is_empty() and wet_start["docks"]["Wd"].is_empty() and wet_start["docks"]["Sd"].is_empty() and not _center_hit(wet_start, 3, 4), "chart 216 flooded row stops the beam at the waterline")
	var wet_solved: Dictionary = Tracer.trace(wet, Charts.make_state(wet, true))
	check(_leaves(wet_solved, 3, 4, "E", "white") and wet_solved["docks"]["Ed"].has("white") and wet_solved["docks"]["Nd"].is_empty() and wet_solved["docks"]["Sd"].is_empty() and wet_solved["docks"]["Wd"].is_empty(), "chart 216 dry tide passes only east")
	var wet_open: Dictionary = Charts.bead()[1]
	_retarget(wet_open, "O", "shutter", 0)
	check(_center_hit(Tracer.trace(wet_open, Charts.make_state(wet_open, false)), 3, 4), "chart 216 a shutter passes while flooded")
	for carrier in ["well", "siphon", "sluice", "weir"]:
		var wet_carry: Dictionary = Charts.bead()[1]
		_retarget(wet_carry, "O", carrier, 180 if carrier == "sluice" or carrier == "weir" else 0)
		check(_center_hit(Tracer.trace(wet_carry, Charts.make_state(wet_carry, false)), 3, 4), "chart 216 a flooded %s carries the beam" % carrier)
	var kept: Dictionary = Charts.bead()[2]
	var kept_hit: Dictionary = Tracer.trace(kept, Charts.make_state(kept, true))
	check(_leaves(kept_hit, 3, 3, "E", "red") and kept_hit["docks"]["Ed"].has("red") and kept_hit["docks"]["Ed"].size() == 1 and kept_hit["docks"]["Nd"].is_empty() and kept_hit["docks"]["Tw"].is_empty(), "chart 217 keeps red")
	var white_pass: Dictionary = Charts.bead()[2]
	white_pass["lanterns"][0]["color"] = "white"
	white_pass["docks"][0]["color"] = "white"
	var white_hit: Dictionary = Tracer.trace(white_pass, Charts.make_state(white_pass, true))
	check(_leaves(white_hit, 3, 3, "E", "white") and not _leaves(white_hit, 3, 3, "E", "red") and not _leaves(white_hit, 3, 3, "E", "blue") and white_hit["docks"]["Ed"].has("white") and white_hit["docks"]["Ed"].size() == 1 and white_hit["docks"]["Nd"].is_empty() and white_hit["docks"]["Tw"].is_empty() and white_hit["docks"]["Tn"].is_empty() and Tracer.is_cleared(white_pass, Charts.make_state(white_pass, true)), "chart 217 keeps white")
	var straight_chart: Dictionary = book[3]
	var straight_hit: Dictionary = Tracer.trace(straight_chart, Charts.make_state(straight_chart, true))
	check(_arrives_from(straight_hit, 3, 3, "E", "white") and _leaves(straight_hit, 3, 3, "E", "white") and not _leaves(straight_hit, 3, 3, "N", "white") and not _leaves(straight_hit, 3, 3, "S", "white") and not _leaves(straight_hit, 3, 3, "W", "white"), "chart 218 the eastbound beam leaves on the same side it entered")
	check(not _leaves(straight_hit, 3, 3, "N", "red") and not _leaves(straight_hit, 3, 3, "S", "blue") and not _leaves(straight_hit, 3, 3, "W", "red"), "chart 218 the stopped beams do not leave")
	var beside: Dictionary = book[4]
	check(int(beside["tide_phases"][0]) == 2, "chart 219 holds a flooded neighbor")
	var beside_state := Charts.make_state(beside, true)
	check(not Tracer.is_flooded(beside, beside_state, Vector2i(3, 2)) and Tracer.is_flooded(beside, beside_state, Vector2i(1, 6)), "chart 219 bead row is dry and the flood row is flooded")
	var beside_hit: Dictionary = Tracer.trace(beside, beside_state)
	check(_leaves(beside_hit, 3, 2, "E", "white") and beside_hit["docks"]["Ed"].has("white") and beside_hit["docks"]["Nd"].is_empty() and beside_hit["docks"]["Sd"].is_empty() and beside_hit["docks"]["Wd"].is_empty() and not _center_hit(beside_hit, 1, 6), "chart 219 the dry row passes only east and the flood beam stops at the waterline")
	var pair: Dictionary = book[5]
	var pair_hit: Dictionary = Tracer.trace(pair, Charts.make_state(pair, true))
	check(_leaves(pair_hit, 2, 3, "E", "white") and not _leaves(pair_hit, 2, 3, "W", "red") and _leaves(pair_hit, 8, 5, "S", "white") and not _leaves(pair_hit, 8, 5, "N", "red"), "chart 220 each bead passes its own clockwise direction")
	check(pair_hit["docks"]["Adn"].is_empty() and pair_hit["docks"]["Adw"].is_empty() and pair_hit["docks"]["Bdn"].is_empty() and pair_hit["docks"]["Bde"].is_empty(), "chart 220 each blocked direction stays dark")
	var swapped_pair := Charts.duplicate_state(Charts.make_state(pair, true))
	swapped_pair["pieces"]["O"]["rot"] = 90
	swapped_pair["pieces"]["U"]["rot"] = 0
	check(not Tracer.is_cleared(pair, swapped_pair), "chart 220 swapping the facings fails")
	var east_seat: Dictionary = Charts.bead()[5]
	_retarget(east_seat, "O", "corona", 0)
	check(not Tracer.is_cleared(east_seat, Charts.make_state(east_seat, true)), "chart 220 a north corona cannot take the east seat")
	var held: Dictionary = book[6]
	check(int(held["tide_phases"][0]) == 0 and int(held["tide_phases"][1]) == 1 and int(held["tide_phases"][2]) == 5 and int(held["solution_tide_index"]) == 1 and int(held["start_tide_index"]) == 0, "chart 221 follows the held tide marks")
	var held_start := Charts.make_state(held, false)
	check(int(held_start["pieces"]["O"]["rot"]) == 180, "chart 221 starts facing south")
	var held_solved := Charts.make_state(held, true)
	var held_hit: Dictionary = Tracer.trace(held, held_solved)
	check(int(held_solved["pieces"]["O"]["rot"]) == 0 and _leaves(held_hit, 4, 3, "E", "white") and held_hit["docks"]["Ed"].has("white") and held_hit["docks"]["Nd"].is_empty() and not bool(held_hit["boats"]["Hb"]), "chart 221 the held facing passes only east")
	var held_low := Charts.duplicate_state(held_solved)
	held_low["tide_index"] = 0
	check(bool(Tracer.trace(held, held_low)["boats"]["Hb"]) and not Tracer.is_cleared(held, held_low), "chart 221 low water wakes the south hull")
	var held_high := Charts.duplicate_state(held_solved)
	held_high["tide_index"] = 2
	var held_high_hit: Dictionary = Tracer.trace(held, held_high)
	check(held_high_hit["docks"]["Ed"].is_empty() and not _center_hit(held_high_hit, 4, 3) and not Tracer.is_cleared(held, held_high), "chart 221 high water stops the beam outside the bead")
	var mark: Dictionary = book[7]
	var mark_solved := Charts.make_state(mark, true)
	check(str(mark_solved["pieces"]["O"]["socket"]) == "line" and int(mark_solved["pieces"]["O"]["rot"]) == 0 and str(mark_solved["pieces"]["G"]["socket"]) == "side", "chart 222 puts the north bead on the line")
	var mark_hit: Dictionary = Tracer.trace(mark, mark_solved)
	check(_leaves(mark_hit, 3, 3, "E", "white") and mark_hit["docks"]["Ed"].has("white") and mark_hit["docks"]["Nd"].is_empty() and mark_hit["docks"]["Sd"].is_empty() and mark_hit["docks"]["Wd"].is_empty(), "chart 222 the open direction satisfies the mark")
	var mark_case: Dictionary = Charts.bead()[7]
	_retarget(mark_case, "O", "casement", 0)
	check(not Tracer.is_cleared(mark_case, Charts.make_state(mark_case, true)), "chart 222 a north casement in that cell fails")
	var mark_fillet: Dictionary = Charts.bead()[7]
	_retarget(mark_fillet, "O", "fillet", 0)
	check(not Tracer.is_cleared(mark_fillet, Charts.make_state(mark_fillet, true)), "chart 222 a north fillet in that cell fails")
	var mark_corona: Dictionary = Charts.bead()[7]
	_retarget(mark_corona, "O", "corona", 0)
	check(not Tracer.is_cleared(mark_corona, Charts.make_state(mark_corona, true)), "chart 222 a north corona in that cell fails")
	var mark_astra: Dictionary = Charts.bead()[7]
	_retarget(mark_astra, "O", "astragal", 0)
	check(not Tracer.is_cleared(mark_astra, Charts.make_state(mark_astra, true)), "chart 222 a north astragal in that cell fails")
	var mark_lintel: Dictionary = Charts.bead()[7]
