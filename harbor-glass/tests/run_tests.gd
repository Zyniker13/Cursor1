	var kinds: Array = ["abacus", "archivolt", "throat", "hood", "architrave", "cyma", "impost", "threshold", "corona", "larmier", "cill", "fillet", "drip", "beak", "vane", "weir", "sluice", "prism", "jamb", "transom", "mullion", "lintel", "shutter", "stain"]
