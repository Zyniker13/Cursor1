	check(_leaves(Tracer.trace(transom_north, Charts.make_state(transom_north, true)), 0, 2, "N", "white"), "a north scotia passes the north a transom cannot turn to")
	var clicked := _blank(5, 5)
	clicked["lanterns"] = [_lamp("L", 2, 4, "N", "white")]
