func test_torus_book() -> void:
	var book: Array = Charts.torus()
	check(book.size() == 8, "torus book has eight charts")
	var titles := ["The Dry Torus", "The Wet Stop", "Color Kept", "No Turn", "Beside the Flood", "Two Tori", "The Held Torus", "The Torus Mark"]
	for i in book.size():
		var chart: Dictionary = book[i]
		check(str(chart["id"]) == str(i + 167), "torus chart %d keeps its number" % (i + 167))
		check(str(chart["title"]) == str(titles[i]), "torus chart %d keeps its title" % (i + 167))
		check(str(chart["harbor"]) == Charts.TORUS, "chart %s belongs to the torus" % str(chart["id"]))
		var torus_count := 0
		for raw_piece in chart["pieces"]:
			var piece: Dictionary = raw_piece
			if str(piece["kind"]) == "torus":
				torus_count += 1
		check(torus_count >= 1, "chart %s needs the torus" % str(chart["id"]))
	for older in Charts.all().slice(0, 166):
		for raw_piece in older["pieces"]:
			var older_piece: Dictionary = raw_piece
			check(str(older_piece["kind"]) != "torus", "chart %s keeps its pieces" % str(older["id"]))
		for raw_fix in older["fixtures"]:
			var older_fix: Dictionary = raw_fix
			check(str(older_fix["kind"]) != "torus", "chart %s keeps its fixed glass" % str(older["id"]))
	for i in book.size():
		for raw_piece in book[i]["pieces"]:
			var piece: Dictionary = raw_piece
			if str(piece["kind"]) != "torus":
				continue
			var piece_id := str(piece["id"])
			_expect_torus_miss(i, piece_id, "casement", 0, "casement north")
			_expect_torus_miss(i, piece_id, "casement", 90, "casement east")
			_expect_torus_miss(i, piece_id, "casement", 180, "casement south")
			_expect_torus_miss(i, piece_id, "casement", 270, "casement west")
			_expect_torus_miss(i, piece_id, "jamb", 0, "jamb north")
			_expect_torus_miss(i, piece_id, "jamb", 90, "jamb east")
			_expect_torus_miss(i, piece_id, "jamb", 180, "jamb south")
			_expect_torus_miss(i, piece_id, "jamb", 270, "jamb west")
			_expect_torus_miss(i, piece_id, "mullion", 0, "mullion")
			_expect_torus_miss(i, piece_id, "transom", 0, "transom")
			_expect_torus_miss(i, piece_id, "lintel", 0, "lintel")
			_expect_torus_miss(i, piece_id, "shutter", 0, "shutter")
			_expect_torus_miss(i, piece_id, "well", 0, "well")
			_expect_torus_miss(i, piece_id, "siphon", 0, "siphon")
			_expect_torus_miss(i, piece_id, "stain", 0, "red stain")
			_expect_torus_miss(i, piece_id, "stain", 90, "blue stain")
			_expect_torus_miss(i, piece_id, "mirror", 0, "mirror")
			_expect_torus_miss(i, piece_id, "mirror", 90, "turned mirror")
			_expect_torus_miss(i, piece_id, "scotia", int(piece["solution_rot"]), "scotia same facing")
			_expect_torus_miss(i, piece_id, "astragal", int(piece["solution_rot"]), "astragal same facing")
			for facing in [0, 90, 180, 270]:
				_expect_torus_miss(i, piece_id, "vane", facing, "vane %d" % facing)
				_expect_torus_miss(i, piece_id, "weir", facing, "weir %d" % facing)
				_expect_torus_miss(i, piece_id, "sluice", facing, "sluice %d" % facing)
				_expect_torus_miss(i, piece_id, "prism", facing, "prism %d" % facing)
	var dry: Dictionary = book[0]
	check(int(dry["tide_phases"][0]) == 0 and int(dry["solution_tide_index"]) == 0, "chart 167 is tide index 0 and flood 0")
	var dry_hit: Dictionary = Tracer.trace(dry, Charts.make_state(dry, true))
	check(_leaves(dry_hit, 3, 3, "S", "white") and dry_hit["docks"]["Sd"].has("white") and dry_hit["docks"]["Sd"].size() == 1, "chart 167 passes the southbound beam")
	check(_leaves(dry_hit, 3, 3, "E", "red") and dry_hit["docks"]["Ed"].has("red") and dry_hit["docks"]["Ed"].size() == 1, "chart 167 passes the eastbound beam")
	check(dry_hit["docks"]["Kd"].is_empty(), "chart 167 refuses the northbound return")
	var dry_case: Dictionary = Charts.torus()[0]
	_retarget(dry_case, "T", "casement", 180)
	var dry_case_hit: Dictionary = Tracer.trace(dry_case, Charts.make_state(dry_case, true))
	check(dry_case_hit["docks"]["Sd"].has("white") and dry_case_hit["docks"]["Ed"].is_empty() and not Tracer.is_cleared(dry_case, Charts.make_state(dry_case, true)), "chart 167 a casement refuses the eastbound beam")
	var dry_jamb: Dictionary = Charts.torus()[0]
	_retarget(dry_jamb, "T", "jamb", 0)
	var dry_jamb_hit: Dictionary = Tracer.trace(dry_jamb, Charts.make_state(dry_jamb, true))
	check(dry_jamb_hit["docks"]["Ed"].is_empty() and dry_jamb_hit["docks"]["Kd"].has("blue") and not Tracer.is_cleared(dry_jamb, Charts.make_state(dry_jamb, true)), "chart 167 a jamb refuses the eastbound beam and passes the northbound return")
	var dry_scotia: Dictionary = Charts.torus()[0]
	_retarget(dry_scotia, "T", "scotia", 0)
	var dry_scotia_hit: Dictionary = Tracer.trace(dry_scotia, Charts.make_state(dry_scotia, true))
	check(dry_scotia_hit["docks"]["Sd"].is_empty() and dry_scotia_hit["docks"]["Ed"].is_empty() and not Tracer.is_cleared(dry_scotia, Charts.make_state(dry_scotia, true)), "chart 167 a scotia facing north refuses the southbound beam")
	var dry_astra: Dictionary = Charts.torus()[0]
	_retarget(dry_astra, "T", "astragal", 0)
	var dry_astra_hit: Dictionary = Tracer.trace(dry_astra, Charts.make_state(dry_astra, true))
	check(dry_astra_hit["docks"]["Sd"].is_empty() and dry_astra_hit["docks"]["Ed"].has("red") and not Tracer.is_cleared(dry_astra, Charts.make_state(dry_astra, true)), "chart 167 an astragal facing north refuses the southbound beam")
	var wet: Dictionary = book[1]
	check(int(wet["start_tide_index"]) == 1 and int(wet["solution_tide_index"]) == 0 and int(wet["tide_phases"][1]) == 3, "chart 168 opens under water and solves dry")
	var wet_start: Dictionary = Tracer.trace(wet, Charts.make_state(wet, false))
	check(wet_start["docks"]["Sd"].is_empty() and wet_start["docks"]["Ed"].is_empty() and not _center_hit(wet_start, 3, 4), "chart 168 flooded row stops the beam at the waterline")
	var wet_solved: Dictionary = Tracer.trace(wet, Charts.make_state(wet, true))
	check(_leaves(wet_solved, 3, 4, "S", "white") and _leaves(wet_solved, 3, 4, "E", "red") and wet_solved["docks"]["Sd"].has("white") and wet_solved["docks"]["Ed"].has("red") and wet_solved["docks"]["Kd"].is_empty(), "chart 168 dry tide passes south and east")
	var wet_open: Dictionary = Charts.torus()[1]
	_retarget(wet_open, "T", "shutter", 0)
	var wet_open_state := Charts.make_state(wet_open, false)
	check(_center_hit(Tracer.trace(wet_open, wet_open_state), 3, 4), "chart 168 a shutter passes while flooded")
	for carrier in ["well", "siphon", "sluice", "weir"]:
		var wet_carry: Dictionary = Charts.torus()[1]
		_retarget(wet_carry, "T", carrier, 180 if carrier == "sluice" or carrier == "weir" else 0)
		var carry_state := Charts.make_state(wet_carry, false)
		check(_center_hit(Tracer.trace(wet_carry, carry_state), 3, 4), "chart 168 a flooded %s carries the beam" % carrier)
	var kept: Dictionary = Charts.torus()[2]
	var kept_hit: Dictionary = Tracer.trace(kept, Charts.make_state(kept, true))
	check(_leaves(kept_hit, 3, 3, "S", "red") and kept_hit["docks"]["Rd"].has("red") and kept_hit["docks"]["Rd"].size() == 1, "chart 169 keeps red")
	check(_leaves(kept_hit, 3, 3, "E", "blue") and kept_hit["docks"]["Bd"].has("blue") and kept_hit["docks"]["Bd"].size() == 1, "chart 169 keeps blue")
	var white_pass: Dictionary = Charts.torus()[2]
	white_pass["lanterns"][0]["color"] = "white"
	white_pass["docks"][0]["color"] = "white"
	var white_hit: Dictionary = Tracer.trace(white_pass, Charts.make_state(white_pass, true))
	check(_leaves(white_hit, 3, 3, "S", "white") and not _leaves(white_hit, 3, 3, "S", "red") and not _leaves(white_hit, 3, 3, "S", "blue") and white_hit["docks"]["Rd"].has("white") and white_hit["docks"]["Rd"].size() == 1 and white_hit["docks"]["Bd"].has("blue") and Tracer.is_cleared(white_pass, Charts.make_state(white_pass, true)), "chart 169 keeps white")
	var straight_chart: Dictionary = book[3]
	var straight_hit: Dictionary = Tracer.trace(straight_chart, Charts.make_state(straight_chart, true))
	check(_arrives_from(straight_hit, 3, 3, "S", "white") and _leaves(straight_hit, 3, 3, "S", "white") and not _leaves(straight_hit, 3, 3, "E", "white") and not _leaves(straight_hit, 3, 3, "N", "white") and not _leaves(straight_hit, 3, 3, "W", "white"), "chart 170 the southbound beam leaves on the same side it entered")
	check(_arrives_from(straight_hit, 3, 3, "E", "red") and _leaves(straight_hit, 3, 3, "E", "red") and not _leaves(straight_hit, 3, 3, "N", "red") and not _leaves(straight_hit, 3, 3, "S", "red") and not _leaves(straight_hit, 3, 3, "W", "red"), "chart 170 the eastbound beam leaves on the same side it entered")
	var beside: Dictionary = book[4]
	check(int(beside["tide_phases"][0]) == 2, "chart 171 holds a flooded neighbor")
	var beside_state := Charts.make_state(beside, true)
	check(not Tracer.is_flooded(beside, beside_state, Vector2i(4, 2)) and Tracer.is_flooded(beside, beside_state, Vector2i(1, 4)), "chart 171 torus row is dry and the next row is flooded")
	var beside_hit: Dictionary = Tracer.trace(beside, beside_state)
	check(_leaves(beside_hit, 4, 2, "E", "white") and _leaves(beside_hit, 4, 2, "S", "blue") and beside_hit["docks"]["Ed"].has("white") and beside_hit["docks"]["Sd"].has("blue") and beside_hit["docks"]["Kd"].is_empty() and not _center_hit(beside_hit, 1, 4), "chart 171 the dry row passes and the flood beam stops at the waterline")
	var pair: Dictionary = book[5]
	var pair_hit: Dictionary = Tracer.trace(pair, Charts.make_state(pair, true))
	check(_leaves(pair_hit, 3, 3, "N", "white") and _leaves(pair_hit, 3, 3, "W", "red") and _leaves(pair_hit, 7, 5, "S", "white") and _leaves(pair_hit, 7, 5, "E", "blue"), "chart 172 each torus passes its open pair")
	check(pair_hit["docks"]["Ads"].is_empty() and pair_hit["docks"]["Bdn"].is_empty() and pair_hit["docks"]["Bdw"].is_empty(), "chart 172 each blocked direction stays dark")
	var swapped_pair := Charts.duplicate_state(Charts.make_state(pair, true))
	swapped_pair["pieces"]["T"]["rot"] = 0
	swapped_pair["pieces"]["U"]["rot"] = 180
	check(not Tracer.is_cleared(pair, swapped_pair), "chart 172 swapping the facings fails")
	var north_seat: Dictionary = Charts.torus()[5]
	_retarget(north_seat, "T", "jamb", 0)
	var north_seat_hit: Dictionary = Tracer.trace(north_seat, Charts.make_state(north_seat, true))
	check(north_seat_hit["docks"]["Ads"].has("blue") and north_seat_hit["docks"]["Adw"].is_empty() and not Tracer.is_cleared(north_seat, Charts.make_state(north_seat, true)), "chart 172 a north jamb cannot take the north-and-west seat")
	var held: Dictionary = book[6]
	check(int(held["tide_phases"][0]) == 0 and int(held["tide_phases"][1]) == 1 and int(held["tide_phases"][2]) == 4 and int(held["solution_tide_index"]) == 1 and int(held["start_tide_index"]) == 0, "chart 173 follows the held tide marks")
	var held_start := Charts.make_state(held, false)
	check(int(held_start["pieces"]["T"]["rot"]) == 180, "chart 173 starts on the other open pair")
	var held_solved := Charts.make_state(held, true)
	var held_hit: Dictionary = Tracer.trace(held, held_solved)
	check(int(held_solved["pieces"]["T"]["rot"]) == 0 and _leaves(held_hit, 3, 3, "S", "white") and _leaves(held_hit, 3, 3, "E", "blue") and held_hit["docks"]["Kd"].is_empty() and not bool(held_hit["boats"]["Hb"]), "chart 173 the held facing passes south and east")
	var held_low := Charts.duplicate_state(held_solved)
	held_low["tide_index"] = 0
	check(bool(Tracer.trace(held, held_low)["boats"]["Hb"]) and not Tracer.is_cleared(held, held_low), "chart 173 low water wakes the south hull")
	var held_high := Charts.duplicate_state(held_solved)
	held_high["tide_index"] = 2
	var held_high_hit: Dictionary = Tracer.trace(held, held_high)
	check(held_high_hit["docks"]["Sd"].is_empty() and not _center_hit(held_high_hit, 3, 3) and not Tracer.is_cleared(held, held_high), "chart 173 high water stops the beam outside the torus")
	var mark: Dictionary = book[7]
	var mark_solved := Charts.make_state(mark, true)
	check(str(mark_solved["pieces"]["T"]["socket"]) == "line" and int(mark_solved["pieces"]["T"]["rot"]) == 0 and str(mark_solved["pieces"]["G"]["socket"]) == "side", "chart 174 puts the north torus on the line")
	var mark_hit: Dictionary = Tracer.trace(mark, mark_solved)
	check(_leaves(mark_hit, 3, 3, "S", "white") and _leaves(mark_hit, 3, 3, "E", "red") and mark_hit["docks"]["Sd"].has("white") and mark_hit["docks"]["Ed"].has("red") and mark_hit["docks"]["Kd"].is_empty(), "chart 174 the open pair satisfies the mark")
	var mark_case: Dictionary = Charts.torus()[7]
	_retarget(mark_case, "T", "casement", 0)
	check(not Tracer.is_cleared(mark_case, Charts.make_state(mark_case, true)), "chart 174 a casement in that cell fails")
	var mark_jamb: Dictionary = Charts.torus()[7]
	_retarget(mark_jamb, "T", "jamb", 0)
	check(not Tracer.is_cleared(mark_jamb, Charts.make_state(mark_jamb, true)), "chart 174 a jamb in that cell fails")
	var mark_mullion: Dictionary = Charts.torus()[7]
	_retarget(mark_mullion, "T", "mullion", 0)
	check(not Tracer.is_cleared(mark_mullion, Charts.make_state(mark_mullion, true)), "chart 174 a mullion in that cell fails")
	var mark_transom: Dictionary = Charts.torus()[7]
	_retarget(mark_transom, "T", "transom", 0)
	check(not Tracer.is_cleared(mark_transom, Charts.make_state(mark_transom, true)), "chart 174 a transom in that cell fails")
	var mark_lintel: Dictionary = Charts.torus()[7]
	_retarget(mark_lintel, "T", "lintel", 0)
	check(not Tracer.is_cleared(mark_lintel, Charts.make_state(mark_lintel, true)), "chart 174 a lintel in that cell fails")
	var mark_scotia: Dictionary = Charts.torus()[7]
	_retarget(mark_scotia, "T", "scotia", 0)
	check(not Tracer.is_cleared(mark_scotia, Charts.make_state(mark_scotia, true)), "chart 174 a scotia in that cell fails")
	var mark_astra: Dictionary = Charts.torus()[7]
	_retarget(mark_astra, "T", "astragal", 0)
	check(not Tracer.is_cleared(mark_astra, Charts.make_state(mark_astra, true)), "chart 174 an astragal in that cell fails")
	check(str(book[0]["teach"]).to_lower().contains("tide index 0") and str(book[0]["teach"]).to_lower().contains("casement") and str(book[0]["teach"]).to_lower().contains("jamb") and str(book[0]["teach"]).to_lower().contains("eastbound") and str(book[0]["teach"]).to_lower().contains("return"), "chart 167 teaches the dry torus")
	check(str(book[1]["teach"]).to_lower().contains("waterline") and str(book[1]["teach"]).to_lower().contains("shutter") and str(book[1]["teach"]).to_lower().contains("well") and str(book[1]["teach"]).to_lower().contains("siphon") and str(book[1]["teach"]).to_lower().contains("sluice") and str(book[1]["teach"]).to_lower().contains("weir"), "chart 168 teaches the wet stop")
	check(str(book[2]["teach"]).to_lower().contains("red stays red") and str(book[2]["teach"]).to_lower().contains("blue stays blue") and str(book[2]["teach"]).to_lower().contains("white stays white") and str(book[2]["teach"]).to_lower().contains("stain") and str(book[2]["teach"]).to_lower().contains("weir"), "chart 169 teaches the kept color")
	check(str(book[3]["teach"]).to_lower().contains("does not turn") and str(book[3]["teach"]).to_lower().contains("prism") and str(book[3]["teach"]).to_lower().contains("vane") and str(book[3]["teach"]).to_lower().contains("sluice") and str(book[3]["teach"]).to_lower().contains("mirror"), "chart 170 teaches the straight pass")
	check(str(book[4]["teach"]).to_lower().contains("waterline") and str(book[4]["teach"]).to_lower().contains("dry"), "chart 171 teaches the dry row beside the flood")
	check(str(book[5]["teach"]).to_lower().contains("north and west") and str(book[5]["teach"]).to_lower().contains("south and east") and str(book[5]["teach"]).to_lower().contains("jamb") and str(book[5]["teach"]).to_lower().contains("south"), "chart 172 teaches both tori")
