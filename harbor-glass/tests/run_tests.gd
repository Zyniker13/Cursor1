		check(str(chart["harbor"]) == Charts.FILLET, "chart %s belongs to the fillet" % str(chart["id"]))
		var fillet_count := 0
		for raw_piece in chart["pieces"]:
			var piece: Dictionary = raw_piece
			if str(piece["kind"]) == "fillet":
				fillet_count += 1
