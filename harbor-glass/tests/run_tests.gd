func _expect_cyma_miss(index: int, piece_id: String, kind: String, rot: int, label: String) -> void:
	var chart: Dictionary = Charts.cyma()[index]
	_retarget(chart, piece_id, kind, rot)
	var state := Charts.make_state(chart, true)
	if Tracer.is_cleared(chart, state):
		check(false, "%s clears cyma chart %d" % [label, index + 231])
	else:
		check(true, "%s misses cyma chart %d" % [label, index + 231])


func test_fascia_rule() -> void:
	check(Tracer.norm_rot("fascia", 0) == 0 and Tracer.norm_rot("fascia", 90) == 90, "a fascia keeps a quarter turn")
	check(Tracer.norm_rot("fascia", 180) == 180 and Tracer.norm_rot("fascia", 270) == 270, "a fascia keeps a half turn")
	check(Tracer.norm_rot("fascia", 360) == 0 and Tracer.norm_rot("fascia", 450) == 90, "a fascia wraps a full turn")
	check(Tracer.turn_rot("fascia", 0) == 90 and Tracer.turn_rot("fascia", 90) == 180, "clicking a fascia walks the facing")
	check(Tracer.turn_rot("fascia", 180) == 270 and Tracer.turn_rot("fascia", 270) == 0, "clicking a fascia returns to north")
	check(Tracer.fascia_facing(0) == "N" and Tracer.fascia_facing(90) == "E" and Tracer.fascia_facing(180) == "S" and Tracer.fascia_facing(270) == "W", "fascia facing follows the quarter turn")
	check(Tracer.fascia_passes(0, "N") and Tracer.fascia_passes(0, "S") and Tracer.fascia_passes(0, "W") and not Tracer.fascia_passes(0, "E"), "a north fascia passes north, south, and west")
	check(Tracer.fascia_passes(90, "N") and Tracer.fascia_passes(90, "E") and Tracer.fascia_passes(90, "W") and not Tracer.fascia_passes(90, "S"), "a fascia turned once from north stops only south")
	check(not Tracer.fascia_passes(180, "W") and Tracer.fascia_passes(180, "E"), "two clicks face south and stop west")
	check(not Tracer.fascia_passes(270, "N") and Tracer.fascia_passes(270, "S"), "three clicks face west and stop north")
