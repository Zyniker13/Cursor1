func _expect_scotia_miss(index: int, piece_id: String, kind: String, rot: int, label: String) -> void:
	var chart: Dictionary = Charts.scotia()[index]
	_retarget(chart, piece_id, kind, rot)
	var state := Charts.make_state(chart, true)
	if Tracer.is_cleared(chart, state):
		check(false, "%s clears scotia chart %d" % [label, index + 159])
	else:
		check(true, "%s misses scotia chart %d" % [label, index + 159])


func test_torus_rule() -> void:
	check(Tracer.norm_rot("torus", 0) == 0 and Tracer.norm_rot("torus", 90) == 90, "a torus keeps a quarter turn")
	check(Tracer.norm_rot("torus", 180) == 180 and Tracer.norm_rot("torus", 270) == 270, "a torus keeps a half turn")
	check(Tracer.norm_rot("torus", 360) == 0 and Tracer.norm_rot("torus", 450) == 90, "a torus wraps a full turn")
	check(Tracer.turn_rot("torus", 0) == 90 and Tracer.turn_rot("torus", 90) == 180, "clicking a torus walks the facing")
	check(Tracer.turn_rot("torus", 180) == 270 and Tracer.turn_rot("torus", 270) == 0, "clicking a torus returns to north")
	check(Tracer.torus_facing(0) == "N" and Tracer.torus_facing(90) == "E" and Tracer.torus_facing(180) == "S" and Tracer.torus_facing(270) == "W", "torus facing follows the quarter turn")
	check(Tracer.rotate_dir("N", 2) == "S" and Tracer.rotate_dir("N", 1) == "E" and Tracer.torus_passes(0, "S") and Tracer.torus_passes(0, "E"), "a north torus passes south and east")
	check(not Tracer.torus_passes(0, "N") and not Tracer.torus_passes(0, "W"), "a north torus stops north and west")
	check(Tracer.scotia_passes(0, "N") and Tracer.scotia_passes(0, "W") and not Tracer.torus_passes(0, "N") and not Tracer.torus_passes(0, "W"), "a north torus does not pass the north scotia pair")
	check(Tracer.astragal_passes(0, "N") and Tracer.astragal_passes(0, "E") and not (Tracer.torus_passes(0, "N") and Tracer.torus_passes(0, "E")), "a north torus does not pass the north astragal pair")
