	wet["solution_tide_index"] = 1
	wet["lanterns"] = [_lamp("L", 1, 0, "S", "red")]
	wet["docks"] = [_need("D", 2, 1, "red")]
	wet["pieces"] = [
		_fixed_shutter("G", 1, 2),
		_fixed_shutter("U", 2, 2),
		_fixed_tide("T", 1, 3, 90),
		_fixed_tide("B", 2, 3, 0),
	]
