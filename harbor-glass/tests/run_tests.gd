func test_quirk_book() -> void:
	var book: Array = Charts.quirk()
	check(book.size() == 8, "quirk book has eight charts")
	var titles := ["The Dry Quirk", "The Wet Stop", "Color Kept", "No Turn", "Beside the Flood", "Two Quirks", "The Held Quirk", "The Quirk Mark"]
	for i in book.size():
		var chart: Dictionary = book[i]
		check(str(chart["id"]) == str(i + 223), "quirk chart %d keeps its number" % (i + 223))
		check(str(chart["title"]) == str(titles[i]), "quirk chart %d keeps its title" % (i + 223))
		check(str(chart["harbor"]) == Charts.QUIRK, "chart %s belongs to the quirk" % str(chart["id"]))
		var quirk_count := 0
		for raw_piece in chart["pieces"]:
			var piece: Dictionary = raw_piece
			if str(piece["kind"]) == "quirk":
				quirk_count += 1
		check(quirk_count >= 1, "chart %s needs the quirk" % str(chart["id"]))
	for older in Charts.all().slice(0, 222):
		for raw_piece in older["pieces"]:
			var older_piece: Dictionary = raw_piece
			check(str(older_piece["kind"]) != "quirk", "chart %s keeps its pieces" % str(older["id"]))
		for raw_fix in older["fixtures"]:
			var older_fix: Dictionary = raw_fix
			check(str(older_fix["kind"]) != "quirk", "chart %s keeps its fixed glass" % str(older["id"]))
	for i in book.size():
		for raw_piece in book[i]["pieces"]:
			var piece: Dictionary = raw_piece
			if str(piece["kind"]) != "quirk":
				continue
			var piece_id := str(piece["id"])
			var open_dir := Tracer.rotate_dir(Tracer.quirk_facing(int(piece["solution_rot"])), -1)
			for crot in [0, 90, 180, 270]:
				if Tracer.casement_facing(crot) != open_dir:
					_expect_quirk_miss(i, piece_id, "casement", crot, "casement %d" % crot)
				if Tracer.rotate_dir(Tracer.fillet_facing(crot), 2) != open_dir:
					_expect_quirk_miss(i, piece_id, "fillet", crot, "fillet %d" % crot)
				if Tracer.rotate_dir(Tracer.bead_facing(crot), 1) != open_dir:
