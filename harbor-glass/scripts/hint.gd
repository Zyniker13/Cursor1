extends RefCounted
class_name HintBook

# Hints compare the live state to the authored solution. They return the id of
# one wrong piece (or "tide"), never a rotation, a socket name, or the full
# layout. A state that already matches the solution produces no mark.
# Mirror, tide mirror, and pane rotations are compared after normalizing
# 180-degree repeats, so an equivalent facing is not reported as wrong.
# A shutter has no facing. Dry stops the beam, and flooded water lets it pass.
# A stain has no facing. Its two states are red and blue, not a rotation.
# A vane has four facings. North, east, south, and west are different pieces.
# A well has no facing. Rotation is ignored, the same way a shutter ignores it.
# A siphon has no facing. Rotation is ignored, the same way a well ignores it.
# A sluice has four facings. North, east, south, and west are different pieces.
# A hint uses that facing. Dry, every facing stops the beam.
# A weir has four facings. North, east, south, and west are different pieces.
# A hint uses that facing. Dry, every facing stops the beam. Flood swaps red
# with blue and leaves along the facing. White stays white.
# A lintel has no facing, so rotation is ignored: while its row is dry a beam passes straight through in the same direction and color without a bounce, and while that row is flooded the beam stops at the waterline and does not enter.
# A mullion has no facing, so rotation is ignored: while its row is dry a north-south beam passes straight through in the same direction and color without a bounce, an east-west beam stops before the cell, and while that row is flooded every beam stops at the waterline.
# A transom has no facing, so rotation is ignored: while its row is dry an east-west beam passes straight through in the same direction and color without a bounce, a north-south beam stops before the cell, and while that row is flooded every beam stops at the waterline.
# A casement has four facings. North, east, south, and west are different pieces. While its row is dry, only a beam already traveling that way passes straight through in the same direction and color without a bounce. Every other direction stops before the cell. While that row is flooded, every beam stops at the waterline.
# A jamb has four facings. North, east, south, and west are different pieces. While its row is dry, north or south passes both north and south, and east or west passes both east and west, in the same direction and color without a bounce. The other axis stops before the cell. While that row is flooded, every beam stops at the waterline.
# An astragal has four facings. North, east, south, and west are different pieces. While its row is dry, the facing and the next clockwise direction pass straight through in the same direction and color without a bounce. The other two directions stop before the cell. While that row is flooded, every beam stops at the waterline.
# A scotia has four facings. North, east, south, and west are different pieces. While its row is dry, the facing and the next counterclockwise direction pass straight through in the same direction and color without a bounce. The other two directions stop before the cell. While that row is flooded, every beam stops at the waterline. A north scotia is not a north astragal.
# A torus has four facings. North, east, south, and west are different pieces. While its row is dry, the opposite of the facing and the next clockwise direction pass straight through in the same direction and color without a bounce. The other two directions stop before the cell. Facing north, the open directions are south and east. While that row is flooded, every beam stops at the waterline. A north torus is not a north scotia and not a north astragal.
# An ogee has four facings. North, east, south, and west are different pieces. While its row is dry, the opposite of the facing and the next counterclockwise direction pass straight through in the same direction and color without a bounce. The other two directions stop before the cell. Facing north, the open directions are south and west. While that row is flooded, every beam stops at the waterline. A north ogee is not a north torus, not a north scotia, and not a north astragal.
# An ovolo has four facings. North, east, south, and west are different pieces. While its row is dry, every direction except the facing passes straight through in the same direction and color without a bounce. The facing stops before the cell. Facing north, east, south, and west pass, and north stops. While that row is flooded, every beam stops at the waterline. A north ovolo is not a north ogee, not a north torus, not a north scotia, and not a north astragal.
# A cavetto has four facings. North, east, south, and west are different pieces. While its row is dry, every direction except the opposite of the facing passes straight through in the same direction and color without a bounce. The opposite direction stops before the cell. Facing north, north, east, and west pass, and south stops. While that row is flooded, every beam stops at the waterline. A north cavetto is not a north ovolo, not a north ogee, not a north torus, and not a north scotia.
# A fillet has four facings. North, east, south, and west are different pieces. While its row is dry, only the opposite of the facing passes straight through in the same direction and color without a bounce. The facing and both sides stop before the cell. Facing north, south passes, and north, east, and west stop. While that row is flooded, every beam stops at the waterline. A north fillet is not a north cavetto, not a north casement, and not a north ovolo.
# A corona has four facings. Opposite facings open the same axis. While its row is dry, the two directions perpendicular to the facing pass straight through in the same direction and color without a bounce. The facing and the opposite stop before the cell. Facing north, east and west pass, and north and south stop. Turned once from north, north and south pass. While that row is flooded, every beam stops at the waterline. A north corona is not a transom, not a mullion, and not a north jamb.
# A bead has four facings. Opposite facings are not the same piece. While its row is dry, only the next clockwise direction passes straight through in the same direction and color without a bounce. The other three directions stop before the cell. Facing north, only east passes. One click faces east and passes only south. While that row is flooded, every beam stops at the waterline. A north bead is not a north casement, not a north fillet, not a north corona, and not a north astragal.
# A quirk has four facings. Opposite facings are not the same piece. While its row is dry, only the next counterclockwise direction passes straight through in the same direction and color without a bounce. The other three directions stop before the cell. Facing north, only west passes. One click faces east and passes only north. While that row is flooded, every beam stops at the waterline. A north quirk is not a north bead, not a north casement, not a north fillet, not a north corona, and not a north scotia.
# A cyma has four facings. Opposite facings are not the same piece. While its row is dry, only the facing passes straight through in the same direction and color without a bounce. The other three directions stop before the cell. Facing north, only north passes. One click faces east and passes only east. While that row is flooded, every beam stops at the waterline. A north cyma is not a north quirk, not a north bead, not a north fillet, not a north astragal, and not a north scotia.
# A fascia has four facings. Opposite facings are not the same piece. While its row is dry, every direction except the next clockwise one passes straight through in the same direction and color without a bounce. That clockwise direction stops before the cell. Facing north, east stops and the other three pass. One click faces east and stops south. While that row is flooded, every beam stops at the waterline. A north fascia is not a north cyma, not a north ovolo, and not a north cavetto.
# A soffit has four facings. Opposite facings are not the same piece. While its row is dry, every direction except the next counterclockwise one passes straight through in the same direction and color without a bounce. That counterclockwise direction stops before the cell. Facing north, west stops and north, east, and south pass. One click faces east and stops north. While that row is flooded, every beam stops at the waterline. A north soffit is not a north fascia, not a north quirk, and not a north cyma.
# A drip has four facings. Opposite facings are not the same piece. While its row is dry, it uses the soffit's rule: every direction except the next counterclockwise one passes. Facing north, west stops and north, east, and south pass. One click faces east and, while dry, stops north. While that row is flooded, the dry rule flips: only the dry-stopped direction passes, and the other three stop at the waterline. A flooded north drip passes only west. A flooded soffit stops that beam.
# A beak has four facings. It is the clockwise mirror of a drip. While its row is dry, every direction except the next clockwise one passes. Facing north, east stops and north, south, and west pass. One click faces east and stops south. While that row is flooded, only that dry-stopped direction passes. A flooded north beak passes only east. A flooded drip passes only west. A flooded fascia stops every beam.
# A hood has four facings. Opposite facings are not the same piece. While its row is dry, every direction except the facing passes. Facing north, north stops and east, south, and west pass. One click faces east and stops east. While that row is flooded, only the facing passes. A flooded north hood passes only north. A flooded beak passes only east. A flooded drip passes only west. A dry cyma passes only the facing, so it misses the dry charts.
# A throat has four facings. Opposite facings are not the same piece. While its row is dry, every direction except the opposite of the facing passes. Facing north, south stops and north, east, and west pass. One click faces east and stops west. While that row is flooded, only that opposite passes. A flooded north throat passes only south. A flooded north hood passes only north. A dry cavetto stops south and stays shut under water.
# A larmier has four facings. Opposite facings share the open set. While its row is dry, the two directions perpendicular to the facing pass. Facing north, east and west pass, and north and south stop. One click faces east and passes north and south. While that row is flooded, only the facing and the opposite pass. A flooded north larmier passes only north and south. A flooded corona stops that axis. A flooded north throat passes only south.
# A cill has four facings. Opposite facings share the open set. While its row is dry, the facing and the opposite pass. Facing north, north and south pass, and east and west stop. One click faces east and passes east and west. While that row is flooded, only the two perpendicular directions pass. A flooded north cill passes only east and west. A flooded north larmier passes only north and south. A flooded corona stays shut.
# A threshold has four facings. Opposite facings do not share the open set. While its row is dry, only the opposite of the facing passes. Facing north, only south passes, and north, east, and west stop. One click faces east and only west passes. While that row is flooded, every direction except the opposite passes. A flooded north threshold passes north, east, and west, and stops south. A flooded north throat passes only south. A dry north cill passes north and south. A dry fillet passes only south and stays shut under water.
# An impost has four facings. Opposite facings do not share the open set. While its row is dry, only the facing passes. Facing north, only north passes, and east, west, and south stop. One click faces east and only east passes. While that row is flooded, every direction except the facing passes. A flooded north impost passes south, east, and west, and stops north. A dry north threshold passes only south. A dry cyma passes only north and stays shut under water. A dry fillet passes only south and stays shut under water.
# An architrave has four facings. While its row is dry, the two perpendicular headings pass. Facing north, east and west pass, and north and south stop. One click faces east and only north and south pass. A south architrave passes the same east and west. While that row is flooded, only the facing passes. A flooded north architrave passes only north. One click faces east and only east passes. A flooded south architrave passes only south. A dry impost passes only the facing. A dry threshold passes only the opposite. A cyma stays shut under water.
# An archivolt has four facings. While its row is dry, every heading stops. While that row is flooded, the two perpendicular headings pass. A flooded north archivolt passes east and west and stops north and south. One click faces east and only north and south pass. A flooded south archivolt passes the same east and west. A dry north throat passes north, east, and west. A flooded north throat passes only south. A flooded north cill passes the same east and west and, while dry, passes north and south.
# An abacus has four facings. While its row is dry, every heading stops. While that row is flooded, only the facing passes. A flooded north abacus passes only north. One click faces east and only east passes. A flooded south abacus passes only south. A dry lintel passes every heading and stays shut under water. A flooded north archivolt passes east and west. A dry cyma passes only north and stays shut under water.
# A rebate has four facings. While its row is dry, every heading stops. One click still stops every heading. While that row is flooded, only the opposite of the facing passes. A flooded north rebate passes only south. East, west, and north stop. One click faces east and only west passes. A flooded south rebate passes only north. A flooded north abacus passes only north. A flooded north archivolt passes east and west. A dry throat passes every heading except south, and a flooded north throat passes this same south.
# An echinus has four facings. While its row is dry, every heading except the opposite passes. A dry north echinus passes north, east, and west, and stops south. While that row is flooded, only the next clockwise heading passes. A flooded north echinus passes only east. One click faces east and only south passes. A flooded south echinus passes only west. A dry fillet passes only south and stays shut under water. A flooded north rebate passes only south. A flooded north abacus passes only north. A flooded north throat passes only south.
# An annulet has four facings. While its row is dry, every heading except the opposite passes. A dry north annulet passes north, east, and west, and stops south. While that row is flooded, only the next counterclockwise heading passes. A flooded north annulet passes only west. One click faces east and only north passes. A flooded south annulet passes only east. A dry bead passes only east and stays shut under water. A dry quirk passes only west and stays shut under water. A flooded north echinus passes only east. A flooded north rebate passes only south. A flooded north abacus passes only north. A flooded north throat passes only south.
# A listel has four facings. While its row is dry, every heading stops. One click still stops every heading. While that row is flooded, the facing and the next clockwise heading pass. A flooded north listel passes north and east. West and south stop. One click faces east and east and south pass. A flooded south listel passes south and west. A dry cyma passes only north and stays shut under water. A flooded north annulet passes only west. A flooded north echinus passes only east. A flooded north rebate passes only south. A flooded north abacus passes only north. A flooded north throat passes only south.
# A necking has four facings. While its row is dry, every heading stops. One click still stops every heading. While that row is flooded, the facing and the next counterclockwise heading pass. A flooded north necking passes north and west. East and south stop. One click faces east and only east and north pass. A flooded south necking passes south and east. A dry scotia passes north and west and stays shut under water. A flooded north listel passes north and east. A flooded north annulet passes only west. A flooded north echinus passes only east. A flooded north rebate passes only south. A flooded north abacus passes only north. A flooded north throat passes only south.
# A taenia has four facings. While its row is dry, every heading stops. One click still stops every heading. While that row is flooded, the facing and the opposite pass. A flooded north taenia passes north and south. East and west stop. One click faces east and only east and west pass. A flooded south taenia passes the same north and south. A dry cill passes north and south and stays open on that axis while dry. A flooded north larmier passes this same pair and, while dry, passes east and west. A flooded north listel passes north and east. A flooded north necking passes north and west. A flooded north annulet passes only west. A flooded north echinus passes only east. A flooded north rebate passes only south. A flooded north abacus passes only north. A flooded north throat passes only south.
# A baguette has four facings. While its row is dry, every heading stops. One click still stops every heading. While that row is flooded, every heading except the opposite passes. A flooded north baguette passes north, east, and west, and stops south. One click faces east and passes east, north, and south, and stops west. A flooded south baguette passes south, east, and west, and stops north. An archivolt stays shut while dry and passes east and west under water. A dry larmier passes east and west. A flooded north threshold passes north, east, and west and, while dry, passes only south. A flooded north taenia passes north and south. A flooded north listel passes north and east. A flooded north necking passes north and west. A flooded north annulet passes only west. A flooded north echinus passes only east. A flooded north rebate passes only south. A flooded north abacus passes only north. A flooded north throat passes only south.
# A reglet has four facings. While its row is dry, every heading stops. One click still stops every heading. While that row is flooded, the facing, the opposite, and the next clockwise heading pass. A flooded north reglet passes north, south, and east, and stops west. One click faces east and east, west, and south pass while north stops. A flooded south reglet passes south, north, and west, and stops east. A dry soffit passes north, east, and south and stays shut under water. A flooded north drip passes only west. A flooded north baguette passes north, east, and west, and stops south. A flooded north listel passes north and east. A flooded north necking passes north and west. A flooded north taenia passes north and south. A flooded north annulet passes only west. A flooded north echinus passes only east. A flooded north rebate passes only south. A flooded north abacus passes only north. A flooded north throat passes only south.
# A billet has four facings. While its row is dry, every heading stops. One click still stops every heading. While that row is flooded, the facing, the opposite, and the next counterclockwise heading pass. A flooded north billet passes north, south, and west, and stops east. One click faces east and east, west, and north pass while south stops. A flooded south billet passes south, north, and east, and stops west. A dry fascia passes north, south, and west and stays shut under water. A flooded north beak passes only east. A flooded north reglet passes north, south, and east, and stops west. A flooded north baguette passes north, east, and west, and stops south. A flooded north listel passes north and east. A flooded north necking passes north and west. A flooded north taenia passes north and south. A flooded north annulet passes only west. A flooded north echinus passes only east. A flooded north rebate passes only south. A flooded north abacus passes only north. A flooded north throat passes only south.
# A reed has four facings. While its row is dry, every heading stops. One click still stops every heading. While that row is flooded, every heading passes. One click still passes every heading. Every flooded facing shares that open set. A flooded impost stops its facing. A dry ovolo passes every heading except its facing and stays shut under water. A lintel passes every heading while dry and stays shut under water. A flooded north billet passes north, south, and west, and stops east. A flooded north reglet passes north, south, and east, and stops west. A flooded north baguette passes north, east, and west, and stops south. A flooded north listel passes north and east. A flooded north necking passes north and west. A flooded north taenia passes north and south. A flooded north annulet passes only west. A flooded north echinus passes only east. A flooded north rebate passes only south. A flooded north abacus passes only north. A flooded north throat passes only south.
# A staff has four facings. While its row is dry, every heading stops. One click still stops every heading. While that row is flooded, the opposite and the next clockwise heading pass. A flooded north staff passes south and east, and stops north and west. One click faces east and south and west pass while north and east stop. A flooded south staff passes north and west. Opposite flooded facings do not share that set. An impost passes only its facing while dry and every heading except that facing under water. A threshold passes only its opposite while dry and every heading except that opposite under water. A dry torus passes south and east and stays shut under water. A dry bead passes only east and stays shut under water. A dry fascia stops only east and stays shut under water. A flooded north beak passes only east. A flooded north billet passes north, south, and west, and stops east. A flooded reed passes every heading.
# A thumb has four facings. While its row is dry, every heading stops. One click still stops every heading. While that row is flooded, the opposite and the next counterclockwise heading pass. A flooded north thumb passes south and west, and stops north and east. One click from south faces west, and east and south pass while north and west stop. A flooded south thumb passes north and east. Opposite flooded facings do not share that set. A dry ogee passes south and west and stays shut under water. A flooded north staff passes south and east. A flooded reed passes every heading.
# A roll has four facings. While its row is dry, every heading stops. One click still stops every heading. While that row is flooded, every heading except the facing passes. A flooded north roll passes south, east, and west, and stops north. One click faces east and north, south, and west pass while east stops. A flooded south roll passes north, east, and west, and stops south. Opposite flooded facings do not share that set. A taenia passes north and south under water. A flooded north impost passes south, east, and west and, while dry, passes only north. A dry ovolo passes every heading except its facing and stays shut under water. A flooded north thumb passes south and west.
# A gutta has four facings. While its row is dry, only the facing passes. North passes only north. One click faces east and only east passes. While that row is flooded, the two perpendicular headings pass. A flooded north gutta passes east and west and stops north and south. One click faces east and only north and south pass. A flooded south gutta passes the same east and west. Opposite flooded facings share that set. A listel stays shut while dry and passes north and east under water. A dry cyma passes only north and stays shut under water. An archivolt stays shut while dry and passes east and west under water.

const Tracer := preload("res://scripts/beam_tracer.gd")

static func wrong_pieces(chart: Dictionary, state: Dictionary) -> PackedStringArray:
	var wrong := PackedStringArray()
	var pieces: Dictionary = state["pieces"]
	for raw in chart["pieces"]:
		var piece: Dictionary = raw
		var id := str(piece["id"])
		var cur: Dictionary = pieces[id]
		var kind := str(piece["kind"])
		var rot_diff := Tracer.norm_rot(kind, int(cur["rot"])) != Tracer.norm_rot(kind, int(piece["solution_rot"]))
		var sock_diff := str(cur["socket"]) != str(piece["solution_socket"])
		if rot_diff or sock_diff:
			wrong.append(id)
	if int(state["tide_index"]) != int(chart["solution_tide_index"]):
		wrong.append("tide")
	return wrong

static func first_wrong(chart: Dictionary, state: Dictionary) -> String:
	var wrong := wrong_pieces(chart, state)
	if wrong.is_empty():
		return ""
	return wrong[0]

# hints_left is the remaining budget. current_mark is the piece already shown.
# Asking again about the same piece does not spend another hint and does not
# reveal anything new. A matching solution returns an empty mark.
static func take_hint(chart: Dictionary, state: Dictionary, hints_left: int, current_mark: String) -> Dictionary:
	var wrong := wrong_pieces(chart, state)
	if wrong.is_empty():
		return {"hints_left": hints_left, "mark": "", "kind": "match"}
	var first := wrong[0]
	if current_mark != "" and first == current_mark:
		return {"hints_left": hints_left, "mark": current_mark, "kind": "same"}
	if hints_left <= 0:
		return {"hints_left": 0, "mark": current_mark, "kind": "empty"}
	return {"hints_left": hints_left - 1, "mark": first, "kind": "new"}
