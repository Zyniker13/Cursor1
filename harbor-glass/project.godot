; Engine configuration file.
; Harbor Glass — South Lantern Quay. Godot 4, 2D, no imported art.

config_version=5

[application]

config/name="Harbor Glass"
config/description="A tide-clock light puzzle across the quay, the reach, the turning basin, the painted lock, the west return, the meeting glass, the tide mirror, the shutter, the stain, the vane, the well, the siphon, the sluice, the weir, the lintel, the mullion, the transom, the casement, the jamb, the astragal, the scotia, the torus, the ogee, the ovolo, the cavetto, the fillet, the corona, the bead, the quirk, the cyma, the fascia, the soffit, and the drip."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
